<%
  const specialtyLinks = (typeof specialties !== 'undefined' ? specialties : []);
%>
<header class="ann-header" id="ann-header">
  <nav class="ann-container" aria-label="Navigation principale">
    <div class="ann-nav">
      <!-- Logo -->
      <a href="/" class="ann-logo" aria-label="Quiz Couple Annuaire - Accueil">
        <div class="ann-logo-icon">
          <svg viewBox="0 0 32 32" fill="none" class="ann-logo-svg">
            <path d="M16 28s-11-7.2-11-14.5C5 8.8 8.6 5 13 5c2.5 0 4.7 1.2 6 3a7.1 7.1 0 016-3c4.4 0 8 3.8 8 8.5C33 20.8 22 28 22 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="3" fill="currentColor" opacity="0.3"/>
          </svg>
        </div>
        <div class="ann-logo-text">
          <span class="ann-logo-title">Quiz Couple</span>
          <span class="ann-logo-subtitle">Annuaire</span>
        </div>
      </a>

      <!-- Desktop Search (compact) -->
      <div class="ann-nav-search" id="nav-search-desktop">
        <div class="ann-search-compact">
          <svg class="ann-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" class="ann-search-input" placeholder="Rechercher un professionnel, une ville..." id="nav-search-input" autocomplete="off">
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="ann-nav-links" id="nav-links-desktop">
        <!-- Spécialités dropdown -->
        <div class="ann-dropdown" data-dropdown>
          <button class="ann-nav-link ann-dropdown-trigger" aria-expanded="false" data-dropdown-trigger>
            <span>Spécialités</span>
            <svg class="ann-chevron" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ann-dropdown-menu" data-dropdown-menu>
            <% for (const spec of specialtyLinks) { %>
            <a href="/<%= spec.id %>/" class="ann-dropdown-item">
              <span class="ann-dropdown-dot" style="background-color: <%= spec.color %>"></span>
              <span><%= spec.name %></span>
            </a>
            <% } %>
          </div>
        </div>

        <!-- Découvrir -->
        <a href="/decouvrir/" class="ann-nav-link">Découvrir l'annuaire</a>

        <!-- Tarifs -->
        <a href="/tarifs/" class="ann-nav-link">Tarifs</a>
      </div>

      <!-- Actions -->
      <div class="ann-nav-actions">
        <!-- Theme Toggle -->
        <button id="ann-theme-toggle" class="ann-icon-btn" aria-label="Changer le thème">
          <svg class="ann-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="ann-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>

        <!-- Login / Mon espace -->
        <a id="ann-login-btn" href="/dashboard/" class="ann-btn ann-btn-outline ann-btn-nav ann-login-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ann-btn-icon"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          <span>Se connecter</span>
        </a>

        <!-- CTA Button -->
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-nav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ann-btn-icon"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          <span>Rejoindre l'annuaire</span>
        </a>

        <!-- Mobile Menu Button -->
        <button id="ann-mobile-btn" class="ann-icon-btn ann-mobile-only" aria-expanded="false" aria-controls="ann-mobile-menu" aria-label="Menu">
          <svg class="ann-menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="ann-close-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="ann-mobile-menu" class="ann-mobile-menu hidden">
      <!-- Mobile Search -->
      <div class="ann-mobile-search">
        <svg class="ann-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" class="ann-search-input" placeholder="Rechercher..." id="mobile-search-input" autocomplete="off">
      </div>

      <div class="ann-mobile-links">
        <!-- Spécialités accordion -->
        <div class="ann-mobile-accordion" data-accordion>
          <button class="ann-mobile-accordion-trigger" aria-expanded="false" data-accordion-trigger>
            <span>Spécialités</span>
            <svg class="ann-chevron" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ann-mobile-accordion-content hidden" data-accordion-content>
            <% for (const spec of specialtyLinks) { %>
            <a href="/<%= spec.id %>/" class="ann-mobile-sublink">
              <span class="ann-dropdown-dot" style="background-color: <%= spec.color %>"></span>
              <%= spec.name %>
            </a>
            <% } %>
          </div>
        </div>

        <a href="/decouvrir/" class="ann-mobile-link">Découvrir l'annuaire</a>
        <a href="/tarifs/" class="ann-mobile-link">Tarifs</a>

        <!-- Mobile Login -->
        <a id="ann-login-btn-mobile" href="/dashboard/" class="ann-mobile-link ann-login-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.125rem;height:1.125rem;margin-right:0.5rem;"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Se connecter
        </a>

        <!-- Mobile CTA -->
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-full">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ann-btn-icon"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          <span>Rejoindre l'annuaire</span>
        </a>
      </div>
    </div>
  </nav>
</header>
