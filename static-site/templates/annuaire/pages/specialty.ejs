<%
  // Variables: specialty, filteredProfessionals, specialties, cities, professionals
  const otherSpecialties = specialties.filter(s => s.id !== specialty.id);
  const seo = specialty.seoContent || {};

  // All cities (for carousel + search), with pro count per city for this specialty
  const cityProCounts = {};
  filteredProfessionals.forEach(p => {
    cityProCounts[p.city] = (cityProCounts[p.city] || 0) + 1;
  });

  // JSON-LD
  const jsonLdArray = [
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": specialty.name + " en France",
      "description": specialty.description,
      "url": canonical,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": baseUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": specialty.name }
      ]
    }
  ];

  if (seo.faq && seo.faq.length > 0) {
    jsonLdArray.push({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": seo.faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    });
  }
%>
<% for (const ld of jsonLdArray) { %>
<script type="application/ld+json"><%- JSON.stringify(ld) %></script>
<% } %>

<!-- Specialty Hero -->
<section class="ann-listing-hero">
  <div class="ann-container">
    <nav class="ann-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <span><%= specialty.name %></span>
    </nav>

    <div class="ann-listing-hero-content">
      <div class="ann-listing-hero-icon" style="background: <%= specialty.color %>">
        <%- include('../partials/specialty-icon', { icon: specialty.icon }) %>
      </div>

      <h1>
        <span class="ann-text-gradient"><%= specialty.name %></span> en France
      </h1>
      <p class="ann-text-muted ann-text-lg" style="max-width: 40rem;">
        <%= specialty.description %>
      </p>

      <div class="ann-listing-stats">
        <div class="ann-listing-stat">
          <strong><%= filteredProfessionals.length %></strong>
          <span>professionnel<%= filteredProfessionals.length > 1 ? 's' : '' %></span>
        </div>
        <div class="ann-listing-stat">
          <strong><%= cities.length %></strong>
          <span>ville<%= cities.length > 1 ? 's' : '' %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- City Carousel -->
<section class="ann-section">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2>Trouvez un <span class="ann-text-gradient"><%= specialty.name.toLowerCase() %></span> dans votre ville</h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0.75rem auto 0;">Sélectionnez votre ville pour consulter les profils disponibles près de chez vous.</p>
    </div>

    <!-- Search filter -->
    <div class="ann-city-search-wrap">
      <div class="ann-city-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem;color:hsl(var(--ann-muted-fg))"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="city-filter-input" placeholder="Rechercher votre ville..." class="ann-city-search-input" autocomplete="off">
      </div>
    </div>

    <!-- Carousel -->
    <div class="ann-carousel-container">
      <button class="ann-carousel-btn ann-carousel-prev" aria-label="Précédent" data-carousel-prev>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="ann-carousel-viewport">
        <div class="ann-carousel-track" id="city-carousel-track">
          <% for (const c of [...cities].sort((a, b) => a.name.localeCompare(b.name, 'fr'))) { %>
          <a href="/<%= specialty.id %>/<%= c.id %>/" class="ann-city-carousel-card" data-city-name="<%= c.name.toLowerCase() %>">
            <svg class="ann-city-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="ann-city-carousel-name"><%= c.name %></span>
            <span class="ann-city-carousel-dept"><%= c.department %> · <%= c.region %></span>
            <% if (cityProCounts[c.id]) { %>
            <span class="ann-city-carousel-count"><%= cityProCounts[c.id] %> pro<%= cityProCounts[c.id] > 1 ? 's' : '' %></span>
            <% } %>
          </a>
          <% } %>
        </div>
      </div>

      <button class="ann-carousel-btn ann-carousel-next" aria-label="Suivant" data-carousel-next>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- No results message -->
    <p class="ann-city-no-results hidden" id="city-no-results" style="text-align:center;color:hsl(var(--ann-muted-fg));margin-top:1rem;">Aucune ville trouvée. Essayez un autre nom.</p>
  </div>
</section>

<% if (seo.sections && seo.sections.length) { %>
<div class="ann-divider"></div>

<!-- SEO Content -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-seo-content">
      <% for (const section of seo.sections) { %>
      <div class="ann-seo-block">
        <h2><%= section.title %></h2>
        <%- section.content %>
      </div>
      <% } %>

      <% if (seo.priceRange) { %>
      <div class="ann-seo-block">
        <h3>Tarifs indicatifs</h3>
        <p><%= seo.priceRange %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (seo.faq && seo.faq.length > 0) { %>
<div class="ann-divider"></div>

<!-- FAQ -->
<section class="ann-section" style="background: hsl(var(--ann-muted) / 0.25);">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2>Questions fréquentes sur <span class="ann-text-gradient">les <%= specialty.name.toLowerCase() %>s</span></h2>
    </div>

    <div class="ann-faq-list">
      <% for (const item of seo.faq) { %>
      <div class="ann-faq-item" data-faq>
        <button class="ann-faq-trigger" data-faq-trigger aria-expanded="false">
          <span><%= item.q %></span>
          <svg class="ann-chevron" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="ann-faq-answer hidden" data-faq-answer>
          <p><%= item.a %></p>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<div class="ann-divider"></div>

<!-- Other specialties -->
<section class="ann-section" style="background: hsl(var(--ann-muted) / 0.25);">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2>Autres <span class="ann-text-gradient">spécialités</span></h2>
      <p class="ann-text-muted">Explorez d'autres types de professionnels du couple.</p>
    </div>

    <div class="ann-categories-grid ann-stagger">
      <% for (const spec of otherSpecialties) { %>
      <a href="/<%= spec.id %>/" class="ann-category-card ann-animate-fade-in-up">
        <div class="ann-category-icon" style="background: <%= spec.color %>">
          <%- include('../partials/specialty-icon', { icon: spec.icon }) %>
        </div>
        <div class="ann-category-info">
          <div class="ann-category-name"><%= spec.name %></div>
          <div class="ann-category-count"><%= professionals.filter(p => p.specialty === spec.id).length %> professionnel<%= professionals.filter(p => p.specialty === spec.id).length > 1 ? 's' : '' %></div>
        </div>
        <svg class="ann-category-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- CTA -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-cta-section">
      <h2 style="margin-bottom: 0.75rem;">Vous êtes <span class="ann-text-gradient"><%= specialty.name.toLowerCase() %></span> ?</h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0 auto 1.5rem;">Inscrivez votre cabinet gratuitement et gagnez en visibilité auprès de patients qualifiés dans votre ville.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-lg">
          Inscrire mon cabinet
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/tarifs/" class="ann-btn ann-btn-outline ann-btn-lg">Voir les tarifs</a>
      </div>
    </div>
  </div>
</section>
