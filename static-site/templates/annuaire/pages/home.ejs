<%
  // Structured data
  const jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Quiz Couple - Annuaire",
      "url": "https://annuaire.quiz-couple.com",
      "description": "L'annuaire des professionnels du couple en France : thérapeutes, sexologues, médiateurs familiaux, coachs parentaux et conseillers conjugaux.",
      "publisher": { "@id": "https://quiz-couple.com/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://annuaire.quiz-couple.com/recherche?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Catégories de professionnels du couple",
      "itemListElement": specialties.map((s, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": s.name,
        "url": "https://annuaire.quiz-couple.com/" + s.id + "/"
      }))
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero Section -->
<section class="ann-hero">
  <div class="ann-hero-bg"></div>
  <div class="ann-orb ann-orb-1" aria-hidden="true"></div>
  <div class="ann-orb ann-orb-2" aria-hidden="true"></div>

  <div class="ann-container ann-hero-content">
    <div style="max-width: 48rem; margin: 0 auto; text-align: center;">
      <div class="ann-badge ann-badge-primary ann-animate-fade-in" style="margin-bottom: 1rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.875rem;height:0.875rem"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Annuaire des professionnels du couple
      </div>

      <h1 class="ann-animate-fade-in-up" style="margin-bottom: 1rem;">
        Trouvez le <span class="ann-text-gradient">professionnel du couple</span> qu'il vous faut
      </h1>

      <p class="ann-text-muted ann-text-lg ann-animate-fade-in-up" style="max-width: 36rem; margin: 0 auto 0.5rem;">
        Thérapeutes, sexologues, médiateurs familiaux... Consultez notre annuaire et trouvez un professionnel qualifié <strong style="color: hsl(var(--ann-fg))">près de chez vous</strong>.
      </p>

      <!-- Stats -->
      <div class="ann-stats ann-animate-fade-in" style="padding: 1.5rem 0;">
        <div class="ann-stat">
          <div class="ann-stat-value"><%= professionals.length %>+</div>
          <div class="ann-stat-label">Professionnels</div>
        </div>
        <div class="ann-stat">
          <div class="ann-stat-value"><%= specialties.length %></div>
          <div class="ann-stat-label">Spécialités</div>
        </div>
        <div class="ann-stat">
          <div class="ann-stat-value"><%= cities.length %></div>
          <div class="ann-stat-label">Villes couvertes</div>
        </div>
      </div>

      <!-- Hero Search -->
      <div class="ann-hero-search ann-animate-scale-in">
        <form class="ann-search-box" id="hero-search-form" action="/recherche/" method="get">
          <div class="ann-search-field">
            <svg class="ann-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" name="q" placeholder="Spécialité, nom du professionnel..." autocomplete="off">
          </div>
          <div class="ann-search-divider"></div>
          <div class="ann-search-field ann-search-field-city">
            <svg class="ann-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <input type="text" name="city" placeholder="Ville ou code postal" autocomplete="off">
          </div>
          <button type="submit" class="ann-search-submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            Rechercher
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Divider -->
<div class="ann-divider"></div>

<!-- Categories Section -->
<section class="ann-section">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2>Trouvez un professionnel par <span class="ann-text-gradient">spécialité</span></h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0.75rem auto 0;">Sélectionnez la spécialité qui correspond à vos besoins pour trouver le bon professionnel.</p>
    </div>

    <div class="ann-categories-grid ann-stagger">
      <% for (const spec of specialties) { %>
      <a href="/<%= spec.id %>/" class="ann-category-card ann-animate-fade-in-up">
        <div class="ann-category-icon" style="background: <%= spec.color %>">
          <% if (spec.icon === 'heart-handshake') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0016.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 002 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5L9.04 7.96a2.17 2.17 0 000 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 013.79 0l2.96 2.66"/><path d="M18 15l-2-2"/><path d="M15 18l-2-2"/></svg>
          <% } else if (spec.icon === 'flame') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z"/></svg>
          <% } else if (spec.icon === 'sparkles') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 01-1.275 1.275L3 12l5.813 1.912a2 2 0 011.275 1.275L12 21l1.912-5.813a2 2 0 011.275-1.275L21 12l-5.813-1.912a2 2 0 01-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          <% } else if (spec.icon === 'scale') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
          <% } else if (spec.icon === 'baby') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h.01"/><path d="M15 12h.01"/><path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/><path d="M19 6.3a9 9 0 01.8 3.7c0 5-3.6 9-8 9s-8-4-8-9a9 9 0 01.8-3.7"/><path d="M12 2c-1.5 0-3 .5-4 1.5"/><path d="M16 3.5c-1-1-2.5-1.5-4-1.5"/></svg>
          <% } else if (spec.icon === 'message-circle-heart') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 104 16.1L2 22Z"/><path d="M15.8 9.2a2.5 2.5 0 00-3.5 0l-.3.4-.3-.4a2.5 2.5 0 00-3.5 0 2.7 2.7 0 000 3.5L12 17l3.8-4.3a2.7 2.7 0 000-3.5Z"/></svg>
          <% } %>
        </div>
        <div class="ann-category-info">
          <div class="ann-category-name"><%= spec.name %></div>
          <div class="ann-category-count"><%= professionals.filter(p => p.specialty === spec.id).length %> professionnel<%= professionals.filter(p => p.specialty === spec.id).length > 1 ? 's' : '' %> référencés</div>
        </div>
        <svg class="ann-category-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>

<!-- Divider -->
<div class="ann-divider"></div>

<!-- Featured Professionals -->
<section class="ann-section" style="background: hsl(var(--ann-muted) / 0.25);">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <div class="ann-badge ann-badge-premium" style="margin-bottom: 0.75rem;">
        <svg viewBox="0 0 24 24" fill="currentColor" style="width:0.75rem;height:0.75rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Professionnels en vedette
      </div>
      <h2>Des professionnels <span class="ann-text-gradient">de confiance</span></h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0.75rem auto 0;">Découvrez nos professionnels les mieux notés, vérifiés et recommandés par leurs patients.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: 1.25rem; max-width: 66rem; margin: 0 auto;">
      <% const featured = professionals.filter(p => p.premium).slice(0, 4); %>
      <% for (const pro of featured) { %>
      <% const proSpec = specialties.find(s => s.id === pro.specialty); %>
      <div class="ann-pro-card ann-pro-card-premium ann-animate-fade-in-up">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
          <div class="ann-badge ann-badge-premium" style="font-size: 0.6875rem;">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:0.625rem;height:0.625rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Premium
          </div>
        </div>

        <div class="ann-pro-header">
          <% if (pro.photoUrl) { %>
          <div class="ann-pro-avatar ann-pro-avatar-photo"><img src="<%= pro.photoUrl %>" alt="Photo de <%= pro.firstName %> <%= pro.lastName %>" loading="lazy"></div>
          <% } else { %>
          <div class="ann-pro-avatar"><%= pro.firstName[0] %><%= pro.lastName[0] %></div>
          <% } %>
          <div class="ann-pro-info">
            <div class="ann-pro-name"><%= pro.firstName %> <%= pro.lastName %></div>
            <div class="ann-pro-specialty"><%= proSpec ? proSpec.name : pro.specialty %></div>
          </div>
        </div>

        <% if (pro.premium && pro.reviewCount > 0) { %>
        <div class="ann-pro-rating">
          <div class="ann-stars">
            <% for (let i = 1; i <= 5; i++) { %>
            <svg class="ann-star<%= i > Math.round(pro.rating) ? ' ann-star-empty' : '' %>" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <% } %>
          </div>
          <span class="ann-rating-text"><%= pro.rating %></span>
          <span class="ann-review-count">(<%= pro.reviewCount %> avis)</span>
        </div>
        <% } %>

        <p class="ann-pro-desc"><%= pro.shortDescription || pro.description %></p>

        <div class="ann-pro-meta">
          <span class="ann-pro-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <% const proCity = cities.find(c => c.id === pro.city); %>
            <%= pro.displayCity || (proCity ? proCity.name : pro.city) %>
          </span>
          <span class="ann-pro-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= pro.yearsExperience %> ans d'exp.
          </span>
          <span class="ann-pro-meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            <%= pro.priceRange %>
          </span>
        </div>

        <div class="ann-pro-actions">
          <a href="/<%= pro.specialty %>/<%= pro.city %>/<%= pro.slug %>/" class="ann-btn ann-btn-primary ann-btn-sm" style="flex:1">Voir le profil</a>
        </div>
      </div>
      <% } %>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
      <a href="/recherche/" class="ann-btn ann-btn-outline">
        Voir tous les professionnels
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Divider -->
<div class="ann-divider"></div>

<!-- Map Section -->
<section class="ann-section">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2>Explorez par <span class="ann-text-gradient">localisation</span></h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0.75rem auto 0;">Tous les professionnels du couple sur une carte interactive. Zoomez sur votre ville pour trouver les plus proches.</p>
    </div>

    <div class="ann-map-container" id="ann-map" data-professionals='<%- JSON.stringify(professionals.map(p => ({ id: p.id, name: p.firstName + " " + p.lastName, lat: p.lat, lng: p.lng, specialty: p.specialty, city: p.city, slug: p.slug, premium: p.premium, plan: p.plan }))) %>' data-specialties='<%- JSON.stringify(specialties.map(s => ({ id: s.id, name: s.name, color: s.color }))) %>'>
    </div>

    <!-- Popular Cities -->
    <div style="margin-top: 2.5rem;">
      <h3 style="margin-bottom: 1.25rem; text-align: center;">Villes populaires</h3>
      <div class="ann-cities-grid ann-stagger">
        <% const topCities = cities.sort((a, b) => b.population - a.population).slice(0, 10); %>
        <% for (const city of topCities) { %>
        <a href="/<%= city.id %>/" class="ann-city-card ann-animate-fade-in-up">
          <svg class="ann-city-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="ann-city-name"><%= city.name %></span>
        </a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Divider -->
<div class="ann-divider"></div>

<!-- How It Works -->
<section class="ann-section" style="background: hsl(var(--ann-muted) / 0.25);">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h2>Comment ça <span class="ann-text-gradient">fonctionne</span></h2>
      <p class="ann-text-muted" style="max-width: 28rem; margin: 0.75rem auto 0;">Un annuaire pensé pour vous simplifier la vie.</p>
    </div>

    <div class="ann-steps" style="max-width: 52rem; margin: 0 auto;">
      <div class="ann-step ann-animate-fade-in-up">
        <div class="ann-step-number">1</div>
        <div class="ann-step-title">Choisissez votre spécialité</div>
        <p class="ann-step-desc">Thérapeute de couple, sexologue, médiateur familial... Sélectionnez ce qui correspond à votre situation.</p>
      </div>
      <div class="ann-step ann-animate-fade-in-up">
        <div class="ann-step-number">2</div>
        <div class="ann-step-title">Trouvez près de chez vous</div>
        <p class="ann-step-desc">Entrez votre ville ou code postal pour afficher les professionnels les plus proches de votre domicile.</p>
      </div>
      <div class="ann-step ann-animate-fade-in-up">
        <div class="ann-step-number">3</div>
        <div class="ann-step-title">Consultez et contactez</div>
        <p class="ann-step-desc">Comparez les profils, lisez les avis et contactez directement le professionnel qui vous convient.</p>
      </div>
    </div>
  </div>
</section>

<!-- Divider -->
<div class="ann-divider"></div>

<!-- CTA Section (for professionals) -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-cta-section">
      <div class="ann-badge ann-badge-primary" style="margin-bottom: 1rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.875rem;height:0.875rem"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
        Vous êtes professionnel ?
      </div>
      <h2 style="margin-bottom: 0.75rem;">Rejoignez notre <span class="ann-text-gradient">annuaire</span></h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0 auto 1.5rem;">Augmentez votre visibilité et recevez de nouveaux clients grâce à notre plateforme spécialisée dans le couple.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-lg">
          Inscrire mon cabinet
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/tarifs/" class="ann-btn ann-btn-outline ann-btn-lg">Voir les tarifs</a>
      </div>
    </div>
  </div>
</section>
