<%
  // Variables: pro, proSpec, proCity, specialties, cities, professionals
  const otherPros = professionals.filter(p => p.id !== pro.id && (p.specialty === pro.specialty || p.city === pro.city)).slice(0, 3);

  // Build openingHoursSpecification for structured data
  const _oh = (typeof pro.openingHours !== 'undefined') ? pro.openingHours : null;
  const _daysMap = { monday: 'Monday', tuesday: 'Tuesday', wednesday: 'Wednesday', thursday: 'Thursday', friday: 'Friday', saturday: 'Saturday', sunday: 'Sunday' };
  const _ohSpecs = [];
  if (_oh) {
    for (const [key, schemaDay] of Object.entries(_daysMap)) {
      const d = _oh[key];
      if (d && !d.closed) {
        if (d.morning_start && d.morning_end) _ohSpecs.push({ "@type": "OpeningHoursSpecification", "dayOfWeek": schemaDay, "opens": d.morning_start, "closes": d.morning_end });
        if (d.afternoon_start && d.afternoon_end) _ohSpecs.push({ "@type": "OpeningHoursSpecification", "dayOfWeek": schemaDay, "opens": d.afternoon_start, "closes": d.afternoon_end });
        if (!d.morning_end && !d.afternoon_start && d.morning_start && d.afternoon_end) _ohSpecs.push({ "@type": "OpeningHoursSpecification", "dayOfWeek": schemaDay, "opens": d.morning_start, "closes": d.afternoon_end });
      }
    }
  }

  // JSON-LD: Person + BreadcrumbList
  const jsonLdArray = [
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": pro.firstName + " " + pro.lastName,
      "jobTitle": proSpec ? proSpec.name : pro.specialty,
      "description": pro.shortDescription || pro.description,
      "url": canonical,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": pro.address,
        "addressLocality": pro.displayCity || (proCity ? proCity.name : pro.city),
        "postalCode": pro.postalCode || "",
        "addressCountry": {
          "@type": "Country",
          "name": "FR"
        }
      },
      "workLocation": {
        "@type": "Place",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": pro.lat,
          "longitude": pro.lng
        }
      },
      "telephone": pro.phone,
      "email": pro.email,
      "knowsLanguage": pro.languages,
      ...(_ohSpecs.length > 0 ? { "openingHoursSpecification": _ohSpecs } : {}),
      ...(pro.premium && pro.reviewCount > 0 ? {
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": pro.rating,
          "reviewCount": pro.reviewCount,
          "bestRating": 5
        }
      } : {})
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": baseUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": proSpec ? proSpec.name : pro.specialty, "item": baseUrl + "/" + pro.specialty + "/" },
        { "@type": "ListItem", "position": 3, "name": proCity ? proCity.name : pro.city, "item": baseUrl + "/" + pro.specialty + "/" + pro.city + "/" },
        { "@type": "ListItem", "position": 4, "name": pro.firstName + " " + pro.lastName }
      ]
    }
  ];
%>
<% for (const ld of jsonLdArray) { %>
<script type="application/ld+json"><%- JSON.stringify(ld) %></script>
<% } %>

<!-- Section 1: Hero 50/50 — Identity + Map -->
<section class="ann-profile-hero">
  <div class="ann-container">
    <nav class="ann-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <a href="/<%= pro.specialty %>/"><%= proSpec ? proSpec.name : pro.specialty %></a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <a href="/<%= pro.specialty %>/<%= pro.city %>/"><%= proCity ? proCity.name : pro.city %></a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <span><%= pro.firstName %> <%= pro.lastName %></span>
    </nav>

    <div class="ann-profile-hero-split">
      <!-- Left: Identity -->
      <div class="ann-profile-hero-left">
        <div class="ann-profile-header">
          <div class="ann-profile-avatar-lg<%= pro.photoUrl ? ' ann-profile-avatar-photo' : '' %>">
            <% if (pro.photoUrl) { %>
            <img src="<%= pro.photoUrl %>" alt="Photo de <%= pro.firstName %> <%= pro.lastName %>" loading="lazy">
            <% } else { %>
            <%= pro.firstName[0] %><%= pro.lastName[0] %>
            <% } %>
            <% if (pro.premium) { %>
            <div class="ann-profile-verified" title="Professionnel vérifié">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:1rem;height:1rem"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <% } %>
          </div>

          <div class="ann-profile-identity">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
              <h1 class="ann-profile-name"><%= pro.firstName %> <%= pro.lastName %></h1>
              <% if (pro.plan === 'boost') { %>
              <span class="ann-badge ann-badge-mini ann-badge-mini-boost">
                <svg viewBox="0 0 24 24" fill="currentColor" style="width:0.625rem;height:0.625rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                Top Pro
              </span>
              <% } else if (pro.plan === 'pro') { %>
              <span class="ann-badge ann-badge-mini ann-badge-mini-pro">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.625rem;height:0.625rem"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Premium
              </span>
              <% } %>
            </div>

            <% if (pro.premium && pro.reviewCount > 0) { %>
            <div class="ann-pro-rating" style="margin-top: 0.5rem;">
              <div class="ann-stars">
                <% for (let i = 1; i <= 5; i++) { %>
                <svg class="ann-star<%= i > Math.round(pro.rating) ? ' ann-star-empty' : '' %>" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <% } %>
              </div>
              <span class="ann-rating-text"><%= pro.rating %></span>
              <span class="ann-review-count">(<%= pro.reviewCount %> avis)</span>
            </div>
            <% } %>

            <a href="/<%= pro.specialty %>/" class="ann-profile-specialty" style="--spec-color: <%= proSpec ? proSpec.color : 'hsl(var(--ann-primary))' %>">
              <%= proSpec ? proSpec.name : pro.specialty %>
            </a>
          </div>
        </div>

        <div class="ann-profile-quick-details">
          <div class="ann-profile-detail-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= pro.displayCity || (proCity ? proCity.name : pro.city) %><% if (pro.postalCode) { %> (<%= pro.postalCode %>)<% } %></span>
          </div>
          <div class="ann-profile-detail-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            <span><%= pro.priceRange %></span>
          </div>
          <% if (pro.address) { %>
          <div class="ann-profile-detail-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span><%= pro.address %></span>
          </div>
          <% } %>
        </div>

        <!-- Primary CTA -->
        <div class="ann-profile-hero-cta">
          <% if (pro.doctolibUrl && pro.premium) { %>
          <a href="<%= pro.doctolibUrl %>" target="_blank" rel="noopener" class="ann-btn ann-btn-primary ann-btn-lg" style="background: #107ACA; border-color: #107ACA;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Prendre rendez-vous
          </a>
          <% } else { %>
          <a href="mailto:<%= pro.email %>?subject=Demande de rendez-vous" class="ann-btn ann-btn-primary ann-btn-lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Demander un rendez-vous
          </a>
          <% } %>
        </div>
      </div>

      <!-- Right: Map -->
      <div class="ann-profile-hero-right">
        <div class="ann-map-container ann-map-hero" id="ann-map"
          data-professionals='<%- JSON.stringify([{ id: pro.id, name: pro.firstName + " " + pro.lastName, lat: pro.lat, lng: pro.lng, specialty: pro.specialty, city: pro.city, slug: pro.slug, premium: pro.premium, plan: pro.plan }]) %>'
          data-specialties='<%- JSON.stringify(specialties.map(s => ({ id: s.id, name: s.name, color: s.color }))) %>'
          data-center='<%- JSON.stringify({ lat: pro.lat, lng: pro.lng }) %>'
          data-zoom="15">
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- Section 2: Methods & Languages -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-profile-row">
      <!-- Methods -->
      <div class="ann-profile-card">
        <h2 class="ann-profile-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><path d="m12 3-1.912 5.813a2 2 0 01-1.275 1.275L3 12l5.813 1.912a2 2 0 011.275 1.275L12 21l1.912-5.813a2 2 0 011.275-1.275L21 12l-5.813-1.912a2 2 0 01-1.275-1.275L12 3Z"/></svg>
          Approches et méthodes
        </h2>
        <div class="ann-profile-tags">
          <% for (const method of pro.methods) { %>
          <span class="ann-profile-tag"><%= method %></span>
          <% } %>
        </div>
      </div>

      <!-- Languages -->
      <div class="ann-profile-card">
        <h2 class="ann-profile-card-title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>
          Langues parlées
        </h2>
        <div class="ann-profile-tags">
          <% for (const lang of pro.languages) { %>
          <span class="ann-profile-tag"><%= lang %></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- Section 3: Description + Reviews | Contact + Hours -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-profile-layout">
      <!-- Main content: Description + Gallery + Reviews -->
      <div class="ann-profile-main">
        <!-- About -->
        <div class="ann-profile-card">
          <h2 class="ann-profile-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Présentation
          </h2>
          <div class="ann-profile-bio"><%- pro.description %></div>
        </div>

        <!-- Cabinet photos & video gallery -->
        <% const hasMedia = pro.photos && pro.photos.length > 0; %>
        <% const hasVideo = pro.videoUrl && pro.photos && pro.photos.includes('video'); %>
        <% const videoId = hasVideo ? (pro.videoUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/) || [])[1] : null; %>
        <div class="ann-profile-card" id="ann-cabinet-photos" style="<%= hasMedia ? '' : 'display:none;' %>">
          <h2 class="ann-profile-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            Galerie
          </h2>
          <div class="ann-cabinet-gallery<%= pro.plan === 'boost' ? ' ann-gallery-mosaic' : ' ann-gallery-duo' %>" id="ann-cabinet-gallery">
            <% if (hasMedia) { %>
              <% let mediaIdx = 0; %>
              <% for (let i = 0; i < pro.photos.length; i++) { %>
                <% if (pro.photos[i] === 'video' && videoId) { %>
                <div class="ann-gallery-item ann-gallery-video<%= (pro.plan === 'boost' && i === 0) ? ' ann-gallery-hero' : '' %>" data-gallery-idx="<%= mediaIdx %>">
                  <iframe src="https://www.youtube.com/embed/<%= videoId %>" title="Vidéo de présentation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" style="width:100%;height:100%;position:absolute;inset:0;"></iframe>
                </div>
                <% mediaIdx++; %>
                <% } else if (pro.photos[i] !== 'video') { %>
                <div class="ann-gallery-item<%= (pro.plan === 'boost' && i === 0) ? ' ann-gallery-hero' : '' %>" data-gallery-idx="<%= mediaIdx %>">
                  <img src="<%= pro.photos[i] %>" alt="Photo du cabinet de <%= pro.firstName %> <%= pro.lastName %>" loading="lazy">
                </div>
                <% mediaIdx++; %>
                <% } %>
              <% } %>
            <% } %>
          </div>
        </div>

        <!-- Google Reviews (Boost only) -->
        <% const reviews = (typeof googleReviews !== 'undefined') ? googleReviews : []; %>
        <% if (pro.premium && reviews.length > 0) { %>
        <div class="ann-profile-card">
          <h2 class="ann-profile-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Avis Google
            <span class="ann-text-muted" style="font-size: 0.8125rem; font-weight: 400; margin-left: 0.5rem;">
              <%= pro.rating %>/5 (<%= pro.reviewCount %> avis)
            </span>
          </h2>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% for (const review of reviews) { %>
            <div style="padding: 1rem; border-radius: var(--ann-radius); background: hsl(var(--ann-muted) / 0.2); border: 1px solid hsl(var(--ann-border));">
              <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <% if (review.authorPhotoUrl) { %>
                <img src="<%= review.authorPhotoUrl %>" alt="Photo de <%= review.authorName %>" loading="lazy" style="width: 2rem; height: 2rem; border-radius: 50%; object-fit: cover;">
                <% } else { %>
                <div style="width: 2rem; height: 2rem; border-radius: 50%; background: linear-gradient(135deg, hsl(var(--ann-primary) / 0.15), hsl(var(--ann-secondary) / 0.15)); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: hsl(var(--ann-primary));">
                  <%= review.authorName[0] %>
                </div>
                <% } %>
                <div style="flex: 1;">
                  <div style="font-weight: 600; font-size: 0.875rem;"><%= review.authorName %></div>
                  <div style="display: flex; align-items: center; gap: 0.375rem;">
                    <div class="ann-stars" style="font-size: 0;">
                      <% for (let i = 1; i <= 5; i++) { %>
                      <svg class="ann-star<%= i > review.rating ? ' ann-star-empty' : '' %>" viewBox="0 0 24 24" style="width:0.75rem;height:0.75rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <% } %>
                    </div>
                    <% if (review.relativeTime) { %>
                    <span class="ann-text-muted" style="font-size: 0.75rem;"><%= review.relativeTime %></span>
                    <% } %>
                  </div>
                </div>
              </div>
              <% if (review.text) { %>
              <p style="font-size: 0.875rem; line-height: 1.6; margin: 0; color: hsl(var(--ann-fg) / 0.85);"><%= review.text %></p>
              <% } %>
            </div>
            <% } %>
          </div>

          <p class="ann-text-muted" style="font-size: 0.6875rem; margin-top: 0.75rem; text-align: center;">
            Avis provenant de Google Maps
          </p>
        </div>
        <% } %>
      </div>

      <!-- Sidebar: Contact + Hours -->
      <aside class="ann-profile-sidebar" id="contact">
        <!-- Contact card -->
        <div class="ann-profile-card ann-profile-contact-card">
          <h3 class="ann-profile-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            Contacter
          </h3>

          <div class="ann-contact-info">
            <a href="tel:<%= pro.phone.replace(/\s/g, '') %>" class="ann-contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              <span><%= pro.phone %></span>
            </a>
            <a href="mailto:<%= pro.email %>" class="ann-contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span><%= pro.email %></span>
            </a>
            <% if (pro.premium && pro.website) { %>
            <a href="<%= pro.website %>" target="_blank" rel="noopener" class="ann-contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
              <span>Site web</span>
            </a>
            <% } %>
          </div>

          <% if (pro.doctolibUrl && pro.premium) { %>
          <a href="<%= pro.doctolibUrl %>" target="_blank" rel="noopener" class="ann-btn ann-btn-primary ann-btn-full" style="margin-top: 1.25rem; background: #107ACA; border-color: #107ACA;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Prendre rendez-vous sur Doctolib
          </a>
          <% } else { %>
          <a href="mailto:<%= pro.email %>?subject=Demande de rendez-vous" class="ann-btn ann-btn-primary ann-btn-full" style="margin-top: 1.25rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Demander un rendez-vous
          </a>
          <% } %>
        </div>

        <!-- Hours card -->
        <%
          const openingHours = (typeof pro.openingHours !== 'undefined') ? pro.openingHours : null;
          const dayNames = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
          const dayKeys = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        %>
        <% if (openingHours) { %>
        <div class="ann-profile-card" id="ann-hours-card">
          <h3 class="ann-profile-card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Horaires
          </h3>
          <div class="ann-hours-list">
            <% for (let d = 0; d < 7; d++) { %>
            <%
              const day = openingHours[dayKeys[d]];
              const isClosed = !day || day.closed;
              let slots = [];
              if (!isClosed) {
                if (day.morning_start && day.morning_end) slots.push(day.morning_start + ' - ' + day.morning_end);
                if (day.afternoon_start && day.afternoon_end) slots.push(day.afternoon_start + ' - ' + day.afternoon_end);
                if (slots.length === 0 && day.morning_start && day.afternoon_end) slots.push(day.morning_start + ' - ' + day.afternoon_end);
              }
            %>
            <div class="ann-hours-row<%= isClosed ? ' ann-hours-closed' : '' %>">
              <span class="ann-hours-day"><%= dayNames[d] %></span>
              <span class="ann-hours-time"><%= isClosed ? 'Fermé' : slots.join(', ') %></span>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- Quick info card -->
        <div class="ann-profile-card">
          <h3 class="ann-profile-card-title">Informations pratiques</h3>
          <div class="ann-profile-info-list">
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Tarif</span>
              <span class="ann-font-medium"><%= pro.priceRange %></span>
            </div>
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Expérience</span>
              <span class="ann-font-medium"><%= pro.yearsExperience %> ans</span>
            </div>
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Disponibilités</span>
              <span class="ann-font-medium"><%= pro.availability %></span>
            </div>
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Ville</span>
              <a href="/<%= pro.city %>/" class="ann-link-primary"><%= pro.displayCity || (proCity ? proCity.name : pro.city) %><% if (pro.postalCode) { %> (<%= pro.postalCode %>)<% } %></a>
            </div>
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Spécialité</span>
              <a href="/<%= pro.specialty %>/" class="ann-link-primary"><%= proSpec ? proSpec.name : pro.specialty %></a>
            </div>
            <% if (pro.plan === 'boost' && pro.website) { %>
            <div class="ann-profile-info-row">
              <span class="ann-text-muted">Site web</span>
              <a href="<%= pro.website %>" target="_blank" rel="noopener" class="ann-link-primary" style="word-break: break-all;"><%= pro.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') %></a>
            </div>
            <% } %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Live data refresh: fetch fresh profile data from Supabase and update DOM -->
<script>
(function() {
  var SUPABASE_URL = '<%= typeof supabaseUrl !== "undefined" ? supabaseUrl : "https://lojvajnnvhatfplevyvy.supabase.co" %>';
  var SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvanZham5udmhhdGZwbGV2eXZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIyNzk3NDIsImV4cCI6MjA4Nzg1NTc0Mn0.gdd9HRbRvfQr6io9jGN6hUCW6tBOtognhwbsTJtSTng';
  var slug = '<%= pro.slug %>';

  fetch(SUPABASE_URL + '/rest/v1/annuaire_professionals?slug=eq.' + encodeURIComponent(slug) + '&is_published=eq.true&select=*&limit=1', {
    headers: { 'apikey': SUPABASE_KEY, 'Accept': 'application/json' }
  })
  .then(function(r) { return r.json(); })
  .then(function(rows) {
    if (!rows || !rows.length) return;
    var p = rows[0];

    // Update name
    var nameEl = document.querySelector('.ann-profile-name');
    if (nameEl) nameEl.textContent = (p.first_name || '') + ' ' + (p.last_name || '');

    // Update bio
    var bioEl = document.querySelector('.ann-profile-bio');
    if (bioEl && p.description) bioEl.innerHTML = p.description;

    // Update phone
    var phoneLinks = document.querySelectorAll('a[href^="tel:"]');
    if (phoneLinks.length && p.phone) {
      for (var i = 0; i < phoneLinks.length; i++) {
        phoneLinks[i].href = 'tel:' + p.phone.replace(/\s/g, '');
        var span = phoneLinks[i].querySelector('span');
        if (span) span.textContent = p.phone;
      }
    }

    // Update email
    var emailLinks = document.querySelectorAll('a[href^="mailto:"]');
    if (emailLinks.length && p.email) {
      for (var i = 0; i < emailLinks.length; i++) {
        var href = emailLinks[i].getAttribute('href');
        if (href.indexOf('subject=') > -1) {
          emailLinks[i].href = 'mailto:' + p.email + '?subject=Demande de rendez-vous';
        } else {
          emailLinks[i].href = 'mailto:' + p.email;
          var span = emailLinks[i].querySelector('span');
          if (span) span.textContent = p.email;
        }
      }
    }

    // Update address in hero details
    var detailItems = document.querySelectorAll('.ann-profile-detail-item');
    for (var i = 0; i < detailItems.length; i++) {
      var svg = detailItems[i].querySelector('svg');
      var span = detailItems[i].querySelector('span');
      if (!svg || !span) continue;
      var svgHtml = svg.innerHTML;
      // Address item (house icon path)
      if (svgHtml.indexOf('M3 9l9-7') > -1 && p.address) {
        span.textContent = p.address;
      }
      // City item (pin icon)
      if (svgHtml.indexOf('M21 10c0 7') > -1 && (p.display_city || p.city)) {
        var label = p.display_city || p.city;
        if (p.postal_code) label += ' (' + p.postal_code + ')';
        span.textContent = label;
      }
      // Price item (dollar icon)
      if (svgHtml.indexOf('y1="1"') > -1 && p.price_range) {
        span.textContent = p.price_range;
      }
    }

    // Update avatar photo
    if (p.photo_url) {
      var avatarDiv = document.querySelector('.ann-profile-avatar-lg');
      if (avatarDiv) {
        var img = avatarDiv.querySelector('img');
        if (img) {
          img.src = p.photo_url;
          img.alt = 'Photo de ' + (p.first_name || '') + ' ' + (p.last_name || '');
        } else {
          var newImg = document.createElement('img');
          newImg.src = p.photo_url;
          newImg.alt = 'Photo de ' + (p.first_name || '') + ' ' + (p.last_name || '');
          avatarDiv.textContent = '';
          avatarDiv.appendChild(newImg);
          avatarDiv.classList.add('ann-profile-avatar-photo');
        }
      }
    }

    // Update methods/approaches
    if (Array.isArray(p.methods) && p.methods.length) {
      var tagContainers = document.querySelectorAll('.ann-profile-tags');
      if (tagContainers.length > 0) {
        tagContainers[0].innerHTML = p.methods.map(function(m) {
          var d = document.createElement('span');
          d.textContent = m;
          return '<span class="ann-profile-tag">' + d.textContent + '</span>';
        }).join('');
      }
    }

    // Update languages
    if (Array.isArray(p.languages) && p.languages.length) {
      var tagContainers = document.querySelectorAll('.ann-profile-tags');
      if (tagContainers.length > 1) {
        tagContainers[1].innerHTML = p.languages.map(function(l) {
          var d = document.createElement('span');
          d.textContent = l;
          return '<span class="ann-profile-tag">' + d.textContent + '</span>';
        }).join('');
      }
    }

    // Update practical info sidebar
    var infoRows = document.querySelectorAll('.ann-profile-info-row');
    for (var i = 0; i < infoRows.length; i++) {
      var label = infoRows[i].querySelector('.ann-text-muted');
      var value = infoRows[i].querySelector('.ann-font-medium, .ann-link-primary');
      if (!label || !value) continue;
      var key = label.textContent.trim();
      if (key === 'Tarif' && p.price_range) value.textContent = p.price_range;
      if (key === 'Expérience' && p.years_experience != null) value.textContent = p.years_experience + ' ans';
      if (key === 'Disponibilités' && p.availability) value.textContent = p.availability;
      if (key === 'Ville' && (p.display_city || p.city)) {
        var cityLabel = p.display_city || p.city;
        if (p.postal_code) cityLabel += ' (' + p.postal_code + ')';
        value.textContent = cityLabel;
      }
    }

    // Update cabinet photos & video
    var gallerySection = document.getElementById('ann-cabinet-photos');
    var gallery = document.getElementById('ann-cabinet-gallery');
    if (gallerySection && gallery && Array.isArray(p.photos) && p.photos.length > 0) {
      var isBoost = p.plan === 'boost';
      gallery.className = isBoost ? 'ann-cabinet-gallery ann-gallery-mosaic' : 'ann-cabinet-gallery ann-gallery-duo';
      var vidMatch = p.video_url ? p.video_url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/) : null;
      var vidId = vidMatch ? vidMatch[1] : null;
      var mediaIdx = 0;
      gallery.innerHTML = p.photos.map(function(url, i) {
        var heroClass = (isBoost && i === 0) ? ' ann-gallery-hero' : '';
        if (url === 'video' && vidId) {
          var idx = mediaIdx++;
          return '<div class="ann-gallery-item ann-gallery-video' + heroClass + '" data-gallery-idx="' + idx + '">' +
            '<iframe src="https://www.youtube.com/embed/' + vidId + '" title="Vidéo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" style="width:100%;height:100%;position:absolute;inset:0;"></iframe>' +
            '</div>';
        } else if (url !== 'video') {
          var idx = mediaIdx++;
          var safe = url.replace(/[&<>"']/g, function(c) { return '&#' + c.charCodeAt(0) + ';'; });
          return '<div class="ann-gallery-item' + heroClass + '" data-gallery-idx="' + idx + '">' +
            '<img src="' + safe + '" alt="Photo du cabinet" loading="lazy">' +
            '</div>';
        }
        return '';
      }).join('');
      gallerySection.style.display = '';
    } else if (gallerySection && (!p.photos || !p.photos.length)) {
      gallerySection.style.display = 'none';
    }

    // Update premium badge
    var isPremium = p.plan === 'pro' || p.plan === 'boost';
    var verifiedBadge = document.querySelector('.ann-profile-verified');
    if (isPremium && !verifiedBadge) {
      var avatarDiv = document.querySelector('.ann-profile-avatar-lg');
      if (avatarDiv) {
        var badge = document.createElement('div');
        badge.className = 'ann-profile-verified';
        badge.title = 'Professionnel vérifié';
        badge.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" style="width:1rem;height:1rem"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
        avatarDiv.appendChild(badge);
      }
    } else if (!isPremium && verifiedBadge) {
      verifiedBadge.remove();
    }

    // Update plan badge (Top Pro / Premium / remove)
    var existingBadge = document.querySelector('.ann-badge-mini-boost, .ann-badge-mini-pro, .ann-badge-premium');
    if (existingBadge) existingBadge.remove();
    if (p.plan === 'boost' || p.plan === 'pro') {
      var nameRow = document.querySelector('.ann-profile-identity > div');
      if (nameRow) {
        var span = document.createElement('span');
        if (p.plan === 'boost') {
          span.className = 'ann-badge ann-badge-mini ann-badge-mini-boost';
          span.innerHTML = '<svg viewBox="0 0 24 24" fill="currentColor" style="width:0.625rem;height:0.625rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg> Top Pro';
        } else {
          span.className = 'ann-badge ann-badge-mini ann-badge-mini-pro';
          span.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.625rem;height:0.625rem"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> Premium';
        }
        nameRow.appendChild(span);
      }
    }

    // Update website link visibility (premium only)
    var contactInfo = document.querySelector('.ann-contact-info');
    if (contactInfo) {
      var websiteLink = contactInfo.querySelector('a[target="_blank"]:not([href*="doctolib"])');
      if (isPremium && p.website && !websiteLink) {
        var a = document.createElement('a');
        a.href = p.website;
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = 'ann-contact-item';
        a.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg><span>Site web</span>';
        contactInfo.appendChild(a);
      } else if (websiteLink && isPremium && p.website) {
        websiteLink.href = p.website;
      } else if (websiteLink && (!isPremium || !p.website)) {
        websiteLink.remove();
      }
    }

    // Update opening hours card
    var hoursCard = document.getElementById('ann-hours-card');
    if (p.opening_hours && hoursCard) {
      var dayKeys = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
      var dayNames = ['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];
      var hoursList = hoursCard.querySelector('.ann-hours-list');
      if (hoursList) {
        hoursList.innerHTML = dayKeys.map(function(key, idx) {
          var d = p.opening_hours[key];
          var closed = !d || d.closed;
          var slots = [];
          if (!closed) {
            if (d.morning_start && d.morning_end) slots.push(d.morning_start + ' - ' + d.morning_end);
            if (d.afternoon_start && d.afternoon_end) slots.push(d.afternoon_start + ' - ' + d.afternoon_end);
            if (slots.length === 0 && d.morning_start && d.afternoon_end) slots.push(d.morning_start + ' - ' + d.afternoon_end);
          }
          return '<div class="ann-hours-row' + (closed ? ' ann-hours-closed' : '') + '">' +
            '<span class="ann-hours-day">' + dayNames[idx] + '</span>' +
            '<span class="ann-hours-time">' + (closed ? 'Fermé' : slots.join(', ')) + '</span></div>';
        }).join('');
      }
    }
  })
  .catch(function(err) { console.warn('[live-profile] Could not refresh data:', err); });
})();

// Analytics tracking
(function() {
  var TRACK_URL = '<%= typeof supabaseUrl !== "undefined" ? supabaseUrl : "https://lojvajnnvhatfplevyvy.supabase.co" %>' + '/functions/v1/annuaire-track';
  var PRO_ID = '<%= pro.id %>';
  function track(payload) {
    try { navigator.sendBeacon(TRACK_URL, JSON.stringify(payload)); } catch(e) {}
  }
  // Track page view
  track({ type: 'view', professional_id: PRO_ID, referrer: document.referrer, user_agent: navigator.userAgent });
  // Track contact clicks
  document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
    el.addEventListener('click', function() { track({ type: 'click', professional_id: PRO_ID, click_type: 'phone' }); });
  });
  document.querySelectorAll('a[href^="mailto:"]').forEach(function(el) {
    el.addEventListener('click', function() { track({ type: 'click', professional_id: PRO_ID, click_type: 'email' }); });
  });
  document.querySelectorAll('.ann-contact-item[href*="doctolib"], a[href*="doctolib"]').forEach(function(el) {
    el.addEventListener('click', function() { track({ type: 'click', professional_id: PRO_ID, click_type: 'appointment' }); });
  });
  // Website clicks: contact card + informations pratiques
  document.querySelectorAll('.ann-contact-item[target="_blank"]:not([href*="doctolib"]), .ann-profile-info-row a[target="_blank"]').forEach(function(el) {
    var span = el.querySelector('span');
    var isWebsite = (span && span.textContent.trim() === 'Site web') || el.closest('.ann-profile-info-row');
    if (isWebsite) {
      el.addEventListener('click', function() { track({ type: 'click', professional_id: PRO_ID, click_type: 'website' }); });
    }
  });
})();

// ── Photo Lightbox ──
(function() {
  // Build lightbox DOM
  var overlay = document.createElement('div');
  overlay.className = 'ann-lightbox';
  overlay.innerHTML =
    '<button class="ann-lightbox-close" aria-label="Fermer">&times;</button>' +
    '<button class="ann-lightbox-prev" aria-label="Précédent"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>' +
    '<div class="ann-lightbox-img-wrap"><img class="ann-lightbox-img" src="" alt=""><span class="ann-lightbox-counter"></span></div>' +
    '<button class="ann-lightbox-next" aria-label="Suivant"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>';
  document.body.appendChild(overlay);

  var img = overlay.querySelector('.ann-lightbox-img');
  var counter = overlay.querySelector('.ann-lightbox-counter');
  var photos = [];
  var currentIdx = 0;

  function collectPhotos() {
    photos = [];
    var items = document.querySelectorAll('#ann-cabinet-gallery .ann-gallery-item:not(.ann-gallery-video)');
    items.forEach(function(item) {
      var imgEl = item.querySelector('img');
      if (imgEl) photos.push(imgEl.src);
    });
  }

  function showPhoto(idx) {
    if (photos.length === 0) return;
    currentIdx = ((idx % photos.length) + photos.length) % photos.length;
    img.src = photos[currentIdx];
    counter.textContent = (currentIdx + 1) + ' / ' + photos.length;
    overlay.querySelector('.ann-lightbox-prev').style.display = photos.length > 1 ? '' : 'none';
    overlay.querySelector('.ann-lightbox-next').style.display = photos.length > 1 ? '' : 'none';
  }

  function openLightbox(idx) {
    collectPhotos();
    if (photos.length === 0) return;
    showPhoto(idx);
    overlay.classList.add('ann-lightbox-open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    overlay.classList.remove('ann-lightbox-open');
    document.body.style.overflow = '';
  }

  // Click on gallery items (skip video items — they have their own player)
  document.addEventListener('click', function(e) {
    var item = e.target.closest('.ann-gallery-item');
    if (item && !item.classList.contains('ann-gallery-video')) {
      var idx = parseInt(item.getAttribute('data-gallery-idx')) || 0;
      openLightbox(idx);
    }
  });

  overlay.querySelector('.ann-lightbox-close').addEventListener('click', closeLightbox);
  overlay.querySelector('.ann-lightbox-prev').addEventListener('click', function() { showPhoto(currentIdx - 1); });
  overlay.querySelector('.ann-lightbox-next').addEventListener('click', function() { showPhoto(currentIdx + 1); });

  // Close on overlay background click
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeLightbox();
  });

  // Keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (!overlay.classList.contains('ann-lightbox-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPhoto(currentIdx - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIdx + 1);
  });

  // Touch swipe support
  var touchStartX = 0;
  overlay.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
  overlay.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) {
      if (dx > 0) showPhoto(currentIdx - 1);
      else showPhoto(currentIdx + 1);
    }
  }, { passive: true });
})();
</script>

