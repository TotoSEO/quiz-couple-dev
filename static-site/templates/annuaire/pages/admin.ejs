<%
  // Annuaire Admin - Professional moderation dashboard
  // Separate from the main site admin, same HMAC auth system
%>

<style>@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}</style>
<section class="ann-section" style="min-height:100vh;padding:2rem 0;">
  <div class="ann-container" style="max-width:64rem;">
    <div id="ann-admin-app" data-url="<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : 'https://lojvajnnvhatfplevyvy.supabase.co' %>">

      <!-- Login Screen -->
      <div id="ann-admin-login" style="max-width:24rem;margin:5rem auto 0;">
        <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:1rem;padding:2rem;text-align:center;">
          <div style="width:3.5rem;height:3.5rem;margin:0 auto 1.5rem;border-radius:50%;background:hsl(var(--ann-primary)/0.1);display:flex;align-items:center;justify-content:center;">
            <svg style="width:1.75rem;height:1.75rem;color:hsl(var(--ann-primary));" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:0.25rem;">Administration Annuaire</h1>
          <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));margin-bottom:1.5rem;">Moderation des fiches professionnelles</p>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            <div style="position:relative;">
              <input type="password" id="ann-admin-pw" style="width:100%;padding:0.75rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;" placeholder="Mot de passe admin" autocomplete="current-password">
            </div>
            <p id="ann-admin-error" style="display:none;font-size:0.875rem;color:hsl(0 70% 50%);"></p>
            <button id="ann-admin-login-btn" class="ann-btn ann-btn-primary" style="width:100%;padding:0.75rem;font-weight:600;">Se connecter</button>
          </div>
        </div>
      </div>

      <!-- Dashboard -->
      <div id="ann-admin-dashboard" style="display:none;">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid hsl(var(--ann-border));flex-wrap:wrap;gap:1rem;">
          <div>
            <h2 style="font-size:1.5rem;font-weight:700;">Administration Annuaire</h2>
            <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));">Gestion des fiches professionnelles</p>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <button id="aadm-deploy" class="ann-btn ann-btn-primary" style="font-size:0.875rem;padding:0.5rem 1rem;display:flex;align-items:center;gap:0.5rem;">
              <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
              Deployer les fiches
            </button>
            <a href="/" style="font-size:0.875rem;color:hsl(var(--ann-primary));text-decoration:none;">Retour au site</a>
            <button id="ann-admin-logout" style="font-size:0.875rem;color:hsl(0 70% 50%);background:none;border:none;cursor:pointer;">Deconnexion</button>
          </div>
        </div>

        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:1rem;margin-bottom:2rem;">
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(40 90% 92%);color:hsl(40 80% 45%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-pending">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">En attente</p>
            </div>
          </div>
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(160 60% 92%);color:hsl(160 60% 40%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-approved">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">Publies</p>
            </div>
          </div>
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(260 50% 92%);color:hsl(260 50% 50%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-total">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">Total fiches</p>
            </div>
          </div>
        </div>

        <!-- Filters & Search -->
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;">
          <button id="aadm-refresh" class="ann-btn" style="font-size:0.875rem;padding:0.5rem 1rem;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));display:flex;align-items:center;gap:0.5rem;">
            <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
            Actualiser
          </button>
          <div style="display:flex;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);overflow:hidden;">
            <button class="aadm-filter" data-filter="all" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-primary));color:hsl(var(--ann-primary-fg));">Tous</button>
            <button class="aadm-filter" data-filter="pending" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">En attente</button>
            <button class="aadm-filter" data-filter="approved" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">Publies</button>
          </div>
          <div style="position:relative;flex:1;min-width:12rem;max-width:20rem;">
            <svg style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);width:0.875rem;height:0.875rem;color:hsl(var(--ann-muted-fg));pointer-events:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="aadm-search" placeholder="Rechercher par nom..." style="width:100%;padding:0.5rem 0.75rem 0.5rem 2.25rem;font-size:0.875rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">
          </div>
        </div>

        <!-- Profiles List -->
        <div id="aadm-profiles-list">
          <p style="text-align:center;color:hsl(var(--ann-muted-fg));padding:3rem 0;">Chargement...</p>
        </div>
      </div>

    </div>

    <!-- Delete Confirmation Modal -->
    <div id="aadm-delete-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
      <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:1rem;padding:2rem;max-width:28rem;width:calc(100% - 2rem);margin:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);">
        <div style="text-align:center;margin-bottom:1.5rem;">
          <div style="width:3.5rem;height:3.5rem;margin:0 auto 1rem;border-radius:50%;background:hsl(0 70% 95%);display:flex;align-items:center;justify-content:center;">
            <svg style="width:1.75rem;height:1.75rem;color:hsl(0 70% 50%);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </div>
          <h2 style="font-size:1.25rem;font-weight:700;margin-bottom:0.5rem;">Supprimer cette fiche ?</h2>
          <p id="aadm-delete-name" style="font-size:1rem;font-weight:600;color:hsl(var(--ann-primary));margin-bottom:0.5rem;"></p>
          <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));line-height:1.5;">
            Cette action est <strong style="color:hsl(0 70% 50%);">irreversible</strong>. La fiche, les statistiques et les avis associes seront definitivement supprimes.
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <button id="aadm-delete-cancel" class="ann-btn" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));">Annuler</button>
          <button id="aadm-delete-confirm" class="ann-btn" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;background:hsl(0 70% 50%);color:white;border:1px solid hsl(0 70% 50%);">Supprimer</button>
        </div>
      </div>
    </div>

  </div>
</section>
<script src="/js/annuaire-admin.js" defer></script>
