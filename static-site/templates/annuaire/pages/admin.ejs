<%
  // Annuaire Admin - Professional moderation dashboard
  // Separate from the main site admin, same HMAC auth system
%>

<style>@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}</style>
<section class="ann-section" style="min-height:100vh;padding:2rem 0;">
  <div class="ann-container" style="max-width:64rem;">
    <div id="ann-admin-app" data-url="<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : 'https://lojvajnnvhatfplevyvy.supabase.co' %>">

      <!-- Login Screen -->
      <div id="ann-admin-login" style="max-width:24rem;margin:5rem auto 0;">
        <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:1rem;padding:2rem;text-align:center;">
          <div style="width:3.5rem;height:3.5rem;margin:0 auto 1.5rem;border-radius:50%;background:hsl(var(--ann-primary)/0.1);display:flex;align-items:center;justify-content:center;">
            <svg style="width:1.75rem;height:1.75rem;color:hsl(var(--ann-primary));" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:0.25rem;">Administration Annuaire</h1>
          <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));margin-bottom:1.5rem;">Moderation des fiches professionnelles</p>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            <div style="position:relative;">
              <input type="password" id="ann-admin-pw" style="width:100%;padding:0.75rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;" placeholder="Mot de passe admin" autocomplete="current-password">
            </div>
            <p id="ann-admin-error" style="display:none;font-size:0.875rem;color:hsl(0 70% 50%);"></p>
            <button id="ann-admin-login-btn" class="ann-btn ann-btn-primary" style="width:100%;padding:0.75rem;font-weight:600;">Se connecter</button>
          </div>
        </div>
      </div>

      <!-- Dashboard -->
      <div id="ann-admin-dashboard" style="display:none;">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid hsl(var(--ann-border));flex-wrap:wrap;gap:1rem;">
          <div>
            <h2 style="font-size:1.5rem;font-weight:700;">Administration Annuaire</h2>
            <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));">Gestion des fiches professionnelles</p>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <button id="aadm-deploy" class="ann-btn ann-btn-primary" style="font-size:0.875rem;padding:0.5rem 1rem;display:flex;align-items:center;gap:0.5rem;">
              <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
              Deployer les fiches
            </button>
            <a href="/" style="font-size:0.875rem;color:hsl(var(--ann-primary));text-decoration:none;">Retour au site</a>
            <button id="ann-admin-logout" style="font-size:0.875rem;color:hsl(0 70% 50%);background:none;border:none;cursor:pointer;">Deconnexion</button>
          </div>
        </div>

        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:1rem;margin-bottom:2rem;">
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(40 90% 92%);color:hsl(40 80% 45%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-pending">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">En attente</p>
            </div>
          </div>
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(160 60% 92%);color:hsl(160 60% 40%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-approved">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">Publies</p>
            </div>
          </div>
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
            <div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(260 50% 92%);color:hsl(260 50% 50%);display:flex;align-items:center;justify-content:center;">
              <svg style="width:1.25rem;height:1.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <p style="font-size:1.5rem;font-weight:700;" id="aadm-stat-total">-</p>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));">Total fiches</p>
            </div>
          </div>
        </div>

        <!-- Section Tabs -->
        <div style="display:flex;border-bottom:2px solid hsl(var(--ann-border));margin-bottom:1.5rem;gap:0;">
          <button class="aadm-tab" data-tab="profiles" style="padding:0.75rem 1.5rem;font-size:0.875rem;font-weight:600;border:none;cursor:pointer;background:none;color:hsl(var(--ann-primary));border-bottom:2px solid hsl(var(--ann-primary));margin-bottom:-2px;">Fiches</button>
          <button class="aadm-tab" data-tab="invoices" style="padding:0.75rem 1.5rem;font-size:0.875rem;font-weight:600;border:none;cursor:pointer;background:none;color:hsl(var(--ann-muted-fg));border-bottom:2px solid transparent;margin-bottom:-2px;">Factures</button>
          <button class="aadm-tab" data-tab="mail" style="padding:0.75rem 1.5rem;font-size:0.875rem;font-weight:600;border:none;cursor:pointer;background:none;color:hsl(var(--ann-muted-fg));border-bottom:2px solid transparent;margin-bottom:-2px;">Mail</button>
        </div>

        <!-- ═══ PROFILES TAB ═══ -->
        <div id="aadm-tab-profiles">

        <!-- Filters & Search -->
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;">
          <button id="aadm-refresh" class="ann-btn" style="font-size:0.875rem;padding:0.5rem 1rem;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));display:flex;align-items:center;gap:0.5rem;">
            <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
            Actualiser
          </button>
          <div style="display:flex;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);overflow:hidden;">
            <button class="aadm-filter" data-filter="all" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-primary));color:hsl(var(--ann-primary-fg));">Tous</button>
            <button class="aadm-filter" data-filter="pending" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">En attente</button>
            <button class="aadm-filter" data-filter="approved" style="padding:0.375rem 0.75rem;font-size:0.875rem;border:none;cursor:pointer;background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">Publies</button>
          </div>
          <div style="position:relative;flex:1;min-width:12rem;max-width:20rem;">
            <svg style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);width:0.875rem;height:0.875rem;color:hsl(var(--ann-muted-fg));pointer-events:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="aadm-search" placeholder="Rechercher par nom..." style="width:100%;padding:0.5rem 0.75rem 0.5rem 2.25rem;font-size:0.875rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">
          </div>
        </div>

        <!-- Bulk Actions Bar (hidden by default) -->
        <div id="aadm-bulk-bar" style="display:none;background:hsl(var(--ann-primary)/0.08);border:1px solid hsl(var(--ann-primary)/0.3);border-radius:var(--ann-radius);padding:0.625rem 1rem;margin-bottom:1rem;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;font-weight:600;color:hsl(var(--ann-primary));">
            <input type="checkbox" id="aadm-select-all"> Tout selectionner
          </label>
          <span id="aadm-selected-count" style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));">0 selectionne(s)</span>
          <div style="margin-left:auto;display:flex;gap:0.5rem;">
            <button id="aadm-bulk-approve" class="ann-btn ann-btn-primary" style="font-size:0.75rem;padding:0.375rem 0.75rem;" disabled>Approuver</button>
            <button id="aadm-bulk-reject" class="ann-btn" style="font-size:0.75rem;padding:0.375rem 0.75rem;color:hsl(40 70% 40%);border:1px solid hsl(40 70% 40%/0.3);background:transparent;" disabled>Depublier</button>
            <button id="aadm-bulk-delete" class="ann-btn" style="font-size:0.75rem;padding:0.375rem 0.75rem;color:hsl(0 70% 50%);border:1px solid hsl(0 70% 50%/0.3);background:transparent;" disabled>Supprimer</button>
          </div>
        </div>

        <!-- Profiles List -->
        <div id="aadm-profiles-list">
          <p style="text-align:center;color:hsl(var(--ann-muted-fg));padding:3rem 0;">Chargement...</p>
        </div>

        </div><!-- end profiles tab -->

        <!-- ═══ INVOICES TAB ═══ -->
        <div id="aadm-tab-invoices" style="display:none;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;">
            <button id="aadm-invoices-refresh" class="ann-btn" style="font-size:0.875rem;padding:0.5rem 1rem;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));display:flex;align-items:center;gap:0.5rem;">
              <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
              Actualiser
            </button>
            <div style="position:relative;flex:1;min-width:12rem;max-width:20rem;">
              <svg style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);width:0.875rem;height:0.875rem;color:hsl(var(--ann-muted-fg));pointer-events:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
              <input type="text" id="aadm-invoices-search" placeholder="Rechercher par nom ou numero..." style="width:100%;padding:0.5rem 0.75rem 0.5rem 2.25rem;font-size:0.875rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-card));color:hsl(var(--ann-fg));">
            </div>
          </div>
          <div id="aadm-invoices-list">
            <p style="text-align:center;color:hsl(var(--ann-muted-fg));padding:3rem 0;">Selectionnez l'onglet Factures pour charger les donnees.</p>
          </div>
        </div>

        <!-- ═══ MAIL TAB ═══ -->
        <div id="aadm-tab-mail" style="display:none;">

          <!-- Template selector -->
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;margin-bottom:1rem;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
              <svg style="width:1.25rem;height:1.25rem;color:hsl(var(--ann-primary));" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <h2 style="font-size:1.125rem;font-weight:700;">Envoi de mails en masse</h2>
            </div>
            <p style="font-size:0.8125rem;color:hsl(var(--ann-muted-fg));margin-bottom:1.25rem;line-height:1.6;">
              Chaque email est envoye individuellement (pas de CC/BCC). Delai de ~600ms entre chaque envoi pour respecter les limites Resend.
            </p>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
              <div>
                <label style="display:block;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">Template</label>
                <select id="aadm-mail-template" style="width:100%;padding:0.625rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;">
                  <option value="">-- Mail vierge --</option>
                  <option value="prospection">Prospection / Annonce</option>
                  <option value="no-spam">No Spam (texte pur)</option>
                </select>
              </div>
              <div>
                <label style="display:block;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">Nom d'expediteur</label>
                <input type="text" id="aadm-mail-from-name" value="Annuaire Quiz Couple" style="width:100%;padding:0.625rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;">
              </div>
            </div>

            <div style="display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin-bottom:1rem;">
              <div>
                <label style="display:block;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">Objet du mail *</label>
                <input type="text" id="aadm-mail-subject" placeholder="Ex: Invitation a rejoindre un nouvel annuaire specialise" style="width:100%;padding:0.625rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;" maxlength="150">
              </div>
              <div>
                <label style="display:block;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">Reply-To <span style="font-weight:400;color:hsl(var(--ann-muted-fg));">(optionnel)</span></label>
                <input type="email" id="aadm-mail-reply-to" placeholder="contact@quiz-couple.com" style="width:100%;padding:0.625rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.875rem;">
              </div>
            </div>
          </div>

          <!-- Email list + HTML editor side by side -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
            <!-- Email list -->
            <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;">
              <label style="display:flex;align-items:center;justify-content:space-between;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">
                <span>Liste des emails *</span>
                <span id="aadm-mail-count" style="font-weight:400;font-size:0.75rem;color:hsl(var(--ann-muted-fg));">0 email(s)</span>
              </label>
              <textarea id="aadm-mail-emails" placeholder="Collez ici vos emails, un par ligne ou separes par des virgules.&#10;&#10;exemple1@email.com&#10;exemple2@email.com&#10;exemple3@email.com" style="width:100%;min-height:16rem;padding:0.75rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.8125rem;font-family:'Courier New',monospace;line-height:1.6;resize:vertical;"></textarea>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));margin-top:0.375rem;">Un email par ligne, ou separes par des virgules ou points-virgules. Les doublons sont automatiquement retires.</p>
            </div>

            <!-- HTML content -->
            <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;">
              <label style="display:block;font-size:0.875rem;font-weight:600;margin-bottom:0.375rem;">Contenu HTML du mail *</label>
              <textarea id="aadm-mail-html" placeholder="<p>Bonjour,</p>&#10;<p>Votre contenu ici...</p>" style="width:100%;min-height:16rem;padding:0.75rem 1rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);background:hsl(var(--ann-bg));color:hsl(var(--ann-fg));font-size:0.8125rem;font-family:'Courier New',monospace;line-height:1.5;resize:vertical;tab-size:2;"></textarea>
              <p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));margin-top:0.375rem;">Le HTML sera automatiquement enveloppe dans un template responsive 600px. Une version texte brut sera generee automatiquement.</p>
            </div>
          </div>

          <!-- Preview -->
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;margin-bottom:1rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
              <label style="font-size:0.875rem;font-weight:600;">Apercu du mail</label>
              <button type="button" id="aadm-mail-preview-btn" style="font-size:0.75rem;padding:0.375rem 0.75rem;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);color:hsl(var(--ann-fg));cursor:pointer;">Rafraichir l'apercu</button>
            </div>
            <div id="aadm-mail-preview" style="background:hsl(var(--ann-bg));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;min-height:10rem;max-height:32rem;overflow-y:auto;">
              <p style="color:hsl(var(--ann-muted-fg));font-size:0.875rem;text-align:center;padding:2rem 0;">Cliquez sur "Rafraichir l'apercu" pour voir le rendu du mail.</p>
            </div>
          </div>

          <!-- Anti-spam tips -->
          <div style="background:hsl(40 90% 55%/0.06);border:1px solid hsl(40 90% 55%/0.2);border-radius:var(--ann-radius);padding:1rem 1.25rem;margin-bottom:1rem;">
            <p style="font-size:0.8125rem;font-weight:600;color:hsl(40 70% 35%);margin-bottom:0.5rem;">
              <svg style="width:0.875rem;height:0.875rem;vertical-align:middle;margin-right:0.25rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Conseils anti-spam
            </p>
            <ul style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));line-height:1.8;margin:0;padding-left:1.25rem;">
              <li>Privilegiez le texte au HTML complexe — pas de gros blocs d'images</li>
              <li>Evitez les mots "gratuit", "promo", "offre exceptionnelle", majuscules excessives</li>
              <li>Maximum 1-2 liens dans le corps du mail</li>
              <li>Pas de raccourcisseurs d'URL (bit.ly, tinyurl, etc.)</li>
              <li>Objet court et descriptif (pas de RE: ou FW: artificiels)</li>
              <li>Le domaine quiz-couple.com doit avoir SPF, DKIM et DMARC configures</li>
            </ul>
          </div>

          <!-- Send controls -->
          <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);padding:1.5rem;">
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
              <button type="button" id="aadm-mail-send" class="ann-btn ann-btn-primary" style="padding:0.625rem 1.5rem;font-weight:600;display:flex;align-items:center;gap:0.5rem;">
                <svg style="width:1rem;height:1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Envoyer
              </button>
              <span id="aadm-mail-status" style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));"></span>
            </div>
            <!-- Progress bar (hidden by default) -->
            <div id="aadm-mail-progress" style="display:none;margin-top:1rem;">
              <div style="background:hsl(var(--ann-border));border-radius:9999px;height:0.5rem;overflow:hidden;">
                <div id="aadm-mail-progress-bar" style="height:100%;background:hsl(var(--ann-primary));border-radius:9999px;width:0%;transition:width 300ms;"></div>
              </div>
              <p id="aadm-mail-progress-text" style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));margin-top:0.375rem;">0 / 0 envoye(s)</p>
            </div>
            <!-- Results (hidden by default) -->
            <div id="aadm-mail-results" style="display:none;margin-top:1rem;padding:1rem;border-radius:var(--ann-radius);font-size:0.875rem;"></div>
          </div>
        </div>

      </div>

    </div>

    <!-- Delete Confirmation Modal -->
    <div id="aadm-delete-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
      <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:1rem;padding:2rem;max-width:28rem;width:calc(100% - 2rem);margin:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);">
        <div style="text-align:center;margin-bottom:1.5rem;">
          <div style="width:3.5rem;height:3.5rem;margin:0 auto 1rem;border-radius:50%;background:hsl(0 70% 95%);display:flex;align-items:center;justify-content:center;">
            <svg style="width:1.75rem;height:1.75rem;color:hsl(0 70% 50%);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </div>
          <h2 style="font-size:1.25rem;font-weight:700;margin-bottom:0.5rem;">Supprimer cette fiche ?</h2>
          <p id="aadm-delete-name" style="font-size:1rem;font-weight:600;color:hsl(var(--ann-primary));margin-bottom:0.5rem;"></p>
          <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));line-height:1.5;">
            Cette action est <strong style="color:hsl(0 70% 50%);">irreversible</strong>. La fiche, les statistiques et les avis associes seront definitivement supprimes.
          </p>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <button id="aadm-delete-cancel" class="ann-btn" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));">Annuler</button>
          <button id="aadm-delete-confirm" class="ann-btn" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;background:hsl(0 70% 50%);color:white;border:1px solid hsl(0 70% 50%);">Supprimer</button>
        </div>
      </div>
    </div>

    <!-- Plan Change Modal -->
    <div id="aadm-plan-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
      <div style="background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));border-radius:1rem;padding:2rem;max-width:28rem;width:calc(100% - 2rem);margin:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);">
        <div style="text-align:center;margin-bottom:1.5rem;">
          <div style="width:3.5rem;height:3.5rem;margin:0 auto 1rem;border-radius:50%;background:hsl(260 50% 92%);display:flex;align-items:center;justify-content:center;">
            <svg style="width:1.75rem;height:1.75rem;color:hsl(260 50% 50%);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h2 style="font-size:1.25rem;font-weight:700;margin-bottom:0.5rem;">Modifier l'abonnement</h2>
          <p id="aadm-plan-name" style="font-size:1rem;font-weight:600;color:hsl(var(--ann-primary));margin-bottom:0.5rem;"></p>
          <p style="font-size:0.875rem;color:hsl(var(--ann-muted-fg));margin-bottom:1rem;">Plan actuel : <strong id="aadm-plan-current"></strong></p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;text-align:left;">
            <label style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);cursor:pointer;">
              <input type="radio" name="aadm-plan" value="gratuit"> <span><strong>Gratuit</strong> — Fiche basique</span>
            </label>
            <label style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);cursor:pointer;">
              <input type="radio" name="aadm-plan" value="pro"> <span><strong>Pro</strong> — Badge certifie, priorite</span>
            </label>
            <label style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:1px solid hsl(var(--ann-border));border-radius:var(--ann-radius);cursor:pointer;">
              <input type="radio" name="aadm-plan" value="boost"> <span><strong>Boost</strong> — Toutes fonctionnalites</span>
            </label>
          </div>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <button id="aadm-plan-cancel" class="ann-btn" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;background:hsl(var(--ann-card));border:1px solid hsl(var(--ann-border));color:hsl(var(--ann-fg));">Annuler</button>
          <button id="aadm-plan-confirm" class="ann-btn ann-btn-primary" style="flex:1;padding:0.625rem;font-size:0.875rem;font-weight:600;">Confirmer</button>
        </div>
      </div>
    </div>

  </div>
</section>
<script src="/js/annuaire-admin.js" defer></script>
