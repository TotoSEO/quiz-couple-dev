<!-- Pricing toggle JS (inline, tiny) -->
<script>
(function(){
  var monthly = document.getElementById('toggle-monthly');
  var annual = document.getElementById('toggle-annual');
  if (!monthly || !annual) return;

  function setPeriod(period) {
    monthly.classList.toggle('active', period === 'monthly');
    annual.classList.toggle('active', period === 'annual');

    document.querySelectorAll('[data-' + period + ']').forEach(function(el) {
      if (el.classList.contains('ann-price-amount')) {
        el.textContent = el.getAttribute('data-' + period);
      } else if (el.classList.contains('ann-price-annual-note')) {
        el.textContent = el.getAttribute('data-' + period);
      }
    });
  }

  monthly.addEventListener('click', function() { setPeriod('monthly'); });
  annual.addEventListener('click', function() { setPeriod('annual'); });
})();
</script>
