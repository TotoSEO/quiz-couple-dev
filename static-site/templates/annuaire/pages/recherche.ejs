<%
  const jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Rechercher un professionnel du couple",
      "url": canonical,
      "description": metaDescription,
      "isPartOf": { "@id": "https://annuaire.quiz-couple.com/#website" }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": baseUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": "Recherche" }
      ]
    }
  ];

  // Prepare a minimal JSON array of all pros for client-side search
  const prosForSearch = (typeof allProfessionals !== 'undefined' ? allProfessionals : []).map(function(p) {
    return {
      firstName: p.firstName,
      lastName: p.lastName,
      slug: p.slug,
      specialty: p.specialty,
      city: p.city,
      postalCode: p.postalCode || '',
      shortDescription: p.shortDescription || '',
      description: p.description || '',
      plan: p.plan || 'gratuit',
      methods: p.methods || [],
      languages: p.languages || ['Fran\u00e7ais'],
      yearsExperience: p.yearsExperience || 0,
      priceRange: p.priceRange || '',
      rating: p.rating || 0,
      reviewCount: p.reviewCount || 0,
      photoUrl: p.photoUrl || null,
      premium: p.premium || false,
    };
  });
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Search Hero -->
<section class="ann-listing-hero">
  <div class="ann-container">
    <nav class="ann-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <span>Recherche</span>
    </nav>

    <div class="ann-listing-hero-content">
      <h1>Rechercher un professionnel <span class="ann-text-gradient">du couple</span></h1>
      <p class="ann-text-muted ann-text-lg" style="max-width: 40rem;">
        Filtrez par nom, ville, mode de consultation ou langue pour trouver le professionnel qui vous correspond.
      </p>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- Search & Filters -->
<section class="ann-section">
  <div class="ann-container">
    <!-- Search box -->
    <div style="max-width: 40rem; margin: 0 auto 2rem;">
      <div class="ann-search-compact" style="border: 1px solid hsl(var(--ann-border)); border-radius: var(--ann-radius); padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.75rem; background: hsl(var(--ann-card));">
        <svg class="ann-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem;flex-shrink:0;color:hsl(var(--ann-muted-fg))"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="text" id="recherche-input" placeholder="Rechercher par nom, ville..." style="border:none;outline:none;background:transparent;width:100%;font-size:1rem;color:hsl(var(--ann-fg));" autocomplete="off">
      </div>
    </div>

    <!-- Filters row -->
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-bottom: 2rem;">
      <!-- Specialty filter -->
      <select id="filter-specialty" style="padding: 0.5rem 0.75rem; border-radius: var(--ann-radius); border: 1px solid hsl(var(--ann-border)); background: hsl(var(--ann-card)); color: hsl(var(--ann-fg)); font-size: 0.875rem;">
        <option value="">Toutes les sp&eacute;cialit&eacute;s</option>
        <% for (const spec of specialties) { %>
        <option value="<%= spec.id %>"><%= spec.name %></option>
        <% } %>
      </select>

      <!-- City filter (filters by department to catch nearby professionals) -->
      <select id="filter-city" style="padding: 0.5rem 0.75rem; border-radius: var(--ann-radius); border: 1px solid hsl(var(--ann-border)); background: hsl(var(--ann-card)); color: hsl(var(--ann-fg)); font-size: 0.875rem;">
        <option value="">Toutes les villes</option>
        <%
          // Group cities by department, show one entry per department
          const deptSeen = new Set();
          for (const c of cities) {
            if (deptSeen.has(c.department)) continue;
            deptSeen.add(c.department);
            // Find all city names in this department for the label
            const deptCities = cities.filter(x => x.department === c.department);
            const label = deptCities.length > 1
              ? deptCities.map(x => x.name).join(', ') + ' (' + c.department + ')'
              : c.name + ' (' + c.department + ')';
        %>
        <option value="<%= c.department %>"><%= label %></option>
        <% } %>
      </select>

      <!-- Language filter -->
      <select id="filter-language" style="padding: 0.5rem 0.75rem; border-radius: var(--ann-radius); border: 1px solid hsl(var(--ann-border)); background: hsl(var(--ann-card)); color: hsl(var(--ann-fg)); font-size: 0.875rem;">
        <option value="">Toutes les langues</option>
        <option value="Fran&ccedil;ais">Fran&ccedil;ais</option>
        <option value="Anglais">Anglais</option>
        <option value="Espagnol">Espagnol</option>
        <option value="Allemand">Allemand</option>
        <option value="Italien">Italien</option>
        <option value="Arabe">Arabe</option>
      </select>
    </div>

    <!-- Results count -->
    <p id="recherche-count" style="text-align: center; margin-bottom: 1.5rem; color: hsl(var(--ann-muted-fg)); font-size: 0.9375rem;"></p>

    <!-- Results grid (3 columns) -->
    <div id="recherche-results" class="ann-search-grid">
    </div>

    <!-- No results message -->
    <div id="recherche-no-results" class="hidden" style="text-align: center; padding: 3rem 1rem;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:3rem;height:3rem;color:hsl(var(--ann-muted-fg));margin:0 auto 1rem;display:block;"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <p style="font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem;">Aucun professionnel trouv&eacute;</p>
      <p style="color: hsl(var(--ann-muted-fg));">Essayez de modifier vos crit&egrave;res de recherche.</p>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- CTA -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-cta-section">
      <h2 style="margin-bottom: 0.75rem;">Vous &ecirc;tes <span class="ann-text-gradient">professionnel du couple</span> ?</h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0 auto 1.5rem;">Inscrivez votre cabinet gratuitement et gagnez en visibilit&eacute; aupr&egrave;s de patients qualifi&eacute;s dans votre ville.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-lg">
          Inscrire mon cabinet
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- All professionals data for client-side search -->
<script>
window.__ANN_PROS__ = <%- JSON.stringify(prosForSearch) %>;
window.__ANN_SPECS__ = <%- JSON.stringify(specialties.map(function(s){ return { id: s.id, name: s.name }; })) %>;
window.__ANN_CITIES__ = <%- JSON.stringify(cities.map(function(c){ return { id: c.id, name: c.name, department: c.department }; })) %>;

(function() {
  var pros = window.__ANN_PROS__;
  var specs = {};
  window.__ANN_SPECS__.forEach(function(s) { specs[s.id] = s.name; });
  var citiesMap = {};
  var cityDeptMap = {};
  window.__ANN_CITIES__.forEach(function(c) {
    citiesMap[c.id] = c.name;
    cityDeptMap[c.id] = c.department;
  });

  // Extract department from postal code (mirrors server-side logic)
  function getDeptFromPostalCode(pc) {
    if (!pc) return '';
    pc = pc.trim();
    if (/^97[1-6]/.test(pc)) return pc.slice(0, 3);
    if (pc.startsWith('20') && pc.length >= 5) {
      return parseInt(pc.slice(0, 3), 10) <= 201 ? '2A' : '2B';
    }
    return pc.slice(0, 2);
  }

  var inputEl = document.getElementById('recherche-input');
  var specEl = document.getElementById('filter-specialty');
  var cityEl = document.getElementById('filter-city');
  var langEl = document.getElementById('filter-language');
  var resultsEl = document.getElementById('recherche-results');
  var countEl = document.getElementById('recherche-count');
  var noResultsEl = document.getElementById('recherche-no-results');

  // Read initial query params
  var params = new URLSearchParams(window.location.search);
  if (params.get('q')) inputEl.value = params.get('q');
  if (params.get('specialite')) specEl.value = params.get('specialite');
  if (params.get('ville')) {
    // ville param can be a city id or a department code
    var villeParam = params.get('ville');
    // If it's a city id, look up its department
    var matchedDept = cityDeptMap[villeParam] || villeParam;
    cityEl.value = matchedDept;
  }

  function renderStars(rating) {
    var html = '<div class="ann-stars">';
    for (var i = 1; i <= 5; i++) {
      html += '<svg class="ann-star' + (i > Math.round(rating) ? ' ann-star-empty' : '') + '" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
    }
    html += '</div>';
    return html;
  }

  function renderCard(p) {
    var specName = specs[p.specialty] || p.specialty;
    var cityName = citiesMap[p.city] || p.city;
    var proUrl = '/' + p.specialty + '/' + p.city + '/' + p.slug + '/';
    var initials = (p.firstName ? p.firstName[0] : '') + (p.lastName ? p.lastName[0] : '');

    var html = '<a href="' + proUrl + '" class="ann-search-card' + (p.premium ? ' ann-search-card-premium' : '') + ' ann-animate-fade-in-up" style="text-decoration:none;color:inherit;display:block;">';

    // Badge
    if (p.plan === 'boost') {
      html += '<div class="ann-badge ann-badge-mini ann-badge-mini-boost" style="font-size:0.625rem;margin-bottom:0.375rem;">';
      html += '<svg viewBox="0 0 24 24" fill="currentColor" style="width:0.5rem;height:0.5rem"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
      html += ' Top Pro</div>';
    } else if (p.plan === 'pro') {
      html += '<div class="ann-badge ann-badge-mini ann-badge-mini-pro" style="font-size:0.625rem;margin-bottom:0.375rem;">';
      html += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.5rem;height:0.5rem"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
      html += ' Certifi\u00e9</div>';
    }

    // Photo + name
    html += '<div style="display:flex;align-items:center;gap:0.625rem;margin-bottom:0.5rem;">';
    if (p.photoUrl) {
      html += '<img src="' + p.photoUrl + '" alt="" loading="lazy" style="width:2.5rem;height:2.5rem;border-radius:50%;object-fit:cover;flex-shrink:0;">';
    } else {
      html += '<div style="width:2.5rem;height:2.5rem;border-radius:50%;background:hsl(var(--ann-primary)/0.1);color:hsl(var(--ann-primary));display:flex;align-items:center;justify-content:center;font-weight:600;font-size:0.75rem;flex-shrink:0;">' + initials + '</div>';
    }
    html += '<div style="min-width:0;">';
    html += '<div style="font-weight:600;font-size:0.875rem;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + p.firstName + ' ' + p.lastName + '</div>';
    html += '<div style="font-size:0.75rem;color:hsl(var(--ann-primary));font-weight:500;">' + specName + '</div>';
    html += '</div></div>';

    // Short description
    var desc = p.shortDescription || '';
    if (desc) {
      html += '<p style="font-size:0.75rem;color:hsl(var(--ann-muted-fg));line-height:1.5;margin:0 0 0.5rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">' + desc + '</p>';
    }

    // Meta: location, experience, price
    html += '<div style="display:flex;flex-wrap:wrap;gap:0.25rem 0.75rem;font-size:0.6875rem;color:hsl(var(--ann-muted-fg));">';
    html += '<span style="display:flex;align-items:center;gap:0.25rem;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.625rem;height:0.625rem;flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>' + cityName + '</span>';
    html += '<span style="display:flex;align-items:center;gap:0.25rem;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.625rem;height:0.625rem;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + p.yearsExperience + ' ans</span>';
    if (p.priceRange) {
      html += '<span style="display:flex;align-items:center;gap:0.25rem;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.625rem;height:0.625rem;flex-shrink:0;"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>' + p.priceRange + '</span>';
    }
    html += '</div>';

    html += '</a>';
    return html;
  }

  function doSearch() {
    var q = (inputEl.value || '').toLowerCase().trim();
    var specFilter = specEl.value;
    var cityFilter = cityEl.value;
    var langFilter = langEl.value;

    var filtered = pros.filter(function(p) {
      // Text search (name, city, specialty, postal code)
      if (q) {
        var fullName = (p.firstName + ' ' + p.lastName).toLowerCase();
        var cityName = (citiesMap[p.city] || '').toLowerCase();
        var specName = (specs[p.specialty] || '').toLowerCase();
        var pc = (p.postalCode || '').toLowerCase();
        if (fullName.indexOf(q) === -1 && cityName.indexOf(q) === -1 && specName.indexOf(q) === -1 && pc.indexOf(q) === -1) {
          return false;
        }
      }
      // Specialty filter
      if (specFilter && p.specialty !== specFilter) return false;
      // City filter: match by department (first 2/3 digits of postal code)
      if (cityFilter) {
        var proDept = p.postalCode ? getDeptFromPostalCode(p.postalCode) : (cityDeptMap[p.city] || '');
        if (proDept !== cityFilter) return false;
      }
      // Language filter
      if (langFilter && (!p.languages || p.languages.indexOf(langFilter) === -1)) return false;
      return true;
    });

    // Sort: premium first, then by rating desc
    filtered.sort(function(a, b) {
      if (a.premium !== b.premium) return b.premium ? 1 : -1;
      return b.rating - a.rating;
    });

    // Render
    if (filtered.length === 0) {
      resultsEl.innerHTML = '';
      countEl.textContent = '';
      noResultsEl.classList.remove('hidden');
    } else {
      noResultsEl.classList.add('hidden');
      countEl.textContent = filtered.length + ' professionnel' + (filtered.length > 1 ? 's' : '') + ' trouv\u00e9' + (filtered.length > 1 ? 's' : '');
      resultsEl.innerHTML = filtered.map(renderCard).join('');
    }
  }

  // Bind events
  inputEl.addEventListener('input', doSearch);
  specEl.addEventListener('change', doSearch);
  cityEl.addEventListener('change', doSearch);
  langEl.addEventListener('change', doSearch);

  // Initial search
  doSearch();
})();
</script>
