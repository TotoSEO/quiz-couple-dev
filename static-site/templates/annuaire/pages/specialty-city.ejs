<%
  // Variables: specialty, city, filteredProfessionals, specialties, cities, professionals
  const otherCities = cities.filter(c => c.id !== city.id);

  // JSON-LD
  const jsonLdArray = [
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": specialty.name + " à " + city.name,
      "description": metaDescription,
      "url": canonical,
      "about": {
        "@type": "City",
        "name": city.name,
        "containedInPlace": { "@type": "AdministrativeArea", "name": city.region }
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": specialty.name + " à " + city.name,
        "numberOfItems": filteredProfessionals.length,
        "itemListElement": filteredProfessionals.map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": p.firstName + " " + p.lastName,
          "url": baseUrl + "/" + p.specialty + "/" + p.city + "/" + p.slug + "/"
        }))
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": baseUrl + "/" },
        { "@type": "ListItem", "position": 2, "name": specialty.name, "item": baseUrl + "/" + specialty.id + "/" },
        { "@type": "ListItem", "position": 3, "name": city.name }
      ]
    }
  ];
%>
<% for (const ld of jsonLdArray) { %>
<script type="application/ld+json"><%- JSON.stringify(ld) %></script>
<% } %>

<!-- Hero -->
<section class="ann-listing-hero">
  <div class="ann-container">
    <nav class="ann-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <a href="/<%= specialty.id %>/"><%= specialty.name %></a>
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.5l3.5 3.5-3.5 3.5"/></svg>
      <span><%= city.name %></span>
    </nav>

    <div class="ann-listing-hero-content">
      <div class="ann-listing-hero-icon" style="background: <%= specialty.color %>">
        <%- include('../partials/specialty-icon', { icon: specialty.icon }) %>
      </div>

      <h1>
        <span class="ann-text-gradient"><%= specialty.name %></span> à <%= city.name %>
      </h1>
      <p class="ann-text-muted ann-text-lg" style="max-width: 40rem;">
        Trouvez un <%= specialty.name.toLowerCase() %> à <%= city.name %> (<%= city.department %>), en <%= city.region %>. Consultez les profils et prenez rendez-vous.
      </p>

      <div class="ann-listing-stats">
        <div class="ann-listing-stat">
          <strong><%= filteredProfessionals.length %></strong>
          <span>professionnel<%= filteredProfessionals.length > 1 ? 's' : '' %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- Professionals listing -->
<section class="ann-section">
  <div class="ann-container">
    <% if (filteredProfessionals.length > 0) { %>
    <div class="ann-listing-grid ann-stagger">
      <% for (const pro of filteredProfessionals) { %>
        <%- include('../partials/pro-card', { pro, specialties, cities }) %>
      <% } %>
    </div>
    <% } else { %>
    <div class="ann-empty-state">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:3rem;height:3rem;color:hsl(var(--ann-muted-fg))"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <h2>Aucun <%= specialty.name.toLowerCase() %> à <%= city.name %> pour le moment</h2>
      <p class="ann-text-muted">Soyez le premier <%= specialty.name.toLowerCase() %> référencé à <%= city.name %> !</p>
      <a href="/rejoindre/" class="ann-btn ann-btn-primary" style="margin-top: 1rem;">
        Inscrire mon cabinet à <%= city.name %>
      </a>
    </div>
    <% } %>
  </div>
</section>

<% if (filteredProfessionals.length > 0) { %>
<div class="ann-divider"></div>

<!-- Map -->
<section class="ann-section" style="background: hsl(var(--ann-muted) / 0.25);">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2><%= specialty.name %>s à <span class="ann-text-gradient"><%= city.name %></span> sur la carte</h2>
    </div>

    <div class="ann-map-container" id="ann-map"
      data-professionals='<%- JSON.stringify(filteredProfessionals.map(p => ({ id: p.id, name: p.firstName + " " + p.lastName, lat: p.lat, lng: p.lng, specialty: p.specialty, city: p.city, slug: p.slug, premium: p.premium }))) %>'
      data-specialties='<%- JSON.stringify(specialties.map(s => ({ id: s.id, name: s.name, color: s.color }))) %>'
      data-center='<%- JSON.stringify({ lat: city.lat, lng: city.lng }) %>'
      data-zoom="12">
    </div>
  </div>
</section>
<% } %>

<% if (typeof seoContent !== 'undefined' && seoContent && seoContent.sections && seoContent.sections.length) { %>
<div class="ann-divider"></div>

<!-- SEO Content -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-seo-content">
      <% for (const section of seoContent.sections) { %>
      <div class="ann-seo-block">
        <h2><%= section.title %></h2>
        <%- section.content %>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<div class="ann-divider"></div>

<!-- Other cities for this specialty -->
<section class="ann-section">
  <div class="ann-container">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2>Trouver un <%= specialty.name.toLowerCase() %> <span class="ann-text-gradient">ailleurs</span></h2>
      <p class="ann-text-muted">Consultez aussi les <%= specialty.name.toLowerCase() %>s dans d'autres villes.</p>
    </div>

    <div class="ann-cities-grid ann-stagger">
      <% for (const c of otherCities) { %>
      <a href="/<%= specialty.id %>/<%= c.id %>/" class="ann-city-card ann-animate-fade-in-up">
        <svg class="ann-city-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="ann-city-name"><%= c.name %></span>
        <span class="ann-city-count"><%= professionals.filter(p => p.specialty === specialty.id && p.city === c.id).length %></span>
      </a>
      <% } %>
    </div>
  </div>
</section>

<div class="ann-divider"></div>

<!-- CTA -->
<section class="ann-section">
  <div class="ann-container">
    <div class="ann-cta-section">
      <h2 style="margin-bottom: 0.75rem;"><%= specialty.name %> à <span class="ann-text-gradient"><%= city.name %></span> ?</h2>
      <p class="ann-text-muted" style="max-width: 32rem; margin: 0 auto 1.5rem;">Rejoignez gratuitement l'annuaire et soyez visible auprès des couples qui cherchent un <%= specialty.name.toLowerCase() %> à <%= city.name %>.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/rejoindre/" class="ann-btn ann-btn-primary ann-btn-lg">
          Inscrire mon cabinet
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/tarifs/" class="ann-btn ann-btn-outline ann-btn-lg">Voir les tarifs</a>
      </div>
    </div>
  </div>
</section>
