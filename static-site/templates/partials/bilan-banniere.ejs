<%
  // La bannière de l'évaluation de couple payante (19 octobre 2026, Thomas :
  // « on ne va pas compter sur le SEO pour vendre »), une fois ouverte
  // (BILAN_OUVERT, config.js), sur les pages qui y renvoient (BILAN_ENTREES,
  // et chaque article de blog hors emprise, manipulation et infidélité) : aux
  // couleurs de l'encart sous le verdict (.qr-bilan, styles.css), un bouton
  // dont le lien porte data-bilan-src="bas-<id>" pour l'onglet Évaluation de
  // l'admin (jamais ?src= dans l'adresse). Le second bouton, seul(e), est
  // parti le 27 octobre 2026 : le seul(e) ne reste que sur la page de vente. Incluse par
  // related-tests.ejs (au-dessus des cartes « À faire ensuite »), par la page
  // des questions de couple et par les articles ; ne rend rien quand
  // l'évaluation est fermée ou que la page n'y renvoie pas.
  const _bilan = (typeof bilanEntree !== 'undefined' && bilanEntree && typeof bilanChemin !== 'undefined' && bilanChemin) ? bilanEntree : null;
  const _BILAN_BAS = {
    fr: { sur: 'Évaluation de couple', titre: 'L\'évaluation complète de votre couple',
          texte: '100 questions précises sur l\'argent, les enfants, où vivre, la fidélité... Chacun répond sur son téléphone, à son rythme et sans voir les réponses de l\'autre, et vous recevez un rapport complet qui compare les réponses, sujet par sujet.',
          points: ['100 questions à deux, chacun sur son téléphone', 'Construit à partir de la recherche en psychologie du couple', 'Un rapport complet en PDF, avec des graphiques'],
          bouton: 'Découvrir l\'évaluation', prix: 'Questions gratuites · rapport {{prix}} pour vous deux' },
    en: { sur: 'Relationship assessment', titre: 'The complete assessment of your relationship',
          texte: '100 specific questions on money, children, where to live, fidelity... You each answer on your own phone, at your own pace and without seeing the other\'s answers, and you get a full report that compares the answers, topic by topic.',
          points: ['100 questions together, each on your own phone', 'Built on research in couple psychology', 'A full PDF report, with charts'],
          bouton: 'Discover the assessment', prix: 'Free questions · report {{prix}} for both of you' },
    es: { sur: 'Evaluación de pareja', titre: 'La evaluación completa de vuestra pareja',
          texte: '100 preguntas concretas sobre el dinero, los hijos, dónde vivir, la fidelidad... Cada uno responde en su teléfono, a su ritmo y sin ver las respuestas del otro, y recibís un informe completo que compara las respuestas, tema por tema.',
          points: ['100 preguntas en pareja, cada uno en su teléfono', 'Construido a partir de la investigación en psicología de pareja', 'Un informe completo en PDF, con gráficos'],
          bouton: 'Descubrir la evaluación', prix: 'Preguntas gratis · informe {{prix}} para los dos' },
    de: { sur: 'Beziehungsanalyse', titre: 'Die vollständige Analyse eurer Beziehung',
          texte: '100 genaue Fragen zu Geld, Kindern, Wohnort, Treue... Jeder antwortet auf dem eigenen Handy, im eigenen Tempo und ohne die Antworten des anderen zu sehen, und ihr bekommt einen vollständigen Bericht, der die Antworten vergleicht, Thema für Thema.',
          points: ['100 Fragen zu zweit, jeder auf dem eigenen Handy', 'Aufgebaut auf der Forschung zur Paarpsychologie', 'Ein vollständiger PDF-Bericht mit Grafiken'],
          bouton: 'Die Analyse entdecken', prix: 'Fragen kostenlos · Bericht {{prix}} für euch beide' },
    it: { sur: 'Valutazione di coppia', titre: 'La valutazione completa della vostra coppia',
          texte: '100 domande precise sui soldi, i figli, dove vivere, la fedeltà... Ciascuno risponde sul proprio telefono, al proprio ritmo e senza vedere le risposte dell\'altro, e ricevete un report completo che confronta le risposte, tema per tema.',
          points: ['100 domande in due, ciascuno sul proprio telefono', 'Costruito a partire dalla ricerca in psicologia di coppia', 'Un report completo in PDF, con grafici'],
          bouton: 'Scopri la valutazione', prix: 'Domande gratuite · report {{prix}} per tutti e due' },
    nl: { sur: 'Relatiecheck', titre: 'De volledige check van jullie relatie',
          texte: '100 concrete vragen over geld, kinderen, waar jullie willen wonen, trouw... Jullie antwoorden ieder op de eigen telefoon, in het eigen tempo en zonder de antwoorden van de ander te zien, en krijgen een volledig rapport dat jullie antwoorden vergelijkt, onderwerp per onderwerp.',
          points: ['100 vragen samen, ieder op de eigen telefoon', 'Gebaseerd op onderzoek naar relaties', 'Een volledig rapport als pdf, met grafieken'],
          bouton: 'Ontdek de relatiecheck', prix: 'Vragen gratis · rapport {{prix}} voor jullie samen' },
  };
  // « Le point sur ma relation » (4 novembre 2026) : sur les tests où l'on se
  // pose seul(e) une question sur sa relation (formule: 'point' dans
  // BILAN_ENTREES) et les articles de ARTICLES_POINT (generate.js), la
  // bannière propose le point, 4,90 € sans réduction, avec #point (bilan.js
  // ouvre tout de suite son départ) et un lien discret vers l'évaluation à
  // deux. Les textes sont ceux de l'encart sous le verdict (encartPoint,
  // quiz-engine-core.js).
  const _POINT_BAS = {
    fr: { sur: 'Le point sur ma relation', titre: 'Faites le point sur votre relation, de votre côté',
          texte: 'Votre partenaire n\'a pas besoin d\'être au courant. 50 questions sur ce que vous vivez, et un rapport rien que pour vous\u00a0: où vous en êtes, ce qui pèse, ce qui vous fait rester, et comment en parler.',
          points: ['Seul(e), sans prévenir votre partenaire', '50 questions, une douzaine de minutes', 'Votre rapport tout de suite, en ligne et en PDF'],
          bouton: 'Faire le point sur ma relation', prix: 'Questions gratuites · rapport {{prix}}',
          duoAvant: 'Plutôt à deux, chacun sur son téléphone\u00a0?', duoLien: 'Voir l\'évaluation de couple' },
    en: { sur: 'My Relationship Check-Up', titre: 'Take stock of your relationship, on your own',
          texte: 'Your partner doesn\'t need to know. 50 questions about what you\'re living, and a report just for you: where you stand, what weighs on you, what makes you stay, and how to talk about it.',
          points: ['On your own, without telling your partner', '50 questions, about twelve minutes', 'Your report right away, online and as a PDF'],
          bouton: 'Start my check-up', prix: 'Free questions · report {{prix}}',
          duoAvant: 'Rather do it together, each on your own phone?', duoLien: 'See the relationship assessment' },
    es: { sur: 'Mi relación, en claro', titre: 'Haz balance de tu relación, por tu lado',
          texte: 'Tu pareja no tiene por qué enterarse. 50 preguntas sobre lo que vives, y un informe solo para ti: dónde estás, lo que te pesa, lo que te hace quedarte y cómo hablarlo.',
          points: ['A solas, sin avisar a tu pareja', '50 preguntas, unos doce minutos', 'Tu informe al momento, en línea y en PDF'],
          bouton: 'Hacer el balance de mi relación', prix: 'Preguntas gratis · informe {{prix}}',
          duoAvant: '¿Mejor en pareja, cada uno en su teléfono?', duoLien: 'Ver la evaluación de pareja' },
    de: { sur: 'Wo steht meine Beziehung?', titre: 'Schau ganz für dich, wie es um deine Beziehung steht',
          texte: 'Dein Partner oder deine Partnerin muss nichts davon wissen. 50 Fragen dazu, was du erlebst, und ein Bericht nur für dich: wo du stehst, was dich belastet, was dich bleiben lässt und wie du darüber reden kannst.',
          points: ['Allein, ohne deinem Partner oder deiner Partnerin Bescheid zu geben', '50 Fragen, etwa zwölf Minuten', 'Dein Bericht sofort, online und als PDF'],
          bouton: 'Den Check allein machen', prix: 'Fragen kostenlos · Bericht {{prix}}',
          duoAvant: 'Lieber zu zweit, jeder auf dem eigenen Handy?', duoLien: 'Zur Beziehungsanalyse' },
    it: { sur: 'Il punto sulla mia relazione', titre: 'Fai il punto sulla tua relazione, per conto tuo',
          texte: 'Il tuo partner non ha bisogno di saperlo. 50 domande su quello che vivi, e un report solo per te: a che punto sei, cosa ti pesa, cosa ti fa restare e come parlarne.',
          points: ['Da solo/a, senza avvisare il tuo partner', '50 domande, una dozzina di minuti', 'Il tuo report subito, online e in PDF'],
          bouton: 'Fare il punto sulla mia relazione', prix: 'Domande gratuite · report {{prix}}',
          duoAvant: 'Meglio in due, ciascuno sul proprio telefono?', duoLien: 'Vedi la valutazione di coppia' },
    nl: { sur: 'Waar staat mijn relatie?', titre: 'Breng je relatie voor jezelf in kaart',
          texte: 'Je partner hoeft er niets van te weten. 50 vragen over wat je beleeft, en een rapport alleen voor jou: waar je staat, wat zwaar weegt, waarom je blijft en hoe je erover kunt praten.',
          points: ['Alleen, zonder je partner op de hoogte te brengen', '50 vragen, een minuut of twaalf', 'Je rapport meteen, online en als pdf'],
          bouton: 'De check alleen doen', prix: 'Vragen gratis · rapport {{prix}}',
          duoAvant: 'Liever samen, ieder op de eigen telefoon?', duoLien: 'Bekijk de relatiecheck' },
  };
  const _point = !!(_bilan && _bilan.formule === 'point');
  const _bp = _POINT_BAS[lang] || _POINT_BAS.fr;
  const _bb = _BILAN_BAS[lang] || _BILAN_BAS.fr;
  // La réduction en cours (bilanPromo, generate.js) : pastille et prix barré.
  const _bbPromo = (typeof bilanPromo !== 'undefined' && bilanPromo) ? bilanPromo : null;
  const _bbPrix = escapeHtml(_bb.prix.replace('{{prix}}', bilanPrix));
  // La moitié « livre » (14 novembre 2026, livre-encart.ejs) : à côté de
  // l'évaluation à deux, dans les langues où le livre est en vente
  // (livreEncartPour, generate.js), jamais à côté du point.
  const _livre = (_bilan && !_point && typeof livreEncartPour === 'function') ? livreEncartPour(lang, _bilan) : null;
  const _livreSrc = _bilan && _bilan.id === 'article' ? 'encart-article' : _bilan && _bilan.groupe === 'questions' ? 'encart-questions' : 'encart-bas';
%>
<%# Un <aside> et non une <section> (14 novembre 2026) : sur la page des
    questions, la bannière est dans <article class="seo-content">, dont les
    règles .seo-content section (bandes de fond, fond transparent, marges
    intérieures à zéro) en faisaient un texte blanc sur fond pêche. %>
<% if (_bilan && _point) { %>
<aside class="qr-bilan qr-bilan--bas qr-bilan--point" aria-label="<%= _bp.sur %>">
  <div class="qr-bilan-visuel" aria-hidden="true"><img src="/bilan/apercu-point-<%= _POINT_BAS[lang] ? lang : 'fr' %>.webp" alt="" width="240" height="340" loading="lazy" decoding="async" draggable="false"></div>
  <div class="qr-bilan-corps">
    <p class="qr-bilan-sur"><%= _bp.sur %></p>
    <h3 class="qr-bilan-titre"><%= _bp.titre %></h3>
    <p class="qr-bilan-texte"><%= _bp.texte %></p>
    <ul class="qr-bilan-points">
      <% for (const p of _bp.points) { %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><%= p %></span></li><% } %>
    </ul>
    <div class="qr-bilan-boutons">
      <a class="qr-bilan-bouton" href="<%= bilanChemin %>#point" data-bilan-src="bas-<%= _bilan.id %>" data-bilan-mode="solo"><%= _bp.bouton %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <p class="qr-bilan-prix"><%= _bp.prix.replace('{{prix}}', bilanPrixPoint) %></p>
    <p class="qr-bilan-autre"><%= _bp.duoAvant %> <a href="<%= bilanChemin %>" data-bilan-src="bas-<%= _bilan.id %>"><%= _bp.duoLien %></a></p>
  </div>
</aside>
<% } else if (_bilan) { %>
<% if (_livre) { %><div class="qr-duo qr-duo--bas"><div class="qr-duo-corps"><% } %>
<aside class="qr-bilan qr-bilan--bas" aria-label="<%= _bb.sur %>">
  <div class="qr-bilan-visuel" aria-hidden="true"><img src="/bilan/apercu-synthese-<%= _BILAN_BAS[lang] ? lang : 'fr' %>.webp" alt="" width="240" height="340" loading="lazy" decoding="async" draggable="false"></div>
  <div class="qr-bilan-corps">
    <p class="qr-bilan-sur"><%= _bb.sur %><% if (_bbPromo) { %> <span class="promo-pastille"><%= _bbPromo.badge %></span><% } %></p>
    <h3 class="qr-bilan-titre"><%= _bb.titre %></h3>
    <p class="qr-bilan-texte"><%= _bb.texte %></p>
    <ul class="qr-bilan-points">
      <% for (const p of _bb.points) { %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><%= p %></span></li><% } %>
    </ul>
    <div class="qr-bilan-boutons">
      <a class="qr-bilan-bouton" href="<%= bilanChemin %>" data-bilan-src="bas-<%= _bilan.id %>"><%= _bb.bouton %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <p class="qr-bilan-prix"><%- _bbPromo ? _bbPromo.marque(_bbPrix) : _bbPrix %></p>
  </div>
</aside>
<% if (_livre) { %><%- include('livre-encart', { livreEncart: _livre, livreSource: _livreSrc, livreNiveau: 'h3' }) %></div></div><% } %>
<% } %>
