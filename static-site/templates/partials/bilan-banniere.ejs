<%
  // La bannière de l'évaluation de couple payante (19 octobre 2026, Thomas :
  // « on ne va pas compter sur le SEO pour vendre »), une fois ouverte
  // (BILAN_OUVERT, config.js), sur les pages qui y renvoient (BILAN_ENTREES,
  // et chaque article de blog hors emprise, manipulation et infidélité) : aux
  // couleurs de l'encart sous le verdict (.qr-bilan, styles.css), un bouton
  // dont le lien porte data-bilan-src="bas-<id>" pour l'onglet Évaluation de
  // l'admin (jamais ?src= dans l'adresse). Le second bouton, seul(e), est
  // parti le 27 octobre 2026 : le seul(e) ne reste que sur la page de vente. Incluse par
  // related-tests.ejs (au-dessus des cartes « À faire ensuite »), par la page
  // des questions de couple et par les articles ; ne rend rien quand
  // l'évaluation est fermée ou que la page n'y renvoie pas.
  const _bilan = (typeof bilanEntree !== 'undefined' && bilanEntree && typeof bilanChemin !== 'undefined' && bilanChemin) ? bilanEntree : null;
  const _BILAN_BAS = {
    fr: { sur: 'Évaluation de couple', titre: 'L\'évaluation complète de votre couple',
          texte: '100 questions précises sur l\'argent, les enfants, où vivre, la fidélité... Vous répondez en même temps, chacun sur son téléphone et sans voir les réponses de l\'autre, et vous recevez un rapport complet qui compare les réponses, sujet par sujet.',
          points: ['100 questions à deux, chacun sur son téléphone', 'Construit à partir de la recherche en psychologie du couple', 'Un rapport complet en PDF, avec des graphiques'],
          bouton: 'Découvrir l\'évaluation', prix: 'Questions gratuites · rapport {{prix}} pour vous deux' },
    en: { sur: 'Relationship assessment', titre: 'The complete assessment of your relationship',
          texte: '100 specific questions on money, children, where to live, fidelity... You answer at the same time, each on your own phone and without seeing the other\'s answers, and you get a full report that compares the answers, topic by topic.',
          points: ['100 questions together, each on your own phone', 'Built on research in couple psychology', 'A full PDF report, with charts'],
          bouton: 'Discover the assessment', prix: 'Free questions · report {{prix}} for both of you' },
    es: { sur: 'Evaluación de pareja', titre: 'La evaluación completa de vuestra pareja',
          texte: '100 preguntas concretas sobre el dinero, los hijos, dónde vivir, la fidelidad... Respondéis a la vez, cada uno en su teléfono y sin ver las respuestas del otro, y recibís un informe completo que compara las respuestas, tema por tema.',
          points: ['100 preguntas en pareja, cada uno en su teléfono', 'Construido a partir de la investigación en psicología de pareja', 'Un informe completo en PDF, con gráficos'],
          bouton: 'Descubrir la evaluación', prix: 'Preguntas gratis · informe {{prix}} para los dos' },
    de: { sur: 'Beziehungsanalyse', titre: 'Die vollständige Analyse eurer Beziehung',
          texte: '100 genaue Fragen zu Geld, Kindern, Wohnort, Treue... Ihr antwortet gleichzeitig, jeder auf dem eigenen Handy und ohne die Antworten des anderen zu sehen, und bekommt einen vollständigen Bericht, der die Antworten vergleicht, Thema für Thema.',
          points: ['100 Fragen zu zweit, jeder auf dem eigenen Handy', 'Aufgebaut auf der Forschung zur Paarpsychologie', 'Ein vollständiger PDF-Bericht mit Grafiken'],
          bouton: 'Die Analyse entdecken', prix: 'Fragen kostenlos · Bericht {{prix}} für euch beide' },
    it: { sur: 'Valutazione di coppia', titre: 'La valutazione completa della vostra coppia',
          texte: '100 domande precise sui soldi, i figli, dove vivere, la fedeltà... Rispondete nello stesso momento, ciascuno sul proprio telefono e senza vedere le risposte dell\'altro, e ricevete un report completo che confronta le risposte, tema per tema.',
          points: ['100 domande in due, ciascuno sul proprio telefono', 'Costruito a partire dalla ricerca in psicologia di coppia', 'Un report completo in PDF, con grafici'],
          bouton: 'Scopri la valutazione', prix: 'Domande gratuite · report {{prix}} per tutti e due' },
  };
  const _bb = _BILAN_BAS[lang] || _BILAN_BAS.fr;
  // La réduction en cours (bilanPromo, generate.js) : pastille et prix barré.
  const _bbPromo = (typeof bilanPromo !== 'undefined' && bilanPromo) ? bilanPromo : null;
  const _bbPrix = escapeHtml(_bb.prix.replace('{{prix}}', bilanPrix));
%>
<% if (_bilan) { %>
<section class="qr-bilan qr-bilan--bas" aria-label="<%= _bb.sur %>">
  <div class="qr-bilan-visuel" aria-hidden="true"><img src="/bilan/apercu-synthese-<%= _BILAN_BAS[lang] ? lang : 'fr' %>.webp" alt="" width="240" height="340" loading="lazy" decoding="async" draggable="false"></div>
  <div class="qr-bilan-corps">
    <p class="qr-bilan-sur"><%= _bb.sur %><% if (_bbPromo) { %> <span class="promo-pastille"><%= _bbPromo.badge %></span><% } %></p>
    <h3 class="qr-bilan-titre"><%= _bb.titre %></h3>
    <p class="qr-bilan-texte"><%= _bb.texte %></p>
    <ul class="qr-bilan-points">
      <% for (const p of _bb.points) { %><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><%= p %></span></li><% } %>
    </ul>
    <div class="qr-bilan-boutons">
      <a class="qr-bilan-bouton" href="<%= bilanChemin %>" data-bilan-src="bas-<%= _bilan.id %>"><%= _bb.bouton %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <p class="qr-bilan-prix"><%- _bbPromo ? _bbPromo.marque(_bbPrix) : _bbPrix %></p>
  </div>
</section>
<% } %>
