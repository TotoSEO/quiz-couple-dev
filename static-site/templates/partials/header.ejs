<%
  // Navigation link definitions
  const testLinks = [
    { routeKey: 'testCouple', labelKey: 'nav.testCouple' },
    { routeKey: 'testCommonPoints', labelKey: 'nav.testCommonPoints' },
    { routeKey: 'testDistance', labelKey: 'nav.testDistance' },
    { routeKey: 'testToxic', labelKey: 'nav.testToxic' },
    { routeKey: 'testCoupleSain', labelKey: 'nav.testCoupleSain' },
    { routeKey: 'testMariage', labelKey: 'nav.testMariage' },
    { routeKey: 'testDivorce', labelKey: 'nav.testDivorce' },
    { routeKey: 'testParentalite', labelKey: 'nav.testParentalite' },
    { routeKey: 'testAstroPrenoms', labelKey: 'nav.testAstroPrenoms' },
  ];
  const quizLinks = [
    { routeKey: 'quizAmoureux', labelKey: 'nav.quizAmoureux' },
    { routeKey: 'quizCoquin', labelKey: 'nav.quizCoquin' },
    { routeKey: 'quizMarrant', labelKey: 'nav.quizMarrant' },
    { routeKey: 'quizKnowledge', labelKey: 'nav.quizKnowledge' },
    { routeKey: 'quizMost', labelKey: 'nav.quizMost' },
    { routeKey: 'quizAdo', labelKey: 'nav.quizAdo' },
  ];
  const directLinks = [
    { routeKey: 'questionsCouple', labelKey: 'nav.questionsCouple' },
    { routeKey: 'problemResolver', labelKey: 'nav.problemResolver' },
    { routeKey: 'blog', labelKey: 'Blog' },
  ];
  const homeUrl = getLocalizedUrl('home', lang);

  // Language names for selector
  const langNames = { fr: 'FR', en: 'EN', es: 'ES', de: 'DE', it: 'IT' };
  const langFullNames = { fr: 'Français', en: 'English', es: 'Español', de: 'Deutsch', it: 'Italiano' };
%>
<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur" id="site-header">
  <nav class="container mx-auto px-4" aria-label="<%= lang === 'fr' ? 'Navigation principale' : 'Main navigation' %>">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="<%= homeUrl %>" class="flex items-center gap-2 text-xl font-bold transition-colors hover:opacity-80" aria-label="Quiz Couple - <%= lang === 'fr' ? 'Accueil' : 'Home' %>">
        <picture>
          <source srcset="/assets/logo-quiz-couple.webp" type="image/webp">
          <img src="/assets/logo-quiz-couple.png" alt="Quiz Couple" class="h-10 w-auto" width="40" height="42" loading="eager" fetchpriority="high">
        </picture>
        <span class="hidden sm:inline">Quiz Couple</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex lg:items-center lg:gap-1">
        <!-- Tests dropdown -->
        <div class="nav-dropdown relative">
          <button class="nav-dropdown-trigger inline-flex h-10 items-center justify-center rounded-md bg-transparent px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground" aria-expanded="false">
            <%= t('common:nav.categoryTests', 'Tests') %>
            <svg class="ml-1 h-3 w-3 transition-transform" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-dropdown-content absolute left-0 top-full z-50 hidden w-[280px] rounded-md border border-border bg-popover p-2 shadow-lg">
            <% for (const link of testLinks) { %>
            <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="block rounded-md p-3 text-sm font-medium leading-none transition-colors hover:bg-accent hover:text-accent-foreground"><%= t('common:' + link.labelKey, link.labelKey) %></a>
            <% } %>
          </div>
        </div>

        <!-- Quizzes dropdown -->
        <div class="nav-dropdown relative">
          <button class="nav-dropdown-trigger inline-flex h-10 items-center justify-center rounded-md bg-transparent px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground" aria-expanded="false">
            <%= t('common:nav.categoryQuizzes', 'Quiz') %>
            <svg class="ml-1 h-3 w-3 transition-transform" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-dropdown-content absolute left-0 top-full z-50 hidden w-[320px] rounded-md border border-border bg-popover p-2 shadow-lg">
            <% for (const link of quizLinks) { %>
            <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="block rounded-md p-3 text-sm font-medium leading-none transition-colors hover:bg-accent hover:text-accent-foreground"><%= t('common:' + link.labelKey, link.labelKey) %></a>
            <% } %>
          </div>
        </div>

        <!-- Direct links -->
        <% for (const link of directLinks) { %>
        <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="inline-flex h-10 items-center justify-center rounded-md bg-transparent px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"><%= t('common:' + link.labelKey, link.labelKey) %></a>
        <% } %>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Language Selector -->
        <div class="nav-dropdown relative">
          <button class="nav-dropdown-trigger inline-flex h-9 items-center justify-center rounded-md border border-border bg-card px-3 text-xs font-medium text-foreground transition-colors hover:bg-accent" aria-label="<%= lang === 'fr' ? 'Changer de langue' : 'Change language' %>">
            <%= langNames[lang] %>
            <svg class="ml-1 h-3 w-3" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-dropdown-content absolute right-0 top-full z-50 hidden w-[140px] rounded-md border border-border bg-popover p-1 shadow-lg">
            <% for (const l of ['fr','en','es','de','it']) { %>
            <a href="<%= getLocalizedUrl(typeof routeKey !== 'undefined' ? routeKey : 'home', l) %>" class="block rounded-md px-3 py-2 text-sm transition-colors hover:bg-accent <%= l === lang ? 'font-bold text-primary' : '' %>" <%= l === lang ? 'aria-current="true"' : '' %>><%= langFullNames[l] %></a>
            <% } %>
          </div>
        </div>

        <!-- Theme Toggle -->
        <button id="theme-toggle" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-foreground transition-colors hover:bg-accent" aria-label="<%= lang === 'fr' ? 'Changer le thème' : 'Toggle theme' %>">
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-card text-foreground transition-colors hover:bg-accent lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
          <svg class="h-5 w-5 menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="h-5 w-5 close-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden py-4 lg:hidden animate-fade-in">
      <div class="flex flex-col space-y-2">
        <!-- Tests accordion -->
        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger flex w-full items-center justify-between rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-muted"  aria-expanded="false">
            <span><%= t('common:nav.categoryTests', 'Tests') %></span>
            <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="mobile-accordion-content hidden ml-4 mt-1 space-y-1 border-l-2 border-border pl-4">
            <% for (const link of testLinks) { %>
            <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="block rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-primary"><%= t('common:' + link.labelKey, link.labelKey) %></a>
            <% } %>
          </div>
        </div>

        <!-- Quiz accordion -->
        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger flex w-full items-center justify-between rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-muted"  aria-expanded="false">
            <span><%= t('common:nav.categoryQuizzes', 'Quiz') %></span>
            <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="mobile-accordion-content hidden ml-4 mt-1 space-y-1 border-l-2 border-border pl-4">
            <% for (const link of quizLinks) { %>
            <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="block rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-primary"><%= t('common:' + link.labelKey, link.labelKey) %></a>
            <% } %>
          </div>
        </div>

        <!-- Direct links -->
        <% for (const link of directLinks) { %>
        <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="rounded-lg px-3 py-3 text-base font-medium transition-colors hover:bg-muted hover:text-primary" ><%= t('common:' + link.labelKey, link.labelKey) %></a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
