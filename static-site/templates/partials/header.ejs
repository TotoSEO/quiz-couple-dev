<%
  // Navigation link definitions with icons
  const testLinks = [
    { routeKey: 'testCouple', labelKey: 'nav.testCouple', icon: '💕', descKey: 'nav.testCoupleDesc' },
    { routeKey: 'testCommonPoints', labelKey: 'nav.testCommonPoints', icon: '🎯', descKey: 'nav.testCommonPointsDesc' },
    { routeKey: 'testDistance', labelKey: 'nav.testDistance', icon: '🌍', descKey: 'nav.testDistanceDesc' },
    { routeKey: 'testToxic', labelKey: 'nav.testToxic', icon: '⚠️', descKey: 'nav.testToxicDesc' },
    { routeKey: 'testCoupleSain', labelKey: 'nav.testCoupleSain', icon: '💚', descKey: 'nav.testCoupleSainDesc' },
    { routeKey: 'testMariage', labelKey: 'nav.testMariage', icon: '💒', descKey: 'nav.testMariageDesc' },
    { routeKey: 'testDivorce', labelKey: 'nav.testDivorce', icon: '⚖️', descKey: 'nav.testDivorceDesc' },
    { routeKey: 'testParentalite', labelKey: 'nav.testParentalite', icon: '👶', descKey: 'nav.testParentaliteDesc' },
    { routeKey: 'testEmmenager', labelKey: 'nav.testEmmenager', icon: '🏠', descKey: 'nav.testEmmenagerDesc' },
    { routeKey: 'testAstroPrenoms', labelKey: 'nav.testAstroPrenoms', icon: '♈', descKey: 'nav.testAstroPrenomsDesc' },
    { routeKey: 'testJalousie', labelKey: 'nav.testJalousie', icon: '🫣', descKey: 'nav.testJalousieDesc' },
    { routeKey: 'testLangageAmour', labelKey: 'nav.testLangageAmour', icon: '💬', descKey: 'nav.testLangageAmourDesc' },
    { routeKey: 'testAttachement', labelKey: 'nav.testAttachement', icon: '🔗', descKey: 'nav.testAttachementDesc' },
    { routeKey: 'testConfiance', labelKey: 'nav.testConfiance', icon: '🤝', descKey: 'nav.testConfianceDesc' },
  ];
  const quizLinks = [
    { routeKey: 'quizAmoureux', labelKey: 'nav.quizAmoureux', icon: '❤️', descKey: 'nav.quizAmoureuxDesc' },
    { routeKey: 'quizCoquin', labelKey: 'nav.quizCoquin', icon: '🔥', descKey: 'nav.quizCoquinDesc' },
    { routeKey: 'quizMarrant', labelKey: 'nav.quizMarrant', icon: '😂', descKey: 'nav.quizMarrantDesc' },
    { routeKey: 'quizKnowledge', labelKey: 'nav.quizKnowledge', icon: '🧠', descKey: 'nav.quizKnowledgeDesc' },
    { routeKey: 'quizMost', labelKey: 'nav.quizMost', icon: '🏆', descKey: 'nav.quizMostDesc' },
    { routeKey: 'quizAdo', labelKey: 'nav.quizAdo', icon: '🌟', descKey: 'nav.quizAdoDesc' },
    { routeKey: 'quizGenant', labelKey: 'nav.quizGenant', icon: '😳', descKey: 'nav.quizGenantDesc' },
    { routeKey: 'quizTuPreferes', labelKey: 'nav.quizTuPreferes', icon: '🤔', descKey: 'nav.quizTuPreferesDesc' },
    { routeKey: 'quizVraiFaux', labelKey: 'nav.quizVraiFaux', icon: '✅', descKey: 'nav.quizVraiFauxDesc' },
  ];
  const directLinks = [
    { routeKey: 'questionsCouple', labelKey: 'nav.questionsCouple' },
    { routeKey: 'blog', labelKey: 'Blog' },
  ];
  const homeUrl = getLocalizedUrl('home', lang);

  // Filter out links that don't have a URL for the current language (frOnly pages in non-FR)
  const filterAvailable = (links) => links.filter(link => getLocalizedUrl(link.routeKey, lang));
  const testLinksFiltered = filterAvailable(testLinks);
  const quizLinksFiltered = filterAvailable(quizLinks);
  const directLinksFiltered = filterAvailable(directLinks);

  // Language names for selector
  const langNames = { fr: 'FR', en: 'EN', es: 'ES', de: 'DE', it: 'IT' };
  const langFullNames = { fr: 'Français', en: 'English', es: 'Español', de: 'Deutsch', it: 'Italiano' };
%>
<header class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80" id="site-header">
  <nav class="container mx-auto px-4" aria-label="<%= lang === 'fr' ? 'Navigation principale' : 'Main navigation' %>">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="<%= homeUrl %>" class="flex items-center gap-2.5 text-xl font-bold transition-colors hover:opacity-80 flex-shrink-0" aria-label="Quiz Couple - <%= lang === 'fr' ? 'Accueil' : 'Home' %>">
        <picture>
          <source srcset="/assets/logo-quiz-couple.webp" type="image/webp">
          <img src="/assets/logo-quiz-couple.png" alt="Quiz Couple" class="h-10 w-auto" width="40" height="42" loading="eager" fetchpriority="high">
        </picture>
        <span class="hidden sm:inline font-bold">Quiz Couple</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex lg:items-center lg:gap-1">
        <!-- Tests Mega Menu -->
        <div class="nav-dropdown relative" data-megamenu>
          <button class="nav-link nav-dropdown-trigger" aria-expanded="false">
            <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
            <%= t('common:nav.categoryTests', 'Tests') %>
            <svg class="nav-chevron" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-megamenu nav-dropdown-content hidden">
            <div class="nav-megamenu-inner">
              <div class="nav-megamenu-header">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                <span><%= t('common:nav.categoryTests', 'Tests') %></span>
                <span class="nav-megamenu-count"><%= testLinksFiltered.length %></span>
              </div>
              <div class="nav-megamenu-grid">
                <% for (const link of testLinksFiltered) { %>
                <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="nav-megamenu-item">
                  <span class="nav-megamenu-icon"><%= link.icon %></span>
                  <span class="nav-megamenu-label"><%= t('common:' + link.labelKey, link.labelKey) %></span>
                </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Quiz Mega Menu -->
        <div class="nav-dropdown relative" data-megamenu>
          <button class="nav-link nav-dropdown-trigger" aria-expanded="false">
            <svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            <%= t('common:nav.categoryQuizzes', 'Quiz') %>
            <svg class="nav-chevron" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-megamenu nav-dropdown-content hidden">
            <div class="nav-megamenu-inner">
              <div class="nav-megamenu-header nav-megamenu-header--quiz">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
                <span><%= t('common:nav.categoryQuizzes', 'Quiz') %></span>
                <span class="nav-megamenu-count"><%= quizLinksFiltered.length %></span>
              </div>
              <div class="nav-megamenu-grid">
                <% for (const link of quizLinksFiltered) { %>
                <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="nav-megamenu-item nav-megamenu-item--quiz">
                  <span class="nav-megamenu-icon"><%= link.icon %></span>
                  <span class="nav-megamenu-label"><%= t('common:' + link.labelKey, link.labelKey) %></span>
                </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Separator -->
        <div class="nav-separator"></div>

        <!-- Direct links -->
        <% for (const link of directLinksFiltered) { %>
        <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="nav-link"><%= t('common:' + link.labelKey, link.labelKey) %></a>
        <% } %>

        <!-- Activities CTA -->
        <a href="<%= getLocalizedUrl('activities', lang) %>" class="nav-cta-btn">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= t('common:nav.activities', 'Activities') %>
        </a>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Language Selector -->
        <div class="nav-dropdown relative">
          <button class="nav-dropdown-trigger nav-action-btn" aria-label="<%= lang === 'fr' ? 'Changer de langue' : 'Change language' %>">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            <span class="text-xs font-semibold"><%= langNames[lang] %></span>
            <svg class="nav-chevron" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="nav-dropdown-content nav-lang-dropdown hidden">
            <% for (const l of ['fr','en','es','de','it']) { %>
            <a href="<%= getLocalizedUrl(typeof routeKey !== 'undefined' ? routeKey : 'home', l) || getLocalizedUrl('home', l) %>" class="nav-lang-option <%= l === lang ? 'nav-lang-option--active' : '' %>"<%- l === lang ? ' aria-current="true"' : '' %>>
              <span class="text-xs font-bold uppercase w-6"><%= langNames[l] %></span>
              <span><%= langFullNames[l] %></span>
              <% if (l === lang) { %><svg class="w-4 h-4 text-primary ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><% } %>
            </a>
            <% } %>
          </div>
        </div>

        <!-- Theme Toggle -->
        <button id="theme-toggle" class="nav-action-btn" aria-label="<%= lang === 'fr' ? 'Changer le thème' : 'Toggle theme' %>">
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
          <svg class="h-5 w-5 menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="h-5 w-5 close-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden lg:hidden animate-fade-in">
      <div class="mobile-nav-inner">
        <!-- Tests accordion -->
        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger" aria-expanded="false">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
              <%= t('common:nav.categoryTests', 'Tests') %>
              <span class="mobile-nav-count"><%= testLinksFiltered.length %></span>
            </span>
            <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="mobile-accordion-content hidden">
            <div class="mobile-nav-grid">
              <% for (const link of testLinksFiltered) { %>
              <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="mobile-nav-item">
                <span class="mobile-nav-item-icon"><%= link.icon %></span>
                <span><%= t('common:' + link.labelKey, link.labelKey) %></span>
              </a>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Quiz accordion -->
        <div class="mobile-accordion">
          <button class="mobile-accordion-trigger" aria-expanded="false">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              <%= t('common:nav.categoryQuizzes', 'Quiz') %>
              <span class="mobile-nav-count"><%= quizLinksFiltered.length %></span>
            </span>
            <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="mobile-accordion-content hidden">
            <div class="mobile-nav-grid">
              <% for (const link of quizLinksFiltered) { %>
              <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="mobile-nav-item mobile-nav-item--quiz">
                <span class="mobile-nav-item-icon"><%= link.icon %></span>
                <span><%= t('common:' + link.labelKey, link.labelKey) %></span>
              </a>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="mobile-nav-divider"></div>

        <!-- Direct links -->
        <% for (const link of directLinksFiltered) { %>
        <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="mobile-nav-link"><%= t('common:' + link.labelKey, link.labelKey) %></a>
        <% } %>

        <!-- Activities CTA (mobile) -->
        <a href="<%= getLocalizedUrl('activities', lang) %>" class="mobile-nav-cta">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= t('common:nav.activities', 'Activities') %>
        </a>
      </div>
    </div>
  </nav>
</header>
