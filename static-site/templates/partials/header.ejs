              <div class="n2-onglet n2-onglet--scinde">
                <a href="<%= urlJeux %>" class="nav-trigger-lien">
                  <span class="n2-onglet-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4M8 10v4"/><circle cx="16" cy="11" r="1"/><circle cx="18" cy="14" r="1"/></svg></span>
                  <%= t('common:nav.jeuxCouple', 'Jeux de couple') %>
                  <span class="n2-onglet-nb"><%= jeuLinksFiltered.length %></span>
                </a>
                <button type="button" class="nav-trigger-fleche" aria-expanded="false"
                        aria-label="<%= t('common:nav.deployerJeux', 'Voir tous les jeux') %>">
                  <svg class="nav-chevron" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="nav-megamenu nav-megamenu--jeux nav-megamenu--sections fam--jeux <%= classesBureau('jeux') %> nav-dropdown-content hidden">
                <div class="nav-megamenu-inner">
                  <%- panneauBureau('jeux') %>
                  <a href="<%= urlJeux %>" class="nav-megamenu-pied">
                    <%= t('common:nav.deployerJeux', 'Voir tous les jeux') %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Quiz spéciaux de saison : le libellé mène au hub, la flèche déplie. -->
            <% if (speciauxLinksFiltered.length) { %>
            <div class="nav-dropdown n2-famille nav-dropdown--scinde relative" data-megamenu style="--cat: var(--speciaux)">
              <div class="n2-onglet n2-onglet--scinde">
                <a href="<%= urlSpeciaux %>" class="nav-trigger-lien">
                  <span class="n2-onglet-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.9 4.6 4.9.4-3.7 3.2 1.1 4.8L12 13.5 7.8 16l1.1-4.8L5.2 8l4.9-.4z"/></svg></span>
                  <%= t('common:nav.ongletSpeciaux', t('common:nav.categorySpeciaux', 'Quiz spéciaux')) %>
                  <span class="n2-onglet-nb"><%= speciauxLinksFiltered.length %></span>
                </a>
                <button type="button" class="nav-trigger-fleche" aria-expanded="false"
                        aria-label="<%= t('common:nav.deployerSpeciaux', 'Voir tous les quiz spéciaux') %>">
                  <svg class="nav-chevron" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </button>
              </div>
              <div class="nav-megamenu nav-megamenu--speciaux nav-megamenu--sections fam--speciaux <%= classesBureau('speciaux') %> nav-dropdown-content hidden">
                <div class="nav-megamenu-inner">
                  <%- panneauBureau('speciaux') %>
                  <a href="<%= urlSpeciaux %>" class="nav-megamenu-pied">
                    <%= t('common:nav.deployerSpeciaux', 'Voir tous les quiz spéciaux') %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </div>
            <% } %>

          </div>

        </div>
      </div>
    </div>

    <%# Menu mobile déplié (9 novembre 2026, Thomas : « quand t'ouvre le menu
        [...] il s'affiche sur tout l'écran pour un max de visibilité de toutes
        les pages et sections ») : il prend tout l'écran sous la rangée du
        logo. D'abord la liste des familles, leur nom seul (leurs sections en
        sous-titre jusqu'au 14 novembre 2026) ; une famille touchée s'ouvre en
        plein écran, ses pages
        rangées sous leurs titres de section, sur deux colonnes, et la flèche
        de la barre ramène à la liste (mobile-menu.js). Les panneaux sont dans
        la page dès le HTML : tous les liens restent lisibles par les robots. %>
    <div id="mobile-menu" class="hidden lg:hidden">
      <div class="container mx-auto px-4">
        <div class="mnav">
          <div class="mnav-accueil">
          <% if (livreMenu) { %>
          <div class="mnav-duo<%= urlEval ? '' : ' mnav-duo--seul' %>">
            <% if (urlEval) { %>
            <a href="<%= urlEval %>" data-bilan-src="menu-mobile" class="mnav-tuile mnav-tuile--eval">
              <span class="mnav-tuile-ic"><%- icEval %></span>
              <span class="mnav-tuile-titre"><%= t('common:nav.evaluer', 'Évaluer son couple') %></span>
              <span class="mnav-tuile-sous"><%= t('livre:menu.evaluerSous', '') %></span>
              <%- icAller %>
            </a>
            <% } %>
            <a href="<%= livreMenu.url %>" class="mnav-tuile mnav-tuile--livre" data-livre-lien="menu-mobile"<%- courant('livreQuizCouple') %>>
              <img class="mnav-tuile-livre" src="/livre/livre-mini-160.webp" alt="" width="160" height="173" loading="lazy" decoding="async">
              <span class="mnav-tuile-titre"><%= livreTitre %></span>
              <span class="mnav-tuile-sous"><%= t('livre:menu.sous', '') %></span>
              <%- icAller %>
            </a>
          </div>
          <% } else if (urlEval) { %>
          <a href="<%= urlEval %>" data-bilan-src="menu-mobile" class="mobile-eval">
            <span class="mobile-eval-ic"><%- icEval %></span>
            <span>
              <span class="mobile-eval-titre"><%= t('common:nav.evaluer', 'Évaluer son couple') %></span>
              <span class="mobile-eval-sous"><%= t('common:nav.evaluerSous', '') %></span>
            </span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <% } %>
          <ul class="mnav-familles">
            <% for (const f of familles) { %>
            <li>
              <button type="button" class="mnav-famille fam--<%= f.cle %>" aria-expanded="false" aria-controls="mnav-<%= f.cle %>">
                <span class="mnav-famille-ic" aria-hidden="true"><%- f.ic %></span>
                <span class="mnav-famille-texte">
                  <span class="mnav-famille-nom"><%= f.nom %> <span class="mnav-nb"><%= f.total %></span></span>
                </span>
                <svg class="mnav-famille-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            </li>
            <% } %>
          </ul>

          <div class="mobile-nav-divider"></div>

          <%# Quatre tuiles carrées en grille de 2 x 2 (17 octobre 2026, Thomas : « 2
              carrés et 2 carrés », puis « pas de gradient ni de fade ; le titre en
              gros, le pictogramme en grand en fond, et en bas, séparée par un
              trait, une longue flèche »). Le titre passe à la ligne après son
              premier mot : « CRÉER / UN QUIZ ». %>
          <%
            const tuileIg = '<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>';
            const tuiles = [{ href: instagramUrl, tuile: 'instagram', ic: tuileIg, libelle: 'Instagram', externe: true }]
              .concat(directLinksFiltered.map((l) => ({ href: urlNav(l.routeKey), tuile: l.tuile, ic: l.ic, libelle: t('common:' + l.labelKey, l.labelKey) })));
          %>
          <div class="mobile-tuiles">
            <% // Largeur des majuscules de Fredoka en gras, en em (relevée dans Chromium),
               // 0,7 pour un signe absent. Sert à trouver la taille qui remplit le carré.
               const chasse = { A: .71, B: .61, C: .63, D: .66, E: .6, F: .61, G: .72, H: .65, I: .24, J: .53, K: .6, L: .57, M: .81, N: .67, O: .72, P: .6, Q: .78, R: .6, S: .54, T: .64, U: .68, V: .73, W: .95, X: .69, Y: .64, Z: .6, 'À': .71, 'Â': .71, 'Ä': .71, 'Ç': .63, 'È': .6, 'É': .6, 'Ê': .6, 'Ë': .6, 'Î': .24, 'Ï': .24, 'Ô': .72, 'Ö': .72, 'Ù': .68, 'Û': .68, 'Ü': .68, ' ': .24, "'": .19, '-': .4 };
               const largeur = (x) => Array.from(x).reduce((t, c) => t + (chasse[c] || .7), 0);
               for (const tu of tuiles) {
                 // Le titre remplit le carré : on garde la coupure qui donne la plus
                 // grande taille, entre « CRÉER / UN QUIZ » (premier mot, puis le
                 // reste), un mot par ligne et une seule ligne. La taille vient de la
                 // plus longue ligne (--l, en em) et du nombre de lignes (--n), en
                 // CSS. À moins de 10 % près, « CRÉER / UN QUIZ » l'emporte.
                 const mots = String(tu.libelle).toUpperCase().split(' ').filter(Boolean);
                 const essais = [[mots.join(' ')]];
                 if (mots.length > 1) essais.push([mots[0], mots.slice(1).join(' ')], mots.slice());
                 const taille = (lg) => Math.min(0.9 / Math.max.apply(null, lg.map(largeur)), 0.78 / (lg.length * 1.02));
                 let lignes = essais[0];
                 for (const e of essais) {
                   const prefere = mots.length > 1 && e.length === 2 && lignes.length !== 2;
                   if (taille(e) > taille(lignes) * (prefere ? 0.9 : 1.1)) lignes = e;
                 }
                 const plusLongue = Math.max.apply(null, lignes.map(largeur)).toFixed(2); %>
            <a href="<%= tu.href %>" class="mobile-tuile mobile-tuile--<%= tu.tuile %>"<% if (tu.externe) { %> target="_blank" rel="noopener" aria-label="<%= t('common:footer.instagram', 'Suivez-nous sur Instagram') %>"<% } %>>
              <span class="mobile-tuile-haut">
                <svg class="mobile-tuile-fond" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- tu.ic %></svg>
                <span class="mobile-tuile-titre" style="--l: <%= plusLongue %>; --n: <%= lignes.length %>"><% for (const ligne of lignes) { %><span><%= ligne %></span><% } %></span>
              </span>
              <span class="mobile-tuile-bas" aria-hidden="true"><span class="mobile-tuile-trait"></span><svg class="mobile-tuile-pointe" viewBox="0 0 10 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 1.5 8.5 6 3 10.5"/></svg></span>
            </a>
            <% } %>
          </div>
          </div>
          <% for (const f of familles) { %><%- panneauMobile(f) %><% } %>
        </div>
      </div>
    </div>
  </nav>
  <% if (bandeauPromoVisible) { %>
  <a href="<%= urlEval %>" data-bilan-src="bandeau-promo" class="bandeau-promo"><span><%- bilanPromo.bandeau %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></a>
  <% } %>
</header>
