  // ── Les sections du menu (9 novembre 2026) ──────────────────────────────
  // Chaque famille range ses pages sous des titres de section (SECTIONS_NAV,
  // config.js ; sectionsPour dans generate.js retire déjà ce qui n'existe pas
  // dans la langue). Le même découpage sert au panneau de bureau, en colonnes,
  // et au menu mobile, où chaque famille s'ouvre en plein écran sur deux
  // colonnes. Une famille d'une seule section n'a pas de titre de section.
  const esc = (x) => String(x).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const pageCourante = typeof routeKey !== 'undefined' ? routeKey : null;
  const nomPage = (k) => t('common:nav.' + k, k);
  const titreSection = (cle) => t('common:nav.sections.' + cle, cle);
  const courant = (k) => (k === pageCourante ? ' aria-current="page"' : '');
  const sectionsDe = (cle) => {
    if (typeof sectionsNav !== 'undefined' && sectionsNav && sectionsNav[cle]) return sectionsNav[cle];
    const routes = ((famillesNav && famillesNav[cle]) || []).filter((k) => getLocalizedUrl(k, lang));
    return routes.length ? [{ cle: cle, routes }] : [];
  };
  const icFamille = {
    tests: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>',
    celib: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.2 3.6-7 8-7s8 2.8 8 7"/></svg>',
    quiz: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>',
    jeux: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4M8 10v4"/><circle cx="16" cy="11" r="1"/><circle cx="18" cy="14" r="1"/></svg>',
    speciaux: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.9 4.6 4.9.4-3.7 3.2 1.1 4.8L12 13.5 7.8 16l1.1-4.8L5.2 8l4.9-.4z"/></svg>',
  };
  const familles = [
    { cle: 'tests', nom: t('common:nav.categoryTests', 'Tests') },
    { cle: 'celib', nom: t('common:nav.categorySingles', 'Tests célibataires') },
    { cle: 'quiz', nom: t('common:nav.categoryQuizzes', 'Quiz') },
    { cle: 'jeux', nom: t('common:nav.jeuxCouple', 'Jeux de couple'),
      hub: getLocalizedUrl('jeuxCouple', lang), hubLibelle: t('common:nav.deployerJeux', 'Voir tous les jeux') },
    { cle: 'speciaux', nom: t('common:nav.ongletSpeciaux', t('common:nav.categorySpeciaux', 'Quiz spéciaux')),
      hub: getLocalizedUrl('speciauxCouple', lang), hubLibelle: t('common:nav.deployerSpeciaux', 'Voir tous les quiz spéciaux') },
  ].map((f) => {
    const sections = sectionsDe(f.cle);
    return Object.assign(f, { sections, total: sections.reduce((n, s) => n + s.routes.length, 0), ic: icFamille[f.cle] });
  }).filter((f) => f.total);
  const familleDe = {};
  for (const f of familles) familleDe[f.cle] = f;
  const flecheDroite = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

  // Bureau : les sections en colonnes (CSS multi-colonnes, une section ne se
  // coupe jamais), dans l'ordre de lecture. Quatre colonnes au plus, cinq
  // pour les tests de couple au-dessus de 1 280 px (nav-megamenu--large),
  // pour que leurs 45 pages tiennent dans la hauteur d'un portable. Une
  // seule section : une grille de deux, sans titre.
  function lienBureau(k) {
    return '<li><a href="' + urlNav(k) + '"' + srcNav(k) + courant(k) + ' class="nav-sec-lien">'
      + '<span class="nav-sec-ic" aria-hidden="true">' + navIcon(k) + '</span>'
      + '<span class="nav-sec-nom">' + esc(nomPage(k)) + '</span></a></li>';
  }
  function panneauBureau(cle) {
    const f = familleDe[cle];
    if (!f) return '';
    if (f.sections.length === 1) return '<ul class="nav-sec-liste nav-sec-liste--grille">' + f.sections[0].routes.map(lienBureau).join('') + '</ul>';
    return '<div class="nav-colonnes">' + f.sections.map((s) =>
      '<div class="nav-sec" role="group" aria-labelledby="nb-' + cle + '-' + s.cle + '">'
      + '<p class="nav-sec-titre" id="nb-' + cle + '-' + s.cle + '">' + esc(titreSection(s.cle)) + '</p>'
      + '<ul class="nav-sec-liste">' + s.routes.map(lienBureau).join('') + '</ul></div>').join('') + '</div>';
  }
  const classesBureau = (cle) => {
    const f = familleDe[cle];
    const n = f && f.sections.length > 1 ? Math.min(4, f.sections.length) : 2;
    return 'nav-megamenu--n' + n + (f && f.sections.length >= 6 ? ' nav-megamenu--large' : '');
  };

  // Mobile : un panneau plein écran par famille, ouvert depuis la liste des
  // familles (mobile-menu.js). La liste ne montre que le nom de chaque famille
  // et son nombre de pages : les sections qu'elle disait dessous (« Jeux de
  // soirée · Jeux de questions… ») sont parties le 14 novembre 2026, à la
  // demande de Thomas ; on les trouve en titres dans le panneau.
  function lienMobile(k) {
    return '<li><a href="' + urlNav(k) + '"' + srcNav(k) + courant(k) + ' class="mnav-lien">'
      + '<span class="mnav-lien-ic" aria-hidden="true">' + navIcon(k) + '</span>'
      + '<span class="mnav-lien-nom">' + esc(nomPage(k)) + '</span></a></li>';
  }
  function panneauMobile(f) {
    const seul = f.sections.length === 1;
    let h = '<div class="mnav-panneau fam--' + f.cle + '" id="mnav-' + f.cle + '" role="group" aria-labelledby="mnav-' + f.cle + '-titre" hidden>'
      + '<div class="mnav-barre">'
      + '<button type="button" class="mnav-retour" aria-label="' + esc(t('common:nav.retour', 'Retour')) + '">'
      + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>'
      + '<p class="mnav-barre-titre" id="mnav-' + f.cle + '-titre"><span class="mnav-barre-ic" aria-hidden="true">' + f.ic + '</span>'
      + '<span class="mnav-barre-nom">' + esc(f.nom) + '</span><span class="mnav-nb">' + f.total + '</span></p>'
      + '</div>';
    for (const s of f.sections) {
      const id = 'nm-' + f.cle + '-' + s.cle;
      h += '<div class="mnav-section' + (seul ? ' mnav-section--seule"' : '" role="group" aria-labelledby="' + id + '"') + '>';
      if (!seul) h += '<p class="mnav-section-titre" id="' + id + '"><span>' + esc(titreSection(s.cle)) + '</span></p>';
      h += '<ul class="mnav-grille">' + s.routes.map(lienMobile).join('') + '</ul></div>';
    }
    if (f.hub) h += '<a href="' + f.hub + '" class="mnav-hub">' + esc(f.hubLibelle) + flecheDroite + '</a>';
    return h + '</div>';
  }
%>

<%# ── En-tête à deux niveaux ─────────────────────────────────────────────
    Niveau 1 : l'identité et l'outillage (logo, liens directs, langue, thème).
    Niveau 2 : la navigation de fond (Tests, Quiz, Jeux) avec ses panneaux.
    Au défilement, chaque écran replie le niveau qui lui sert le moins :
    le bureau replie le niveau 1 et fait apparaître un petit logo dans le
    niveau 2 ; le mobile replie la rangée de puces du niveau 2 et fait
    glisser le logo, centré en haut de page, vers la gauche. %>
<header class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80" id="site-header">
  <% if (urlEval || livreMenu) { %>
  <style>
    <% if (urlEval) { %>
    .n2-eval { display: inline-flex; align-items: center; gap: .5rem; height: 2.5rem; padding: 0 1rem 0 .4rem; margin-right: .45rem; border-radius: 999px; font-size: .875rem; font-weight: 700; white-space: nowrap; color: #fff; background: hsl(var(--primary)); text-decoration: none; box-shadow: 0 8px 18px -10px hsl(var(--primary) / .9); transition: background .2s ease, transform .2s ease; }
    .n2-eval:hover, .n2-eval:focus-visible { color: #fff; background: hsl(340 65% 58%); transform: translateY(-1px); }
    .n2-eval:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 2px; }
    .n2-eval-ic { display: inline-flex; align-items: center; justify-content: center; width: 1.8rem; height: 1.8rem; border-radius: 999px; background: hsl(0 0% 100% / .22); flex-shrink: 0; }
    .n2-eval-ic svg { width: 1rem; height: 1rem; }
    .mobile-eval { display: grid; grid-template-columns: 2.7rem minmax(0, 1fr) 1.25rem; gap: .85rem; align-items: center; padding: .9rem 1rem .9rem .85rem; border-radius: 1rem; color: #fff; background: hsl(var(--primary)); text-decoration: none; }
    .mobile-eval:hover, .mobile-eval:focus-visible { color: #fff; background: hsl(340 65% 58%); }
    .mobile-eval-ic { display: inline-flex; align-items: center; justify-content: center; width: 2.7rem; height: 2.7rem; border-radius: .85rem; background: hsl(0 0% 100% / .22); }
    .mobile-eval-ic svg { width: 1.4rem; height: 1.4rem; }
    .mobile-eval-titre { display: block; font-size: 1.02rem; font-weight: 800; line-height: 1.2; }
    .mobile-eval-sous { display: block; margin-top: .15rem; font-size: .8rem; line-height: 1.3; color: hsl(0 0% 100% / .88); }
    .mobile-eval > svg { width: 1.25rem; height: 1.25rem; }
    /* En thème sombre, le rose clair du thème portait un texte blanc à peine
       lisible et un halo (14 novembre 2026, Thomas : « en mode dark il est
       moche dans le menu ») : un aplat rose foncé bordé de rose, comme les
       cartes sombres du menu, et la pastille de l'icône en rose plein. */
    .dark .n2-eval { color: hsl(330 25% 96%); background: hsl(338 42% 19%); box-shadow: inset 0 0 0 1px hsl(338 90% 72% / .55); }
    .dark .n2-eval:hover, .dark .n2-eval:focus-visible { color: #fff; background: hsl(338 42% 24%); box-shadow: inset 0 0 0 1px hsl(338 90% 72% / .85); }
    .dark .n2-eval-ic, .dark .mobile-eval-ic { color: hsl(300 30% 10%); background: hsl(var(--primary)); }
    .dark .mobile-eval { color: hsl(330 25% 96%); background: hsl(338 42% 17%); box-shadow: inset 0 0 0 1px hsl(338 90% 72% / .45); }
    .dark .mobile-eval:hover, .dark .mobile-eval:focus-visible { color: #fff; background: hsl(338 42% 22%); }
    .dark .mobile-eval-sous { color: hsl(338 50% 86%); }
    @media (prefers-reduced-motion: reduce) { .n2-eval { transition: none; } }
    <% } %>
    <% if (livreMenu) { %>
    /* Le bouton du livre, aux couleurs de sa couverture : à droite de
       « Évaluer son couple » sur ordinateur, à côté de lui sur une même
       rangée dans le menu du téléphone (.mnav-duo). */
    .n2-livre { display: inline-flex; align-items: center; gap: .45rem; height: 2.5rem; padding: 0 1rem 0 .4rem; margin-right: .45rem; border-radius: 999px; font-size: .875rem; font-weight: 700; white-space: nowrap; color: #2b1722; background: #ffd45c; text-decoration: none; box-shadow: inset 0 0 0 1px #e9b93a; transition: background .2s ease, transform .2s ease; }
    .n2-livre:hover, .n2-livre:focus-visible { color: #2b1722; background: #ffca33; transform: translateY(-1px); }
    .n2-livre:focus-visible { outline: 2px solid #b98a00; outline-offset: 2px; }
    .n2-livre img { width: 1.75rem; height: auto; transform: rotate(-7deg); filter: drop-shadow(0 2px 2px rgb(43 23 34 / .22)); }
    /* Deux lignes serrées, « 100 aventures » puis « à deux » : la barre des
       onglets est pleine au-dessus de 1 440 px (compteurs des familles
       affichés). Et la pastille ne rétrécit jamais : jusqu'au 14 novembre
       2026, elle passait de 165 à 143 px au-dessus de 1 440 px, et le texte
       (« Cadeau de Noël ») dépassait de son fond. */
    .n2-livre { flex-shrink: 0; }
    .n2-livre-texte { display: flex; flex-direction: column; line-height: 1.05; }
    .n2-livre-haut { font-size: .8125rem; font-weight: 800; }
    .n2-livre-bas { font-size: .75rem; font-weight: 600; opacity: .8; }
    /* Au-dessus de 1 440 px, les compteurs des familles reviennent et la
       rangée, bornée à 1 368 px, déborderait de 4 px : l'écart entre les
       onglets passe de 0,3 à 0,15 rem quand le bouton du livre est là. */
    @media (min-width: 1440px) { .entete-onglets { gap: .15rem; } }
    .dark .n2-livre { color: #ffe7a3; background: #2b2314; box-shadow: inset 0 0 0 1px rgb(255 212 92 / .5); }
    .dark .n2-livre:hover, .dark .n2-livre:focus-visible { color: #fff3cf; background: #372d1a; box-shadow: inset 0 0 0 1px rgb(255 212 92 / .8); }
    @media (min-width: 1024px) and (max-width: 1179.98px) {
      .n2-livre { padding: 0 .4rem; }
      .n2-livre-texte { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    }
    .mnav-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
    .mnav-duo--seul { grid-template-columns: minmax(0, 1fr); }
    .mnav-tuile { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: .55rem; min-height: 8.4rem; padding: .85rem .85rem 1rem; border-radius: 1rem; text-decoration: none; }
    .mnav-tuile > svg { position: absolute; top: .85rem; right: .8rem; width: 1.2rem; height: 1.2rem; }
    .mnav-tuile-ic { display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border-radius: .85rem; background: hsl(0 0% 100% / .22); }
    .mnav-tuile-ic svg { width: 1.35rem; height: 1.35rem; }
    .mnav-tuile-livre { width: 2.4rem; height: auto; margin: -.1rem 0 .05rem .15rem; transform: rotate(-7deg); filter: drop-shadow(0 3px 3px rgb(43 23 34 / .25)); }
    .mnav-tuile-titre { display: block; font-size: 1rem; font-weight: 800; line-height: 1.2; hyphens: manual; overflow-wrap: normal; }
    .mnav-tuile-sous { display: block; margin-top: -.3rem; font-size: .8rem; line-height: 1.3; }
    .mnav-tuile--eval { color: #fff; background: hsl(var(--primary)); }
    .mnav-tuile--eval:hover, .mnav-tuile--eval:focus-visible { color: #fff; background: hsl(340 65% 58%); }
    .mnav-tuile--eval .mnav-tuile-sous { color: hsl(0 0% 100% / .9); }
    .mnav-tuile--livre { color: #2b1722; background: #ffd45c; box-shadow: inset 0 0 0 1px #e9b93a; }
    /* « Cadeau de couple idéal ! » (14 novembre 2026, Thomas : « dans une
       couleur qui ressort ») : une étiquette rouge, comme le badge des encarts
       du livre (blanc sur #c8233f, 5,6:1), dans les deux thèmes. */
    .mnav-tuile--livre .mnav-tuile-sous { margin-top: -.15rem; padding: .24rem .5rem; border-radius: .5rem; background: #c8233f; color: #fff; font: 800 .8rem/1.25 var(--font-display, inherit); text-wrap: balance; }
    .mnav-tuile--livre:hover, .mnav-tuile--livre:focus-visible { color: #2b1722; background: #ffca33; }
    .dark .mnav-tuile--eval { color: hsl(330 25% 96%); background: hsl(338 42% 17%); box-shadow: inset 0 0 0 1px hsl(338 90% 72% / .45); }
    .dark .mnav-tuile--eval:hover, .dark .mnav-tuile--eval:focus-visible { color: #fff; background: hsl(338 42% 22%); }
    .dark .mnav-tuile--eval .mnav-tuile-ic { color: hsl(300 30% 10%); background: hsl(var(--primary)); }
    .dark .mnav-tuile--eval .mnav-tuile-sous { color: hsl(338 50% 86%); }
    .dark .mnav-tuile--livre { color: #ffe7a3; background: #2b2314; box-shadow: inset 0 0 0 1px rgb(255 212 92 / .5); }
    .dark .mnav-tuile--livre:hover, .dark .mnav-tuile--livre:focus-visible { color: #fff3cf; background: #372d1a; }
    @media (prefers-reduced-motion: reduce) { .n2-livre { transition: none; } }
    <% } %>
    <% if (bandeauPromoVisible) { %>
    .bandeau-promo { display: flex; align-items: center; justify-content: center; gap: .55rem; padding: .62rem 1rem; color: #fff; background: hsl(286 38% 14%); font: 700 .9rem/1.4 var(--font-display, inherit); text-align: center; text-decoration: none; }
    .bandeau-promo:hover, .bandeau-promo:focus-visible { color: #fff; background: hsl(286 38% 19%); }
    .bandeau-promo:focus-visible { outline: 2px solid hsl(43 96% 58%); outline-offset: -4px; }
    .bandeau-promo-remise { display: inline-block; margin: 0 .1rem; padding: .05rem .5rem; border-radius: 999px; color: hsl(286 38% 14%); background: hsl(43 96% 58%); font-weight: 800; white-space: nowrap; }
    .bandeau-promo > svg { width: 1.05rem; height: 1.05rem; flex-shrink: 0; color: hsl(43 96% 58%); }
    .dark .bandeau-promo { background: hsl(266 42% 22%); }
    .dark .bandeau-promo:hover, .dark .bandeau-promo:focus-visible { background: hsl(266 42% 27%); }
    #site-header:has(#mobile-menu:not(.hidden)) > .bandeau-promo { display: none; }
    /* Collée, la barre allonge l'en-tête de sa hauteur (62 px sur deux lignes,
       42 px sur une, à partir d'environ 520 px de large) : les ancres et les
       scrollIntoView de la page s'arrêtent d'autant plus bas, et les blocs
       collés du résultat (notation, renvoi, portrait), posés dans styles.css
       sous l'en-tête seul, descendent d'autant. */
    @media (max-width: 1023.98px) {
      html { --barre-promo: 3.9rem; scroll-padding-top: var(--barre-promo); }
      html .qr-zone--avis, html .qr-rate--collant { top: calc(4.5rem + var(--barre-promo)); }
      html .qr-zone--avis { max-height: calc(100vh - 6rem - var(--barre-promo)); max-height: calc(100dvh - 6rem - var(--barre-promo)); }
      html .apr-profil-carte { top: calc(5.5rem + var(--barre-promo)); }
    }
    /* Le bloc « Poursuivez avec d'autres tests » n'est collé qu'à partir de
       900 px (styles.css) ; en dessous il est en position relative, et ce
       top le faisait descendre de 134 px sur les boutons « Recommencer » et
       « Partager », qu'il cachait (9 novembre 2026). */
    @media (min-width: 900px) and (max-width: 1023.98px) {
      html .qr-zone--suite { top: calc(4.5rem + var(--barre-promo)); }
    }
    @media (min-width: 520px) and (max-width: 1023.98px) { html { --barre-promo: 2.65rem; } }
    @media (min-width: 1024px) { .bandeau-promo { display: none; } }
    <% } %>
  </style>
  <% } %>
