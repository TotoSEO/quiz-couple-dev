<%
  // Le message ne parlait que de mesure d'audience. Depuis qu'un clic sur
  // « Accepter » accorde aussi les trois signaux publicitaires, il doit dire
  // que la publicité personnalisée en fait partie : un consentement que la
  // personne n'a pas pu comprendre ne vaut rien, ni juridiquement, ni pour
  // Google, qui redescend alors sur des annonces non personnalisées.
  const cookieTranslations = {
    fr: { message: 'Ce site utilise des cookies pour mesurer son audience et afficher des publicités personnalisées.', accept: 'Accepter', refuse: 'Refuser', privacy: 'Politique de confidentialité', privacyLink: '/confidentialite/' },
    en: { message: 'This site uses cookies to measure its audience and show personalised ads.', accept: 'Accept', refuse: 'Decline', privacy: 'Privacy policy', privacyLink: '/en/privacy-policy/' },
    es: { message: 'Este sitio utiliza cookies para medir su audiencia y mostrar anuncios personalizados.', accept: 'Aceptar', refuse: 'Rechazar', privacy: 'Política de privacidad', privacyLink: '/es/politica-privacidad/' },
    de: { message: 'Diese Website verwendet Cookies, um ihre Reichweite zu messen und personalisierte Werbung anzuzeigen.', accept: 'Akzeptieren', refuse: 'Ablehnen', privacy: 'Datenschutz', privacyLink: '/de/datenschutz/' },
    it: { message: 'Questo sito utilizza cookie per misurare il proprio pubblico e mostrare annunci personalizzati.', accept: 'Accetta', refuse: 'Rifiuta', privacy: 'Privacy', privacyLink: '/it/privacy/' },
  };
  const ct = cookieTranslations[lang] || cookieTranslations.fr;
%>
<div id="cookie-consent" role="dialog" aria-label="Cookie consent" class="cookie-banner hidden">
  <div class="cookie-card">
    <span class="cookie-emoji" aria-hidden="true">🍪</span>
    <p class="cookie-text">
      <%= ct.message %>
      <a href="<%= ct.privacyLink %>" class="cookie-link"><%= ct.privacy %></a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-refuse" class="cookie-refuse"><%= ct.refuse %></button>
      <button id="cookie-accept" class="cookie-accept"><%= ct.accept %></button>
    </div>
  </div>
</div>
