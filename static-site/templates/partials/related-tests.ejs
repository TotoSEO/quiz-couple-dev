<%
  const _relatedMap = {
    testCouple:       ['testCompatibilite', 'testCommonPoints', 'testCoupleSain', 'testConfiance'],
    testCommonPoints: ['testCompatibilite', 'testCouple', 'testMariage', 'testLangageAmour'],
    testCompatibilite:['testCouple', 'testCommonPoints', 'testCoupleSain', 'testMariage'],
    testDistance:     ['testCouple', 'testConfiance', 'testLangageAmour', 'testAttachement'],
    testToxic:        ['testPervers', 'testCoupleSain', 'testDivorce', 'testJalousie'],
    testPervers:      ['testToxic', 'testJalousie', 'testCoupleSain', 'testDivorce'],
    testCoupleSain:   ['testToxic', 'testCouple', 'testLangageAmour', 'testAmourHabitude'],
    testAmourHabitude:['testDivorce', 'testCoupleSain', 'testLangageAmour', 'testCouple'],
    testMariage:      ['testCouple', 'testCommonPoints', 'testParentalite', 'testEmmenager'],
    testDivorce:      ['testAmourHabitude', 'testToxic', 'testCoupleSain', 'testConfiance'],
    testParentalite:  ['testMariage', 'testEmmenager', 'testCoupleSain', 'testCommonPoints'],
    testEmmenager:    ['testMariage', 'testCommonPoints', 'testParentalite', 'testCoupleSain'],
    testAstroPrenoms: ['testCouple', 'testCommonPoints', 'testLangageAmour', 'testMariage'],
    testJalousie:     ['testConfiance', 'testToxic', 'testPervers', 'testCoupleSain'],
    testLangageAmour: ['testAttachement', 'testCouple', 'testAmourHabitude', 'testCoupleSain'],
    testAttachement:  ['testConfiance', 'testLangageAmour', 'testToxic', 'testJalousie'],
    testConfiance:    ['testJalousie', 'testPervers', 'testToxic', 'testCoupleSain'],
    quizAmoureux:     ['quizCoquin', 'quizMarrant', 'testLangageAmour', 'quizTuPreferes'],
    quizCoquin:       ['quizAmoureux', 'testLangageAmour', 'quizGenant', 'quizTuPreferes'],
    quizMarrant:      ['quizGenant', 'quizTuPreferes', 'quizMost', 'quizKnowledge'],
    quizKnowledge:    ['zamours', 'quizMost', 'quizMarrant', 'testCommonPoints'],
    quizMost:         ['quizKnowledge', 'zamours', 'quizMarrant', 'quizTuPreferes'],
    quizAdo:          ['quizAmoureux', 'quizMarrant', 'quizKnowledge', 'testCouple'],
    zamours:          ['quizKnowledge', 'testCommonPoints', 'quizMarrant', 'quizMost'],
    quizGenant:       ['quizMarrant', 'quizCoquin', 'quizTuPreferes', 'quizMost'],
    quizTuPreferes:   ['quizMarrant', 'quizGenant', 'quizMost', 'quizAmoureux'],
    quizVraiFaux:     ['quizKnowledge', 'quizMarrant', 'testCouple', 'quizMost'],
    quizTentation:    ['testAmourHabitude', 'testCouple', 'testJalousie', 'quizCoquin'],
  };

  const _relatedIcons = {
    testCouple: '💕', testCommonPoints: '🎯', testDistance: '🌍', testToxic: '⚠️',
    testCoupleSain: '💚', testMariage: '💒', testDivorce: '⚖️', testParentalite: '👶',
    testEmmenager: '🏠', testAstroPrenoms: '♈', testJalousie: '🫣', testLangageAmour: '💬',
    testAttachement: '🔗', testConfiance: '🤝', testCompatibilite: '💘', testPervers: '🎭', testAmourHabitude: '☕',
    quizAmoureux: '❤️', quizCoquin: '🔥', quizMarrant: '😂', quizKnowledge: '🧠',
    quizMost: '🏆', quizAdo: '🌟', quizGenant: '😳', quizTuPreferes: '🤔', quizVraiFaux: '✅',
    zamours: '📺', quizTentation: '🏝️',
  };

  const _relatedKeys = (_relatedMap[routeKey] || []).filter(function(k) {
    return getLocalizedUrl(k, lang);
  }).slice(0, 4);

  const _relatedLabel = lang === 'fr' ? 'Continuez l\'aventure' :
    lang === 'en' ? 'Keep exploring' :
    lang === 'es' ? 'Sigue explorando' :
    lang === 'de' ? 'Weiter entdecken' :
    'Continua a esplorare';

  const _relatedSub = lang === 'fr' ? 'Ces tests pourraient aussi vous plaire' :
    lang === 'en' ? 'You might also enjoy these tests' :
    lang === 'es' ? 'Estos tests también te pueden gustar' :
    lang === 'de' ? 'Diese Tests könnten Ihnen auch gefallen' :
    'Potrebbero piacerti anche questi test';

  const _articlesLabel = lang === 'fr' ? 'Pour aller plus loin' :
    lang === 'en' ? 'Go further' :
    lang === 'es' ? 'Para profundizar' :
    lang === 'de' ? 'Mehr erfahren' :
    'Per approfondire';

  const _articlesSub = lang === 'fr' ? 'Nos articles pour approfondir le sujet' :
    lang === 'en' ? 'Our articles to dig deeper' :
    lang === 'es' ? 'Nuestros artículos para profundizar' :
    lang === 'de' ? 'Unsere Artikel zum Vertiefen' :
    'I nostri articoli per approfondire';

  const _relatedArticles = (typeof relatedArticles !== 'undefined' && Array.isArray(relatedArticles)) ? relatedArticles : [];
%>
<% if (_relatedKeys.length > 0) { %>
<section class="related-tests-section">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="related-tests-header">
      <span class="related-tests-badge"><%= _relatedLabel %></span>
      <p class="related-tests-sub"><%= _relatedSub %></p>
    </div>
    <div class="related-tests-grid">
      <% for (const rk of _relatedKeys) {
        const rTitle = t('quizzes:' + rk + '.shortTitle', t('quizzes:' + rk + '.title', rk));
        const rDesc = t('quizzes:' + rk + '.description', '');
        const rUrl = getLocalizedUrl(rk, lang);
        const rIcon = _relatedIcons[rk] || '📝';
        if (!rUrl) continue;
      %>
      <a href="<%= rUrl %>" class="related-test-card no-underline group">
        <span class="related-test-icon"><%= rIcon %></span>
        <div class="related-test-content">
          <h3 class="related-test-title"><%= rTitle %></h3>
          <% if (rDesc) { %><p class="related-test-desc"><%= rDesc %></p><% } %>
        </div>
        <svg class="related-test-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
<% if (_relatedArticles.length > 0) { %>
<section class="related-articles-section animate-on-scroll">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="related-tests-header">
      <span class="related-tests-badge related-tests-badge--articles"><%= _articlesLabel %></span>
      <p class="related-tests-sub"><%= _articlesSub %></p>
    </div>
    <div class="related-articles-grid">
      <% for (const art of _relatedArticles) { if (!art.url) continue; %>
      <a href="<%= art.url %>" class="related-article-card no-underline group">
        <span class="related-article-icon" aria-hidden="true">📖</span>
        <span class="related-article-title"><%= art.title %></span>
        <svg class="related-test-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
