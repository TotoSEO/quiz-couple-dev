<%
  // Bloc « à faire ensuite » affiché en bas de page. Il double l'écran de
  // résultat du moteur, dont la table de suggestions vit dans
  // static-site/js/quiz-engine-core.js : les trois premières entrées sont les
  // mêmes des deux côtés, la quatrième ajoute une porte de sortie
  // supplémentaire ici où la place le permet.
  //
  // Les sept jeux étaient totalement absents de cette table : ni comme entrée,
  // ni comme suggestion. Ils étaient donc invisibles depuis les 42 pages, alors
  // que ce sont les pages les plus faciles à enchaîner.
  const _relatedMap = {
    // Tests à faire à deux, ambiance posée
    testCouple:       ['testCompatibilite', 'quizKnowledge', 'testCoupleSain', 'testCommonPoints'],
    testCommonPoints: ['jeuQuiDeNous', 'quizKnowledge', 'testCompatibilite', 'testCouple'],
    testCompatibilite:['testCouple', 'testCompatSexuelle', 'testMariage', 'testEmmenager'],
    testCoupleSain:   ['testConfiance', 'testCouple', 'testCompatibilite', 'testLangageAmour'],
    testDistance:     ['testDistanceAime', 'quizKnowledge', 'testCouple', 'testConfiance'],

    // Étapes de vie
    testMariage:      ['testEmmenager', 'testParentalite', 'testCompatibilite', 'testCouple'],
    testEmmenager:    ['testParentalite', 'testMariage', 'testCompatibilite', 'testChargeMentale'],
    testParentalite:  ['testEmmenager', 'testMariage', 'testCoupleSain', 'testCouple'],

    // Alerte, personne seule : on reste sur la question suivante
    testToxic:        ['testPervers', 'testEmprise', 'testDivorce', 'testCoupleSain'],
    testPervers:      ['testToxic', 'testEmprise', 'testJalousie', 'testDivorce'],
    testDivorce:      ['testFinCouple', 'testAmourHabitude', 'testToxic', 'testCoupleSain'],
    testFinCouple:    ['testAimeEncore', 'testCouche', 'testToxic', 'testDivorce'],
    testAmourHabitude:['testFinCouple', 'testSuisJeAmoureux', 'testDivorce', 'testCoupleSain'],
    compteurCouple:   ['calculatriceAmour', 'testAmourHabitude', 'testCoupleSain', 'testMariage'],

    // Doute et soupçon
    testInfidelite:   ['testCouche', 'testConfiance', 'testJalousie', 'quizTentation'],
    testCouche:       ['testInfidelite', 'testFinCouple', 'testConfiance', 'testToxic'],
    testJalousie:     ['testConfiance', 'testInfidelite', 'testToxic', 'testCouche'],
    testConfiance:    ['testJalousie', 'testDependance', 'testInfidelite', 'testAttachement'],
    testDependance:   ['testAttachement', 'testConfiance', 'testJalousie', 'testToxic'],

    // Introspection
    testSuisJeAmoureux: ['testAmourAmitie', 'testCrush', 'testSecret', 'testLangageAmour'],
    testAmourAmitie:  ['testSecret', 'testSuisJeAmoureux', 'testAmourAmi', 'testAmourHabitude'],
    testCrush:        ['testSecret', 'testSuisJeAmoureux', 'testAmourAmitie', 'testAmourAmi'],
    testAmourAmi:     ['testAmourAmitie', 'testSecret', 'testCrush', 'testSuisJeAmoureux'],
    testSecret:       ['testSuisJeAmoureux', 'testAmourAmitie', 'testLangageAmour', 'testAttachement'],
    testDistanceAime: ['testDistance', 'testAimeEncore', 'testFinCouple', 'testAttachement'],
    testAimeEncore:   ['testFinCouple', 'testAmourHabitude', 'testCouple', 'testSuisJeAmoureux'],
    testEmprise:      ['testToxic', 'testPervers', 'testDependance', 'testJalousie'],
    testEx:           ['testDependance', 'testAttachement', 'testSuisJeAmoureux', 'testToxic'],
    testChargeMentale:['testCoupleSain', 'testParentalite', 'testEmmenager', 'testCouple'],
    quizRencontre:    ['testAmourAmitie', 'questionsCouple', 'quizAmoureux', 'testSuisJeAmoureux'],
    testPersonnalite: ['testLangageAmour', 'testAttachement', 'testCouple', 'testCoupleSain'],
    quizTypeCouple:   ['testPersonnalite', 'testLangageAmour', 'testCouple', 'quizKnowledge'],
    testPretRelation: ['testTrouverAmour', 'testEx', 'testAttachement', 'testCoupleOuCelibat'],
    testDureeCelibat: ['testCelibataire', 'testTrouverAmour', 'testPretRelation', 'testCoupleOuCelibat'],
    testEstCeLeBon:   ['testCoupleSain', 'testJeLaimeEncore', 'testAmourHabitude', 'testFinCouple'],
    testCompatSexuelle: ['testCompatibilite', 'quizCoquin', 'jeuActionVeriteHot', 'testPurete'],
    testLangageAmour: ['testPersonnalite', 'testAttachement', 'testCouple', 'quizKnowledge'],
    testAttachement:  ['testPersonnalite', 'testDependance', 'testLangageAmour', 'testConfiance'],

    // Lecture symbolique
    testAmeSoeur:     ['testKarmique', 'testCouple', 'testCompatibilite', 'testSuisJeAmoureux'],
    testKarmique:     ['testAmeSoeur', 'testDateNaissance', 'testAttachement', 'testSuisJeAmoureux'],
    testDateNaissance:['testSignesChinois', 'testKarmique', 'testAstroPrenoms', 'testCouple'],
    testSignesChinois:['testDateNaissance', 'testAstroPrenoms', 'testCompatibilite', 'testCouple'],
    testAstroPrenoms: ['testDateNaissance', 'testKarmique', 'testCompatibilite', 'testCouple'],

    // Quiz légers
    quizAmoureux:     ['jeuDilemmes', 'quizTuPreferes', 'quizKnowledge', 'quizMarrant'],
    quizMarrant:      ['quizGenant', 'quizMost', 'quizMortFilmHorreur', 'quizTuPreferes'],
    quizGenant:       ['quizMarrant', 'jeuActionVerite', 'quizMost', 'quizTuPreferes'],
    quizKnowledge:    ['jeuQuiDeNous', 'zamours', 'testCommonPoints', 'quizMost'],
    quizMost:         ['jeuActionVerite', 'quizMarrant', 'quizTuPreferes', 'quizKnowledge'],
    quizVraiFaux:     ['quizKnowledge', 'zamours', 'quizMarrant', 'jeuDilemmes'],
    zamours:          ['quizKnowledge', 'jeuQuiDeNous', 'quizMost', 'testCommonPoints'],
    quizAdo:          ['quizMarrant', 'quizTuPreferes', 'testCouple', 'quizKnowledge'],

    // Le fil chaud : le quiz coquin ne proposait ni action ou vérité coquin
    // ni la roue des gages, c'était le trou le plus visible de la table.
    quizCoquin:       ['jeuActionVeriteHot', 'testCompatSexuelle', 'jeuGages', 'quizTentation'],
    jeuActionVeriteHot:['quizCoquin', 'testCompatSexuelle', 'jeuGages', 'jeuActionVerite'],
    quizTentation:    ['testInfidelite', 'quizCoquin', 'testConfiance', 'testJalousie'],

    // Jeux
    quizTuPreferes:   ['jeuDilemmes', 'pourContre', 'jeuActionVerite', 'quizMost'],
    jeuActionVerite:  ['jeuActionVeriteHot', 'jeuGages', 'jeuPlateau', 'quizTuPreferes'],
    jeuGages:         ['jeuActionVerite', 'jeuActionVeriteHot', 'jeuPlateau', 'quizMost'],
    jeuPlateau:       ['jeuActionVerite', 'jeuQuiDeNous', 'jeuDilemmes', 'quizKnowledge'],
    jeuQuiDeNous:     ['quizKnowledge', 'jeuDilemmes', 'pourContre', 'zamours'],
    jeuDilemmes:      ['pourContre', 'quizTuPreferes', 'jeuQuiDeNous', 'quizMost'],
    pourContre:       ['jeuDilemmes', 'quizTuPreferes', 'jeuQuiDeNous', 'testCommonPoints'],
    jeuJamais:        ['jeuActionVerite', 'quizGenant', 'quizCoquin', 'quizTuPreferes'],
    jeuQuiPourrait:   ['jeuQuiDeNous', 'jeuJamais', 'quizTuPreferes', 'quizMost'],
    jeuOuiNon:        ['jeuDilemmes', 'jeuDixMais', 'pourContre', 'jeuQuiDeNous'],
    jeuPhrases:       ['jeuQuiDeNous', 'jeuJamais', 'quizKnowledge', 'jeuQuiPourrait'],
    jeuDixMais:       ['jeuOuiNon', 'jeuDilemmes', 'jeuJamais', 'quizTuPreferes'],

    // Les quiz spéciaux d'Halloween (16 octobre 2026) : d'un quiz de saison à
    // l'autre, puis un jeu
    quizSerialKiller:    ['quizSuperVilain', 'quizMortFilmHorreur', 'quizPossession', 'quizTuPreferes'],
    quizMortFilmHorreur: ['quizPossession', 'quizSerialKiller', 'quizDuoVilains', 'jeuDilemmes'],
    quizPossession:      ['quizMortFilmHorreur', 'quizSerialKiller', 'quizSuperVilain', 'jeuJamais'],
    quizSuperVilain:     ['quizDuoVilains', 'quizSerialKiller', 'quizMortFilmHorreur', 'quizTuPreferes'],
    quizDuoVilains:      ['quizSuperVilain', 'quizPossession', 'quizMortFilmHorreur', 'jeuActionVerite'],
  };

  const _relatedIcons = {
    testCouple: '💕', testCommonPoints: '🎯', testDistance: '🌍', testToxic: '⚠️',
    testCoupleSain: '💚', testMariage: '💒', testDivorce: '⚖️', testParentalite: '👶',
    testEmmenager: '🏠', testAstroPrenoms: '♈', testDateNaissance: '📅', testSignesChinois: '🐉', testJalousie: '🫣', testLangageAmour: '💬',
    testAttachement: '🔗', testConfiance: '🤝', testCompatibilite: '💘', testPervers: '🎭', testAmourHabitude: '☕', testEstCeLeBon: '🔑', compteurCouple: '📆', testCompatSexuelle: '🔥',
    testAmeSoeur: '💫', testFinCouple: '🪢', testAmourAmitie: '🧭', testCrush: '💘', testAmourAmi: '🧡', testKarmique: '🔮', testInfidelite: '💔', testCouche: '🛏️', testSecret: '💌', testAimeEncore: '💞', testEmprise: '🔒', testDistanceAime: '📞', testEx: '🕰️', testChargeMentale: '🧠', quizRencontre: '💬', testSuisJeAmoureux: '💗',
    quizAmoureux: '❤️', quizCoquin: '🔥', quizMarrant: '😂', quizKnowledge: '🧠',
    quizMost: '🏆', quizAdo: '🌟', quizGenant: '😳', quizTuPreferes: '🤔', quizVraiFaux: '✅',
    zamours: '📺', quizTentation: '🏝️',
    jeuActionVerite: '🎲', jeuActionVeriteHot: '🌶️', jeuGages: '🎡',
    jeuPlateau: '🎲', jeuQuiDeNous: '👀', jeuDilemmes: '⚖️', pourContre: '👍', jeuJamais: '🙊', jeuQuiPourrait: '🏆', jeuOuiNon: '✅', jeuPhrases: '💬', jeuDixMais: '🔟',
    quizSerialKiller: '🔪', quizMortFilmHorreur: '🎬', quizPossession: '👻', quizSuperVilain: '🦹', quizDuoVilains: '🎭',
  };

  const _relatedKeys = (_relatedMap[routeKey] || []).filter(function(k) {
    return getLocalizedUrl(k, lang);
  }).slice(0, 4);

  // Famille de chaque page suggérée (FAMILLES_NAV, la liste du menu) : elle
  // donne la couleur de la carte, son étiquette et le verbe du bouton.
  // Les deux outils (calculatrice, compteur) sont rangés dans les tests mais
  // s'essaient plutôt qu'ils ne se font.
  const _familleDe = function (k) {
    if (k === 'calculatriceAmour' || k === 'compteurCouple') return 'outil';
    for (const f of ['tests', 'celib', 'quiz', 'jeux', 'speciaux']) {
      if (famillesNav && famillesNav[f] && famillesNav[f].indexOf(k) !== -1) return f;
    }
    return /^jeu/.test(k) || k === 'pourContre' ? 'jeux' : (/^quiz/.test(k) || k === 'zamours' ? 'quiz' : 'tests');
  };

  const _TXT = {
    fr: { pastille: 'À faire ensuite', titre: 'Continuez l\'aventure',
          sous: { tests: 'Ces tests pourraient aussi vous plaire', quiz: 'Ces quiz pourraient aussi vous plaire', jeux: 'Ces jeux pourraient aussi vous plaire', mix: 'D\'autres idées qui pourraient vous plaire' },
          famille: { tests: 'Test de couple', celib: 'Test célibataire', quiz: 'Quiz de couple', jeux: 'Jeu de couple', outil: 'Outil', speciaux: 'Quiz spécial' },
          essayer: 'Essayer',
          blogPastille: 'Le blog', blogTitre: 'Pour aller plus loin', blogSous: 'Nos articles pour approfondir le sujet',
          lire: 'Lire l\'article', minutes: '{n} min', lu: 'Lu {n} fois' },
    en: { pastille: 'Up next', titre: 'Keep exploring',
          sous: { tests: 'You might also enjoy these tests', quiz: 'You might also enjoy these quizzes', jeux: 'You might also enjoy these games', mix: 'More ideas you might enjoy' },
          famille: { tests: 'Couple test', celib: 'Singles test', quiz: 'Couple quiz', jeux: 'Couple game', outil: 'Tool', speciaux: 'Special quiz' },
          essayer: 'Try it',
          blogPastille: 'The blog', blogTitre: 'Go further', blogSous: 'Our articles to dig deeper',
          lire: 'Read the article', minutes: '{n} min', lu: 'Read {n} times' },
    es: { pastille: 'Lo siguiente', titre: 'Sigue explorando',
          sous: { tests: 'Estos tests también te pueden gustar', quiz: 'Estos quiz también te pueden gustar', jeux: 'Estos juegos también te pueden gustar', mix: 'Más ideas que te pueden gustar' },
          famille: { tests: 'Test de pareja', celib: 'Test para solteros', quiz: 'Quiz de pareja', jeux: 'Juego en pareja', outil: 'Herramienta', speciaux: 'Quiz especial' },
          essayer: 'Probar',
          blogPastille: 'El blog', blogTitre: 'Para profundizar', blogSous: 'Nuestros artículos para profundizar',
          lire: 'Leer el artículo', minutes: '{n} min', lu: 'Leído {n} veces' },
    de: { pastille: 'Als Nächstes', titre: 'Weiter entdecken',
          sous: { tests: 'Diese Tests könnten euch auch gefallen', quiz: 'Diese Quiz könnten euch auch gefallen', jeux: 'Diese Spiele könnten euch auch gefallen', mix: 'Weitere Ideen, die euch gefallen könnten' },
          famille: { tests: 'Beziehungstest', celib: 'Single-Test', quiz: 'Paar-Quiz', jeux: 'Paarspiel', outil: 'Tool', speciaux: 'Besonderes Quiz' },
          essayer: 'Ausprobieren',
          blogPastille: 'Der Blog', blogTitre: 'Mehr erfahren', blogSous: 'Unsere Artikel zum Vertiefen',
          lire: 'Artikel lesen', minutes: '{n} Min.', lu: '{n} Mal gelesen' },
    it: { pastille: 'Da fare dopo', titre: 'Continua a esplorare',
          sous: { tests: 'Potrebbero piacerti anche questi test', quiz: 'Potrebbero piacerti anche questi quiz', jeux: 'Potrebbero piacerti anche questi giochi', mix: 'Altre idee che potrebbero piacerti' },
          famille: { tests: 'Test di coppia', celib: 'Test per single', quiz: 'Quiz di coppia', jeux: 'Gioco di coppia', outil: 'Strumento', speciaux: 'Quiz speciale' },
          essayer: 'Prova',
          blogPastille: 'Il blog', blogTitre: 'Per approfondire', blogSous: 'I nostri articoli per approfondire',
          lire: 'Leggi l\'articolo', minutes: '{n} min', lu: 'Letto {n} volte' },
  };
  const _tx = _TXT[lang] || _TXT.fr;
  const _locale = { fr: 'fr-FR', en: 'en-US', es: 'es-ES', de: 'de-DE', it: 'it-IT' }[lang] || 'fr-FR';
  const _nombre = function (n) { try { return Number(n).toLocaleString(_locale); } catch (e) { return String(n); } };

  // Le sous-titre suit ce qui est proposé : « ces tests » sous une liste de
  // jeux était faux sur la moitié des pages.
  const _familles = _relatedKeys.map(_familleDe);
  const _groupe = function (f) { return f === 'celib' || f === 'outil' ? 'tests' : (f === 'speciaux' ? 'quiz' : f); };
  const _sousTitre = _familles.length && _familles.every(function (f) { return _groupe(f) === _groupe(_familles[0]); })
    ? _tx.sous[_groupe(_familles[0])] : _tx.sous.mix;

  // Largeurs des images relevées dans Chromium : quatre colonnes de 263 px
  // dans le conteneur de 1152 px, quatre colonnes fluides de 1024 à 1183 px,
  // deux colonnes au-dessous ; sur téléphone, deux cartes de tests par
  // rangée et une carte d'article à 78 % de la bande qui défile.
  const _taillesTest = '(min-width: 1184px) 263px, (min-width: 1024px) calc((100vw - 100px) / 4), (min-width: 640px) calc((100vw - 56px) / 2), calc((100vw - 48px) / 2)';
  const _taillesArticle = '(min-width: 1184px) 263px, (min-width: 1024px) calc((100vw - 100px) / 4), (min-width: 640px) calc((100vw - 56px) / 2), calc(78vw - 27px)';

  const _relatedArticles = (typeof relatedArticles !== 'undefined' && Array.isArray(relatedArticles)) ? relatedArticles : [];
  const _seuilLu = typeof seuilLectures === 'number' ? seuilLectures : 10;
%>
<% if (_relatedKeys.length > 0) { %>
<section class="related-tests-section suite-section" aria-labelledby="suite-titre">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="bloc-entete suite-entete">
      <span class="bloc-pastille"><%= _tx.pastille %></span>
      <h2 class="bloc-titre" id="suite-titre"><%= _tx.titre %></h2>
      <span class="bloc-trait" aria-hidden="true"></span>
      <p class="bloc-sous-titre"><%= _sousTitre %></p>
    </div>
    <div class="suite-grille">
      <% _relatedKeys.forEach(function (rk, i) {
        const rUrl = getLocalizedUrl(rk, lang);
        if (!rUrl) return;
        const fam = _familles[i];
        const rTitle = t('common:nav.' + rk, t('quizzes:' + rk + '.shortTitle', t('quizzes:' + rk + '.title', rk)));
        const rDesc = t('home:quizGrid.cards.' + rk, t('quizzes:' + rk + '.description', ''));
        const rIcon = _relatedIcons[rk] || '💞';
        const _f = quizFeatured && quizFeatured[rk];
        const rImg = _f ? '/quiz/featured/' + _f.file + '.webp' : null;
        const rSrcset = rImg ? srcsetImage(rImg) : null;
        const rCta = fam === 'outil' ? _tx.essayer
          : fam === 'jeux' ? t('common:buttons.startGame', 'Jouer')
          : fam === 'quiz' ? t('common:buttons.startQuiz', 'Faire le quiz')
          : t('common:buttons.startTest', 'Faire le test');
      %>
      <a href="<%= rUrl %>" class="suite-carte suite-carte--<%= fam === 'outil' ? 'tests' : fam %>">
        <span class="suite-media">
          <% if (rImg) { %>
          <img src="<%= rImg %>"<% if (rSrcset) { %> srcset="<%= rSrcset %>" sizes="<%= _taillesTest %>"<% } %> alt="" loading="lazy" decoding="async" width="1200" height="630">
          <% } %>
          <span class="suite-emoji" aria-hidden="true"><%= rIcon %></span>
        </span>
        <span class="suite-corps">
          <span class="suite-famille"><%= _tx.famille[fam] || _tx.famille.tests %></span>
          <h3 class="suite-nom"><%= rTitle %></h3>
          <% if (rDesc) { %><span class="suite-desc"><%= rDesc %></span><% } %>
          <span class="suite-cta"><%= rCta %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
        </span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
<% if (_relatedArticles.length > 0) { %>
<section class="related-articles-section lire-section" aria-labelledby="lire-titre">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="bloc-entete lire-entete">
      <span class="bloc-pastille"><%= _tx.blogPastille %></span>
      <h2 class="bloc-titre" id="lire-titre"><%= _tx.blogTitre %></h2>
      <span class="bloc-trait" aria-hidden="true"></span>
      <p class="bloc-sous-titre"><%= _tx.blogSous %></p>
    </div>
    <div class="lire-grille">
      <% for (const art of _relatedArticles) { if (!art.url) continue; %>
      <a href="<%= art.url %>" class="lire-carte">
        <span class="lire-media">
          <% if (art.image) { %>
          <img src="<%= art.image %>"<% if (art.imageSrcset) { %> srcset="<%= art.imageSrcset %>" sizes="<%= _taillesArticle %>"<% } %> alt="" loading="lazy" decoding="async" width="1200" height="675">
          <% } %>
        </span>
        <span class="lire-corps">
          <h3 class="lire-titre"><%= art.title %></h3>
          <span class="lire-meta">
            <% if (art.minutes) { %>
            <span class="lire-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><%= _tx.minutes.replace('{n}', art.minutes) %></span>
            <% } %>
            <% if (art.lectures !== null && art.lectures !== undefined && art.lectures >= _seuilLu) { %>
            <span class="lire-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><%= _tx.lu.replace('{n}', _nombre(art.lectures)) %></span>
            <% } %>
          </span>
          <span class="lire-bouton"><%= _tx.lire %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
        </span>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
