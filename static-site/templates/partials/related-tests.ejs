<%
  // Bloc « à faire ensuite » affiché en bas de page. Il double l'écran de
  // résultat du moteur, dont la table de suggestions vit dans
  // static-site/js/quiz-engine-core.js : les trois premières entrées sont les
  // mêmes des deux côtés, la quatrième ajoute une porte de sortie
  // supplémentaire ici où la place le permet.
  //
  // Les sept jeux étaient totalement absents de cette table : ni comme entrée,
  // ni comme suggestion. Ils étaient donc invisibles depuis les 42 pages, alors
  // que ce sont les pages les plus faciles à enchaîner.
  const _relatedMap = {
    // Tests à faire à deux, ambiance posée
    testCouple:       ['testCompatibilite', 'quizKnowledge', 'testCoupleSain', 'testCommonPoints'],
    testCommonPoints: ['jeuQuiDeNous', 'quizKnowledge', 'testCompatibilite', 'testCouple'],
    testCompatibilite:['testCouple', 'testMariage', 'testEmmenager', 'testCommonPoints'],
    testCoupleSain:   ['testConfiance', 'testCouple', 'testCompatibilite', 'testLangageAmour'],
    testDistance:     ['testDistanceAime', 'quizKnowledge', 'testCouple', 'testConfiance'],

    // Étapes de vie
    testMariage:      ['testEmmenager', 'testParentalite', 'testCompatibilite', 'testCouple'],
    testEmmenager:    ['testParentalite', 'testMariage', 'testCompatibilite', 'testCommonPoints'],
    testParentalite:  ['testEmmenager', 'testMariage', 'testCoupleSain', 'testCouple'],

    // Alerte, personne seule : on reste sur la question suivante
    testToxic:        ['testPervers', 'testDivorce', 'testCoupleSain', 'testJalousie'],
    testPervers:      ['testToxic', 'testJalousie', 'testDivorce', 'testConfiance'],
    testDivorce:      ['testAmourHabitude', 'testToxic', 'testCoupleSain', 'testConfiance'],
    testAmourHabitude:['testSuisJeAmoureux', 'testDivorce', 'testCoupleSain', 'testLangageAmour'],

    // Doute et soupçon
    testInfidelite:   ['testCouche', 'testConfiance', 'testJalousie', 'quizTentation'],
    testCouche:       ['testInfidelite', 'testConfiance', 'testToxic', 'testJalousie'],
    testJalousie:     ['testConfiance', 'testInfidelite', 'testToxic', 'testCouche'],
    testConfiance:    ['testJalousie', 'testCoupleSain', 'testInfidelite', 'testAttachement'],

    // Introspection
    testSuisJeAmoureux: ['testSecret', 'testAttachement', 'testLangageAmour', 'testAmourHabitude'],
    testSecret:       ['testSuisJeAmoureux', 'testLangageAmour', 'testAttachement', 'testCompatibilite'],
    testDistanceAime: ['testDistance', 'testSecret', 'testAttachement', 'testConfiance'],
    testLangageAmour: ['testAttachement', 'testCouple', 'quizKnowledge', 'testCoupleSain'],
    testAttachement:  ['testLangageAmour', 'testConfiance', 'testSuisJeAmoureux', 'testKarmique'],

    // Lecture symbolique
    testKarmique:     ['testDateNaissance', 'testAstroPrenoms', 'testAttachement', 'testSuisJeAmoureux'],
    testDateNaissance:['testKarmique', 'testAstroPrenoms', 'testCompatibilite', 'testCouple'],
    testAstroPrenoms: ['testDateNaissance', 'testKarmique', 'testCompatibilite', 'testCouple'],

    // Quiz légers
    quizAmoureux:     ['jeuDilemmes', 'quizTuPreferes', 'quizKnowledge', 'quizMarrant'],
    quizMarrant:      ['quizGenant', 'quizMost', 'jeuActionVerite', 'quizTuPreferes'],
    quizGenant:       ['quizMarrant', 'jeuActionVerite', 'quizMost', 'quizTuPreferes'],
    quizKnowledge:    ['jeuQuiDeNous', 'zamours', 'testCommonPoints', 'quizMost'],
    quizMost:         ['jeuActionVerite', 'quizMarrant', 'quizTuPreferes', 'quizKnowledge'],
    quizVraiFaux:     ['quizKnowledge', 'zamours', 'quizMarrant', 'jeuDilemmes'],
    zamours:          ['quizKnowledge', 'jeuQuiDeNous', 'quizMost', 'testCommonPoints'],
    quizAdo:          ['quizMarrant', 'quizTuPreferes', 'testCouple', 'quizKnowledge'],

    // Le fil chaud : le quiz coquin ne proposait ni action ou vérité coquin
    // ni la roue des gages, c'était le trou le plus visible de la table.
    quizCoquin:       ['jeuActionVeriteHot', 'jeuGages', 'quizTentation', 'quizGenant'],
    jeuActionVeriteHot:['quizCoquin', 'jeuGages', 'quizTentation', 'jeuActionVerite'],
    quizTentation:    ['testInfidelite', 'quizCoquin', 'testConfiance', 'testJalousie'],

    // Jeux
    quizTuPreferes:   ['jeuDilemmes', 'pourContre', 'jeuActionVerite', 'quizMost'],
    jeuActionVerite:  ['jeuActionVeriteHot', 'jeuGages', 'jeuPlateau', 'quizTuPreferes'],
    jeuGages:         ['jeuActionVerite', 'jeuActionVeriteHot', 'jeuPlateau', 'quizMost'],
    jeuPlateau:       ['jeuActionVerite', 'jeuQuiDeNous', 'jeuDilemmes', 'quizKnowledge'],
    jeuQuiDeNous:     ['quizKnowledge', 'jeuDilemmes', 'pourContre', 'zamours'],
    jeuDilemmes:      ['pourContre', 'quizTuPreferes', 'jeuQuiDeNous', 'quizMost'],
    pourContre:       ['jeuDilemmes', 'quizTuPreferes', 'jeuQuiDeNous', 'testCommonPoints'],
  };

  const _relatedIcons = {
    testCouple: '💕', testCommonPoints: '🎯', testDistance: '🌍', testToxic: '⚠️',
    testCoupleSain: '💚', testMariage: '💒', testDivorce: '⚖️', testParentalite: '👶',
    testEmmenager: '🏠', testAstroPrenoms: '♈', testDateNaissance: '📅', testJalousie: '🫣', testLangageAmour: '💬',
    testAttachement: '🔗', testConfiance: '🤝', testCompatibilite: '💘', testPervers: '🎭', testAmourHabitude: '☕',
    testKarmique: '🔮', testInfidelite: '💔', testCouche: '🛏️', testSecret: '💌', testDistanceAime: '📞', testSuisJeAmoureux: '💗',
    quizAmoureux: '❤️', quizCoquin: '🔥', quizMarrant: '😂', quizKnowledge: '🧠',
    quizMost: '🏆', quizAdo: '🌟', quizGenant: '😳', quizTuPreferes: '🤔', quizVraiFaux: '✅',
    zamours: '📺', quizTentation: '🏝️',
    jeuActionVerite: '🎲', jeuActionVeriteHot: '🌶️', jeuGages: '🎡',
    jeuPlateau: '🎲', jeuQuiDeNous: '👀', jeuDilemmes: '⚖️', pourContre: '👍',
  };

  const _relatedKeys = (_relatedMap[routeKey] || []).filter(function(k) {
    return getLocalizedUrl(k, lang);
  }).slice(0, 4);

  const _relatedLabel = lang === 'fr' ? 'Continuez l\'aventure' :
    lang === 'en' ? 'Keep exploring' :
    lang === 'es' ? 'Sigue explorando' :
    lang === 'de' ? 'Weiter entdecken' :
    'Continua a esplorare';

  const _relatedSub = lang === 'fr' ? 'Ces tests pourraient aussi vous plaire' :
    lang === 'en' ? 'You might also enjoy these tests' :
    lang === 'es' ? 'Estos tests también te pueden gustar' :
    lang === 'de' ? 'Diese Tests könnten Ihnen auch gefallen' :
    'Potrebbero piacerti anche questi test';

  const _articlesLabel = lang === 'fr' ? 'Pour aller plus loin' :
    lang === 'en' ? 'Go further' :
    lang === 'es' ? 'Para profundizar' :
    lang === 'de' ? 'Mehr erfahren' :
    'Per approfondire';

  const _articlesSub = lang === 'fr' ? 'Nos articles pour approfondir le sujet' :
    lang === 'en' ? 'Our articles to dig deeper' :
    lang === 'es' ? 'Nuestros artículos para profundizar' :
    lang === 'de' ? 'Unsere Artikel zum Vertiefen' :
    'I nostri articoli per approfondire';

  const _relatedArticles = (typeof relatedArticles !== 'undefined' && Array.isArray(relatedArticles)) ? relatedArticles : [];
%>
<% if (_relatedKeys.length > 0) { %>
<section class="related-tests-section">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="related-tests-header">
      <span class="related-tests-badge"><%= _relatedLabel %></span>
      <p class="related-tests-sub"><%= _relatedSub %></p>
    </div>
    <div class="related-tests-grid">
      <% for (const rk of _relatedKeys) {
        const rTitle = t('quizzes:' + rk + '.shortTitle', t('quizzes:' + rk + '.title', rk));
        const rDesc = t('quizzes:' + rk + '.description', '');
        const rUrl = getLocalizedUrl(rk, lang);
        const rIcon = _relatedIcons[rk] || '📝';
        if (!rUrl) continue;
      %>
      <a href="<%= rUrl %>" class="related-test-card no-underline group">
        <span class="related-test-icon"><%= rIcon %></span>
        <div class="related-test-content">
          <h3 class="related-test-title"><%= rTitle %></h3>
          <% if (rDesc) { %><p class="related-test-desc"><%= rDesc %></p><% } %>
        </div>
        <svg class="related-test-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
<% if (_relatedArticles.length > 0) { %>
<section class="related-articles-section animate-on-scroll">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="related-tests-header">
      <span class="related-tests-badge related-tests-badge--articles"><%= _articlesLabel %></span>
      <p class="related-tests-sub"><%= _articlesSub %></p>
    </div>
    <div class="related-articles-grid">
      <% for (const art of _relatedArticles) { if (!art.url) continue; %>
      <a href="<%= art.url %>" class="related-article-card no-underline group">
        <span class="related-article-icon" aria-hidden="true">📖</span>
        <span class="related-article-title"><%= art.title %></span>
        <svg class="related-test-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
