<%
  // Le pied de page reprend l'integralite des tests et des quiz : chaque page
  // doit etre atteignable depuis n'importe quelle autre.
  const footerTestLinks = [
    { routeKey: 'testCouple', labelKey: 'nav.testCouple' },
    { routeKey: 'testCommonPoints', labelKey: 'nav.testCommonPoints' },
    { routeKey: 'testCompatibilite', labelKey: 'nav.testCompatibilite' },
    { routeKey: 'testSuisJeAmoureux', labelKey: 'nav.testSuisJeAmoureux' },
    { routeKey: 'testDistance', labelKey: 'nav.testDistance' },
    { routeKey: 'testAmourAmitie', labelKey: 'nav.testAmourAmitie' },
    { routeKey: 'testCrush', labelKey: 'nav.testCrush' },
    { routeKey: 'testFinCouple', labelKey: 'nav.testFinCouple' },
    { routeKey: 'testToxic', labelKey: 'nav.testToxic' },
    { routeKey: 'testPervers', labelKey: 'nav.testPervers' },
    { routeKey: 'testAmourHabitude', labelKey: 'nav.testAmourHabitude' },
    { routeKey: 'testCoupleSain', labelKey: 'nav.testCoupleSain' },
    { routeKey: 'testMariage', labelKey: 'nav.testMariage' },
    { routeKey: 'testDivorce', labelKey: 'nav.testDivorce' },
    { routeKey: 'testParentalite', labelKey: 'nav.testParentalite' },
    { routeKey: 'testEmmenager', labelKey: 'nav.testEmmenager' },
    { routeKey: 'testAstroPrenoms', labelKey: 'nav.testAstroPrenoms' },
    { routeKey: 'testDateNaissance', labelKey: 'nav.testDateNaissance' },
    { routeKey: 'testAmeSoeur', labelKey: 'nav.testAmeSoeur' },
    { routeKey: 'testKarmique', labelKey: 'nav.testKarmique' },
    { routeKey: 'testJalousie', labelKey: 'nav.testJalousie' },
    { routeKey: 'testInfidelite', labelKey: 'nav.testInfidelite' },
    { routeKey: 'testCouche', labelKey: 'nav.testCouche' },
    { routeKey: 'testSecret', labelKey: 'nav.testSecret' },
    { routeKey: 'testDistanceAime', labelKey: 'nav.testDistanceAime' },
    { routeKey: 'testEx', labelKey: 'nav.testEx' },
    { routeKey: 'testChargeMentale', labelKey: 'nav.testChargeMentale' },
    { routeKey: 'testLangageAmour', labelKey: 'nav.testLangageAmour' },
    { routeKey: 'testPersonnalite', labelKey: 'nav.testPersonnalite' },
    { routeKey: 'testAttachement', labelKey: 'nav.testAttachement' },
    { routeKey: 'testConfiance', labelKey: 'nav.testConfiance' },
    { routeKey: 'testDependance', labelKey: 'nav.testDependance' },
  ];
  const footerQuizLinks = [
    { routeKey: 'quizAmoureux', labelKey: 'nav.quizAmoureux' },
    { routeKey: 'quizRencontre', labelKey: 'nav.quizRencontre' },
    { routeKey: 'quizCoquin', labelKey: 'nav.quizCoquin' },
    { routeKey: 'quizMarrant', labelKey: 'nav.quizMarrant' },
    { routeKey: 'quizGenant', labelKey: 'nav.quizGenant' },
    { routeKey: 'quizKnowledge', labelKey: 'nav.quizKnowledge' },
    { routeKey: 'quizMost', labelKey: 'nav.quizMost' },
    { routeKey: 'quizAdo', labelKey: 'nav.quizAdo' },
    { routeKey: 'quizVraiFaux', labelKey: 'nav.quizVraiFaux' },
    { routeKey: 'zamours', labelKey: 'nav.zamours' },
    { routeKey: 'quizTentation', labelKey: 'nav.quizTentation' },
    { routeKey: 'questionsCouple', labelKey: 'nav.questionsCouple' },
  ];
  const footerJeuxLinks = [
    { routeKey: 'jeuxCouple', labelKey: 'nav.jeuxCouple' },
    { routeKey: 'quizTuPreferes', labelKey: 'nav.quizTuPreferes' },
    { routeKey: 'jeuActionVerite', labelKey: 'nav.jeuActionVerite' },
    { routeKey: 'jeuActionVeriteHot', labelKey: 'nav.jeuActionVeriteHot' },
    { routeKey: 'jeuGages', labelKey: 'nav.jeuGages' },
    { routeKey: 'jeuPlateau', labelKey: 'nav.jeuPlateau' },
    { routeKey: 'jeuQuiDeNous', labelKey: 'nav.jeuQuiDeNous' },
    { routeKey: 'jeuDilemmes', labelKey: 'nav.jeuDilemmes' },
    { routeKey: 'jeuJamais', labelKey: 'nav.jeuJamais' },
    { routeKey: 'jeuQuiPourrait', labelKey: 'nav.jeuQuiPourrait' },
    { routeKey: 'jeuOuiNon', labelKey: 'nav.jeuOuiNon' },
    { routeKey: 'pourContre', labelKey: 'nav.pourContre' },
  ];
  const footerLegalLinks = [
    { routeKey: 'about', labelKey: 'footer.about' },
    { routeKey: 'legalMentions', labelKey: 'footer.legalMentions' },
    { routeKey: 'privacy', labelKey: 'footer.privacy' },
    { routeKey: 'blog', label: 'Blog' },
    { routeKey: 'activities', labelKey: 'nav.activities' },
    { routeKey: 'contact', labelKey: 'nav.contact' },
    { routeKey: 'sitemap', labelKey: 'footer.sitemap' },
  ];
  const homeUrl = getLocalizedUrl('home', lang);
  const currentYear = new Date().getFullYear();

  // Filter out links not available in current language
  const _filterAvail = (links) => links.filter(l => getLocalizedUrl(l.routeKey, lang));
  const footerTestLinksFiltered = _filterAvail(footerTestLinks);
  const footerQuizLinksFiltered = _filterAvail(footerQuizLinks);
  const footerJeuxLinksFiltered = _filterAvail(footerJeuxLinks);
%>
<footer class="border-t border-border bg-muted/30">
  <div class="container mx-auto px-6 sm:px-8 py-12">

    <!-- Sources préférées Google.
         Le lien profond documenté par Google (preferences/source?q=domaine)
         ouvre son outil avec le site déjà rempli : un clic suffit. On passe
         par ce lien plutôt que par le script officiel news.google.com, qui
         chargerait un tiers sur toutes les pages alors que le site ne pose
         rien sans consentement. La fonctionnalité travaille au domaine, pas
         au répertoire : la même URL vaut pour les cinq langues. -->
    <div class="gsource">
      <a class="gsource-btn" href="https://www.google.com/preferences/source?q=quiz-couple.com"
         target="_blank" rel="noopener" data-emplacement="pied"
         aria-label="<%= t('common:footer.sourcePrefAria', 'Ajouter Quiz Couple aux sources préférées de Google') %>">
        <span class="gsource-g" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="26" height="26" focusable="false">
            <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
            <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
            <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
            <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
          </svg>
        </span>
        <span class="gsource-txt"><%= t('common:footer.sourcePrefTitre', 'Ajouter Quiz Couple à mes sources préférées') %></span>
      </a>
      <p class="gsource-sous"><%= t('common:footer.sourcePrefSous', '') %></p>
    </div>

    <div class="grid gap-10 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="<%= homeUrl %>" class="flex items-center gap-2 text-xl font-bold no-underline">
          <picture>
            <source srcset="/assets/logo-quiz-couple.webp" type="image/webp">
            <img src="/assets/logo-quiz-couple.png" alt="Quiz Couple" class="h-10 w-auto" width="40" height="40" loading="lazy">
          </picture>
          Quiz Couple
        </a>
        <p class="text-sm text-muted-foreground max-w-xs"><%= t('common:footer.brandDescription', 'Des quiz gratuits pour mieux se connaître et renforcer votre couple.') %></p>
      </div>

      <!-- Tests -->
      <div>
        <span class="block mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"><%= t('common:nav.categoryTests', 'Tests') %></span>
        <div class="flex flex-col gap-2">
          <% for (const link of footerTestLinksFiltered) { %>
          <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="text-sm text-muted-foreground transition-colors hover:text-primary no-underline"><%= t('common:' + link.labelKey, link.labelKey) %></a>
          <% } %>
        </div>
      </div>

      <!-- Quiz -->
      <div>
        <span class="block mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"><%= t('common:nav.categoryQuizzes', 'Quiz') %></span>
        <div class="flex flex-col gap-2">
          <% for (const link of footerQuizLinksFiltered) { %>
          <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="text-sm text-muted-foreground transition-colors hover:text-primary no-underline"><%= t('common:' + link.labelKey, link.labelKey) %></a>
          <% } %>
        </div>
      </div>

      <!-- Jeux -->
      <div>
        <span class="block mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"><%= t('common:nav.categoryJeux', 'Jeux') %></span>
        <div class="flex flex-col gap-2">
          <% for (const link of footerJeuxLinksFiltered) { %>
          <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="text-sm text-muted-foreground transition-colors hover:text-primary no-underline"><%= t('common:' + link.labelKey, link.labelKey) %></a>
          <% } %>
        </div>
      </div>

      <!-- Legal / Info -->
      <div>
        <span class="block mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"><%= t('common:footer.information', 'Information') %></span>
        <div class="flex flex-col gap-2">
          <% for (const link of footerLegalLinks) { %>
          <a href="<%= getLocalizedUrl(link.routeKey, lang) %>" class="text-sm text-muted-foreground transition-colors hover:text-primary no-underline"><%= link.label || t('common:' + link.labelKey, link.labelKey) %></a>
          <% } %>
          <%# Revenir sur son choix est une obligation, et ce lien est le seul
              chemin pour le faire une fois la banniere fermee. Il reste
              masque tant que la plateforme de consentement n'a pas repondu,
              c'est consentement.js qui le devoile : un lien qui n'ouvre rien
              vaut moins que pas de lien du tout. %>
          <button type="button" data-cmp-ouvrir hidden class="text-left text-sm text-muted-foreground transition-colors hover:text-primary bg-transparent border-0 p-0 cursor-pointer"><%= t('common:footer.cookiePrefs', 'Gérer mes cookies') %></button>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 border-t border-border pt-8">
      <p class="text-center text-sm text-muted-foreground">
        &copy; <%= currentYear %> Quiz Couple. <%= t('common:footer.copyright', 'Tous droits réservés. Fait avec') %>
        <svg class="inline-block h-4 w-4 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        <%= t('common:footer.inFrance', 'en France') %>.
      </p>
    </div>
  </div>
</footer>
