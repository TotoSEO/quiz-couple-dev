<%
// Encart partenaire affilie, reserve aux pages au contenu adulte et a la seule
// langue du partenaire. Pilote par PARTENAIRE_ADULTE dans build/config.js :
// passer « actif » a false le retire de tout le site sans autre modification.
const pa = typeof partenaireAdulte !== 'undefined' ? partenaireAdulte : null;
if (pa && pa.actif && pa.routes.includes(routeKey) && pa.langues.includes(lang)) {
%>
<section class="py-12">
  <div class="container mx-auto px-4">
    <div class="partenaire-adulte">
      <span class="partenaire-adulte-mention"><%= pa.textes[lang].mention %></span>
      <h2 class="partenaire-adulte-titre"><%= pa.textes[lang].titre %></h2>
      <p class="partenaire-adulte-texte"><%= pa.textes[lang].texte %></p>
      <a class="btn btn-cta btn-gradient" href="<%= pa.url %>"
         target="_blank" rel="sponsored nofollow noopener"><%= pa.textes[lang].bouton %></a>
    </div>
  </div>
</section>
<% } %>
