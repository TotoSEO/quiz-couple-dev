<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="<%= supabaseUrl %>">
  <title><%= rawTitle %></title>
  <meta name="description" content="<%= rawDescription %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="<%= noindex %>">
  <% } %><link rel="canonical" href="<%= canonical %>">
  <% for (const alt of alternates) { %>
  <link rel="alternate" hreflang="<%= alt.hreflang %>" href="<%= alt.href %>">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
  <meta property="og:site_name" content="Quiz Couple">
  <meta property="og:title" content="<%= rawTitle %>">
  <meta property="og:description" content="<%= rawDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:locale" content="<%= locale %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <% if (typeof ogType !== 'undefined' && ogType === 'article') { %>
  <meta property="article:published_time" content="<%= typeof articlePublishedTime !== 'undefined' ? articlePublishedTime : '' %>">
  <meta property="article:modified_time" content="<%= typeof articleModifiedTime !== 'undefined' ? articleModifiedTime : '' %>">
  <meta property="article:author" content="<%= typeof articleAuthor !== 'undefined' ? articleAuthor : '' %>">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= rawTitle %>">
  <meta name="twitter:description" content="<%= rawDescription %>">
  <meta name="twitter:url" content="<%= canonical %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Theme initialization (inline to prevent flash) -->
  <script>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='dark'){document.documentElement.classList.add('dark')}
      else if(t==='light'){document.documentElement.classList.remove('dark')}
      else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches){document.documentElement.classList.add('dark')}
    })();
  </script>

  <!-- Critical CSS (inlined for fast FCP) -->
  <style>
    :root{--background:280 30% 98%;--foreground:280 60% 10%;--card:280 25% 96%;--primary:338 72% 62%;--primary-foreground:0 0% 100%;--muted:280 20% 92%;--muted-foreground:280 15% 45%;--border:280 20% 88%;--radius:0.875rem}
    .dark{--background:270 50% 4%;--foreground:280 20% 95%;--card:270 45% 8%;--primary:340 65% 65%;--muted:270 30% 15%;--muted-foreground:270 15% 60%;--border:270 30% 18%}
    *,::after,::before{box-sizing:border-box;margin:0;padding:0;border:0 solid}
    body{font-family:Inter,system-ui,-apple-system,sans-serif;background-color:hsl(var(--background));color:hsl(var(--foreground));-webkit-font-smoothing:antialiased;line-height:1.5}
    .container{width:100%;max-width:80rem;margin:0 auto;padding:0 1rem}
    .text-foreground{color:hsl(var(--foreground))}.bg-background{background-color:hsl(var(--background))}
    .font-bold{font-weight:700}.text-center{text-align:center}
    .mb-4{margin-bottom:1rem}.mb-6{margin-bottom:1.5rem}.py-16{padding-top:4rem;padding-bottom:4rem}
    .mx-auto{margin-left:auto;margin-right:auto}.px-4{padding-left:1rem;padding-right:1rem}
    .text-3xl{font-size:1.875rem;line-height:2.25rem}.text-lg{font-size:1.125rem;line-height:1.75rem}
    .relative{position:relative}.overflow-hidden{overflow:hidden}
    .hidden{display:none}.flex{display:flex}.grid{display:grid}.block{display:block}.inline-flex{display:inline-flex}
    .items-center{align-items:center}.justify-between{justify-content:space-between}.justify-center{justify-content:center}
    .gap-2{gap:.5rem}.gap-4{gap:1rem}
    header{background-color:hsl(var(--background)/0.8);backdrop-filter:blur(12px);border-bottom:1px solid hsl(var(--border));position:sticky;top:0;z-index:50}
  </style>

  <!-- Fonts (non-blocking, reduced weights) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap"></noscript>

  <!-- Preload hero image for LCP (home page) -->
  <% if (typeof routeKey !== 'undefined' && routeKey === 'home') { %>
  <link rel="preload" href="/assets/quiz-couple-hero.webp" as="image" type="image/webp">
  <% } %>

  <!-- Full CSS -->
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Google Analytics with Consent Mode v2 -->
  <script>
    window.dataLayer=window.dataLayer||[];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});
    if(localStorage.getItem('cookie-consent')==='accepted'){gtag('consent','update',{analytics_storage:'granted'});}
  </script>

  <%- typeof jsonLdHtml !== 'undefined' && jsonLdHtml ? jsonLdHtml : '' %>
</head>
<body class="bg-background text-foreground font-sans antialiased">
  <%- include('partials/header', { lang, t, getLocalizedUrl, routeSlugs: routeSlugs }) %>

  <main class="relative z-0">
    <%- content %>
  </main>

  <%- include('partials/footer', { lang, t, getLocalizedUrl }) %>
  <%- include('partials/cookie-consent', { lang }) %>

  <!-- JS -->
  <script src="/js/theme.js" defer></script>
  <script src="/js/mobile-menu.js" defer></script>
  <script src="/js/cookie-consent.js" defer></script>
  <script src="/js/obl.js" defer></script>

  <!-- GA (deferred) -->
  <script>
    window.addEventListener('load',function(){
      var s=document.createElement('script');
      s.src='https://www.googletagmanager.com/gtag/js?id=<%= gaId %>';
      s.async=true;
      document.head.appendChild(s);
      s.onload=function(){
        gtag('js',new Date());
        gtag('config','<%= gaId %>',{send_page_view:true});
      };
    });
  </script>
</body>
</html>
