<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <%# ── Plateforme de consentement (InMobi Choice, via The Moneytizer) ──────
      Elle vient en premier, avant tout le reste : le talon __tcfapi qu'elle
      installe doit exister quand les scripts publicitaires arrivent sur la
      page. Un partenaire qui ne trouve pas cette interface considere qu'il
      n'a pas le consentement et n'enchérit pas, ou enchérit en non
      personnalisé, ce qui vaut plusieurs fois moins cher.
      La connexion au domaine est ouverte d'avance : le fichier est chargé en
      async, mais la poignee de main TLS coute une centaine de millisecondes
      qu'on gagne ici, et c'est du temps en moins avant l'affichage de la
      banniere.
      Le script est repris tel quel, tel que la regie le fournit. Le seul
      element a renseigner est l'hote, qui designe le compte sous lequel la
      configuration est enregistree, donc celui de la regie et non le notre. %>
  <link rel="preconnect" href="https://cmp.inmobi.com">
  <link rel="dns-prefetch" href="https://cmp.inmobi.com">
  <!-- InMobi Choice. Consent Manager Tag v3.0 (for TCF 2.3) -->
  <script type="text/javascript" async=true>
  (function() {
    var host = "www.themoneytizer.com";
    var element = document.createElement('script');
    var firstScript = document.getElementsByTagName('script')[0];
    var url = 'https://cmp.inmobi.com'
      .concat('/choice/', '6Fv0cGNfc_bw8', '/', host, '/choice.js?tag_version=V3');
    var uspTries = 0;
    var uspTriesLimit = 3;
    element.async = true;
    element.type = 'text/javascript';
    element.src = url;

    firstScript.parentNode.insertBefore(element, firstScript);

    function makeStub() {
      var TCF_LOCATOR_NAME = '__tcfapiLocator';
      var queue = [];
      var win = window;
      var cmpFrame;

      function addFrame() {
        var doc = win.document;
        var otherCMP = !!(win.frames[TCF_LOCATOR_NAME]);

        if (!otherCMP) {
          if (doc.body) {
            var iframe = doc.createElement('iframe');

            iframe.style.cssText = 'display:none';
            iframe.name = TCF_LOCATOR_NAME;
            doc.body.appendChild(iframe);
          } else {
            setTimeout(addFrame, 5);
          }
        }
        return !otherCMP;
      }

      function tcfAPIHandler() {
        var gdprApplies;
        var args = arguments;

        if (!args.length) {
          return queue;
        } else if (args[0] === 'setGdprApplies') {
          if (
            args.length > 3 &&
            args[2] === 2 &&
            typeof args[3] === 'boolean'
          ) {
            gdprApplies = args[3];
            if (typeof args[2] === 'function') {
              args[2]('set', true);
            }
          }
        } else if (args[0] === 'ping') {
          var retr = {
            gdprApplies: gdprApplies,
            cmpLoaded: false,
            cmpStatus: 'stub'
          };

          if (typeof args[2] === 'function') {
            args[2](retr);
          }
        } else {
          if(args[0] === 'init' && typeof args[3] === 'object') {
            args[3] = Object.assign(args[3], { tag_version: 'V3' });
          }
          queue.push(args);
        }
      }

      function postMessageEventHandler(event) {
        var msgIsString = typeof event.data === 'string';
        var json = {};

        try {
          if (msgIsString) {
            json = JSON.parse(event.data);
          } else {
            json = event.data;
          }
        } catch (ignore) {}

        var payload = json.__tcfapiCall;

        if (payload) {
          window.__tcfapi(
            payload.command,
            payload.version,
            function(retValue, success) {
              var returnMsg = {
                __tcfapiReturn: {
                  returnValue: retValue,
                  success: success,
                  callId: payload.callId
                }
              };
              if (msgIsString) {
                returnMsg = JSON.stringify(returnMsg);
              }
              if (event && event.source && event.source.postMessage) {
                event.source.postMessage(returnMsg, '*');
              }
            },
            payload.parameter
          );
        }
      }

      while (win) {
        try {
          if (win.frames[TCF_LOCATOR_NAME]) {
            cmpFrame = win;
            break;
          }
        } catch (ignore) {}

        if (win === window.top) {
          break;
        }
        win = win.parent;
      }
      if (!cmpFrame) {
        addFrame();
        win.__tcfapi = tcfAPIHandler;
        win.addEventListener('message', postMessageEventHandler, false);
      }
    };

    makeStub();

    var uspStubFunction = function() {
      var arg = arguments;
      if (typeof window.__uspapi !== uspStubFunction) {
        setTimeout(function() {
          if (typeof window.__uspapi !== 'undefined') {
            window.__uspapi.apply(window.__uspapi, arg);
          }
        }, 500);
      }
    };

    var checkIfUspIsReady = function() {
      uspTries++;
      if (window.__uspapi === uspStubFunction && uspTries < uspTriesLimit) {
        console.warn('USP is not accessible');
      } else {
        clearInterval(uspInterval);
      }
    };

    if (typeof window.__uspapi === 'undefined') {
      window.__uspapi = uspStubFunction;
      var uspInterval = setInterval(checkIfUspIsReady, 6000);
    }
  })();
  </script>
  <!-- End InMobi Choice. Consent Manager Tag v3.0 (for TCF 2.3) -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="<%= supabaseUrl %>">
  <title><%= rawTitle %></title>
  <meta name="description" content="<%= rawDescription %>">
  <%# max-image-preview:large is what lets Google Discover and Search show the
      full-width image card instead of a thumbnail. Without it the featured
      image is capped at 100px and the page is effectively invisible in Discover. %>
  <meta name="robots" content="<%= typeof noindex !== 'undefined' && noindex ? noindex : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' %>">
<% if (typeof sansCache !== 'undefined' && sansCache) { %>
  <%# GitHub Pages sert le HTML avec max-age=600 et ne laisse pas changer les
      en-tetes. Pendant dix minutes apres un deploiement, le navigateur rejoue
      donc l'ancienne page, qui pointe vers l'ancien ?v= des scripts : le
      tableau de bord semble ne pas se mettre a jour tant qu'on ne vide pas le
      cache. Sur une page d'administration, rien ne justifie de garder une
      copie, on l'interdit. %>
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
<% } %>
  <link rel="canonical" href="<%= canonical %>">
  <% for (const alt of alternates) { %>
  <link rel="alternate" hreflang="<%= alt.hreflang %>" href="<%= alt.href %>">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
  <meta property="og:site_name" content="Quiz Couple">
  <meta property="og:title" content="<%= rawTitle %>">
  <meta property="og:description" content="<%= rawDescription %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:locale" content="<%= locale %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="<%= typeof ogImageWidth !== 'undefined' ? ogImageWidth : 1200 %>">
  <meta property="og:image:height" content="<%= typeof ogImageHeight !== 'undefined' ? ogImageHeight : 630 %>">
  <% if (typeof ogType !== 'undefined' && ogType === 'article') { %>
  <meta property="article:published_time" content="<%= typeof articlePublishedTime !== 'undefined' ? articlePublishedTime : '' %>">
  <meta property="article:modified_time" content="<%= typeof articleModifiedTime !== 'undefined' ? articleModifiedTime : '' %>">
  <meta property="article:author" content="<%= typeof articleAuthor !== 'undefined' ? articleAuthor : '' %>">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= rawTitle %>">
  <meta name="twitter:description" content="<%= rawDescription %>">
  <meta name="twitter:url" content="<%= canonical %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Theme initialization (inline to prevent flash) -->
  <script>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='dark'){document.documentElement.classList.add('dark')}
      else if(t==='light'){document.documentElement.classList.remove('dark')}
      else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches){document.documentElement.classList.add('dark')}
      // Enable scroll-reveal only when motion is allowed (gates the hiding CSS,
      // set before paint so there is no flash and no-JS users see everything).
      if(!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)){document.documentElement.classList.add('js-reveal')}
    })();
  </script>

  <!-- Critical CSS (inlined for fast FCP) -->
  <style>
    :root{--background:24 56% 97%;--foreground:328 30% 13%;--card:0 0% 100%;--primary:338 83% 62%;--primary-foreground:0 0% 100%;--muted:22 40% 93%;--muted-foreground:328 12% 42%;--border:338 34% 91%;--radius:0.875rem}
    .dark{--background:285 24% 8%;--foreground:330 25% 94%;--card:285 22% 12%;--primary:338 95% 71%;--muted:285 18% 16%;--muted-foreground:326 13% 66%;--border:290 16% 22%}
    *,::after,::before{box-sizing:border-box;margin:0;padding:0;border:0 solid}
    body{font-family:Inter,system-ui,-apple-system,sans-serif;background-color:hsl(var(--background));color:hsl(var(--foreground));-webkit-font-smoothing:antialiased;line-height:1.5}
    .container{width:100%;max-width:80rem;margin:0 auto;padding:0 1rem}@media(min-width:640px){.container{padding:0 2rem}}
    .text-foreground{color:hsl(var(--foreground))}.bg-background{background-color:hsl(var(--background))}
    .font-bold{font-weight:700}.text-center{text-align:center}
    .mb-4{margin-bottom:1rem}.mb-6{margin-bottom:1.5rem}.py-16{padding-top:4rem;padding-bottom:4rem}
    .mx-auto{margin-left:auto;margin-right:auto}.px-4{padding-left:1rem;padding-right:1rem}
    .text-3xl{font-size:1.875rem;line-height:2.25rem}.text-lg{font-size:1.125rem;line-height:1.75rem}
    .relative{position:relative}.overflow-hidden{overflow:hidden}
    .hidden{display:none}.flex{display:flex}.grid{display:grid}.block{display:block}.inline-flex{display:inline-flex}
    .items-center{align-items:center}.justify-between{justify-content:space-between}.justify-center{justify-content:center}
    .gap-2{gap:.5rem}.gap-4{gap:1rem}
    header{background-color:hsl(var(--background)/0.8);backdrop-filter:blur(12px);border-bottom:1px solid hsl(var(--border));position:sticky;top:0;z-index:50}
  </style>

  <!-- Fonts (non-blocking, reduced weights) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap"></noscript>

  <!-- Preload hero image for LCP (home page) -->
  <% if (typeof routeKey !== 'undefined' && routeKey === 'home') { %>
  <link rel="preload" href="/assets/quiz-couple-hero.webp" as="image" type="image/webp">
  <!-- cf7a42f54f657854c287ed4d2afdf069 -->
  <% } else if (typeof featuredImage !== 'undefined' && featuredImage) { %>
  <link rel="preload" href="<%= featuredImage %>" as="image" type="image/webp">
  <% } %>

  <!-- Full CSS -->
  <link rel="stylesheet" href="/css/styles.css">

  <%# Empreinte de la construction. Le générateur remplace le jeton ci-dessous
      par la même empreinte que celle ajoutée aux scripts et à la feuille de
      style. Les scripts s'en servent pour demander leurs fichiers de
      questions : sans elle, un cache peut répondre avec les données d'une
      version du site où le quiz de la page n'existait pas encore. %>
  <script>window.__QCV="EMPREINTE_RESSOURCES";</script>

  <%# Mode consentement de Google. Les quatre signaux partent refuses, et
      c'est la plateforme de consentement qui les accorde : consentement.js
      lit la chaine TCF et la traduit pour gtag. Le refus par defaut doit
      etre pose ici, avant tout chargement, sinon une balise Google qui
      demarre avant la reponse de la CMP travaille sans savoir. %>
  <script>
    window.dataLayer=window.dataLayer||[];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:2000});
  </script>

  <%# La régie du site est The Moneytizer. AdSense a été retiré : le compte
      ayant été refusé, son script se chargeait sur chaque page sans jamais
      rien afficher, et la balise meta déclarait un compte non approuvé.
      Les quatre signaux de consentement posés au-dessus restent utiles :
      ils valent pour toute régie publicitaire, pas seulement pour Google. %>

  <%- typeof jsonLdHtml !== 'undefined' && jsonLdHtml ? jsonLdHtml : '' %>
</head>
<body class="bg-background text-foreground font-sans antialiased">
  <%- include('partials/header', { lang, t, getLocalizedUrl, routeSlugs: routeSlugs }) %>

  <% var avecPub = typeof pagePublicitaire !== 'undefined' && pagePublicitaire; %>
  <main class="relative z-0">
    <%- content %>
    <%# Le megabanner de bas de page. Il est pose ici plutot que dans chaque
        gabarit : c'est le dernier endroit commun a toutes les pages, juste
        avant le bloc d'avis, donc apres tout le contenu utile. %>
    <% if (avecPub) { %>
    <%- include('partials/pub', { format: 28 }) %>
    <% } %>
    <%# L'interstitiel de l'ecran de resultat. Le div est pose ici, vide : ses
        scripts ne partent qu'au moment ou le resultat s'affiche, sur le clic
        de la personne. C'est le bon declencheur, celui que Google decrit pour
        son propre interstitiel web, et non le chargement de la page, qui
        frapperait les visiteurs arrivant depuis la recherche. %>
    <% if (avecPub && typeof pageJouable !== 'undefined' && pageJouable) { %>
    <%- include('partials/pub', { format: 15, differe: true }) %>
    <% } %>
    <% if (typeof pageJouable !== 'undefined' && pageJouable) { %>
    <%- include('partials/quiz-reviews', { lang: lang, t: t, routeKey: routeKey, genrePage: (typeof genrePage !== 'undefined' ? genrePage : 'test'), supabaseUrl: supabaseUrl, supabaseKey: supabaseKey }) %>
    <% } %>
  </main>

  <%# Le double skyrail vit dans les gouttieres, a cote du contenu et jamais
      dedans. Il ne prend aucune place dans le flux et ne decale rien : c'est
      le seul format qu'on peut poser sans rien reserver. Il se place lui-meme
      et ne s'affiche que sur les ecrans assez larges pour l'accueillir. %>
  <% if (avecPub) { %>
  <%- include('partials/pub', { format: 4 }) %>
  <% } %>

  <%- include('partials/footer', { lang, t, getLocalizedUrl }) %>

  <!-- JS -->
  <%# La mesure d'audience passe en premier : elle expose window.QCAudience,
      que quiz-extras.js lit pour rattacher un lancement de test a la visite
      qui l'a produit. Les scripts differes s'executent dans l'ordre du
      document, donc celui-ci est pret avant les suivants. Il part des la fin
      de l'analyse du HTML, sans attendre les images, pour attraper aussi les
      visites qui repartent en deux secondes. %>
  <script src="/js/audience.js" defer></script>
  <%# L'ecran de resultat prend sa propre adresse et compte comme une page
      vue. Il lit window.QCAudience, donc il passe apres la mesure d'audience.
      Les moteurs de quiz sont charges plus haut dans le document, mais ils ne
      l'appellent qu'a la fin d'une partie : l'ordre est sans consequence. %>
  <script src="/js/resultat-url.js" defer></script>
  <script src="/js/theme.js" defer></script>
  <script src="/js/mobile-menu.js" defer></script>
  <script src="/js/consentement.js" defer></script>
  <script src="/js/obl.js" defer></script>
  <script src="/js/scroll-reveal.js" defer></script>
  <script src="/js/quiz-extras.js" defer></script>
  <%# Le compteur de lectures a besoin de window.QCAudience, donc il doit
      partir APRES audience.js. Les scripts differes s'executent dans l'ordre
      du document : place dans le corps de l'article, celui-ci passait avant
      et ne trouvait pas la mesure d'audience. Sur la page de listing, il ne
      trouve pas de compteur et ne fait rien. %>
  <% if (routeKey === 'blog') { %>
  <script src="/js/blog-lectures.js" defer></script>
  <% } %>

  <!-- GA (deferred) -->
  <script>
    window.addEventListener('load',function(){
      var s=document.createElement('script');
      s.src='https://www.googletagmanager.com/gtag/js?id=<%= gaId %>';
      s.async=true;
      document.head.appendChild(s);
      s.onload=function(){
        gtag('js',new Date());
        gtag('config','<%= gaId %>',{send_page_view:true});
      };
    });
  </script>
</body>
</html>
