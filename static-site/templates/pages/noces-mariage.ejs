<%
  // Noces de mariage (6 novembre 2026) : la date du mariage, les noces du
  // moment et les suivantes, puis le tableau des noces de la langue. Chaque
  // pays a sa liste (clé « liste » de noces-mariage.json : années, nom, autres
  // noms, noces les plus fêtées) ; le tableau de la page et l'outil
  // (js/noces-mariage.js) lisent la même. Outil autonome, hors quiz-loader,
  // sur le gabarit des outils par date (classes astro-* et dn-*).
  const ns = 'noces-mariage';
  const pageTitle = t('quizzes:nocesMariage.title', 'Noces de mariage');
  const listeNoces = (t(ns + ':liste', []) || []).filter(function (x) { return x && typeof x.an === 'number' && x.nom; })
    .slice().sort(function (a, b) { return a.an - b.an; });
  const avecOok = listeNoces.some(function (x) { return x.ook; });
  const FRACTIONS = { 3: '¼', 4: '⅓', 6: '½', 9: '¾' };
  const unitesAn = t(ns + ':unites.an', ['an', 'ans']);
  // La même écriture des années que le script : « 12 ans », « 12½ ans ».
  function anneesNoces(an) {
    const mois = Math.round(an * 12), entier = Math.floor(mois / 12), reste = mois % 12;
    if (!reste) return entier + ' ' + (entier === 1 ? unitesAn[0] : unitesAn[1]);
    return (entier ? entier : '') + (FRACTIONS[reste] || '') + ' ' + unitesAn[1];
  }
  function majuscule(s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1); }

  // Tout ce que le script doit pouvoir afficher, dans la langue de la page.
  const nmI18n = {
    form: {
      jour: t(ns + ':form.jour', 'Jour'),
      moisLabel: t(ns + ':form.moisLabel', 'Mois'),
      annee: t(ns + ':form.annee', 'Année'),
      mois: t(ns + ':form.mois', []),
      moisDate: t(ns + ':form.moisDate', []),
      joursSemaine: t(ns + ':form.joursSemaine', []),
      dateAffichee: t(ns + ':form.dateAffichee', '{{j}} {{mois}} {{a}}'),
      dateAvecJour: t(ns + ':form.dateAvecJour', '{{js}} {{date}}'),
      erreur: t(ns + ':form.erreur', ''),
      erreurVide: t(ns + ':form.erreurVide', ''),
    },
    unites: t(ns + ':unites', {}),
    et: t(ns + ':et', ' et '),
    virgule: t(ns + ':virgule', ', '),
    quand: t(ns + ':quand', {}),
    resultat: t(ns + ':resultat', {}),
    liste: listeNoces.map(function (x) { return { an: x.an, nom: x.nom, ook: x.ook || '', anglo: !!x.anglo }; }),
  };

  const faqEntrees = [];
  for (let i = 1; i <= 6; i++) {
    const q = t(ns + ':faq.q' + i, '');
    const a = t(ns + ':faq.a' + i, '');
    if (q && a) faqEntrees.push({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } });
  }

  const baseUrl = 'https://quiz-couple.com';
  const imageNM = (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : ((typeof ogImage !== 'undefined' && ogImage) ? ogImage : baseUrl + '/og-image.webp');
  const appNM = {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    // Même identifiant que le bloc du générateur, qui porte la note des avis :
    // les deux se lisent comme une seule application.
    '@id': canonical + '#application',
    name: t(ns + ':jsonLd.name', pageTitle),
    description: t('quizzes:nocesMariage.metaDescription', t('quizzes:nocesMariage.description', '')),
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: lang,
    url: canonical,
    image: imageNM,
    isAccessibleForFree: true,
    about: { '@type': 'Thing', name: t(ns + ':jsonLd.about', '') },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    author: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl },
    publisher: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl, logo: { '@type': 'ImageObject', url: baseUrl + '/apple-touch-icon.png' } }
  };
  const points3 = t(ns + ':section3.points', []);
%>
<script type="application/ld+json"><%- JSON.stringify(appNM) %></script>
<% if (faqEntrees.length) { %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntrees }) %></script>
<% } %>

<!-- Hero -->
<section class="quiz-page-hero relative overflow-hidden hero-gradient">
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:nocesMariage.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="9" cy="14" r="5"/><circle cx="15" cy="14" r="5"/><path d="M10 5l2-2 2 2-2 2z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.highlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- escapeHtml(heroTitle).replace(escapeHtml(heroHighlight), '<span class="text-gradient">' + escapeHtml(heroHighlight) + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
      <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':hero.subtitle', '') %></p>
    </div>
  </div>
  <%# L'image de tête vient en dernier dans le code, comme sur les autres pages de test. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', featuredImageSrcset: typeof featuredImageSrcset !== 'undefined' ? featuredImageSrcset : null }) %>
</section>

<!-- L'outil -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="nm-outil" class="astro-form-card rounded-2xl p-6 md:p-10" data-lang="<%= lang %>">

        <div id="nm-formulaire">
          <h2 class="text-xl md:text-2xl font-bold text-center mb-6"><%= t(ns + ':form.titre', '') %></h2>
          <div class="dn-personne">
            <p class="dn-personne-titre"><span class="dn-personne-num dn-personne-num-1">1</span><%= t(ns + ':form.dateTitre', '') %></p>
            <div class="dn-champs">
              <div class="astro-field">
                <label class="astro-field-label" for="nm-jour"><%= t(ns + ':form.jour', 'Jour') %></label>
                <div class="astro-select-wrap"><select id="nm-jour" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="nm-mois"><%= t(ns + ':form.moisLabel', 'Mois') %></label>
                <div class="astro-select-wrap"><select id="nm-mois" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="nm-annee"><%= t(ns + ':form.annee', 'Année') %></label>
                <div class="astro-select-wrap"><select id="nm-annee" class="astro-input astro-select"></select></div>
              </div>
            </div>
            <p class="text-sm text-muted-foreground"><%= t(ns + ':form.dateAide', '') %></p>
          </div>

          <p id="nm-erreur" class="dn-erreur hidden" role="alert"></p>

          <div class="mt-6 text-center">
            <button id="nm-lancer" type="button" class="btn btn-cta btn-gradient astro-submit-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><circle cx="9" cy="14" r="5"/><circle cx="15" cy="14" r="5"/></svg>
              <%= t(ns + ':form.lancer', '') %>
            </button>
            <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':form.aide', '') %></p>
          </div>
        </div>

        <div id="nm-resultat" class="hidden"></div>

        <div id="nm-suite" class="hidden">
          <div class="cc-actions">
            <button id="nm-copier" type="button" class="btn btn-outline px-6 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              <%= t(ns + ':resultat.lienBouton', '') %>
            </button>
            <button id="nm-refaire" type="button" class="btn btn-outline px-6 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              <%= t(ns + ':resultat.modifier', '') %>
            </button>
          </div>
          <p id="nm-copie" class="cc-copie hidden" role="status"></p>

          <div class="dn-suite-carte">
            <h3 class="dn-suite-titre"><%= t(ns + ':suite.titre', '') %></h3>
            <p class="dn-suite-texte"><%= t(ns + ':suite.texte', '') %></p>
            <a class="btn btn-cta btn-gradient" href="<%= getLocalizedUrl('compteurCouple', lang) %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <%= t(ns + ':suite.bouton', '') %>
            </a>
          </div>
          <div class="text-center mt-6">
            <a href="#pq-reviews" class="btn btn-outline px-6 py-2.5 text-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':resultat.avis', '') %>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# Sous l'outil, jamais au-dessus. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section1.p1') %></p>
        <p><%- t(ns + ':section1.p2') %></p>
        <% const s1p3 = t(ns + ':section1.p3', ''); if (s1p3) { %><p><%- s1p3 %></p><% } %>
      </div>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16" id="liste-des-noces">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section2.p1') %></p>
      </div>
      <% if (listeNoces.length) { %>
      <div class="overflow-x-auto mb-6">
        <table class="quiz-table nm-table">
          <thead><tr>
            <th><%= t(ns + ':table.annees', '') %></th>
            <th><%= t(ns + ':table.noces', '') %></th>
            <% if (avecOok) { %><th><%= t(ns + ':table.ook', '') %></th><% } %>
          </tr></thead>
          <tbody>
            <% listeNoces.forEach(function (x) { %>
            <tr data-nm-mois="<%= Math.round(x.an * 12) %>"<% if (x.phare) { %> class="nm-phare"<% } %>>
              <td class="font-medium nm-annees"><%= anneesNoces(x.an) %></td>
              <td class="nm-nom-cellule"><%= majuscule(x.nom) %><% if (x.anglo) { %> <span class="nm-marque" title="<%= t(ns + ':table.angloTitre', '') %>">*</span><% } %></td>
              <% if (avecOok) { %><td class="text-sm text-muted-foreground"><%= x.ook || '' %></td><% } %>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section2.p2') %></p>
      </div>
    </section>

    <%# Comment fêter ses noces : avant l'histoire, pour que ses liens ne tombent pas en bas de page. %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section3.p1') %></p>
      </div>
      <% if (points3.length) { %>
      <ul class="space-y-3 text-muted-foreground leading-relaxed list-disc pl-6 mb-6">
        <% for (const pt of points3) { %><li><%- pt %></li><% } %>
      </ul>
      <% } %>
      <% const s3p2 = t(ns + ':section3.p2', ''); if (s3p2) { %>
      <div class="space-y-4 text-muted-foreground leading-relaxed"><p><%- s3p2 %></p></div>
      <% } %>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section4.p1') %></p>
        <p><%- t(ns + ':section4.p2') %></p>
        <% const s4p3 = t(ns + ':section4.p3', ''); if (s4p3) { %><p><%- s4p3 %></p><% } %>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', 'FAQ') %></h2>
      <div class="space-y-3">
        <% for (let i = 1; i <= 6; i++) { const q = t(ns + ':faq.q' + i, ''); if (!q) continue; %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- t(ns + ':faq.a' + i) %></div>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<script>window.NM_I18N = <%- JSON.stringify(nmI18n).replace(/</g, '\\u003c') %>;</script>
<script src="/js/noces-mariage.js" defer></script>
