<%
  const quizKey = 'testAmeSoeur';
  const ns = 'quiz-ame-soeur';
  const quizTitle = t('quizzes:testAmeSoeur.title', 'Test âme sœur');
  const quizDesc = t('quizzes:testAmeSoeur.metaDescription', '');

  // Les 24 questions du pool, reprises de gd.json pour le balisage Quiz.
  // Le test en pose vingt : la propriété questionsPerSession le dit, pour que
  // le balisage ne promette pas une longueur que le moteur ne tient pas.
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd'];
  for (let qi = 1; qi <= 24; qi++) {
    const qText = tgd('ameSoeur.q' + qi, '');
    if (!qText || qText === 'ameSoeur.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local('ameSoeur.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'ameSoeur.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "datePublished": "2026-08-21", "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": "soulmate" },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": hasPart.length || 24 },
      { "@type": "PropertyValue", "name": "questionsPerSession", "value": 20 },
      { "@type": "PropertyValue", "name": "audience", "value": "couples and singles" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const faqNums = [1, 2, 3, 4, 5];
  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.2l-1.6-1.6a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Quiz Engine -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="ame-soeur" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

