<%
  // Le bilan de l'année à deux (7 novembre 2026) : le jeu du Nouvel An pour
  // les couples, quatre manches sur un seul téléphone (souvenirs, trophées,
  // ce qu'on retient, l'année prochaine), puis le bilan avec les trophées de
  // chacun et la résolution de couple. Le jeu passe avant l'article, comme
  // sur les autres pages de jeu. Moteur NouvelAnGame, textes du jeu dans
  // gd.json (nouvelAn.*), texte de la page dans jeu-nouvel-an.json.
  const ns = 'jeu-nouvel-an';
  const pageTitle = t('quizzes:jeuNouvelAn.title', 'Le bilan de l\'année à deux');

  // Des exemples de chaque manche, lus directement dans le réservoir du jeu
  // (gd.json) : la page montre mot pour mot les questions qui seront posées,
  // dans toutes les langues. Les trophées s'écrivent avec leur question.
  const lire = function (cle) { const v = tgd('nouvelAn.' + cle, ''); return v && v !== 'nouvelAn.' + cle ? v : null; };
  const manches = [
    { cle: 'souvenirs', ids: [1, 2, 3, 5, 7, 9, 11, 13].map(function (i) { return 's' + i; }) },
    { cle: 'trophees',  ids: [1, 2, 3, 4, 6, 9, 13, 16].map(function (i) { return 't' + i; }) },
    { cle: 'retenir',   ids: [1, 2, 3, 5, 8, 9].map(function (i) { return 'r' + i; }) },
    { cle: 'avenir',    ids: [1, 2, 3, 5, 8, 11].map(function (i) { return 'p' + i; }) }
  ].map(function (m) {
    m.questions = m.ids.map(function (id) {
      const texte = lire(id);
      if (!texte) return null;
      if (m.cle !== 'trophees') return { texte: texte };
      return { texte: texte, question: lire(id + '_q') };
    }).filter(Boolean);
    return m;
  });
  const autres = t(ns + ':section3.items', []);
  const listeAutres = Array.isArray(autres) ? autres : [];

  const faqNums = [1, 2, 3, 4, 5, 6];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Game",
      "name": t(ns + ':jsonLd.name', pageTitle),
      "description": t('quizzes:jeuNouvelAn.metaDescription', ''),
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "gamePlatform": "Web browser",
      "numberOfPlayers": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 2 }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '').replace(/<[^>]+>/g, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% if (getLocalizedUrl('jeuxCouple', lang)) { %>
          <li><a href="<%= getLocalizedUrl('jeuxCouple', lang) %>"><%= t('quizzes:jeuxCouple.shortTitle', 'Jeux de couple') %></a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% } %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:jeuNouvelAn.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8l-.6 5.2A3.4 3.4 0 0 1 12 11.2 3.4 3.4 0 0 1 8.6 8.2L8 3z"/><path d="M12 11.2V19"/><path d="M8.5 21h7"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- escapeHtml(heroTitle).replace(escapeHtml(heroHighlight), '<span class="text-gradient">' + escapeHtml(heroHighlight) + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
  <%# L'image de tête vient en dernier dans le code : sur mobile, elle s'affiche sous le texte (order: 99) et sur grand écran elle est posée en absolu. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', featuredImageSrcset: typeof featuredImageSrcset !== 'undefined' ? featuredImageSrcset : null }) %>
</section>

<!-- Le jeu -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="nouvel-an" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- t(ns + ':section1.intro', '') %></p>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section1.intro2', '') %></p>
      <div class="space-y-4 mb-8">
        <% for (let i = 1; i <= 4; i++) { %>
        <div class="flex items-start gap-4 bg-card border border-border rounded-lg p-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center"><%= i %></span>
          <div>
            <h3 class="font-semibold mb-1"><%= t(ns + ':section1.etape' + i + 'Titre', '') %></h3>
            <p class="text-muted-foreground"><%- t(ns + ':section1.etape' + i + 'Texte', '') %></p>
          </div>
        </div>
        <% } %>
      </div>
      <p class="text-muted-foreground leading-relaxed"><%- t(ns + ':section1.apres', '') %></p>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section2.intro', '') %></p>
      <% manches.forEach(function(m) { if (!m.questions.length) return; %>
      <h3 class="text-xl font-bold mb-3"><%= t(ns + ':section2.' + m.cle + 'Titre', '') %></h3>
      <p class="text-muted-foreground leading-relaxed mb-5"><%- t(ns + ':section2.' + m.cle + 'Texte', '') %></p>
      <ol class="quiz-static-list mb-10">
        <% m.questions.forEach(function(q) { %>
        <li class="quiz-static-item"><p class="quiz-static-q"><% if (q.question) { %><strong><%= q.texte %></strong> <%= q.question %><% } else { %><%= q.texte %><% } %></p></li>
        <% }) %>
      </ol>
      <% }) %>
      <p class="text-muted-foreground leading-relaxed"><%- t(ns + ':section2.apres', '') %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-6"><%- t(ns + ':section3.intro', '') %></p>
      <% if (listeAutres.length) { %>
      <ul class="space-y-3 mb-6">
        <% listeAutres.forEach(function(item) { %>
        <li class="text-muted-foreground leading-relaxed"><%- item %></li>
        <% }) %>
      </ul>
      <% } %>
      <% const s3apres = t(ns + ':section3.apres', ''); if (s3apres) { %><p class="text-muted-foreground leading-relaxed"><%- s3apres %></p><% } %>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section4.intro', '') %></p>
      <div class="quiz-resume">
        <p class="quiz-resume-titre"><%= t(ns + ':section4.resumeTitre', '') %></p>
        <ul>
          <% for (let i = 1; i <= 4; i++) { %>
          <li><%- t(ns + ':section4.resume' + i, '') %></li>
          <% } %>
        </ul>
      </div>
      <% const s4apres = t(ns + ':section4.apres', ''); if (s4apres) { %><p class="text-muted-foreground leading-relaxed mt-8"><%- s4apres %></p><% } %>
    </section>

    <section class="mb-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { const q = t(ns + ':faq.q' + i, ''); if (!q) continue; %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= q %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
