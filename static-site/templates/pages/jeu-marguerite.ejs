<%
  // Effeuiller la marguerite en ligne (7 novembre 2026) : une fleur de 14 à
  // 26 pétales tirés au hasard, qu'on effeuille en touchant les pétales un
  // par un, avec la formule de la langue (« il m'aime, il ne m'aime pas »,
  // un pétale sur deux) ou la formule française en cinq mots (un peu,
  // beaucoup, passionnément, à la folie, pas du tout). Un prénom facultatif
  // remplace « il » ou « elle ». Les pétales sont dessinés par le script
  // (js/marguerite.js, racine #mg-outil) : la fleur garde sa place carrée
  // dès le chargement, rien ne bouge quand ils arrivent. La carte du
  // résultat porte quiz-result-card : c'est elle que guettent le compteur de
  // parties et le bloc des avis. Textes dans jeu-marguerite.json.
  const ns = 'jeu-marguerite';
  const pageTitle = t('quizzes:jeuMarguerite.title', 'Effeuiller la marguerite');
  const pronoms = t(ns + ':pronoms', []);
  const versions = t(ns + ':versions', {});
  const ordreVersions = t(ns + ':ordreVersions', ['courte', 'longue']).filter(function (v) { return versions[v]; });
  const versionDefaut = t(ns + ':versionDefaut', ordreVersions[0]);
  const urlSecret = getLocalizedUrl('testSecret', lang);
  const mgData = {
    pronoms: pronoms, versions: versions, versionDefaut: versionDefaut, url: canonical,
    outil: t(ns + ':outil', {}), suite: urlSecret || '',
  };

  const faqNums = [1, 2, 3, 4, 5, 6];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Game",
      "name": t(ns + ':jsonLd.name', pageTitle),
      "description": t('quizzes:jeuMarguerite.metaDescription', ''),
      "about": t(ns + ':jsonLd.about', ''),
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "gamePlatform": "Web browser",
      "numberOfPlayers": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 1 }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '').replace(/<[^>]+>/g, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="quiz-page-hero relative overflow-hidden hero-gradient">
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% if (getLocalizedUrl('jeuxCouple', lang)) { %>
          <li><a href="<%= getLocalizedUrl('jeuxCouple', lang) %>"><%= t('quizzes:jeuxCouple.shortTitle', 'Jeux de couple') %></a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% } %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:jeuMarguerite.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="2.5"/><path d="M12 9.5V4M12 14.5V20M9.5 12H4M14.5 12H20M10.2 10.2 6.3 6.3M13.8 13.8l3.9 3.9M13.8 10.2l3.9-3.9M10.2 13.8l-3.9 3.9"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.highlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- escapeHtml(heroTitle).replace(escapeHtml(heroHighlight), '<span class="text-gradient">' + escapeHtml(heroHighlight) + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
  <%# L'image de tête vient en dernier dans le code, comme sur les autres pages de jeu. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', featuredImageSrcset: typeof featuredImageSrcset !== 'undefined' ? featuredImageSrcset : null }) %>
</section>

<!-- La marguerite -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="mg-outil" class="astro-form-card mg-outil rounded-2xl p-6 md:p-10" data-lang="<%= lang %>">
        <h2 class="mg-titre"><%= t(ns + ':outil.titre', '') %></h2>

        <div class="mg-reglages">
          <label class="mg-champ" for="mg-prenom">
            <span class="mg-libelle"><%= t(ns + ':outil.prenom', '') %></span>
            <input id="mg-prenom" class="mg-saisie" type="text" maxlength="30" autocomplete="off" spellcheck="false" placeholder="<%= t(ns + ':outil.prenomExemple', '') %>">
          </label>
          <% if (pronoms.length) { %>
          <div class="mg-groupe">
            <span class="mg-libelle" id="mg-pronom-titre"><%= t(ns + ':outil.pronom', '') %></span>
            <div class="mg-choix" role="group" aria-labelledby="mg-pronom-titre">
              <% pronoms.forEach(function (p, i) { %>
              <button type="button" class="mg-option<%= i === 0 ? ' mg-option--actif' : '' %>" data-pronom="<%= p.id %>" aria-pressed="<%= i === 0 ? 'true' : 'false' %>"><%= p.label %></button>
              <% }) %>
            </div>
          </div>
          <% } %>
          <div class="mg-groupe">
            <span class="mg-libelle" id="mg-version-titre"><%= t(ns + ':outil.version', '') %></span>
            <div class="mg-choix mg-choix--versions" role="group" aria-labelledby="mg-version-titre">
              <% ordreVersions.forEach(function (v) { %>
              <button type="button" class="mg-option<%= v === versionDefaut ? ' mg-option--actif' : '' %>" data-version="<%= v %>" aria-pressed="<%= v === versionDefaut ? 'true' : 'false' %>"><%= versions[v].nom %></button>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="mg-scene">
          <div class="mg-fleur" id="mg-fleur" role="group" aria-label="<%= t(ns + ':outil.fleur', '') %>">
            <span class="mg-coeur" aria-hidden="true"></span>
          </div>
        </div>

        <div class="mg-parole">
          <p class="mg-tete" aria-hidden="true"></p>
          <p class="mg-phrase" aria-live="polite"><%= t(ns + ':outil.consigne', '') %></p>
        </div>

        <div class="mg-actions">
          <button type="button" id="mg-tout" class="btn btn-outline mg-bouton"><%= t(ns + ':outil.tout', '') %></button>
          <button type="button" id="mg-nouvelle" class="btn btn-ghost mg-bouton">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
            <%= t(ns + ':outil.nouvelle', '') %>
          </button>
        </div>

        <div id="mg-resultat" class="mg-resultat" hidden></div>
        <p id="mg-copie" class="cc-copie hidden" role="status"></p>
      </div>
    </div>
  </div>
</section>

<%# Sous la fleur, jamais au-dessus. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <% ['section1', 'section2', 'section3'].forEach(function (cle, idx) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':' + cle + '.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% ['p1', 'p2', 'p3'].forEach(function (p) { const v = t(ns + ':' + cle + '.' + p, ''); if (v) { %><p><%- v %></p><% } }) %>
      </div>
    </section>
    <% if (idx === 0 && typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>
    <% }) %>

    <section class="mb-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { const q = t(ns + ':faq.q' + i, ''); if (!q) continue; %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= q %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<script>window.MG_DATA = <%- JSON.stringify(mgData).replace(/</g, '\\u003c') %>;</script>
<script src="/js/marguerite.js" defer></script>
