<%
  // Phrases à compléter, version couple. Comme les autres jeux, le moteur
  // passe avant l'article : on doit pouvoir commencer sans faire défiler.
  const ns = 'jeu-phrases';
  const pageTitle = t('quizzes:jeuPhrases.title', 'Phrases à compléter en couple | Jeu gratuit');

  // Les vingt phrases sont lues dans le réservoir du jeu : la liste de la
  // page est mot pour mot celle que le moteur pose, dans les cinq langues,
  // sans copie qui pourrait dériver au fil des retouches.
  const phrases = [];
  for (let i = 1; i <= 20; i++) {
    const v = tgd('phrases.q' + i, '');
    if (v && v !== 'phrases.q' + i) phrases.push(v);
  }

  const faqNums = [1, 2, 3, 4, 5];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Game",
      "name": t(ns + ':jsonLd.name', pageTitle),
      "description": t('quizzes:jeuPhrases.metaDescription', ''),
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "gamePlatform": "Web browser",
      "numberOfPlayers": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 2 }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% if (getLocalizedUrl('jeuxCouple', lang)) { %>
          <li><a href="<%= getLocalizedUrl('jeuxCouple', lang) %>"><%= t('quizzes:jeuxCouple.shortTitle', 'Jeux de couple') %></a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% } %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:jeuPhrases.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Le jeu -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="phrases" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- t(ns + ':section1.p1', '') %></p>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- t(ns + ':section1.p2', '') %></p>
      <p class="text-muted-foreground leading-relaxed"><%- t(ns + ':section1.p3', '') %></p>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section2.intro', '') %></p>
      <div class="space-y-4">
        <% for (const m of ['Lecture', 'Chrono']) { %>
        <div class="flex items-start gap-4 p-5 bg-card border border-border rounded-lg">
          <span class="flex items-center justify-center w-11 h-11 rounded-full bg-primary/15 text-xl flex-shrink-0" aria-hidden="true"><%= t(ns + ':section2.mode' + m + 'Emoji', '💬') %></span>
          <div>
            <h3 class="font-semibold mb-1"><%= t(ns + ':section2.mode' + m + 'Titre', '') %></h3>
            <p class="text-muted-foreground"><%- t(ns + ':section2.mode' + m + 'Texte', '') %></p>
          </div>
        </div>
        <% } %>
      </div>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section2.apres', '') %></p>
    </section>

    <% if (phrases.length) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section3.intro', '') %></p>
      <ol class="quiz-static-list">
        <% phrases.forEach(function(p) { %>
        <li class="quiz-static-item">
          <h3 class="quiz-static-q"><%= p %></h3>
        </li>
        <% }) %>
      </ol>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section3.apres', '') %></p>
    </section>
    <% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section4.p1', '') %></p>
        <p><%- t(ns + ':section4.p2', '') %></p>
        <p><%- t(ns + ':section4.p3', '') %></p>
      </div>
    </section>

    <section class="mb-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= t(ns + ':faq.q' + i, '') %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

    </div>
    <%# La colonne laterale n'existe qu'au-dela de 1440 px, la ou il reste
        de la place a cote d'un texte qui reste centre. En dessous elle
        n'est pas affichee : le contenu garde sa mise en page d'avant. %>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %>
    <aside class="avec-colonne__aside"><%- include('../partials/pub', { format: 3 }) %></aside>
    <% } %>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
