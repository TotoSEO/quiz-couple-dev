<%
  const allLabel = lang === 'fr' ? 'Tous' : lang === 'en' ? 'All' : lang === 'es' ? 'Todos' : lang === 'de' ? 'Alle' : lang === 'nl' ? 'Alle' : 'Tutti';
%>
<section class="container mx-auto px-4 section-padding">
  <header class="mb-12 text-center">
    <h1 class="text-3xl md:text-4xl font-bold mb-4"><%= t('common:blog.heading', 'Blog') %></h1>
    <p class="text-muted-foreground text-lg max-w-2xl mx-auto"><%= t('common:blog.subheading', '') %></p>
  </header>

  <% if (blogCategories && blogCategories.length) { %>
  <nav class="blog-category-tabs" aria-label="Categories">
    <a class="blog-category-tab" href="<%= getLocalizedPath('blog', lang) %>" data-category="all"><%= allLabel %></a>
    <% blogCategories.forEach(function(cat) { %>
    <a class="blog-category-tab" href="<%= getLocalizedPath('blog', lang) %>#<%= cat.key %>" data-category="<%= cat.key %>"><%= cat.label %></a>
    <% }); %>
  </nav>
  <% } %>

  <div class="blog-grid" id="blog-articles-grid">
<% if (blogArticlesList && blogArticlesList.length) { %>
  <% blogArticlesList.forEach(function(a) { %>
    <article class="blog-card" data-category="<%= a.category || '' %>">
      <a href="<%= a.url %>" class="no-underline"><div class="blog-card-image-wrapper"><img src="<%= a.featuredImage %>"<% if (srcsetImage(a.featuredImage)) { %> srcset="<%= srcsetImage(a.featuredImage) %>" sizes="(min-width: 1536px) 433px, (min-width: 1280px) 393px, (min-width: 1024px) calc((100vw - 103px) / 3), (min-width: 768px) calc((100vw - 68px) / 2), calc(100vw - 34px)"<% } %> alt="<%= escapeHtml(a.featuredImageAlt) %>" class="blog-card-image" loading="lazy" width="400" height="225"></div></a>
      <% if (a.categoryLabel) { %>
      <div class="blog-card-category"><span class="blog-category-badge"><%= a.categoryLabel %></span></div>
      <% } %>
      <h2 class="blog-card-title"><a href="<%= a.url %>"><%= a.title %></a></h2>
      <div class="blog-card-meta"><span><%= new Date(a.publishedAt).toLocaleDateString(lang === 'fr' ? 'fr-FR' : lang, { year: 'numeric', month: 'long', day: 'numeric' }) %></span></div>
      <p class="blog-card-excerpt"><%= a.excerpt %></p>
      <a href="<%= a.url %>" class="blog-card-cta no-underline"><%= t("common:blog.readArticle", "Lire l'article") %></a>
    </article>
  <% }); %>
<% } else { %>
    <p class="text-center text-muted-foreground col-span-full py-16"><%= t('common:blog.noArticles', 'Aucun article disponible.') %></p>
<% } %>
  </div>
</section>

<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

<script>
(function() {
  // Les onglets filtrent la liste sur place. La catégorie est dans le
  // fragment de l'adresse (#psychologie), jamais en paramètre : une adresse à
  // paramètre est une page de plus pour Google (20 octobre 2026). Les anciens
  // liens ?category= sont lus, puis l'adresse est réécrite.
  var tabs = document.querySelectorAll('.blog-category-tab');
  var cards = document.querySelectorAll('.blog-card[data-category]');
  function connue(cat) {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].getAttribute('data-category') === cat) return true;
    return false;
  }
  function filtrer(cat) {
    if (!connue(cat)) cat = 'all';
    for (var i = 0; i < tabs.length; i++) tabs[i].classList.toggle('is-active', tabs[i].getAttribute('data-category') === cat);
    for (var j = 0; j < cards.length; j++) cards[j].style.display = (cat === 'all' || cards[j].getAttribute('data-category') === cat) ? '' : 'none';
  }
  function duFragment() {
    try { return decodeURIComponent(location.hash.slice(1)) || 'all'; } catch (e) { return 'all'; }
  }
  var ancienne = new URLSearchParams(location.search).get('category');
  if (ancienne) {
    try { history.replaceState(null, '', location.pathname + (ancienne !== 'all' && connue(ancienne) ? '#' + ancienne : '')); } catch (e) {}
  }
  filtrer(ancienne || duFragment());
  window.addEventListener('hashchange', function () { filtrer(duFragment()); });
  window.addEventListener('popstate', function () { filtrer(duFragment()); });
  for (var k = 0; k < tabs.length; k++) {
    tabs[k].addEventListener('click', function (e) {
      if (e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var cat = this.getAttribute('data-category');
      e.preventDefault();
      try { history.pushState(null, '', location.pathname + (cat === 'all' ? '' : '#' + cat)); } catch (er) {}
      filtrer(cat);
    });
  }
})();
</script>
