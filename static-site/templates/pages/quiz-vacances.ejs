<%
  // Test « où partir en vacances ? ». Page française uniquement : les
  // partenaires voyage mis en avant ne servent que le marché français.
  // Le questionnaire et ses 200 destinations vivent dans vacances.js et
  // /js/data/vacances-fr.json : la page reste légère, les données ne se
  // chargent que quand quelqu'un joue.
  const questionsTest = [
    { q: 'Pour commencer : vos âges ?', o: ['18 à 25 ans', '26 à 35 ans', '36 à 45 ans', '46 ans et plus'] },
    { q: 'Week-end en amoureux ou vraies vacances ?', o: ['Un week-end en amoureux', 'De vraies vacances'] },
    { q: 'Combien de temps partez-vous ?', o: ['Une nuit', 'Deux nuits', 'Trois nuits', '4 à 7 jours', '8 à 12 jours', 'Deux semaines ou plus'] },
    { q: 'On part où ?', o: ['En France', 'En Europe', 'Plus loin', 'Surprenez-nous'] },
    { q: 'Le décor de vos rêves ?', o: ['La mer', 'La montagne', 'Une île paradisiaque', 'Une ville à explorer', 'Nature et grands espaces'] },
    { q: 'Le budget par personne, transport compris ?', o: ['Moins de 300 €', '300 à 800 €', '800 à 1500 €', 'Plus de 1500 €'] },
    { q: 'Vous partiriez plutôt...', o: ['Au printemps', 'En été', 'En automne', 'En hiver'] },
    { q: 'Et sur place, le programme ?', o: ['Farniente et transats', 'Découverte et visites', 'Aventure et sensations'] }
  ];
  const faq = [
    { q: 'Comment le test choisit-il les destinations proposées ?',
      a: "Chacune des 244 destinations de notre base est décrite précisément : durées réalistes sur place, niveau de budget par personne transport compris, bonnes saisons, décor et rythme. Vos réponses servent de filtres, et seules les destinations qui les respectent toutes ressortent. Quand une combinaison est trop exigeante, le test élargit un critère à la fois et vous le dit, plutôt que de proposer n'importe quoi." },
    { q: 'Pourquoi certaines propositions sont-elles des circuits et pas une seule ville ?',
      a: "Parce qu'une durée change la nature du voyage. Amsterdam se savoure en deux à cinq nuits ; pour huit jours et plus, le test propose les Pays-Bas avec plusieurs étapes, jamais huit jours au même endroit. Toutes les destinations longues portent leurs étapes conseillées." },
    { q: 'Les budgets affichés sont-ils réalistes ?',
      a: "Ils incluent le transport depuis la France, l'hébergement et la vie sur place, par personne. Une semaine aux Maldives ne s'affichera jamais dans un budget de 300 €, et un week-end à Gérardmer ne vous demandera pas 1500 €." },
    { q: 'Le test tient-il compte de la saison ?',
      a: "Oui, strictement. Le ski ne sort qu'en hiver, la Laponie aussi, les fjords norvégiens en été, la Thaïlande pendant la saison sèche. Une destination très saisonnière ne sortira jamais de sa fenêtre, même quand le test élargit les autres critères." },
    { q: 'Faut-il créer un compte ou payer ?',
      a: "Non. Le test est gratuit, sans inscription, et vos réponses ne sont pas conservées. Seul le nombre de tests réalisés est compté." },
    { q: 'Peut-on refaire le test avec d\'autres critères ?',
      a: "Bien sûr, et c'est même conseillé : changez la durée ou le budget et la sélection change du tout au tout. Beaucoup de couples le font à deux, chacun ses réponses, pour comparer les deux listes." }
  ];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Quiz",
      "name": "Test : où partir en vacances en couple ?",
      "description": rawDescription,
      "about": { "@type": "Thing", "name": "Choisir une destination de vacances en couple" },
      "educationalLevel": "beginner",
      "learningResourceType": "Quiz",
      "interactivityType": "active",
      "inLanguage": "fr",
      "isAccessibleForFree": true,
      "hasPart": questionsTest.map((x, i) => ({
        "@type": "Question", "position": i + 1, "name": x.q,
        "suggestedAnswer": x.o.map((o, j) => ({ "@type": "Answer", "position": j + 1, "text": o }))
      }))
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faq.map(x => ({
        "@type": "Question", "name": x.q,
        "acceptedAnswer": { "@type": "Answer", "text": x.a }
      }))
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li aria-current="page">Test où partir en vacances ?</li>
        </ol>
      </nav>
      <span class="badge badge-primary mb-4">8 questions · Plus de 200 destinations · Gratuit</span>
      <h1 class="text-3xl md:text-5xl font-bold mb-4">
        Où partir en vacances en couple ? <span class="text-gradient">Notre test le trouve pour vous</span>
      </h1>
      <p class="text-lg text-muted-foreground mb-2">
        Huit questions sur vos envies, votre budget et vos dates. En face, plus de deux cents destinations décrites une par une, avec leurs vraies durées, leurs vraies saisons et leurs vrais prix. Le test croise les deux et vous rend une liste courte, cohérente, dans laquelle vous n'avez plus qu'à choisir.
      </p>
      <div class="mt-6">
        <a href="#vacances-racine" class="btn btn-cta btn-lg" id="vacances-demarrer">Trouver notre destination 🧭</a>
      </div>
    </div>
  </div>
</section>

<!-- Questionnaire -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="vacances-racine" class="va-racine" data-lang="fr"></div>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
</section>

<!-- Contenu SEO -->
<div class="seo-content">
<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Un test qui remplace le fameux « ça dépend »</h2>
    <p class="mb-4">Demandez autour de vous où partir en couple et vous obtiendrez toujours les trois mêmes réponses : Rome, les Maldives, et « ça dépend ». Les deux premières ignorent vos dates et votre budget, la troisième ne sert à rien. Ce test a été construit pour transformer le « ça dépend » en une <strong>liste courte de destinations qui collent vraiment à vos réponses</strong>.</p>
    <p class="mb-3">Pour y arriver, chacune des <strong>244 destinations de notre base</strong> est décrite comme un conseiller de voyage le ferait :</p>
    <ul class="list-disc pl-6 space-y-2 mb-4">
      <li><strong>La durée juste :</strong> une fourchette de nuits réaliste, ni l'aller-retour express en Corse, ni la semaine de trop à Amsterdam.</li>
      <li><strong>Le vrai budget :</strong> un niveau de prix par personne, transport compris, pas le tarif d'appel d'une brochure.</li>
      <li><strong>Les bonnes saisons :</strong> les fenêtres où la destination se montre sous son meilleur jour, pas celles où elle se vend le mieux.</li>
      <li><strong>Le décor et le rythme :</strong> mer, montagne, île, ville ou grands espaces, et ce qu'on y fait vraiment, du transat à l'aventure.</li>
      <li><strong>Les étapes des formats longs :</strong> au-delà d'une semaine, chaque proposition devient un itinéraire avec ses villes-étapes.</li>
    </ul>
    <p class="mb-4">Vos huit réponses traversent cette base comme un filtre. Et quand une combinaison est trop pointue, le test ne triche pas : il <strong>élargit un critère à la fois et vous dit lequel</strong>, plutôt que d'inventer une nuit à l'autre bout du monde.</p>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Où partir selon le temps devant vous</h2>
    <p class="mb-4">C'est le filtre que tous les classements ignorent, et c'est pourtant le premier qui compte : <strong>une durée change la nature du voyage</strong>. Voici comment le test raisonne, avec des exemples tirés de la base :</p>
    <div class="quiz-table-wrap">
      <table class="quiz-table">
        <thead>
          <tr><th>Votre format</th><th>Ce que le test propose</th><th>Exemples de la base</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>1 à 2 nuits</strong></td><td>Une échappée proche, zéro temps perdu en transport</td><td>Honfleur, Colmar, Gérardmer</td></tr>
          <tr><td><strong>3 nuits</strong></td><td>Une capitale européenne prise à la bonne dose</td><td>Amsterdam, Rome, Porto</td></tr>
          <tr><td><strong>4 à 7 jours</strong></td><td>Une région entière, avec le temps de s'y poser</td><td>Andalousie, Sicile, Tenerife</td></tr>
          <tr><td><strong>8 à 12 jours</strong></td><td>Un circuit à 3 ou 4 étapes, jamais huit jours au même endroit</td><td>Pays-Bas : Amsterdam, Haarlem, Utrecht, La Haye</td></tr>
          <tr><td><strong>2 semaines et plus</strong></td><td>Le grand voyage, itinéraire complet fourni</td><td>Tour d'Islande, Thaïlande, Polynésie française</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mb-4">La règle Amsterdam résume tout : <strong>trois nuits sur place, c'est une merveille ; huit jours, c'est une punition</strong>, la ville se traverse à vélo en vingt minutes. Sur un format long, le test bascule donc automatiquement sur le circuit Pays-Bas, moulins de Kinderdijk compris.</p>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">La bonne destination au bon moment</h2>
    <p class="mb-4">La saison fait ou défait un voyage, et les pires erreurs se réservent en deux clics sur n'importe quel comparateur. Notre base connaît les fenêtres de chaque destination, et les plus saisonnières, le ski, les aurores, les fjords, <strong>ne sortent jamais de la leur</strong> :</p>
    <div class="quiz-table-wrap">
      <table class="quiz-table">
        <thead>
          <tr><th>Saison</th><th>Les valeurs sûres de la base</th><th>L'erreur qu'on vous évite</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>Printemps</strong></td><td>Cyclades avant la foule, Andalousie encore douce, Amsterdam en fleurs</td><td>La montagne entre deux saisons, ni ski ni sentiers</td></tr>
          <tr><td><strong>Été</strong></td><td>Fjords de Norvège, Bretagne, lacs alpins</td><td>La Thaïlande en pleine mousson</td></tr>
          <tr><td><strong>Automne</strong></td><td>Rome sans la canicule, vignobles en vendanges, Istanbul</td><td>Les îles grecques qui ferment peu à peu</td></tr>
          <tr><td><strong>Hiver</strong></td><td>Les Trois Vallées, Laponie finlandaise, Tenerife au soleil</td><td>Réserver la Laponie... pour juillet</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Combien prévoir, transport compris</h2>
    <p class="mb-4">Un budget de voyage qui ne compte pas le transport est un mensonge commode. Ici, les quatre niveaux s'entendent <strong>par personne, vols ou essence compris</strong>, et aucune proposition ne dépassera jamais ce que vous avez déclaré :</p>
    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div class="card p-5">
        <h3 class="font-bold mb-2">Moins de 300 €</h3>
        <p class="text-muted-foreground">Le week-end malin, accessible en train ou en voiture : Honfleur, Gérardmer, les lacs, les vignobles. La France regorge de trésors à ce prix.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-bold mb-2">300 à 800 €</h3>
        <p class="text-muted-foreground">L'Europe s'ouvre en vols courts : Porto, Rome, Amsterdam, les Cyclades hors été, et les plus beaux formats d'une semaine en France.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-bold mb-2">800 à 1500 €</h3>
        <p class="text-muted-foreground">Le soleil lointain et les circuits : Tenerife, l'Islande, le Monténégro, la Thaïlande en s'y prenant tôt, les grands itinéraires européens.</p>
      </div>
      <div class="card p-5">
        <h3 class="font-bold mb-2">Plus de 1500 €</h3>
        <p class="text-muted-foreground">Le voyage d'une vie : Polynésie, Maldives, Bali, Japon, safaris. Les propositions affichent leurs étapes et leurs vraies durées.</p>
      </div>
    </div>
  </div>
</section>

<%# Un seul encart dans le texte, la lecture deja commencee. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Cinq façons de bien utiliser le test</h2>
    <ol class="list-decimal pl-6 space-y-2 mb-4">
      <li><strong>Fixez vos dates avant tout :</strong> la saison est le filtre le plus impitoyable de la base, autant lui donner la bonne information dès le départ.</li>
      <li><strong>Soyez honnêtes sur le budget :</strong> il inclut le transport, l'hébergement et la vie sur place. Un budget sincère donne une liste réservable, pas une liste de rêves.</li>
      <li><strong>Jouez-le deux fois :</strong> changez un seul critère entre les deux parties, la durée ou le budget, et regardez la sélection se transformer du tout au tout.</li>
      <li><strong>Répondez chacun de votre côté :</strong> comparez ensuite vos deux listes. Les destinations présentes dans les deux sont votre réponse.</li>
      <li><strong>Gardez les étapes proposées :</strong> sur les formats longs, l'itinéraire affiché est prêt à poser sur un carnet de réservation, ville par ville.</li>
    </ol>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Week-end ou vraies vacances : deux logiques opposées</h2>
    <p class="mb-4">C'est le vieux débat du couple, et il se tranche mieux quand on admet que <strong>les deux formats ne répondent pas aux mêmes règles</strong> :</p>
    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div class="card p-5">
        <h3 class="font-bold mb-3">🥐 Le week-end qui fait du bien</h3>
        <ul class="list-disc pl-5 space-y-2 text-muted-foreground">
          <li>Moins de trois heures de route ou de train, sinon le transport mange le séjour</li>
          <li>Un seul plaisir central : un spa, une grande table, un marché, une balade</li>
          <li>Deux nuits plutôt qu'une dès que possible, la vraie coupure commence au deuxième réveil</li>
          <li>L'insolite fait des merveilles : une cabane ou une bulle transforme 36 heures en souvenir durable</li>
        </ul>
      </div>
      <div class="card p-5">
        <h3 class="font-bold mb-3">🧳 Les vacances qui comptent</h3>
        <ul class="list-disc pl-5 space-y-2 text-muted-foreground">
          <li>Une région plutôt qu'un point sur la carte, pour changer de décor sans refaire sa valise chaque soir</li>
          <li>La saison se choisit avant la destination, jamais l'inverse</li>
          <li>Un rythme en deux temps : la découverte d'abord, le repos pour finir</li>
          <li>Le budget se calcule transport compris dès le premier jour, c'est lui qui décide du rayon d'action</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-4">Ce que vous obtenez à la fin</h2>
    <p class="mb-4">Une liste courte, <strong>quatre à huit propositions</strong>, chacune avec sa photo, sa fourchette de nuits, son niveau de budget et une phrase qui dit pourquoi elle vaut le détour. Les longs formats affichent leurs étapes conseillées, et la sélection de voyage Quiz Couple complète le tout avec des pistes concrètes pour réserver.</p>
    <p class="mb-4">Ensuite, refaites-le. Changez un seul critère et regardez la liste changer : c'est la meilleure façon d'arbitrer le débat montagne ou mer avec des arguments plutôt qu'avec de la mauvaise foi.</p>
    <p class="mb-4">Et si la question du moment est moins la destination que l'état de la relation, le <a href="<%= getLocalizedUrl('testCouple', 'fr') %>">test de couple en 20 questions</a> reste la meilleure porte d'entrée, et une <a href="<%= getLocalizedUrl('testDistance', 'fr') %>">relation à distance se teste aussi</a> avant de réserver à deux.</p>
  </div>
</section>

<section>
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Questions fréquentes</h2>
    <div class="space-y-4">
      <% for (const f of faq) { %>
      <div class="card p-5">
        <h3 class="font-bold mb-2"><%= f.q %></h3>
        <p class="text-muted-foreground"><%= f.a %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>
</div>

<%# La mention d'affiliation vit tout en bas de la page, discrète mais
    complète : l'information légale est là, sans coller une étiquette sous
    chaque bouton. %>
<div class="container mx-auto px-4 max-w-3xl">
  <p class="va-mention-affiliation">Certaines propositions de destinations peuvent être alimentées par des liens d'affiliation qui redirigent vers des partenaires de confiance. Nous pouvons toucher une commission sur vos réservations, ce qui nous permet de continuer à faire vivre le site ❤️</p>
</div>

<script src="/js/vacances-moteur.js" defer></script>
<script src="/js/vacances.js" defer></script>
