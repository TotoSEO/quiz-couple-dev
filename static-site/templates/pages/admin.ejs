<%
  // Admin page - review moderation dashboard
  // Not indexed by search engines (noindex meta handled in base.ejs)
%>
<meta name="robots" content="noindex, nofollow">

<section class="min-h-screen py-8">
  <div class="container mx-auto px-4 max-w-5xl">
    <div id="admin-app" data-url="<%= supabaseUrl %>" data-key="<%= supabaseKey %>">
      <!-- Login Screen (shown by default) -->
      <div id="admin-login" class="max-w-md mx-auto mt-20">
        <div class="glass-card-strong rounded-2xl p-8 text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold">Administration</h1>
            <p class="text-sm text-muted-foreground mt-1">Accès réservé à l'administrateur</p>
          </div>
          <div class="space-y-4">
            <div class="relative">
              <input type="password" id="admin-password" class="input w-full pr-10" placeholder="Mot de passe" autocomplete="current-password">
              <button type="button" id="admin-toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
                <svg class="w-4 h-4 eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="w-4 h-4 eye-closed hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
            <p id="admin-login-error" class="hidden text-sm text-destructive"></p>
            <button id="admin-login-btn" class="btn btn-primary w-full py-3">Se connecter</button>
          </div>
        </div>
      </div>

      <!-- Dashboard (hidden by default) -->
      <div id="admin-dashboard" class="hidden">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-border">
          <h1 class="text-2xl font-bold">Administration</h1>
          <div class="flex items-center gap-4">
            <div class="flex rounded-lg border border-border overflow-hidden">
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors active" data-tab="reviews">Avis</button>
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors" data-tab="articles">Articles</button>
            </div>
            <button id="admin-logout" class="text-sm text-destructive hover:text-destructive/80 transition-colors">Déconnexion</button>
          </div>
        </div>

        <!-- Reviews Tab -->
        <div id="admin-reviews-tab">
          <!-- Stats cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-lg">⭐</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-avg">-</p>
                <p class="text-xs text-muted-foreground">Note moyenne</p>
              </div>
            </div>
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-lg">🕐</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-pending">-</p>
                <p class="text-xs text-muted-foreground">En attente</p>
              </div>
            </div>
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-lg">✅</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-approved">-</p>
                <p class="text-xs text-muted-foreground">Approuvés</p>
              </div>
            </div>
          </div>

          <!-- Filters -->
          <div class="flex items-center gap-3 mb-6 flex-wrap">
            <button id="admin-refresh" class="btn btn-outline btn-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
              Actualiser
            </button>
            <div class="flex rounded-lg border border-border overflow-hidden">
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors active" data-filter="all">Tous <span id="admin-filter-all-count"></span></button>
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors" data-filter="pending">En attente <span id="admin-filter-pending-count"></span></button>
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors" data-filter="approved">Approuvés <span id="admin-filter-approved-count"></span></button>
            </div>
          </div>

          <!-- Reviews list -->
          <div id="admin-reviews-list" class="space-y-4">
            <p class="text-center text-muted-foreground py-8">Chargement...</p>
          </div>
        </div>

        <!-- Articles Tab -->
        <div id="admin-articles-tab" class="hidden" style="max-width:100%;overflow:hidden;">
          <!-- Article List View -->
          <div id="articles-list-view">
            <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
              <h2 class="text-lg font-semibold">Articles du blog</h2>
              <div class="flex items-center gap-2">
                <button id="articles-create" class="btn btn-primary btn-sm">+ Nouvel article</button>
                <button id="articles-refresh" class="btn btn-outline btn-sm">
                  <svg class="w-4 h-4 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                  Actualiser
                </button>
              </div>
            </div>
            <div id="articles-list" class="space-y-3">
              <p class="text-center text-muted-foreground py-8">Chargement...</p>
            </div>
          </div>

          <!-- Article Editor View -->
          <div id="article-editor-view" class="hidden" style="max-width:100%;overflow:hidden;">
            <div class="flex items-center gap-3 mb-6">
              <button id="article-back" class="btn btn-outline btn-sm">← Retour</button>
              <h2 class="text-lg font-semibold" id="article-editor-title" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">Modifier l'article</h2>
            </div>

            <!-- Image Upload -->
            <div class="glass-card rounded-xl p-5 mb-6" style="overflow:hidden;">
              <h3 class="font-semibold mb-3">Image à la une</h3>
              <div style="display:flex;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
                <div id="article-image-preview" style="width:12rem;height:8rem;border-radius:0.5rem;overflow:hidden;flex-shrink:0;background:hsl(var(--muted));display:flex;align-items:center;justify-content:center;color:hsl(var(--muted-foreground));font-size:0.875rem;">
                  Aucune image
                </div>
                <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:0.5rem;">
                  <input type="file" id="article-image-input" accept="image/webp,image/jpeg,image/png" style="font-size:0.875rem;max-width:100%;overflow:hidden;">
                  <button id="article-image-upload-btn" class="btn btn-primary btn-sm hidden">Uploader l'image</button>
                  <p id="article-image-status" class="text-sm text-muted-foreground"></p>
                </div>
              </div>
            </div>

            <!-- Language Tabs -->
            <div class="flex rounded-lg border border-border overflow-hidden mb-4">
              <button class="lang-tab px-4 py-2 text-sm font-medium transition-colors active" data-lang="fr">FR</button>
              <button class="lang-tab px-4 py-2 text-sm font-medium transition-colors" data-lang="en">EN</button>
              <button class="lang-tab px-4 py-2 text-sm font-medium transition-colors" data-lang="es">ES</button>
              <button class="lang-tab px-4 py-2 text-sm font-medium transition-colors" data-lang="de">DE</button>
              <button class="lang-tab px-4 py-2 text-sm font-medium transition-colors" data-lang="it">IT</button>
            </div>

            <!-- Translation Form -->
            <div class="glass-card rounded-xl p-5 space-y-4" style="overflow:hidden;">
              <div>
                <label class="block text-sm font-medium mb-1">Slug</label>
                <input type="text" id="article-field-slug" class="input" style="width:100%;max-width:100%;box-sizing:border-box;" placeholder="slug-de-l-article">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">H1 (Titre principal de la page)</label>
                <input type="text" id="article-field-title" class="input" style="width:100%;max-width:100%;box-sizing:border-box;" placeholder="Titre H1 de l'article">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Title (balise &lt;title&gt;)</label>
                <input type="text" id="article-field-meta-title" class="input" style="width:100%;max-width:100%;box-sizing:border-box;" placeholder="Balise title pour le SEO">
                <p class="text-xs text-muted-foreground mt-1">Idéalement 50-60 caractères. <span id="meta-title-count" class="font-medium">0</span>/60</p>
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Meta description</label>
                <textarea id="article-field-meta-description" class="input" rows="3" style="width:100%;max-width:100%;box-sizing:border-box;" placeholder="Description pour les moteurs de recherche"></textarea>
                <p class="text-xs text-muted-foreground mt-1">Idéalement 150-160 caractères. <span id="meta-desc-count" class="font-medium">0</span>/160</p>
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Alt de l'image à la une</label>
                <input type="text" id="article-field-alt" class="input" style="width:100%;max-width:100%;box-sizing:border-box;" placeholder="Texte alternatif de l'image">
              </div>
              <div class="flex items-center gap-3 pt-2">
                <button id="article-save-lang" class="btn btn-primary">Enregistrer cette langue</button>
                <span id="article-save-status" class="text-sm text-muted-foreground"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/admin.js" defer></script>
