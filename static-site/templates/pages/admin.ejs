<%
  // Admin page - review moderation dashboard
  // Not indexed by search engines (noindex meta handled in base.ejs)
%>

<section class="min-h-screen py-8">
  <div class="container mx-auto px-4 max-w-5xl">
    <div id="admin-app" data-url="<%= supabaseUrl %>" data-key="<%= supabaseKey %>">
      <!-- Login Screen (shown by default) -->
      <div id="admin-login" class="max-w-md mx-auto mt-20">
        <div class="glass-card-strong rounded-2xl p-8 text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-8 h-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold">Administration</h1>
            <p class="text-sm text-muted-foreground mt-1">Accès réservé à l'administrateur</p>
          </div>
          <div class="space-y-4">
            <div class="relative">
              <input type="password" id="admin-password" class="input w-full pr-10" placeholder="Mot de passe" autocomplete="current-password">
              <button type="button" id="admin-toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
                <svg class="w-4 h-4 eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="w-4 h-4 eye-closed hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
            <p id="admin-login-error" class="hidden text-sm text-destructive"></p>
            <button id="admin-login-btn" class="btn btn-primary w-full py-3">Se connecter</button>
          </div>
        </div>
      </div>

      <!-- Dashboard (hidden by default) -->
      <div id="admin-dashboard" class="hidden">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-border flex-wrap gap-3">
          <h1 class="text-2xl font-bold">Administration</h1>
          <div class="flex items-center gap-4 flex-wrap">
            <div class="flex rounded-lg border border-border overflow-hidden">
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors active" data-tab="reviews">Avis<span class="admin-pastille hidden" data-notif="reviews">!</span></button>
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors" data-tab="leads">Leads<span class="admin-pastille hidden" data-notif="leads">!</span></button>
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors" data-tab="messages">Messagerie<span class="admin-pastille hidden" data-notif="messages">!</span></button>
              <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors" data-tab="stats">Stats</button>
            <button class="admin-tab px-4 py-2 text-sm font-medium transition-colors" data-tab="affiliation">Affiliation</button>
            </div>
            <%# Le site est statique : ce qui est saisi ici vit dans Supabase et
                n'apparaît en ligne qu'après une reconstruction. Elle a lieu
                toute seule toutes les deux heures ; ce bouton la déclenche
                tout de suite. L'intitulé seul ne le disait pas. %>
            <button id="admin-deploy" class="btn btn-sm"
                    title="Reconstruit le site tout de suite pour publier les articles et avis enregistrés ici. Sans ça, la mise en ligne se fait toute seule dans les deux heures."
                    style="background:hsl(var(--primary));color:white;display:flex;align-items:center;gap:0.5rem;">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Publier maintenant
            </button>
            <button id="admin-logout" class="text-sm text-destructive hover:text-destructive/80 transition-colors">Deconnexion</button>
          </div>
        </div>

        <!-- Deploy status banner (hidden by default) -->
        <div id="deploy-banner" class="hidden mb-6 rounded-xl p-4" style="border:1px solid hsl(var(--primary)/0.3);background:hsl(var(--primary)/0.05);">
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <div id="deploy-spinner" class="hidden" style="width:1.25rem;height:1.25rem;border:2px solid hsl(var(--primary)/0.3);border-top-color:hsl(var(--primary));border-radius:50%;animation:spin 0.6s linear infinite;flex-shrink:0;"></div>
            <svg id="deploy-icon-success" class="hidden w-5 h-5 flex-shrink-0" style="color:hsl(142 71% 45%);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <svg id="deploy-icon-error" class="hidden w-5 h-5 flex-shrink-0" style="color:hsl(var(--destructive));" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <p id="deploy-message" class="text-sm font-medium"></p>
          </div>
        </div>

        <!-- Global Stats -->
        <div class="mb-6">
          <div class="glass-card rounded-xl p-4 flex items-center gap-3" style="max-width:280px;">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-lg" style="background:hsl(200 80% 92%);color:hsl(200 80% 45%);">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p class="text-2xl font-bold" id="admin-stat-activities">-</p>
              <p class="text-xs text-muted-foreground">Validations Activités</p>
            </div>
          </div>
        </div>

        <!-- Reviews Tab -->
        <div id="admin-reviews-tab">
          <!-- Stats cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-lg">⭐</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-avg">-</p>
                <p class="text-xs text-muted-foreground">Note moyenne</p>
              </div>
            </div>
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-lg">🕐</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-pending">-</p>
                <p class="text-xs text-muted-foreground">En attente</p>
              </div>
            </div>
            <div class="glass-card rounded-xl p-4 flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-lg">✅</div>
              <div>
                <p class="text-2xl font-bold" id="admin-stat-approved">-</p>
                <p class="text-xs text-muted-foreground">Approuvés</p>
              </div>
            </div>
          </div>

          <!-- Filters -->
          <div class="flex items-center gap-3 mb-6 flex-wrap">
            <button id="admin-refresh" class="btn btn-outline btn-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
              Actualiser
            </button>
            <div class="flex rounded-lg border border-border overflow-hidden">
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors active" data-filter="all">Tous <span id="admin-filter-all-count"></span></button>
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors" data-filter="pending">En attente <span id="admin-filter-pending-count"></span></button>
              <button class="admin-filter px-3 py-1.5 text-sm transition-colors" data-filter="approved">Approuvés <span id="admin-filter-approved-count"></span></button>
            </div>
          </div>

          <!-- Reviews list -->
          <div id="admin-reviews-list" class="space-y-4">
            <p class="text-center text-muted-foreground py-8">Chargement...</p>
          </div>
        </div>

        <!-- Stats Tab -->
        <div id="admin-stats-tab" class="hidden">
          <!-- KPI cards -->
          <div class="stats-kpis">
            <div class="stats-kpi">
              <div class="stats-kpi-icon" style="background:linear-gradient(135deg,hsl(var(--primary)),hsl(var(--secondary)));">🎯</div>
              <div>
                <p class="stats-kpi-value" id="admin-stats-total">-</p>
                <p class="stats-kpi-label">Tests &amp; quiz réalisés (total)</p>
              </div>
            </div>
            <div class="stats-kpi">
              <div class="stats-kpi-icon" style="background:linear-gradient(135deg,hsl(200 80% 55%),hsl(255 60% 62%));">📅</div>
              <div>
                <p class="stats-kpi-value" id="admin-stats-today">-</p>
                <p class="stats-kpi-label">Aujourd'hui</p>
              </div>
            </div>
            <div class="stats-kpi">
              <div class="stats-kpi-icon" style="background:linear-gradient(135deg,hsl(150 60% 45%),hsl(190 65% 48%));">📈</div>
              <div>
                <p class="stats-kpi-value" id="admin-stats-30d">-</p>
                <p class="stats-kpi-label">30 derniers jours</p>
              </div>
            </div>
          </div>

          <!-- Tops et flops : pages en hausse et en baisse, replie par defaut -->
          <details class="stats-details">
            <summary>
              <span class="stats-details-emoji" aria-hidden="true">🚀</span>
              <span>
                <span class="stats-details-titre">Tops et flops</span>
                <span class="stats-details-sub">Les 5 pages qui montent et les 5 qui baissent</span>
              </span>
              <svg class="stats-details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="stats-details-corps">
              <div class="stats-comp" role="group" aria-label="Comparaison">
                <button class="stats-comp-btn" data-comp="1">Aujourd'hui vs hier</button>
                <button class="stats-comp-btn active" data-comp="7">7 j vs 7 j précédents</button>
                <button class="stats-comp-btn" data-comp="30">30 j vs 30 j précédents</button>
              </div>
              <div class="stats-movers">
                <div>
                  <h3 class="stats-movers-titre">📈 En hausse</h3>
                  <div id="admin-movers-hausse"><p class="stats-movers-vide">Chargement...</p></div>
                </div>
                <div>
                  <h3 class="stats-movers-titre">📉 En baisse</h3>
                  <div id="admin-movers-baisse"><p class="stats-movers-vide">Chargement...</p></div>
                </div>
              </div>
            </div>
          </details>

          <!-- Total daily evolution curve -->
          <div class="stats-panel">
            <div class="stats-panel-head">
              <div>
                <h2 class="stats-panel-title">Évolution quotidienne</h2>
                <p class="stats-panel-sub">Nombre total de tests &amp; quiz réalisés chaque jour.</p>
              </div>
              <div class="stats-range" role="group" aria-label="Période">
                <button class="stats-range-btn active" data-range="30">30 j</button>
                <button class="stats-range-btn" data-range="90">90 j</button>
                <button class="stats-range-btn" data-range="365">1 an</button>
              </div>
            </div>
            <canvas id="admin-stats-total-chart" class="stats-canvas" style="height:220px;"></canvas>
          </div>

          <!-- Per-quiz breakdown + selected curve, replies par defaut -->
          <details class="stats-details">
            <summary>
              <span class="stats-details-emoji" aria-hidden="true">📋</span>
              <span>
                <span class="stats-details-titre">Toutes les pages, test par test</span>
                <span class="stats-details-sub">Total, parties du jour en vert, courbe au clic</span>
              </span>
              <svg class="stats-details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="stats-details-corps">
              <p class="stats-panel-sub" style="margin-bottom:0.6rem;">Cliquez sur un quiz pour voir sa courbe sur 30 jours.</p>
              <div id="admin-stats-list" class="stats-list"></div>
              <div class="stats-souscourbe">
                <h3 class="stats-panel-title" id="admin-stats-chart-title" style="font-size:0.95rem;">Sélectionnez un quiz ci-dessus</h3>
                <canvas id="admin-stats-chart" class="stats-canvas" style="height:180px;"></canvas>
              </div>
            </div>
          </details>
        </div>

        <!-- Leads Tab -->
        <div id="admin-leads-tab" class="hidden">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <h2 class="text-lg font-semibold">Leads</h2>
            <button id="leads-refresh" class="btn btn-outline btn-sm">
              <svg class="w-4 h-4 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
              Actualiser
            </button>
          </div>
          <div class="glass-card rounded-xl overflow-hidden">
            <div style="overflow-x:auto;">
              <table id="leads-table" style="width:100%;border-collapse:collapse;font-size:0.875rem;">
                <thead style="background:hsl(var(--muted));">
                  <tr>
                    <th style="padding:0.75rem 1rem;text-align:left;font-weight:600;">Prénom</th>
                    <th style="padding:0.75rem 1rem;text-align:left;font-weight:600;">Adresse e-mail</th>
                    <th style="padding:0.75rem 1rem;text-align:left;font-weight:600;">Sujet</th>
                    <th style="padding:0.75rem 1rem;text-align:left;font-weight:600;">Date</th>
                    <th style="padding:0.75rem 1rem;text-align:center;font-weight:600;">Vérifié</th>
                    <th style="padding:0.75rem 1rem;text-align:center;font-weight:600;">Clôturé</th>
                  </tr>
                </thead>
                <tbody id="leads-table-body">
                  <tr><td colspan="5" style="padding:2rem;text-align:center;color:hsl(var(--muted-foreground));">Chargement...</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Messages Tab -->
        <div id="admin-messages-tab" class="hidden">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <h2 class="text-lg font-semibold">Messagerie</h2>
            <div class="flex items-center gap-2 flex-wrap">
              <div class="flex rounded-lg border border-border overflow-hidden">
                <button class="messages-filter px-3 py-1.5 text-sm transition-colors active" data-filter="all">Tous</button>
                <button class="messages-filter px-3 py-1.5 text-sm transition-colors" data-filter="new">Nouveaux</button>
                <button class="messages-filter px-3 py-1.5 text-sm transition-colors" data-filter="read">Lus</button>
                <button class="messages-filter px-3 py-1.5 text-sm transition-colors" data-filter="archived">Archivés</button>
              </div>
              <button id="messages-refresh" class="btn btn-outline btn-sm">
                <svg class="w-4 h-4 inline-block mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
                Actualiser
              </button>
            </div>
          </div>
          <div id="messages-list" class="space-y-3">
            <p class="text-center text-muted-foreground py-8">Chargement...</p>
          </div>
        </div>

        <!-- Affiliation Tab -->
        <div id="admin-affiliation-tab" class="hidden">

          <!-- Saisie du jeton. Il n'est jamais écrit dans le dépôt : le site
               est statique et public, tout ce qui est construit est lisible
               par n'importe qui. Il reste dans ce navigateur. -->
          <div id="afl-gate" class="afl-gate hidden">
            <div class="afl-gate-card">
              <span class="afl-gate-icon" aria-hidden="true">🔑</span>
              <h2 class="afl-gate-title">Connecter Affilae</h2>
              <p class="afl-gate-text">Collez votre jeton d'API Affilae. Il est enregistré dans ce navigateur uniquement, jamais sur le site.</p>
              <input type="password" id="afl-token-input" class="input w-full" placeholder="eyJhbGciOi..." autocomplete="off" spellcheck="false">
              <p id="afl-gate-error" class="afl-gate-error hidden"></p>
              <button id="afl-token-save" class="btn btn-primary w-full">Connecter</button>
              <p class="afl-gate-hint">Le jeton se crée dans Affilae, menu « Jetons d'API ». Il peut être révoqué à tout moment.</p>
            </div>
          </div>

          <div id="afl-board" class="hidden">

            <!-- Barre de contrôle -->
            <div class="afl-bar">
              <div class="afl-bar-left">
                <select id="afl-profile" class="afl-select" aria-label="Site"></select>
                <div class="afl-range" role="group" aria-label="Période">
                  <button class="afl-range-btn" data-days="7">7 j</button>
                  <button class="afl-range-btn active" data-days="30">30 j</button>
                  <button class="afl-range-btn" data-days="90">90 j</button>
                  <button class="afl-range-btn" data-days="365">1 an</button>
                </div>
              </div>
              <div class="afl-bar-right">
                <span id="afl-updated" class="afl-updated"></span>
                <button id="afl-refresh" class="afl-icon-btn" title="Actualiser" aria-label="Actualiser">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 11-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                </button>
                <button id="afl-forget" class="afl-icon-btn afl-icon-btn--danger" title="Oublier le jeton" aria-label="Oublier le jeton">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg>
                </button>
              </div>
            </div>

            <p id="afl-error" class="afl-error hidden"></p>

            <!-- Indicateurs -->
            <div class="afl-kpis">
              <div class="afl-kpi"><span class="afl-kpi-label">Clics</span><span class="afl-kpi-value" id="afl-kpi-clicks">-</span></div>
              <div class="afl-kpi"><span class="afl-kpi-label">Conversions</span><span class="afl-kpi-value" id="afl-kpi-conv">-</span></div>
              <div class="afl-kpi afl-kpi--phare"><span class="afl-kpi-label">Commissions</span><span class="afl-kpi-value" id="afl-kpi-commissions">-</span></div>
              <div class="afl-kpi"><span class="afl-kpi-label">Gain par clic</span><span class="afl-kpi-value" id="afl-kpi-epc">-</span></div>
            </div>

            <!-- Partenariats -->
            <section class="afl-panel">
              <div class="afl-panel-head">
                <div>
                  <h2 class="afl-panel-title">Partenariats</h2>
                  <p class="afl-panel-sub" id="afl-part-sub">&nbsp;</p>
                </div>
                <div class="afl-chips" role="group" aria-label="Filtrer par statut">
                  <button class="afl-chip active" data-statut="tous">Tous</button>
                  <button class="afl-chip" data-statut="active">Acceptés</button>
                  <button class="afl-chip" data-statut="pending">En attente</button>
                </div>
              </div>
              <div class="afl-tablewrap">
                <table class="afl-table">
                  <thead>
                    <tr>
                      <th class="afl-sort" data-tri="nom">Programme</th>
                      <th>Statut</th>
                      <th class="afl-hide-sm">Rémunération</th>
                      <th class="afl-num afl-sort" data-tri="clics">Clics</th>
                      <th class="afl-num afl-sort" data-tri="conv">Conv.</th>
                      <th class="afl-num afl-sort" data-tri="gains">Gains</th>
                    </tr>
                  </thead>
                  <tbody id="afl-part-body"></tbody>
                </table>
              </div>
            </section>

            <!-- Générateur de liens -->
            <section class="afl-panel">
              <div class="afl-panel-head">
                <div>
                  <h2 class="afl-panel-title">Générer un lien tracké</h2>
                  <p class="afl-panel-sub">Choisissez le programme, la page de destination et un identifiant pour savoir d'où vient le clic.</p>
                </div>
              </div>
              <div class="afl-gen">
                <label class="afl-field">
                  <span>Programme</span>
                  <select id="afl-gen-part" class="afl-select afl-select--full"></select>
                </label>
                <label class="afl-field">
                  <span>Page de destination <em>(optionnel)</em></span>
                  <input type="url" id="afl-gen-url" class="input" placeholder="https://exemple.com/une-page" autocomplete="off" spellcheck="false">
                </label>
                <label class="afl-field">
                  <span>D'où vient le clic <em>(optionnel)</em></span>
                  <input type="text" id="afl-gen-sub" class="input" placeholder="guide-cadeaux" autocomplete="off" spellcheck="false">
                </label>
                <button id="afl-gen-btn" class="btn btn-primary afl-gen-btn">Générer</button>
              </div>
              <div id="afl-gen-out" class="afl-gen-out hidden">
                <code id="afl-gen-link"></code>
                <button id="afl-gen-copy" class="afl-copy">Copier</button>
              </div>
              <p id="afl-gen-note" class="afl-gen-note hidden"></p>
            </section>

            <!-- Dernières conversions -->
            <section class="afl-panel">
              <div class="afl-panel-head">
                <div>
                  <h2 class="afl-panel-title">Dernières conversions</h2>
                  <p class="afl-panel-sub" id="afl-conv-sub">&nbsp;</p>
                </div>
              </div>
              <div id="afl-conv-list" class="afl-conv-list"></div>
            </section>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin{to{transform:rotate(360deg)}}
  /* ── Stats tab ── */
  .stats-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem;}
  .stats-kpi{display:flex;align-items:center;gap:0.9rem;padding:1.1rem 1.25rem;border-radius:1rem;background:hsl(var(--card));border:1px solid hsl(var(--border));box-shadow:0 4px 16px -8px hsl(var(--primary)/0.18);}
  .stats-kpi-icon{width:2.75rem;height:2.75rem;border-radius:0.85rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;color:#fff;flex-shrink:0;box-shadow:0 4px 12px -4px hsl(var(--primary)/0.5);}
