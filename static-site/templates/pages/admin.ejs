  .stats-kpi-label{font-size:0.72rem;color:hsl(var(--muted-foreground));margin-top:0.25rem;text-transform:uppercase;letter-spacing:0.03em;font-weight:600;}
  .stats-panel{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;padding:1.35rem 1.4rem;margin-bottom:1.5rem;box-shadow:0 4px 16px -10px hsl(var(--primary)/0.15);}
  .stats-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}
  .stats-panel-title{font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;margin:0;}
  .stats-panel-sub{font-size:0.8rem;color:hsl(var(--muted-foreground));margin:0.15rem 0 0;}
  .stats-range{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;flex-shrink:0;}
  .stats-range-btn{padding:0.35rem 0.85rem;font-size:0.8rem;font-weight:600;background:transparent;border:none;cursor:pointer;color:hsl(var(--muted-foreground));transition:background .15s,color .15s;}
  .stats-range-btn.active{background:hsl(var(--primary));color:#fff;}
  .stats-canvas{width:100%;display:block;}
  .stats-list{display:flex;flex-direction:column;gap:0.15rem;}
  .stats-row{display:flex;align-items:center;gap:0.75rem;width:100%;text-align:left;background:none;border:none;padding:0.5rem 0.4rem;cursor:pointer;color:inherit;border-radius:0.5rem;transition:background .15s;}
  .stats-row:hover{background:hsl(var(--muted)/0.6);}
  .stats-row.active{background:hsl(var(--primary)/0.1);}
  .stats-row-name{flex:0 0 11rem;font-size:0.82rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .stats-row-bar{flex:1;height:0.55rem;border-radius:9999px;background:hsl(var(--muted));overflow:hidden;}
  .stats-row-bar>span{display:block;height:100%;border-radius:9999px;background:linear-gradient(90deg,hsl(var(--primary)),hsl(var(--secondary)));}
  .stats-row-val{flex:0 0 3rem;text-align:right;font-weight:700;font-variant-numeric:tabular-nums;font-size:0.9rem;}
  .stats-row-jour{flex:0 0 2.7rem;text-align:right;font-size:0.78rem;font-weight:700;font-variant-numeric:tabular-nums;color:hsl(150 62% 38%);}
  .dark .stats-row-jour{color:hsl(150 55% 55%);}
  .stats-row-jour.est-zero{color:hsl(var(--muted-foreground)/0.45);font-weight:500;}
  @media (max-width:520px){.stats-row-name{flex-basis:6.5rem;}.stats-row-jour{flex-basis:2.2rem;}}

  /* ── Sections repliables (sommaire) ── */
  .stats-details{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;margin-bottom:1.5rem;box-shadow:0 4px 16px -10px hsl(var(--primary)/0.15);}
  .stats-details summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:0.85rem;padding:1.05rem 1.4rem;border-radius:1rem;transition:background .15s;}
  .stats-details summary::-webkit-details-marker{display:none;}
  .stats-details summary:hover{background:hsl(var(--muted)/0.5);}
  .stats-details-emoji{font-size:1.25rem;flex-shrink:0;}
  .stats-details-titre{display:block;font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;}
  .stats-details-sub{display:block;font-size:0.78rem;color:hsl(var(--muted-foreground));margin-top:0.1rem;}
  .stats-details-chevron{width:1.15rem;height:1.15rem;margin-left:auto;flex-shrink:0;color:hsl(var(--muted-foreground));transition:transform .2s;}
  .stats-details[open] .stats-details-chevron{transform:rotate(180deg);}
  .stats-details-corps{padding:0.25rem 1.4rem 1.35rem;}
  @media (max-width:520px){.stats-details summary{padding:0.95rem 1rem;}.stats-details-corps{padding:0.25rem 1rem 1.1rem;}}

  /* ── Tops et flops ── */
  .stats-comp{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;max-width:100%;}
  .stats-comp-btn{padding:0.35rem 0.8rem;font-size:0.78rem;font-weight:600;background:transparent;border:none;cursor:pointer;color:hsl(var(--muted-foreground));transition:background .15s,color .15s;white-space:nowrap;}
  .stats-comp-btn.active{background:hsl(var(--primary));color:#fff;}
  @media (max-width:560px){
    div:has(> .stats-comp){max-width:100%;overflow-x:auto;scrollbar-width:none;}
    .stats-comp{flex-shrink:0;}
  }
  .stats-movers{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.1rem;}
  @media (max-width:700px){.stats-movers{grid-template-columns:1fr;}}
  .stats-movers-titre{font-size:0.85rem;font-weight:700;margin-bottom:0.5rem;}
  .stats-movers-vide{font-size:0.82rem;color:hsl(var(--muted-foreground));padding:0.4rem 0;}
  .stats-mover{display:flex;align-items:center;gap:0.6rem;padding:0.42rem 0.4rem;border-radius:0.5rem;}
  .stats-mover:nth-child(odd){background:hsl(var(--muted)/0.35);}
  .stats-mover-nom{flex:1;font-size:0.82rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;}
  .stats-mover-vals{font-size:0.76rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;white-space:nowrap;}
  .stats-mover-delta{font-size:0.76rem;font-weight:700;padding:0.14rem 0.5rem;border-radius:999px;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .stats-mover-delta.est-plus{background:hsl(150 62% 40%/0.13);color:hsl(150 62% 32%);}
  .dark .stats-mover-delta.est-plus{color:hsl(150 55% 60%);}
  .stats-mover-delta.est-moins{background:hsl(0 72% 52%/0.12);color:hsl(0 72% 42%);}
  .dark .stats-mover-delta.est-moins{color:hsl(0 80% 68%);}

  .stats-souscourbe{margin-top:1.1rem;padding-top:1rem;border-top:1px solid hsl(var(--border));}

  /* Les groupes de boutons segmentés (onglets, filtres avis, filtres messages)
     sont des .flex qui ne rétrécissent pas : sur téléphone ils dépassaient de
     la vue et décalaient toute la page vers la droite, quel que soit l'onglet
     affiché. On les borne à la largeur disponible et on les laisse défiler. */
  @media (max-width:520px){
    div:has(> .admin-filter),
    div:has(> .messages-filter),
    div:has(> .admin-tab){
      max-width:100%;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;
    }
    div:has(> .admin-filter)::-webkit-scrollbar,
    div:has(> .messages-filter)::-webkit-scrollbar,
    div:has(> .admin-tab)::-webkit-scrollbar{display:none;}
    .admin-filter,.messages-filter,.admin-tab{white-space:nowrap;flex-shrink:0;}
    .admin-filter,.messages-filter{padding-left:.65rem;padding-right:.65rem;font-size:.8rem;}
    /* Un élément flex a min-width:auto par défaut et refuse donc de descendre
       sous la largeur de son contenu : sans cette ligne le conteneur des
       onglets reste plus large que l'écran et le défilement interne ne sert
       à rien. */
    div:has(> div > .admin-tab){min-width:0;}
    .admin-tab{padding-left:.7rem;padding-right:.7rem;}

    .stats-repere{
      position:absolute;z-index:19;pointer-events:none;
      width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:9999px;
      background:#7C5AD0;box-shadow:0 0 0 2px hsl(var(--card));
    }
  }

  /* ═══ Onglet Affiliation ═══════════════════════════════════
     Tableau de bord dense mais calme : on lit d'abord les quatre
     chiffres, ensuite le détail par partenaire. Tout passe par les
     variables du site, donc le mode sombre suit sans règle en plus. */

  /* .hidden vaut display:none dans la feuille principale, mais ce bloc-ci est
     chargé après elle : à spécificité égale mes display:flex et display:grid
     gagnaient, et les éléments masqués restaient à l'écran. On rend donc la
     classe prioritaire pour tout l'onglet. */
  #admin-affiliation-tab .hidden{display:none !important;}

  /* Écran de connexion au jeton */
  .afl-gate{display:flex;justify-content:center;padding:2rem 0 3rem;}
  .afl-gate-card{width:100%;max-width:26rem;display:grid;gap:.85rem;padding:2rem 1.75rem;border-radius:1.25rem;
    background:hsl(var(--card));border:1px solid hsl(var(--border));box-shadow:0 20px 48px -32px hsl(var(--primary)/.5);text-align:center;}
  .afl-gate-icon{font-size:2rem;line-height:1;}
  .afl-gate-title{font-family:'Poppins','Inter',sans-serif;font-size:1.2rem;font-weight:700;margin:0;}
  .afl-gate-text{font-size:.88rem;color:hsl(var(--muted-foreground));margin:0;line-height:1.55;}
  .afl-gate-hint{font-size:.75rem;color:hsl(var(--muted-foreground));margin:0;}
  .afl-gate-error{font-size:.82rem;color:hsl(var(--destructive));margin:0;}

  /* Barre de contrôle */
  .afl-bar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1.25rem;}
  .afl-bar-left,.afl-bar-right{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;}
  .afl-select{appearance:none;padding:.45rem 2rem .45rem .8rem;border-radius:.65rem;border:1px solid hsl(var(--border));
    background:hsl(var(--card));color:hsl(var(--foreground));font-size:.85rem;font-weight:600;cursor:pointer;
    background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);
    background-position:calc(100% - 1rem) 55%,calc(100% - .7rem) 55%;background-size:.3rem .3rem,.3rem .3rem;background-repeat:no-repeat;}
  .afl-select--full{width:100%;}
  .afl-range{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;background:hsl(var(--card));}
  .afl-range-btn{padding:.4rem .8rem;font-size:.8rem;font-weight:600;background:transparent;border:none;cursor:pointer;
    color:hsl(var(--muted-foreground));transition:background .15s,color .15s;}
  .afl-range-btn:hover{color:hsl(var(--foreground));}
  .afl-range-btn.active{background:hsl(var(--primary));color:#fff;}
  .afl-updated{font-size:.72rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .afl-icon-btn{width:2.1rem;height:2.1rem;display:inline-flex;align-items:center;justify-content:center;border-radius:.6rem;
    border:1px solid hsl(var(--border));background:hsl(var(--card));color:hsl(var(--muted-foreground));cursor:pointer;transition:all .15s;}
  .afl-icon-btn svg{width:1rem;height:1rem;}
  .afl-icon-btn:hover{color:hsl(var(--primary));border-color:hsl(var(--primary)/.4);}
  .afl-icon-btn--danger:hover{color:hsl(var(--destructive));border-color:hsl(var(--destructive)/.4);}
  .afl-icon-btn.tourne svg{animation:spin .7s linear infinite;}
  .afl-error{padding:.75rem 1rem;border-radius:.75rem;background:hsl(var(--destructive)/.1);
    border:1px solid hsl(var(--destructive)/.3);color:hsl(var(--destructive));font-size:.85rem;margin-bottom:1rem;}

  /* Indicateurs */
  .afl-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.75rem;margin-bottom:1.5rem;}
  .afl-kpi{display:grid;gap:.3rem;padding:1.1rem 1.2rem;border-radius:1rem;background:hsl(var(--card));
    border:1px solid hsl(var(--border));box-shadow:0 4px 16px -12px hsl(var(--primary)/.4);}
  .afl-kpi-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:hsl(var(--muted-foreground));}
  .afl-kpi-value{font-family:'Poppins','Inter',sans-serif;font-size:1.55rem;font-weight:800;line-height:1.05;
    font-variant-numeric:tabular-nums;white-space:nowrap;}
  .afl-kpi--phare{border-color:hsl(var(--primary)/.35);background:hsl(var(--primary)/.05);}
  .afl-kpi--phare .afl-kpi-value{color:hsl(var(--primary));}

  /* Panneaux */
  .afl-panel{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;
    padding:1.35rem 1.4rem;margin-bottom:1.25rem;box-shadow:0 4px 16px -12px hsl(var(--primary)/.3);}
  .afl-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}
  .afl-panel-title{font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;margin:0;}
  .afl-panel-sub{font-size:.8rem;color:hsl(var(--muted-foreground));margin:.15rem 0 0;}
  .afl-chips{display:inline-flex;gap:.35rem;flex-wrap:wrap;}
  .afl-chip{padding:.3rem .75rem;border-radius:999px;border:1px solid hsl(var(--border));background:transparent;
    font-size:.78rem;font-weight:600;color:hsl(var(--muted-foreground));cursor:pointer;transition:all .15s;}
  .afl-chip:hover{color:hsl(var(--foreground));}
  .afl-chip.active{background:hsl(var(--primary));border-color:hsl(var(--primary));color:#fff;}

  /* Tableau */
  .afl-tablewrap{overflow-x:auto;margin:0 -.4rem;}
  .afl-table{width:100%;border-collapse:collapse;font-size:.85rem;min-width:32rem;}
  .afl-table th{text-align:left;padding:.5rem .55rem;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;
    font-weight:700;color:hsl(var(--muted-foreground));border-bottom:1px solid hsl(var(--border));white-space:nowrap;}
  .afl-table td{padding:.65rem .55rem;border-bottom:1px solid hsl(var(--border)/.6);vertical-align:middle;}
  .afl-table tbody tr:last-child td{border-bottom:0;}
  .afl-table tbody tr{transition:background .15s;}
  .afl-table tbody tr:hover{background:hsl(var(--muted)/.5);}
  .afl-num{text-align:right;font-variant-numeric:tabular-nums;}
  .afl-sort{cursor:pointer;user-select:none;}
  .afl-sort:hover{color:hsl(var(--primary));}
  .afl-sort.tri::after{content:'';display:inline-block;margin-left:.3rem;border-left:.25rem solid transparent;
    border-right:.25rem solid transparent;border-top:.3rem solid currentColor;vertical-align:middle;}
  .afl-sort.tri.asc::after{border-top:0;border-bottom:.3rem solid currentColor;}
  .afl-prog{font-weight:600;}
  .afl-remu{font-size:.78rem;color:hsl(var(--muted-foreground));}
  .afl-vide{padding:2rem .5rem;text-align:center;color:hsl(var(--muted-foreground));font-size:.85rem;}
  .afl-statut{display:inline-block;padding:.16rem .55rem;border-radius:999px;font-size:.68rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;}
  .afl-statut--active{background:hsl(152 55% 45%/.16);color:hsl(152 60% 32%);}
  .dark .afl-statut--active{color:hsl(152 60% 62%);}
  .afl-statut--pending{background:hsl(38 85% 50%/.16);color:hsl(32 75% 38%);}
  .dark .afl-statut--pending{color:hsl(38 85% 65%);}
  .afl-statut--autre{background:hsl(var(--muted));color:hsl(var(--muted-foreground));}

  /* Générateur */
  .afl-gen{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.85rem;align-items:end;}
  .afl-field{display:grid;gap:.3rem;min-width:0;}
  .afl-field>span{font-size:.75rem;font-weight:600;color:hsl(var(--muted-foreground));}
  .afl-field>span em{font-style:normal;font-weight:400;opacity:.75;}
  .afl-gen-btn{height:2.6rem;}
  .afl-gen-out{display:flex;align-items:center;gap:.6rem;margin-top:1rem;padding:.7rem .9rem;border-radius:.75rem;
    background:hsl(var(--muted)/.6);border:1px solid hsl(var(--border));}
  .afl-gen-out code{flex:1;min-width:0;font-size:.8rem;word-break:break-all;font-family:ui-monospace,Menlo,Consolas,monospace;}
  .afl-copy{flex-shrink:0;padding:.35rem .8rem;border-radius:.5rem;border:1px solid hsl(var(--primary)/.35);
    background:hsl(var(--primary)/.1);color:hsl(var(--primary));font-size:.78rem;font-weight:700;cursor:pointer;transition:all .15s;}
  .afl-copy:hover{background:hsl(var(--primary));color:#fff;}
  .afl-gen-note{margin:.7rem 0 0;font-size:.78rem;color:hsl(var(--muted-foreground));}

  /* Conversions */
  .afl-conv-list{display:grid;gap:.5rem;}
  .afl-conv{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.7rem .85rem;
    border-radius:.7rem;background:hsl(var(--muted)/.45);}
  .afl-conv-nom{font-weight:600;font-size:.87rem;}
  .afl-conv-meta{font-size:.73rem;color:hsl(var(--muted-foreground));margin-top:.1rem;}
  .afl-conv-gain{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap;}

  @media (max-width:640px){
    .afl-hide-sm{display:none;}
    .afl-table td:nth-child(3){display:none;}
    .afl-panel{padding:1.1rem .95rem;}
    .afl-bar{gap:.5rem;}
    .afl-bar-left{width:100%;}
    .afl-select{flex:1;}
    .afl-kpi-value{font-size:1.35rem;}
    .afl-gen-out{flex-direction:column;align-items:stretch;}
    .afl-copy{width:100%;}
  }
  @media (prefers-reduced-motion:reduce){.afl-icon-btn.tourne svg{animation:none;}}
    .admin-tab{position:relative;}
    /* Pastille d'alerte : un avis a moderer, un message non lu, un lead arrive
       depuis la derniere visite de l'onglet. Le detail chiffre est dans le
       title de la pastille. */
    .admin-pastille{
      position:absolute;top:.15rem;right:.1rem;
      min-width:1.05rem;height:1.05rem;padding:0 .25rem;
      display:inline-flex;align-items:center;justify-content:center;
      border-radius:9999px;background:hsl(var(--destructive));color:#fff;
      font-size:.65rem;font-weight:800;line-height:1;
      box-shadow:0 0 0 2px hsl(var(--card));
    }
    .admin-pastille.hidden{display:none;}
    /* Infobulle du graphique de statistiques */
    .stats-infobulle{
      position:absolute;z-index:20;pointer-events:none;
      display:flex;flex-direction:column;gap:.1rem;
      padding:.4rem .6rem;border-radius:.5rem;
      background:hsl(var(--popover));border:1px solid hsl(var(--border));
      box-shadow:0 10px 24px -8px rgb(0 0 0 / .35);
      font-size:.75rem;line-height:1.3;white-space:nowrap;
    }
    .stats-infobulle.est-cachee,.stats-repere.est-cachee{display:none;}
    .stats-infobulle-date{color:hsl(var(--muted-foreground));font-size:.7rem;}
    .stats-infobulle-val{color:hsl(var(--foreground));font-weight:700;}
</style>
