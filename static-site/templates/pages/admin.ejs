<%
  // Tableau de bord d'administration : une application plein ecran, barre
  // laterale a gauche, indicateurs et grand graphique au milieu. La page
  // n'est pas indexee (noindex pose par base.ejs) et n'a ni en-tete ni pied
  // de page du site : base.ejs les ecarte pour cette route.
  //
  // Le script admin.js retrouve tout par identifiant et par classe : les
  // identifiants ci-dessous sont un contrat, on ne les renomme pas.
%>
<link rel="stylesheet" href="/css/admin.css">

<div id="admin-app" class="adm" data-url="<%= supabaseUrl %>" data-key="<%= supabaseKey %>">

  <!-- Connexion (affichee par defaut) -->
  <div id="admin-login" class="adm-login">
    <div class="adm-login-carte">
      <div class="adm-login-logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      </div>
      <h1>Quiz Couple</h1>
      <p class="adm-login-sub">Tableau de bord. Accès réservé à l'administrateur.</p>
      <div class="adm-login-champ">
        <input type="password" id="admin-password" class="input w-full" placeholder="Mot de passe" autocomplete="current-password" aria-label="Mot de passe">
        <button type="button" id="admin-toggle-pw" class="adm-login-oeil" aria-label="Afficher ou masquer le mot de passe">
          <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-closed hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>
      <p id="admin-login-error" class="adm-login-erreur hidden"></p>
      <button id="admin-login-btn" class="btn btn-primary" type="button">Se connecter</button>
    </div>
  </div>

  <!-- Le tableau de bord (masque tant qu'on n'est pas connecte) -->
  <div id="admin-dashboard" class="adm-shell hidden">

    <aside class="adm-side" aria-label="Navigation du tableau de bord">
      <div class="adm-brand">
        <div class="adm-brand-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.35-9.33-8.6C1 9 2.6 5.5 6 5.5c2 0 3.2 1.2 4 2.4.8-1.2 2-2.4 4-2.4 3.4 0 5 3.5 3.33 6.9C19 16.65 12 21 12 21z"/></svg>
        </div>
        <div>
          <div class="adm-brand-nom">Quiz Couple</div>
          <div class="adm-brand-sub">Tableau de bord</div>
        </div>
      </div>

      <nav class="adm-nav">
        <p class="adm-nav-titre">Mesure</p>
            <button class="admin-tab active" data-tab="stats" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-5 4 3 5-7"/></svg><span>Parties</span></button>
            <button class="admin-tab" data-tab="trafic" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><span>Trafic</span></button>
            <button class="admin-tab" data-tab="blog" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z"/></svg><span>Blog</span></button>
            <button class="admin-tab" data-tab="distance" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg><span>À distance</span></button>
        <p class="adm-nav-titre">Gestion</p>
            <button class="admin-tab" data-tab="reviews" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg><span>Avis</span><span class="admin-pastille hidden" data-notif="reviews">!</span></button>
            <button class="admin-tab" data-tab="leads" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg><span>Leads</span><span class="admin-pastille hidden" data-notif="leads">!</span></button>
            <button class="admin-tab" data-tab="messages" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg><span>Messagerie</span><span class="admin-pastille hidden" data-notif="messages">!</span></button>
        <p class="adm-nav-titre">Revenus</p>
            <button class="admin-tab" data-tab="affiliation" type="button"><svg class="adm-nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18M7 6h1v4"/><path d="M16.71 13.88l.7.71-2.82 2.82"/></svg><span>Affiliation</span></button>
      </nav>

      <div class="adm-side-pied">
        <%# Le site est statique : ce qui est saisi ici vit dans Supabase et
            n'apparaît en ligne qu'après une reconstruction. Elle a lieu toute
            seule toutes les deux heures ; ce bouton la déclenche tout de suite. %>
        <button id="admin-deploy" class="adm-publier" type="button"
                title="Reconstruit le site tout de suite pour publier les articles et avis enregistrés ici. Sans ça, la mise en ligne se fait toute seule dans les deux heures.">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span>Publier maintenant</span>
        </button>
        <div class="adm-side-actions">
          <button id="theme-toggle" class="adm-ico-btn" type="button" aria-label="Changer le thème" title="Clair ou sombre">
            <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <span>Thème</span>
          </button>
          <button id="admin-logout" class="adm-ico-btn adm-ico-btn--danger" type="button" aria-label="Déconnexion">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>
            <span>Déconnexion</span>
          </button>
        </div>
      </div>
    </aside>

    <div class="adm-main">
      <header class="adm-top">
        <div>
          <h1 class="adm-top-titre" id="adm-titre">Parties</h1>
          <p class="adm-top-sub" id="adm-sous-titre">Lancés, terminés et taux de finition, toutes pages confondues</p>
        </div>
        <div class="adm-top-droite">
          <span class="adm-puce" title="Validations d'activités">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <strong id="admin-stat-activities">-</strong> activités
          </span>
          <span class="adm-puce" id="adm-date"></span>
          <span class="adm-puce adm-puce--fraicheur" id="adm-fraicheur" hidden
                title="Les données lues restent en mémoire dans ce navigateur : changer d'onglet ne les recharge pas. « Actualiser » vide cette mémoire et recharge l'onglet ouvert."></span>
          <button id="adm-rafraichir" class="adm-ico-btn adm-rafraichir" type="button" title="Recharger les données depuis la base">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
            <span>Actualiser</span>
          </button>
        </div>
      </header>

      <div class="adm-contenu">

        <!-- Etat de la publication (masque par defaut) -->
        <div id="deploy-banner" class="hidden">
          <div class="adm-bandeau-int">
            <div id="deploy-spinner" class="hidden"></div>
            <svg id="deploy-icon-success" class="hidden" style="color:hsl(142 71% 45%);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <svg id="deploy-icon-error" class="hidden" style="color:hsl(var(--destructive));" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <p id="deploy-message"></p>
          </div>
        </div>

        <!-- ═══ Parties (Stats) ═══ -->
        <div id="admin-stats-tab">
          <div class="stats-tetes">
            <div class="stats-tete stats-tete--lances">
              <p class="stats-tete-titre">Lancés aujourd'hui</p>
              <p class="stats-tete-jour"><span id="admin-lances-jour">-</span><span class="adm-delta hidden" id="adm-delta-lances"></span></p>
              <svg class="adm-spark est-vide" id="adm-spark-lances" viewBox="0 0 124 42" preserveAspectRatio="none" aria-hidden="true"></svg>
              <p class="stats-tete-sub">parties commencées, toutes pages</p>
              <p class="stats-tete-total">Total : <strong id="admin-lances-total">-</strong></p>
              <p class="stats-tete-sub" id="admin-lances-distance"></p>
            </div>
            <div class="stats-tete stats-tete--finis">
              <p class="stats-tete-titre">Terminés aujourd'hui</p>
              <p class="stats-tete-jour"><span id="admin-finis-jour">-</span><span class="adm-delta hidden" id="adm-delta-finis"></span></p>
              <svg class="adm-spark est-vide" id="adm-spark-finis" viewBox="0 0 124 42" preserveAspectRatio="none" aria-hidden="true"></svg>
              <p class="stats-tete-sub">parties allées jusqu'au résultat</p>
              <p class="stats-tete-total">Total : <strong id="admin-finis-total">-</strong></p>
            </div>
            <div class="stats-tete stats-tete--ratio">
              <p class="stats-tete-titre">Taux de finition du jour</p>
              <p class="stats-tete-jour" id="admin-ratio-jour">-</p>
              <p class="stats-tete-sub" id="admin-ratio-detail">des parties lancées vont au bout</p>
            </div>
          </div>

          <!-- Le grand graphique -->
          <div class="stats-panel">
            <div class="stats-panel-head">
              <div>
                <h2 class="stats-panel-title">Évolution quotidienne</h2>
                <p class="stats-panel-sub">Lancés, terminés et taux de finition, jour par jour. Cliquez une vignette pour masquer ou réafficher sa courbe. Le taux écarte les pages qui n'ont pas de parcours à abandonner : celles à résultat immédiat, et les jeux de cartes qu'on arrête quand on veut.</p>
              </div>
              <div class="stats-range" role="group" aria-label="Période">
                <button class="stats-range-btn active" data-range="30" type="button">30 j</button>
                <button class="stats-range-btn" data-range="90" type="button">90 j</button>
                <button class="stats-range-btn" data-range="365" type="button">1 an</button>
              </div>
            </div>
            <div class="stats-legende" id="admin-stats-legende" role="group" aria-label="Courbes affichées"></div>
            <canvas id="admin-stats-total-chart" class="stats-canvas adm-canvas--hero"></canvas>
          </div>

          <div class="adm-duo">
            <!-- Tops et flops -->
            <details class="stats-details" open>
              <summary>
                <span class="stats-details-emoji" aria-hidden="true">🚀</span>
                <span>
                  <span class="stats-details-titre">Tops et flops</span>
                  <span class="stats-details-sub">Les 5 pages qui montent et les 5 qui baissent</span>
                </span>
                <svg class="stats-details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="stats-details-corps">
                <div class="stats-comp" role="group" aria-label="Comparaison">
                  <button class="stats-comp-btn active" data-comp="1" type="button">Aujourd'hui vs hier</button>
                  <button class="stats-comp-btn" data-comp="7" type="button">7 j vs 7 j précédents</button>
                  <button class="stats-comp-btn" data-comp="30" type="button">30 j vs 30 j précédents</button>
                </div>
                <div class="stats-movers">
                  <div>
                    <h3 class="stats-movers-titre">📈 En hausse</h3>
                    <div id="admin-movers-hausse"><p class="stats-movers-vide">Chargement...</p></div>
                  </div>
                  <div>
                    <h3 class="stats-movers-titre">📉 En baisse</h3>
                    <div id="admin-movers-baisse"><p class="stats-movers-vide">Chargement...</p></div>
                  </div>
                </div>
              </div>
            </details>

            <!-- La courbe d'une seule page -->
            <div class="stats-panel">
              <div class="stats-panel-head">
                <div>
                  <h2 class="stats-panel-title" id="admin-stats-chart-title">Sélectionnez une page ci-dessous</h2>
                  <p class="stats-panel-sub">Lancés, finis et taux de la page choisie dans la liste, jour par jour.</p>
                </div>
              </div>
              <div class="stats-souscourbe">
                <canvas id="admin-stats-chart" class="stats-canvas adm-canvas--sec"></canvas>
              </div>
            </div>
          </div>

          <!-- Toutes les pages -->
          <details class="stats-details">
            <summary>
              <span class="stats-details-emoji" aria-hidden="true">📋</span>
              <span>
                <span class="stats-details-titre">Toutes les pages, test par test</span>
                <span class="stats-details-sub">Rangé par tests, quiz et jeux. Lancés, finis et taux de finition</span>
              </span>
              <svg class="stats-details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="stats-details-corps">
              <div class="stats-comp stats-comp--periode" role="group" aria-label="Période">
                <button class="stats-comp-btn active" data-periode="0" type="button">Tout</button>
                <button class="stats-comp-btn" data-periode="1" type="button">Aujourd'hui</button>
                <button class="stats-comp-btn" data-periode="7" type="button">7 j</button>
                <button class="stats-comp-btn" data-periode="30" type="button">30 j</button>
                <button class="stats-comp-btn" data-periode="60" type="button">60 j</button>
                <button class="stats-comp-btn" data-periode="90" type="button">90 j</button>
                <button class="stats-comp-btn" data-periode="182" type="button">6 mois</button>
                <button class="stats-comp-btn" data-periode="365" type="button">1 an</button>
              </div>
              <p class="stats-panel-sub" id="admin-stats-mesure-aide" style="margin:.6rem 0;">Cliquez sur l'en-tête d'une colonne pour trier, sur une ligne pour voir sa courbe.</p>
              <div id="admin-stats-list" class="stats-list"></div>
            </div>
          </details>
        </div>

        <!-- ═══ Trafic ═══ -->
        <div id="admin-trafic-tab" class="hidden">
          <div class="adm-toolbar">
            <div class="stats-comp stats-comp--periode" role="group" aria-label="Période">
              <button class="stats-comp-btn active" data-trafic-periode="1" type="button">Aujourd'hui</button>
              <button class="stats-comp-btn" data-trafic-periode="7" type="button">7 j</button>
              <button class="stats-comp-btn" data-trafic-periode="30" type="button">30 j</button>
              <button class="stats-comp-btn" data-trafic-periode="90" type="button">90 j</button>
              <button class="stats-comp-btn" data-trafic-periode="365" type="button">1 an</button>
            </div>
          </div>

          <div class="trafic-kpis">
            <div class="stats-tete trafic-kpi--visites">
              <p class="stats-tete-titre">Visites</p>
              <p class="stats-tete-jour" id="trafic-visites">-</p>
              <svg class="adm-spark est-vide" id="adm-spark-visites" viewBox="0 0 124 42" preserveAspectRatio="none" aria-hidden="true"></svg>
              <p class="stats-tete-sub" id="trafic-visites-sub">sur la période</p>
            </div>
            <div class="stats-tete trafic-kpi--vues">
              <p class="stats-tete-titre">Pages vues</p>
              <p class="stats-tete-jour" id="trafic-vues">-</p>
              <svg class="adm-spark est-vide" id="adm-spark-vues" viewBox="0 0 124 42" preserveAspectRatio="none" aria-hidden="true"></svg>
              <p class="stats-tete-sub">rechargements compris</p>
            </div>
            <div class="stats-tete trafic-kpi--profondeur">
              <p class="stats-tete-titre">Pages par visite</p>
              <p class="stats-tete-jour" id="trafic-ppv">-</p>
              <p class="stats-tete-sub">en moyenne</p>
            </div>
            <div class="stats-tete trafic-kpi--rebond">
              <p class="stats-tete-titre">Une seule page</p>
              <p class="stats-tete-jour" id="trafic-rebond">-</p>
              <p class="stats-tete-sub" id="trafic-rebond-sub">des visites repartent sans cliquer</p>
            </div>
          </div>

          <div class="stats-panel">
            <div class="stats-panel-head">
              <div>
                <h2 class="stats-panel-title">Évolution quotidienne</h2>
                <p class="stats-panel-sub">Visites et pages vues, jour par jour. Cliquez une vignette pour masquer ou réafficher sa courbe.</p>
              </div>
            </div>
            <div class="stats-legende" id="trafic-legende" role="group" aria-label="Courbes affichées"></div>
            <canvas id="trafic-chart" class="stats-canvas adm-canvas--hero"></canvas>
          </div>

          <div class="adm-duo">
            <div class="stats-panel">
              <div class="stats-panel-head">
                <div>
                  <h2 class="stats-panel-title">D'où viennent les visites</h2>
                  <p class="stats-panel-sub">Le site d'origine de la première page. Les visites qui redémarrent après une pause, dont le référent est le site lui-même, ne sont pas comptées ici.</p>
                </div>
              </div>
              <div id="trafic-sources" class="trafic-barres"><p class="stats-movers-vide">Chargement...</p></div>
            </div>
            <div class="stats-panel">
              <div class="stats-panel-head">
                <div>
                  <h2 class="stats-panel-title">Profondeur de visite</h2>
                  <p class="stats-panel-sub">Combien de pages par visite. Une moyenne cache la forme : ici on voit la répartition réelle.</p>
                </div>
              </div>
              <div id="trafic-profondeur" class="trafic-barres"><p class="stats-movers-vide">Chargement...</p></div>
            </div>
          </div>

          <div class="stats-panel">
            <div class="stats-panel-head">
              <div>
                <h2 class="stats-panel-title">Entonnoir des pages jouables</h2>
                <p class="stats-panel-sub">Les trois nombres portent sur les mêmes visites : celles qui ont vu la page, celles qui ont touché le moteur, celles qui sont allées jusqu'au résultat.</p>
              </div>
            </div>
            <div class="stats-entetes">
              <span class="stats-entete-nom">Page</span>
              <button class="stats-tri" data-tri-ent="visites" style="--col:var(--adm-s-visites);" type="button">Visites <span class="stats-tri-fleche">▾</span></button>
              <button class="stats-tri" data-tri-ent="lances" style="--col:var(--adm-s-lances);" type="button">Lancés <span class="stats-tri-fleche">▾</span></button>
              <button class="stats-tri" data-tri-ent="finis" style="--col:var(--adm-s-finis);" type="button">Finis <span class="stats-tri-fleche">▾</span></button>
            </div>
            <div id="trafic-entonnoir" class="stats-list"><p class="stats-movers-vide">Chargement...</p></div>
          </div>

          <div class="stats-panel">
            <div class="stats-panel-head">
              <div>
                <h2 class="stats-panel-title">Toutes les pages</h2>
                <p class="stats-panel-sub">« Directes » : les visites qui ont commencé sur cette page, donc arrivées d'un moteur ou d'un lien externe. Le reste est venu par le maillage interne. « Rebond » : parmi les arrivées directes, celles qui sont reparties sans voir une autre page.</p>
              </div>
            </div>
            <div class="stats-entetes trafic-entetes">
              <span class="stats-entete-nom">Page</span>
              <button class="stats-tri" data-tri-pages="pages_vues" style="--col:hsl(var(--muted-foreground));" type="button">Vues <span class="stats-tri-fleche">▾</span></button>
