<style>
  @keyframes spin{to{transform:rotate(360deg)}}
  /* ── Stats tab ── */
  .stats-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem;}
  .stats-kpi{display:flex;align-items:center;gap:0.9rem;padding:1.1rem 1.25rem;border-radius:1rem;background:hsl(var(--card));border:1px solid hsl(var(--border));box-shadow:0 4px 16px -8px hsl(var(--primary)/0.18);}
  .stats-kpi-icon{width:2.75rem;height:2.75rem;border-radius:0.85rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;color:#fff;flex-shrink:0;box-shadow:0 4px 12px -4px hsl(var(--primary)/0.5);}
  .stats-kpi-value{font-family:'Poppins','Inter',sans-serif;font-size:1.6rem;font-weight:800;line-height:1;font-variant-numeric:tabular-nums;}
  .stats-kpi-label{font-size:0.72rem;color:hsl(var(--muted-foreground));margin-top:0.25rem;text-transform:uppercase;letter-spacing:0.03em;font-weight:600;}
  .stats-panel{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;padding:1.35rem 1.4rem;margin-bottom:1.5rem;box-shadow:0 4px 16px -10px hsl(var(--primary)/0.15);}
  .stats-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}
  .stats-panel-title{font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;margin:0;}
  .stats-panel-sub{font-size:0.8rem;color:hsl(var(--muted-foreground));margin:0.15rem 0 0;}
  .stats-range{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;flex-shrink:0;}
  .stats-range-btn{padding:0.35rem 0.85rem;font-size:0.8rem;font-weight:600;background:transparent;border:none;cursor:pointer;color:hsl(var(--muted-foreground));transition:background .15s,color .15s;}
  .stats-range-btn.active{background:hsl(var(--primary));color:#fff;}
  .stats-canvas{width:100%;display:block;}
  /* Une ligne = une page, trois chiffres par ligne. Le fond se remplit
     selon la colonne de tri : classer par ratio dessine les ratios, classer
     par lances dessine les volumes. Un filet separe chaque ligne, sinon
     quarante lignes collees ne se lisent pas. */
  .stats-list{display:flex;flex-direction:column;}
  .stats-avis{font-size:0.78rem;line-height:1.5;color:hsl(var(--muted-foreground));background:hsl(38 92% 55%/0.1);border-left:3px solid hsl(38 92% 50%);border-radius:0.4rem;padding:0.55rem 0.75rem;margin-bottom:0.6rem;}
  .stats-entetes{display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0.7rem 0.45rem;border-bottom:2px solid hsl(var(--border));margin-bottom:0.1rem;}
  .stats-entete-nom{flex:1;min-width:0;font-size:0.7rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:hsl(var(--muted-foreground));}
  .stats-tri{flex:0 0 5.2rem;display:flex;align-items:center;justify-content:flex-end;gap:0.2rem;background:none;border:none;padding:0.15rem 0.2rem;cursor:pointer;border-radius:0.35rem;font-size:0.7rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:hsl(var(--muted-foreground));white-space:nowrap;transition:color .15s,background .15s;}
  .stats-tri:hover{background:hsl(var(--muted)/0.6);color:hsl(var(--foreground));}
  .stats-tri.est-actif{color:var(--col);}
  .stats-tri-fleche{font-size:0.65rem;opacity:0.35;}
  .stats-tri.est-actif .stats-tri-fleche{opacity:1;}
  /* Sur « Tout », la colonne des lancés date sa mesure : sans ça, une page
     ancienne à 12 finis pour 0 lancé ressemble à un compteur cassé. */
  .stats-tri-note{flex-basis:100%;font-size:0.55rem;font-weight:600;letter-spacing:0;text-transform:none;opacity:0.65;text-align:right;}
  .stats-tri{flex-wrap:wrap;}
  .stats-row{position:relative;display:flex;align-items:center;gap:0.5rem;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid hsl(var(--border)/0.6);padding:0.55rem 0.7rem;cursor:pointer;color:inherit;overflow:hidden;transition:background .15s;}
  .stats-row:last-child{border-bottom:none;}
  .stats-row::before{content:'';position:absolute;inset:0 auto 0 0;width:var(--part,0%);background:color-mix(in srgb, var(--fam) 11%, transparent);pointer-events:none;transition:width .25s ease;}
  .stats-row:hover{background:hsl(var(--muted)/0.45);}
  .stats-row.active{box-shadow:inset 2px 0 0 var(--fam);background:hsl(var(--muted)/0.5);}
  .stats-row>*{position:relative;}
  .stats-row-name{flex:1;min-width:0;font-size:0.88rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .stats-cell{flex:0 0 5.2rem;text-align:right;font-variant-numeric:tabular-nums;font-size:0.95rem;font-weight:700;}
  .stats-cell--lances{color:hsl(217 91% 52%);}
  .stats-cell--finis{color:hsl(338 72% 52%);}
  .dark .stats-cell--lances{color:hsl(217 90% 70%);}
  .dark .stats-cell--finis{color:hsl(338 80% 68%);}
  .stats-cell--ratio{font-size:1.05rem;font-weight:800;}
  /* Le delta du jour, sous le chiffre : assez petit pour ne pas concurrencer
     le cumul, assez present pour se voir. Vert, comme un gain. */
  .stats-cell{display:flex;flex-direction:column;align-items:flex-end;line-height:1.15;}
  .stats-cell-jour{font-size:0.66rem;font-weight:700;color:hsl(150 62% 38%);letter-spacing:0;}
  .dark .stats-cell-jour{color:hsl(150 55% 55%);}
  .stats-cell--ratio .stats-cell-jour{color:hsl(var(--muted-foreground));}
  .stats-cell.est-faible{color:hsl(0 72% 50%);}
  .dark .stats-cell.est-faible{color:hsl(0 78% 68%);}
  .stats-cell.est-fort{color:hsl(150 62% 36%);}
  .dark .stats-cell.est-fort{color:hsl(150 55% 55%);}
  .stats-cell.est-vide{color:hsl(var(--muted-foreground)/0.5);font-weight:600;font-size:0.85rem;}
  @media (max-width:640px){
    .stats-cell,.stats-tri{flex-basis:3.9rem;font-size:0.85rem;}
    .stats-cell--ratio{font-size:0.95rem;}
    .stats-row-name{font-size:0.82rem;}
  }
  /* Regroupement tests / quiz / jeux. Une couleur par famille, reprise sur
     l'en-tete, sur le liseré de chaque ligne et sur sa barre : la liste fait
     une quarantaine de pages, sans repere visuel on la lit mal. */
  .stats-groupe{margin-top:1rem;}
  .stats-groupe:first-child{margin-top:0.2rem;}
  .stats-groupe-tete{display:flex;align-items:center;gap:0.5rem;padding:0.35rem 0.4rem;margin-bottom:0.25rem;border-bottom:1px solid hsl(var(--border));}
  .stats-groupe-pastille{width:0.55rem;height:0.55rem;border-radius:9999px;background:var(--fam);flex:0 0 auto;}
  .stats-groupe-nom{font-size:0.78rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:var(--fam);}
  .stats-groupe-compte{margin-left:auto;font-size:0.75rem;font-weight:600;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .stats-row{border-left:2px solid transparent;}
  .stats-groupe .stats-row{border-left-color:color-mix(in srgb, var(--fam) 45%, transparent);}
  .stats-groupe .stats-row-bar>span{background:var(--fam);}
  .stats-fam-test{--fam:hsl(265 62% 58%);}
  .stats-fam-quiz{--fam:hsl(338 72% 58%);}
  .stats-fam-jeu{--fam:hsl(172 60% 40%);}
  .dark .stats-fam-test{--fam:hsl(265 70% 70%);}
  .dark .stats-fam-quiz{--fam:hsl(338 80% 68%);}
  .dark .stats-fam-jeu{--fam:hsl(172 55% 55%);}
  /* Taux de finition : la valeur remplace le total, la barre represente le
     pourcentage lui-meme. En dessous de 40 % la valeur passe en rouge, c'est
     la lecture utile de tout ce tableau. */
  .stats-row-val.est-faible{color:hsl(0 70% 52%);}
  .dark .stats-row-val.est-faible{color:hsl(0 75% 68%);}
  .stats-row-val.est-fort{color:hsl(150 62% 38%);}
  .dark .stats-row-val.est-fort{color:hsl(150 55% 55%);}
  .stats-row-val{flex-basis:3.6rem;}
  /* Colonne secondaire : l'autre nombre du couple, en gris, pour garder le
     contexte quand on regarde un ratio (128 sur 340). */
  /* Trois blocs en tete : le compteur des lances, le ratio du jour au
     milieu, le compteur des finis. Chaque compteur porte le chiffre du jour
     en grand et le cumul en petit : c'est le couple qu'on regarde. */
  .stats-tetes{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;margin-bottom:1.5rem;align-items:stretch;}
  .stats-tete{border:1px solid hsl(var(--border));border-radius:1rem;padding:1rem 1.25rem;display:flex;flex-direction:column;justify-content:center;background:hsl(var(--card)/0.5);}
  .stats-tete-titre{display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;color:var(--tete);}
  .stats-tete-jour{font-size:2rem;font-weight:800;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--tete);margin-top:0.15rem;}
  .stats-tete-sub{font-size:0.75rem;color:hsl(var(--muted-foreground));}
  .stats-tete-total{margin-top:0.5rem;padding-top:0.5rem;border-top:1px dashed hsl(var(--border));font-size:0.8rem;color:hsl(var(--muted-foreground));}
  .stats-tete-total strong{color:hsl(var(--foreground));font-variant-numeric:tabular-nums;}
  .stats-tete--lances{--tete:hsl(217 91% 60%);}
  .stats-tete--finis{--tete:hsl(338 72% 58%);}
  .stats-tete--ratio{--tete:hsl(38 92% 50%);min-width:11rem;text-align:center;border-color:var(--tete);}
  .stats-tete--ratio .stats-tete-titre{justify-content:center;}
  .stats-tete--ratio .stats-tete-jour{font-size:2.6rem;}
  .dark .stats-tete--lances{--tete:hsl(217 90% 70%);}
  .dark .stats-tete--finis{--tete:hsl(338 80% 68%);}
  .dark .stats-tete--ratio{--tete:hsl(38 95% 62%);}
  @media (max-width:700px){.stats-tetes{grid-template-columns:1fr;}.stats-tete--ratio{min-width:0;}}
  /* ── Onglet Trafic ──────────────────────────────────────────────────
     Il reprend le vocabulaire visuel des stats (panneaux, lignes, cellules
     alignees a droite) et n'ajoute que ce qui lui est propre : une grille de
     quatre indicateurs au lieu de trois et des barres horizontales pour les
     repartitions. */
  .trafic-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:0.9rem;margin-bottom:1.5rem;}
  .trafic-kpi--visites{--tete:hsl(258 70% 52%);}
  .trafic-kpi--vues{--tete:hsl(199 85% 42%);}
  .trafic-kpi--profondeur{--tete:hsl(150 55% 36%);}
  .trafic-kpi--rebond{--tete:hsl(38 92% 42%);}
  .dark .trafic-kpi--visites{--tete:hsl(258 85% 76%);}
  .dark .trafic-kpi--vues{--tete:hsl(199 85% 65%);}
  .dark .trafic-kpi--profondeur{--tete:hsl(150 55% 60%);}
  .dark .trafic-kpi--rebond{--tete:hsl(38 92% 65%);}
  @media (max-width:900px){.trafic-kpis{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:420px){.trafic-kpis{grid-template-columns:1fr;}}
  .trafic-duo{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;}
  .trafic-duo>.stats-panel{margin-bottom:1.5rem;}
  @media (max-width:900px){.trafic-duo{grid-template-columns:1fr;gap:0;}}
  /* Barres de repartition : la valeur est lisible meme quand la barre est
     minuscule, parce que le chiffre vit a droite et pas dans la barre. */
  .trafic-barres{display:flex;flex-direction:column;gap:0.4rem;}
  .trafic-barre{display:flex;align-items:center;gap:0.6rem;font-size:0.82rem;}
  .trafic-barre-nom{flex:0 0 7.5rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;}
  .trafic-barre-piste{flex:1;min-width:0;height:0.5rem;border-radius:9999px;background:hsl(var(--muted));overflow:hidden;}
  /* display:block obligatoire : sur un span en flux inline, width et height
     sont ignores et la jauge ne se dessine jamais. */
  .trafic-barre-jauge{display:block;height:100%;border-radius:9999px;background:var(--bar,hsl(258 70% 55%));transition:width .25s ease;}
  /* Le nombre et sa part l'un au-dessus de l'autre : cote a cote, « 2 778 »
     et « 72 % » ne tenaient pas dans la colonne sur telephone et la ligne
     doublait de hauteur. */
  .trafic-barre-val{flex:0 0 4.4rem;text-align:right;font-variant-numeric:tabular-nums;font-weight:700;display:flex;flex-direction:column;align-items:flex-end;line-height:1.15;}
  .trafic-barre-pct{font-size:0.7rem;font-weight:600;color:hsl(var(--muted-foreground));}
  @media (max-width:640px){.trafic-barre-nom{flex-basis:6rem;}}
  /* Cinq colonnes dans « Toutes les pages » : les cellules retrecissent un
     peu pour que le chemin garde de la place. */
  .trafic-entetes .stats-tri,.trafic-ligne .stats-cell{flex-basis:4.6rem;}
  @media (max-width:640px){
    .trafic-entetes .stats-tri,.trafic-ligne .stats-cell{flex-basis:3.4rem;font-size:0.8rem;}
    /* Quatre colonnes de chiffres plus un chemin ne tiennent pas sur un
       telephone : le chemin se reduisait a « /te... ». « Vues » est la
       colonne dont on peut se passer, les visites disent la meme chose sans
       compter les rechargements. Elle revient des qu'il y a la place. */
    .trafic-entetes .stats-tri[data-tri-pages="pages_vues"],
    .trafic-ligne .stats-cell--vues{display:none;}
    /* Et le chemin passe sur deux lignes plutot que d'etre coupe. */
    #trafic-pages .stats-row-name{white-space:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.25;}
  }
  .trafic-ligne{cursor:default;}
  .trafic-ligne:hover{background:none;}
  .trafic-sous{font-size:0.66rem;font-weight:600;color:hsl(var(--muted-foreground));letter-spacing:0;}
  .stats-cell--visites{color:hsl(258 70% 52%);}
  .stats-cell--vues{color:hsl(var(--muted-foreground));}
  .dark .stats-cell--visites{color:hsl(258 85% 76%);}
  .trafic-vide{font-size:0.82rem;color:hsl(var(--muted-foreground));padding:1.2rem 0.4rem;text-align:center;}
  /* Le selecteur de periode a huit entrees : il doit pouvoir passer a la ligne. */
  .stats-comp--periode{flex-wrap:wrap;}
  /* Vignettes de selection des courbes, facon Search Console : on clique
     pour masquer ou reafficher une courbe, la vignette eteinte se grise. */
  .stats-legende{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.5rem;margin:0.25rem 0 0.9rem;}
  .stats-leg{display:flex;flex-direction:column;gap:0.15rem;align-items:flex-start;padding:0.55rem 0.75rem;border:1px solid hsl(var(--border));border-radius:0.7rem;background:transparent;cursor:pointer;text-align:left;color:inherit;transition:background .15s,border-color .15s,opacity .15s;border-top:3px solid var(--leg);}
  .stats-leg:hover{background:hsl(var(--muted)/0.5);}
  .stats-leg-nom{display:flex;align-items:center;gap:0.4rem;font-size:0.75rem;font-weight:600;color:hsl(var(--muted-foreground));}
  .stats-leg-puce{width:0.5rem;height:0.5rem;border-radius:9999px;background:var(--leg);flex:0 0 auto;}
  .stats-leg-val{font-size:1.15rem;font-weight:700;font-variant-numeric:tabular-nums;color:var(--leg);}
  .stats-leg.est-eteinte{opacity:0.45;border-top-color:hsl(var(--border));}
  .stats-leg.est-eteinte .stats-leg-val{color:hsl(var(--muted-foreground));}
  .stats-leg.est-eteinte .stats-leg-puce{background:hsl(var(--muted-foreground));}
  .stats-infobulle-ligne{display:flex;align-items:center;gap:0.4rem;white-space:nowrap;}
  .stats-infobulle-puce{width:0.45rem;height:0.45rem;border-radius:9999px;flex:0 0 auto;}
  .stats-infobulle-nom{color:hsl(var(--muted-foreground));font-size:0.72rem;}
  .stats-infobulle-ligne .stats-infobulle-val{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums;}
  .stats-row-sur{flex:0 0 8.5rem;text-align:right;font-size:0.75rem;font-variant-numeric:tabular-nums;color:hsl(var(--muted-foreground));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  @media (max-width:520px){.stats-row-sur{display:none;}}

  /* ── Onglet Blog ──────────────────────────────────────────────────────
     Meme grille que « Toutes les pages », a une difference pres : la
     premiere colonne porte le titre de l'article et pas son chemin. Un
     titre est long, il passe donc sur deux lignes plutot que d'etre coupe
     au milieu d'un mot. */
  .blog-entetes .stats-tri,.blog-ligne .stats-cell{flex-basis:4.6rem;}
  .blog-ligne{cursor:default;}
  .blog-ligne:hover{background:none;}
  #blog-articles .stats-row-name{white-space:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;}
  .blog-lien{color:inherit;text-decoration:none;}
  .blog-lien:hover{color:hsl(var(--primary));text-decoration:underline;}
  /* Le meme article existe en cinq langues : sans cette pastille, cinq
     lignes de titres traduits se ressemblent trop pour etre distinguees.
     Elle passe devant le titre et pas derriere : sur telephone, un titre
     long est coupe a deux lignes et emportait la pastille avec lui. */
  .blog-langue{margin-right:0.45rem;padding:0.05rem 0.35rem;border-radius:0.35rem;background:hsl(var(--muted));color:hsl(var(--muted-foreground));font-size:0.62rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;}
  .blog-sourcepref-note{margin:0.85rem 0 0;font-size:0.72rem;line-height:1.5;color:hsl(var(--muted-foreground));}
  @media (max-width:640px){
    .blog-entetes .stats-tri,.blog-ligne .stats-cell{flex-basis:3.4rem;font-size:0.8rem;}
    /* Quatre colonnes de chiffres et un titre ne tiennent pas sur un
       telephone. « Ouvertures » saute en premier : c'est la colonne dont on
       peut se passer, les lectures portent l'information utile. */
    .blog-entetes .stats-tri[data-tri-blog="ouvertures"],.blog-ligne .stats-cell--vues{display:none;}
  }

  /* ── Sections repliables (sommaire) ── */
  .stats-details{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;margin-bottom:1.5rem;box-shadow:0 4px 16px -10px hsl(var(--primary)/0.15);}
  .stats-details summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:0.85rem;padding:1.05rem 1.4rem;border-radius:1rem;transition:background .15s;}
  .stats-details summary::-webkit-details-marker{display:none;}
  .stats-details summary:hover{background:hsl(var(--muted)/0.5);}
  .stats-details-emoji{font-size:1.25rem;flex-shrink:0;}
  .stats-details-titre{display:block;font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;}
  .stats-details-sub{display:block;font-size:0.78rem;color:hsl(var(--muted-foreground));margin-top:0.1rem;}
  .stats-details-chevron{width:1.15rem;height:1.15rem;margin-left:auto;flex-shrink:0;color:hsl(var(--muted-foreground));transition:transform .2s;}
  .stats-details[open] .stats-details-chevron{transform:rotate(180deg);}
  .stats-details-corps{padding:0.25rem 1.4rem 1.35rem;}
  @media (max-width:520px){.stats-details summary{padding:0.95rem 1rem;}.stats-details-corps{padding:0.25rem 1rem 1.1rem;}}

  /* ── Tops et flops ── */
  .stats-comp{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;max-width:100%;}
  .stats-comp-btn{padding:0.35rem 0.8rem;font-size:0.78rem;font-weight:600;background:transparent;border:none;cursor:pointer;color:hsl(var(--muted-foreground));transition:background .15s,color .15s;white-space:nowrap;}
  .stats-comp-btn.active{background:hsl(var(--primary));color:#fff;}
  @media (max-width:560px){
    div:has(> .stats-comp){max-width:100%;overflow-x:auto;scrollbar-width:none;}
    .stats-comp{flex-shrink:0;}
  }
  .stats-movers{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.1rem;}
  @media (max-width:700px){.stats-movers{grid-template-columns:1fr;}}
  .stats-movers-titre{font-size:0.85rem;font-weight:700;margin-bottom:0.5rem;}
  .stats-movers-vide{font-size:0.82rem;color:hsl(var(--muted-foreground));padding:0.4rem 0;}
  .stats-mover{display:flex;align-items:center;gap:0.6rem;padding:0.42rem 0.4rem;border-radius:0.5rem;}
  .stats-mover:nth-child(odd){background:hsl(var(--muted)/0.35);}
  .stats-mover-nom{flex:1;font-size:0.82rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;}
  .stats-mover-vals{font-size:0.76rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;white-space:nowrap;}
  .stats-mover-delta{font-size:0.76rem;font-weight:700;padding:0.14rem 0.5rem;border-radius:999px;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .stats-mover-delta.est-plus{background:hsl(150 62% 40%/0.13);color:hsl(150 62% 32%);}
  .dark .stats-mover-delta.est-plus{color:hsl(150 55% 60%);}
  .stats-mover-delta.est-moins{background:hsl(0 72% 52%/0.12);color:hsl(0 72% 42%);}
  .dark .stats-mover-delta.est-moins{color:hsl(0 80% 68%);}

  .stats-souscourbe{margin-top:1.1rem;padding-top:1rem;border-top:1px solid hsl(var(--border));}

  /* Les groupes de boutons segmentés (onglets, filtres avis, filtres messages)
     sont des .flex qui ne rétrécissent pas : sur téléphone ils dépassaient de
     la vue et décalaient toute la page vers la droite, quel que soit l'onglet
     affiché. On les borne à la largeur disponible et on les laisse défiler. */
  @media (max-width:520px){
    div:has(> .admin-filter),
    div:has(> .messages-filter),
    div:has(> .admin-tab){
      max-width:100%;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;
    }
    div:has(> .admin-filter)::-webkit-scrollbar,
    div:has(> .messages-filter)::-webkit-scrollbar,
    div:has(> .admin-tab)::-webkit-scrollbar{display:none;}
    .admin-filter,.messages-filter,.admin-tab{white-space:nowrap;flex-shrink:0;}
    .admin-filter,.messages-filter{padding-left:.65rem;padding-right:.65rem;font-size:.8rem;}
    /* Un élément flex a min-width:auto par défaut et refuse donc de descendre
       sous la largeur de son contenu : sans cette ligne le conteneur des
       onglets reste plus large que l'écran et le défilement interne ne sert
       à rien. */
    div:has(> div > .admin-tab){min-width:0;}
    .admin-tab{padding-left:.7rem;padding-right:.7rem;}

    .stats-repere{
      position:absolute;z-index:19;pointer-events:none;
      width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:9999px;
      background:#7C5AD0;box-shadow:0 0 0 2px hsl(var(--card));
    }
  }

  /* ═══ Onglet Affiliation ═══════════════════════════════════
     Tableau de bord dense mais calme : on lit d'abord les quatre
     chiffres, ensuite le détail par partenaire. Tout passe par les
     variables du site, donc le mode sombre suit sans règle en plus. */

  /* .hidden vaut display:none dans la feuille principale, mais ce bloc-ci est
     chargé après elle : à spécificité égale mes display:flex et display:grid
     gagnaient, et les éléments masqués restaient à l'écran. On rend donc la
     classe prioritaire pour tout l'onglet. */
  #admin-affiliation-tab .hidden{display:none !important;}

  /* Écran de connexion au jeton */
  .afl-gate{display:flex;justify-content:center;padding:2rem 0 3rem;}
  .afl-gate-card{width:100%;max-width:26rem;display:grid;gap:.85rem;padding:2rem 1.75rem;border-radius:1.25rem;
    background:hsl(var(--card));border:1px solid hsl(var(--border));box-shadow:0 20px 48px -32px hsl(var(--primary)/.5);text-align:center;}
  .afl-gate-icon{font-size:2rem;line-height:1;}
  .afl-gate-title{font-family:'Poppins','Inter',sans-serif;font-size:1.2rem;font-weight:700;margin:0;}
  .afl-gate-text{font-size:.88rem;color:hsl(var(--muted-foreground));margin:0;line-height:1.55;}
  .afl-gate-hint{font-size:.75rem;color:hsl(var(--muted-foreground));margin:0;}
  .afl-gate-error{font-size:.82rem;color:hsl(var(--destructive));margin:0;}

  /* Barre de contrôle */
  .afl-bar{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1.25rem;}
  .afl-bar-left,.afl-bar-right{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;}
  .afl-select{appearance:none;padding:.45rem 2rem .45rem .8rem;border-radius:.65rem;border:1px solid hsl(var(--border));
    background:hsl(var(--card));color:hsl(var(--foreground));font-size:.85rem;font-weight:600;cursor:pointer;
    background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);
    background-position:calc(100% - 1rem) 55%,calc(100% - .7rem) 55%;background-size:.3rem .3rem,.3rem .3rem;background-repeat:no-repeat;}
  .afl-select--full{width:100%;}
  /* Au doigt, un champ sous 16 px fait zoomer Safari sur iPhone, et la page
     ne revient pas a l echelle : le tableau de bord se consulte aussi au
     telephone. */
  @media (hover: none) and (pointer: coarse) { .afl-select{font-size:16px;} }
  .afl-range{display:inline-flex;border:1px solid hsl(var(--border));border-radius:999px;overflow:hidden;background:hsl(var(--card));}
  .afl-range-btn{padding:.4rem .8rem;font-size:.8rem;font-weight:600;background:transparent;border:none;cursor:pointer;
    color:hsl(var(--muted-foreground));transition:background .15s,color .15s;}
  .afl-range-btn:hover{color:hsl(var(--foreground));}
  .afl-range-btn.active{background:hsl(var(--primary));color:#fff;}
  .afl-updated{font-size:.72rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .afl-icon-btn{width:2.1rem;height:2.1rem;display:inline-flex;align-items:center;justify-content:center;border-radius:.6rem;
    border:1px solid hsl(var(--border));background:hsl(var(--card));color:hsl(var(--muted-foreground));cursor:pointer;transition:all .15s;}
  .afl-icon-btn svg{width:1rem;height:1rem;}
  .afl-icon-btn:hover{color:hsl(var(--primary));border-color:hsl(var(--primary)/.4);}
  .afl-icon-btn--danger:hover{color:hsl(var(--destructive));border-color:hsl(var(--destructive)/.4);}
  .afl-icon-btn.tourne svg{animation:spin .7s linear infinite;}
  .afl-error{padding:.75rem 1rem;border-radius:.75rem;background:hsl(var(--destructive)/.1);
    border:1px solid hsl(var(--destructive)/.3);color:hsl(var(--destructive));font-size:.85rem;margin-bottom:1rem;}

  /* Indicateurs */
  .afl-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:.75rem;margin-bottom:1.5rem;}
  .afl-kpi{display:grid;gap:.3rem;padding:1.1rem 1.2rem;border-radius:1rem;background:hsl(var(--card));
    border:1px solid hsl(var(--border));box-shadow:0 4px 16px -12px hsl(var(--primary)/.4);}
  .afl-kpi-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:hsl(var(--muted-foreground));}
  .afl-kpi-value{font-family:'Poppins','Inter',sans-serif;font-size:1.55rem;font-weight:800;line-height:1.05;
    font-variant-numeric:tabular-nums;white-space:nowrap;}
  .afl-kpi--phare{border-color:hsl(var(--primary)/.35);background:hsl(var(--primary)/.05);}
  .afl-kpi--phare .afl-kpi-value{color:hsl(var(--primary));}

  /* Panneaux */
  .afl-panel{background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:1rem;
    padding:1.35rem 1.4rem;margin-bottom:1.25rem;box-shadow:0 4px 16px -12px hsl(var(--primary)/.3);}
  .afl-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;}
  .afl-panel-title{font-family:'Poppins','Inter',sans-serif;font-size:1.05rem;font-weight:700;margin:0;}
  .afl-panel-sub{font-size:.8rem;color:hsl(var(--muted-foreground));margin:.15rem 0 0;}
  .afl-chips{display:inline-flex;gap:.35rem;flex-wrap:wrap;}
  .afl-chip{padding:.3rem .75rem;border-radius:999px;border:1px solid hsl(var(--border));background:transparent;
    font-size:.78rem;font-weight:600;color:hsl(var(--muted-foreground));cursor:pointer;transition:all .15s;}
  .afl-chip:hover{color:hsl(var(--foreground));}
  .afl-chip.active{background:hsl(var(--primary));border-color:hsl(var(--primary));color:#fff;}

  /* Tableau */
  .afl-tablewrap{overflow-x:auto;margin:0 -.4rem;}
  .afl-table{width:100%;border-collapse:collapse;font-size:.85rem;min-width:32rem;}
  .afl-table th{text-align:left;padding:.5rem .55rem;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;
    font-weight:700;color:hsl(var(--muted-foreground));border-bottom:1px solid hsl(var(--border));white-space:nowrap;}
  .afl-table td{padding:.65rem .55rem;border-bottom:1px solid hsl(var(--border)/.6);vertical-align:middle;}
  .afl-table tbody tr:last-child td{border-bottom:0;}
  .afl-table tbody tr{transition:background .15s;}
  .afl-table tbody tr:hover{background:hsl(var(--muted)/.5);}
  .afl-num{text-align:right;font-variant-numeric:tabular-nums;}
  .afl-sort{cursor:pointer;user-select:none;}
  .afl-sort:hover{color:hsl(var(--primary));}
  .afl-sort.tri::after{content:'';display:inline-block;margin-left:.3rem;border-left:.25rem solid transparent;
    border-right:.25rem solid transparent;border-top:.3rem solid currentColor;vertical-align:middle;}
  .afl-sort.tri.asc::after{border-top:0;border-bottom:.3rem solid currentColor;}
  .afl-prog{font-weight:600;}
  .afl-remu{font-size:.78rem;color:hsl(var(--muted-foreground));}
  .afl-vide{padding:2rem .5rem;text-align:center;color:hsl(var(--muted-foreground));font-size:.85rem;}
  .afl-statut{display:inline-block;padding:.16rem .55rem;border-radius:999px;font-size:.68rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;}
  .afl-statut--active{background:hsl(152 55% 45%/.16);color:hsl(152 60% 32%);}
  .dark .afl-statut--active{color:hsl(152 60% 62%);}
  .afl-statut--pending{background:hsl(38 85% 50%/.16);color:hsl(32 75% 38%);}
  .dark .afl-statut--pending{color:hsl(38 85% 65%);}
  .afl-statut--autre{background:hsl(var(--muted));color:hsl(var(--muted-foreground));}

  /* Générateur */
  .afl-gen{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.85rem;align-items:end;}
  .afl-field{display:grid;gap:.3rem;min-width:0;}
  .afl-field>span{font-size:.75rem;font-weight:600;color:hsl(var(--muted-foreground));}
  .afl-field>span em{font-style:normal;font-weight:400;opacity:.75;}
  .afl-gen-btn{height:2.6rem;}
  .afl-gen-out{display:flex;align-items:center;gap:.6rem;margin-top:1rem;padding:.7rem .9rem;border-radius:.75rem;
    background:hsl(var(--muted)/.6);border:1px solid hsl(var(--border));}
  .afl-gen-out code{flex:1;min-width:0;font-size:.8rem;word-break:break-all;font-family:ui-monospace,Menlo,Consolas,monospace;}
  .afl-copy{flex-shrink:0;padding:.35rem .8rem;border-radius:.5rem;border:1px solid hsl(var(--primary)/.35);
