<%
  const ns = 'quiz-date-naissance';
  const quizTitle = t('quizzes:testDateNaissance.title', 'Compatibilité par date de naissance');
  // Tout ce que le calculateur doit pouvoir afficher, dans la langue de la page.
  // Les 144 textes de duos de signes, eux, sont chargés à la demande.
  const dnI18n = {
    form: {
      mois: t(ns + ':form.mois', []),
      moisDate: t(ns + ':form.moisDate', []),
      dateAffichee: t(ns + ':form.dateAffichee', '{{j}} {{mois}} {{a}}'),
      erreur: t(ns + ':form.erreur', ''),
    },
    signes: t(ns + ':signes', {}),
    animaux: t(ns + ':animaux', {}),
    elements: t(ns + ':elements', {}),
    cheminsTraits: t(ns + ':cheminsTraits', {}),
    bandesVie: t(ns + ':bandesVie', {}),
    nombresCouple: t(ns + ':nombresCouple', {}),
    relations: t(ns + ':relations', {}),
    elementsRelation: t(ns + ':elementsRelation', {}),
    paliers: t(ns + ':paliers', {}),
    resultat: t(ns + ':resultat', {}),
  };

  // La page ne passe pas par le gabarit générique, elle doit donc émettre
  // elle-même le balisage de sa FAQ. Sans lui, six questions et réponses
  // restent invisibles pour les résultats enrichis.
  const faqEntrees = [];
  for (let i = 1; i <= 6; i++) {
    const q = t(ns + ':faq.q' + i, '');
    const a = t(ns + ':faq.a' + i, '');
    if (q && a) faqEntrees.push({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } });
  }
%>
<% if (faqEntrees.length) { %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntrees }) %></script>
<% } %>

<!-- Hero -->
<section class="relative overflow-hidden astro-hero-section py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', variant: 'banner' }) %>
  <div class="astro-stars" aria-hidden="true">
    <% for (let i = 1; i <= 20; i++) { %><div class="astro-star astro-star-<%= i %>"></div><% } %>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.highlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
      <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':hero.subtitle', '') %></p>
    </div>
  </div>
</section>

<!-- Calculateur -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="dn-outil" class="astro-form-card rounded-2xl p-6 md:p-10" data-lang="<%= lang %>">

        <div id="dn-formulaire">
          <h2 class="text-xl md:text-2xl font-bold text-center mb-6"><%= t(ns + ':form.titre', '') %></h2>

          <% const personnes = [{ n: '1', cle: 'personne1' }, { n: '2', cle: 'personne2' }]; %>
          <% personnes.forEach(function (p, idx) { %>
          <% if (idx === 1) { %>
          <div class="astro-heart-divider">
            <div class="astro-heart-line"></div>
            <span class="astro-heart-icon">&#10084;&#65039;</span>
            <div class="astro-heart-line"></div>
          </div>
          <% } %>
          <div class="dn-personne">
            <p class="dn-personne-titre"><span class="dn-personne-num dn-personne-num-<%= p.n %>"><%= p.n %></span><%= t(ns + ':form.' + p.cle, '') %></p>
            <div class="dn-champs">
              <div class="astro-field">
                <label class="astro-field-label" for="dn-jour<%= p.n %>"><%= t(ns + ':form.jour', 'Jour') %></label>
                <div class="astro-select-wrap"><select id="dn-jour<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="dn-mois<%= p.n %>"><%= t(ns + ':form.moisLabel', 'Mois') %></label>
                <div class="astro-select-wrap"><select id="dn-mois<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="dn-annee<%= p.n %>"><%= t(ns + ':form.annee', 'Année') %></label>
                <div class="astro-select-wrap"><select id="dn-annee<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
            </div>
          </div>
          <% }); %>

          <p id="dn-erreur" class="dn-erreur hidden" role="alert"></p>

          <div class="mt-8 text-center">
            <button id="dn-lancer" type="button" class="btn btn-cta btn-gradient astro-submit-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':form.lancer', '') %>
            </button>
            <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':form.aide', '') %></p>
          </div>
        </div>

        <div id="dn-resultat" class="hidden"></div>

        <div id="dn-suite" class="hidden">
          <div class="dn-suite-carte">
            <h3 class="dn-suite-titre"><%= t(ns + ':suite.titre', '') %></h3>
            <p class="dn-suite-texte"><%= t(ns + ':suite.texte', '') %></p>
            <a class="btn btn-cta btn-gradient" href="<%= getLocalizedUrl('testAstroPrenoms', lang) %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':suite.bouton', '') %>
            </a>
          </div>
          <div class="text-center mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button id="dn-refaire" type="button" class="btn btn-outline px-8 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              <%= t(ns + ':resultat.refaire', '') %>
            </button>
            <a href="#pq-reviews" class="btn btn-outline px-6 py-2.5 text-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= lang === 'fr' ? 'Laisser un avis' : lang === 'es' ? 'Dejar una opinión' : lang === 'de' ? 'Bewertung abgeben' : lang === 'it' ? 'Lascia una recensione' : 'Leave a review' %>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu SEO -->
