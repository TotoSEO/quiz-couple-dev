      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-6"><%- t(ns + ':section2.p1') %></p>
      <div class="mt-8 mb-6">
        <h3 class="text-xl font-semibold mb-3"><%= t(ns + ':section2.sub1Title') %></h3>
