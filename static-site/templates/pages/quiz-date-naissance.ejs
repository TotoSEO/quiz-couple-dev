      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section4.p1') %></p>
        <p><%- t(ns + ':section4.p2') %></p>
      </div>
      <h3 class="text-xl font-semibold mb-3"><%= t(ns + ':section4.sub1Title') %></h3>
      <% const t4h = t(ns + ':section4.tableHeaders', []); const t4r = t(ns + ':section4.tableRows', []); %>
