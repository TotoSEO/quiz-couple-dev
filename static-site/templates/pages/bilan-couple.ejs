<%
  // L'évaluation de couple payante (docs/bilan/CONCEPTION.md) : une page de
  // vente (`lp` de {lang}/bilan.json), et l'application (js/bilan.js), qui
  // prend toute la place dès qu'on commence (body.bilan-focus) et parle à la
  // fonction serveur `bilan`. Le calcul vient de js/bilan-coeur.js, le
  // rapport de js/bilan-rapport.js (le même gabarit que le PDF), les
  // questions de /js/data/bilan-<lang>.json, chargé quand l'application
  // s'ouvre. Les styles de la page de vente (.blp-*) et les retouches des
  // écrans de l'application sont dans css/pages/bilanCouple.css, mis en ligne
  // par le gabarit de base (cssPage) ; la base des écrans (.bilan-*) reste
  // dans styles.css, celle du rapport dans /css/bilan-rapport.css.
  //
  // La page de vente, resserrée le 23 octobre 2026 (Thomas, devant la page
  // du quiz couple de WeBloom : « Son contenu est bon, synthétique, ya pas trop
  // d'info, le wording est bon, et sa ligne de flotaison est excellente. Nous,
  // y'a beaucoup beaucoup trop de texte ») : 2 770 mots et 23 000 px de haut
  // sur téléphone avant, douze sections. Le premier écran porte la promesse
  // (titre, une phrase), la réduction, un seul gros bouton (à deux), le lien
  // « faites-la seul(e) », les moyens de paiement et « Quiz Couple, des
  // milliers de visiteurs chaque jour » ; le même jour, Thomas a fait retirer
  // la phrase « Questions gratuites, sans créer de compte... », Amazon Pay et
  // le dégradé du haut de page, et demandé de l'air entre les blocs ; puis les chiffres, le ruban des douze domaines, trois
  // étapes, le rapport page par page en curseur (quiz-slider.js), les deux
  // façons de faire (#facons, la cible des liens « seul(e) » du site), une
  // question à essayer (bilan-lp.js), le prix, la confiance, huit questions
  // fréquentes, le dernier appel et la barre collée en bas sur téléphone.
  // Partis ce jour-là : les coches du haut, le fil d'Ariane, la grille des
  // domaines, « pour qui », le comparatif conseiller / IA / évaluation et la
  // section sur la recherche (une phrase sous les étapes et une réponse de la
  // FAQ la remplacent). Aucun nombre de pages n'est promis : les rapports
  // d'exemple en font de 27 à 47. Tout ce qui bouge n'anime que transform et
  // opacity, rien ne part de l'opacité 0 dans le premier écran, et
  // prefers-reduced-motion arrête tout.
  //
  // La page est en noindex dans les cinq langues (generate.js,
  // noindexRoutes) : elle est écrite pour convaincre quelqu'un qui arrive d'un
  // test, pas pour le référencement.
  const ns = 'bilan';
  const pageTitle = t('quizzes:bilanCouple.title', 'Évaluation de couple');
  const prix = typeof bilanPrix !== 'undefined' ? bilanPrix : '9,90 €';
  // La réduction en cours (PROMO_* de coeur.mjs, promoBilanPour dans
  // generate.js ; 20 octobre 2026, Thomas : « en ce moment -20% sur le test,
  // puis le prix de base barré avec le nouveau prix à côté ») : `prix` est
  // alors le prix réduit, `promo.html` le prix habituel barré suivi du
  // nouveau, `marque()` le met à la place du prix dans un texte échappé.
  const promo = (typeof bilanPromo !== 'undefined' && bilanPromo) ? bilanPromo : null;
  const marque = (html) => (promo ? promo.marque(html) : html);
  const jours = typeof bilanGarantie !== 'undefined' ? bilanGarantie : 0;
  // {{prix}} et {{jours}} dans les textes de la page.
  const rp = (s) => String(s || '').replace(/\{\{prix\}\}/g, prix).replace(/\{\{jours\}\}/g, jours);
  const L = (k, d) => t(ns + ':lp.' + k, d === undefined ? '' : d);
  // Le français colle « ? ! : ; » à leur mot.
  const ins = (s) => lang === 'fr' ? String(s || '').replace(/ ([?!:;»])/g, ' $1').replace(/« /g, '« ') : String(s || '');
  const e = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const x = (k, d) => e(ins(rp(L(k, d))));
  const tx = (s) => e(ins(rp(s)));
  const liste = (k) => { const v = L(k, []); return Array.isArray(v) ? v : []; };
  const masc = (nom, pose, classe) => (typeof mascotteSvg === 'function' ? mascotteSvg(nom, pose, {}, classe) : '');

  const faqItems = liste('faq.items');
  const faqEntrees = faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: rp(f.a) } }));

  const baseUrl = 'https://quiz-couple.com';
  const imageBilan = (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : baseUrl + '/og-image.webp';
  const appBilan = {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: t(ns + ':jsonLd.name', pageTitle),
    description: t('quizzes:bilanCouple.metaDescription', ''),
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: lang,
    url: canonical,
    image: imageBilan,
    about: { '@type': 'Thing', name: t(ns + ':jsonLd.about', '') },
    offers: Object.assign({ '@type': 'Offer', price: (bilanPrixCentimes / 100).toFixed(2), priceCurrency: 'EUR' }, promo && promo.fin ? { priceValidUntil: promo.fin } : {}),
    author: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl },
    publisher: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl, logo: { '@type': 'ImageObject', url: baseUrl + '/apple-touch-icon.png' } }
  };

  // Les aperçus du rapport : des pages d'un rapport d'exemple (couple
  // fictif), rendues par bilan/apercus.mjs dans chaque langue. 240 px de large
  // seulement, exprès (19 octobre 2026, Thomas : « ça doit rester affiché en
  // tout petit et illisible volontairement pour éviter toute copie sans
  // payer ») : on voit la mise en page, pas le texte, et les images ne
  // s'ouvrent ni ne se glissent (pointer-events, draggable, bilanCouple.css).
  const apercu = (nom) => '/bilan/apercu-' + nom + '-' + lang + '.webp';

  // Tout ce que l'application affiche, dans la langue de la page, avec le
  // prix et la garantie déjà écrits.
  const appTextes = JSON.parse(rp(JSON.stringify(t(ns + ':app', {}))));
  const bilanConfig = {
    lang,
    fonction: supabaseUrl + '/functions/v1/bilan',
    cle: supabaseKey,
    chemin: getLocalizedPath('bilanCouple', lang),
    cgv: getLocalizedPath('cgv', lang),
    contact: getLocalizedPath('contact', lang),
    confidentialite: getLocalizedPath('privacy', lang),
    // Les tests gratuits proposés au célibataire qui a répondu au sondage de
    // l'évaluation seul(e) (25 octobre 2026), avec leur nom du menu.
    celibTests: ['testCelibataire', 'testPretRelation', 'testDureeCelibat', 'testTrouverAmour']
      .map((r) => ({ url: getLocalizedPath(r, lang), titre: t('common:nav.' + r, '') }))
      .filter((x) => x.titre),
    prix,
    // Le même prix en centimes : l'écran « rapport prêt » le partage en deux.
    prixCentimes: typeof bilanPrixCentimes !== 'undefined' ? bilanPrixCentimes : null,
    garantie: jours,
    // L'offre de l'application montre la même réduction, si le serveur
    // confirme qu'il l'appliquera (bilan.js, promoAffichee).
    promo: promo ? { badge: promo.badge, code: promo.codeTexte, prix: promo.prix, html: promo.html } : null,
    ouvert: !!(typeof bilanOuvert !== 'undefined' && bilanOuvert),
    apercu: apercu('synthese'),
    textes: appTextes,
  };

  // Les douze domaines, dans l'ordre du rapport : titres et noms brefs dans
  // bilan-questions.json, une phrase par domaine dans lp.domaines.liste.
  const DOMS = ['quotidien', 'temps', 'entourage', 'travail', 'argent', 'logement', 'enfants', 'valeurs', 'disputes', 'confiance', 'intimite', 'meteo'];
  const domTitre = (id) => t('bilan-questions:domaines.' + id + '.titre', id);
  const domBref = (id) => t('bilan-questions:domaines.' + id + '.bref', domTitre(id));
  // Une icône au trait par domaine (24 x 24, trait de 1.8).
  const ICONES_DOM = {
    quotidien: '<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-5h4v5"/>',
    temps: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    entourage: '<circle cx="8" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.5"/><path d="M3 19c.6-3.2 2.5-5 5-5s4.4 1.8 5 5"/><path d="M13.5 18.5c.4-2.4 1.6-3.7 3-3.7s2.7 1.3 3.2 3.7"/>',
    travail: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
    argent: '<circle cx="12" cy="12" r="9"/><path d="M14.5 9.5c-.4-1-1.4-1.5-2.5-1.5-1.6 0-2.5.9-2.5 2 0 2.8 5 1.2 5 4 0 1.1-.9 2-2.5 2-1.2 0-2.2-.6-2.6-1.6"/><path d="M12 6.5v1.5M12 16v1.5"/>',
    logement: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M14 20v-6h-4v6"/><path d="M2 21h20"/>',
    enfants: '<circle cx="12" cy="7" r="3.5"/><path d="M6 21v-3a6 6 0 0 1 12 0v3"/><path d="M9 14l3 3 3-3"/>',
    valeurs: '<path d="M12 3l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.4 6.7 19.1l1-5.8-4.2-4.1 5.9-.9z"/>',
    disputes: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z"/><path d="M9 11h.01M12 11h.01M15 11h.01"/>',
    confiance: '<path d="M12 3l8 3v6c0 4.6-3.4 8.2-8 9-4.6-.8-8-4.4-8-9V6z"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
    intimite: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
    meteo: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  };
  const icone = (chemins, classe) => '<svg class="' + (classe || '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + chemins + '</svg>';
  const iconesConfiance = [
    '<circle cx="12" cy="8" r="4"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/><path d="M3 3l18 18"/>',
    '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><path d="M3 3l18 18"/>',
    '<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/>',
    '<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  ];
  // Les moyens de paiement sous le prix du hero (20 octobre 2026, Thomas :
  // « le pictogramme carte, apple pay, amazon pay, ça peut rassurer ») : six
  // vignettes de 46 x 30 dessinées en SVG, fond blanc posé par le CSS pour que
  // les marques gardent leurs couleurs en thème sombre ; la liste affichée est
  // MOYENS_PAIEMENT (config.js), passée en `moyensPaiement`.
  const svgPaiement = (corps) => '<svg viewBox="0 0 46 30" aria-hidden="true" focusable="false">' + corps + '</svg>';
  const policeMarque = "font-family=\"Arial, Helvetica, sans-serif\"";
  const PICTOS_PAIEMENT = {
    visa: { nom: 'Visa', svg: svgPaiement('<text x="23" y="19.6" text-anchor="middle" ' + policeMarque + ' font-weight="800" font-style="italic" font-size="13" letter-spacing=".4" fill="#1a1f71">VISA</text>') },
    mastercard: { nom: 'Mastercard', svg: svgPaiement('<circle cx="18" cy="15" r="8.5" fill="#eb001b"/><circle cx="28" cy="15" r="8.5" fill="#f79e1b"/><path d="M23 8.13A8.5 8.5 0 0 1 23 21.87A8.5 8.5 0 0 1 23 8.13Z" fill="#ff5f00"/>') },
    cb: { nom: 'Carte bancaire (CB)', svg: svgPaiement('<defs><linearGradient id="blp-cb-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2cb34a"/><stop offset="1" stop-color="#1b5eab"/></linearGradient></defs><rect x="9" y="5" width="28" height="20" rx="3" fill="url(#blp-cb-grad)"/><text x="23" y="19.4" text-anchor="middle" ' + policeMarque + ' font-weight="700" font-size="11.5" fill="#fff">CB</text>') },
    applepay: { nom: 'Apple Pay', svg: svgPaiement('<g transform="translate(8.5 7.3) scale(.6)"><path fill="#000" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></g><text x="24" y="19.8" font-family="-apple-system, \'Helvetica Neue\', Arial, sans-serif" font-weight="600" font-size="12.5" letter-spacing="-.2" fill="#000">Pay</text>') },
    googlepay: { nom: 'Google Pay', svg: svgPaiement('<g transform="translate(6.6 6.6) scale(.7)"><path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#fbbc05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></g><text x="25.2" y="19.8" ' + policeMarque + ' font-weight="600" font-size="12.5" letter-spacing="-.2" fill="#3c4043">Pay</text>') },
    amazonpay: { nom: 'Amazon Pay', svg: svgPaiement('<text x="23" y="13.2" text-anchor="middle" ' + policeMarque + ' font-weight="700" font-size="9.4" letter-spacing="-.3" fill="#232f3e">amazon</text><path d="M13.5 16.3c5.3 3.9 14 3.9 19.6-.3" fill="none" stroke="#f90" stroke-width="1.6" stroke-linecap="round"/><path d="M30.7 15.1l2.6.9-1 2.5" fill="none" stroke="#f90" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><text x="23" y="26.2" text-anchor="middle" ' + policeMarque + ' font-weight="600" font-size="8.6" fill="#232f3e">pay</text>') },
  };
  const moyens = (typeof moyensPaiement !== 'undefined' && Array.isArray(moyensPaiement) ? moyensPaiement : []).filter((m) => PICTOS_PAIEMENT[m]);
  // Les mêmes vignettes sous le bouton de paiement de l'application
  // (bilan.js, blocConfiance), avec un dégradé à elles : celui du haut de page
  // reste dans le DOM une fois la page de vente masquée, et une référence
  // url(#...) vers un dégradé masqué ne se peint pas.
  bilanConfig.paiements = moyens.map((m) => ({ nom: PICTOS_PAIEMENT[m].nom, svg: PICTOS_PAIEMENT[m].svg.replace(/blp-cb-grad/g, 'bilan-cb-grad') }));
  const fleche = '<svg class="blp-fleche" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>';
  const coche = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

  // Le radar du haut de page : onze axes (le climat a sa propre partie),
  // trois formes qui se fondent l'une dans l'autre (opacité seulement).
  const AXES = DOMS.filter((d) => d !== 'meteo');
  const RC = { cx: 190, cy: 150, r: 100 };
  const ang = (i) => -Math.PI / 2 + (2 * Math.PI * i) / AXES.length;
  const pt = (i, r) => [RC.cx + r * Math.cos(ang(i)), RC.cy + r * Math.sin(ang(i))];
  const poly = (vals) => vals.map((v, i) => pt(i, RC.r * v / 100).map((n) => n.toFixed(1)).join(',')).join(' ');
  const FORMES = [[97, 87, 94, 82, 90, 61, 86, 93, 62, 81, 84], [80, 70, 88, 75, 65, 90, 95, 70, 78, 60, 72], [90, 92, 70, 88, 84, 78, 60, 85, 80, 92, 88]];
  const grilleRadar = [25, 50, 75, 100].map((k) => '<polygon points="' + AXES.map((d, i) => pt(i, RC.r * k / 100).map((n) => n.toFixed(1)).join(',')).join(' ') + '" class="blp-radar-grille' + (k === 100 ? ' blp-radar-grille--bord' : '') + '"/>').join('');
  const axesRadar = AXES.map((d, i) => { const [px, py] = pt(i, RC.r); return '<line x1="' + RC.cx + '" y1="' + RC.cy + '" x2="' + px.toFixed(1) + '" y2="' + py.toFixed(1) + '" class="blp-radar-axe"/>'; }).join('');
  const libellesRadar = AXES.map((d, i) => {
    const c = Math.cos(ang(i)); const s = Math.sin(ang(i));
    const [lx, ly] = pt(i, RC.r + 18);
    const anchor = c > 0.25 ? 'start' : c < -0.25 ? 'end' : 'middle';
    const dy = s > 0.6 ? 8 : s < -0.6 ? -2 : 3;
    return '<text x="' + lx.toFixed(1) + '" y="' + (ly + dy).toFixed(1) + '" text-anchor="' + anchor + '" class="blp-radar-lib">' + e(domBref(d)) + '</text>';
  }).join('');
  const anneauTour = (2 * Math.PI * 26).toFixed(2);
  const anneauPlein = (2 * Math.PI * 26 * 0.83).toFixed(2);

  // La question à essayer, telle que Camille l'a vue (accords au
  // féminin, le prénom du partenaire à la place de « {autre} »).
  const demoQ = liste('demo.questions');
  const partenaire = L('demo.partenaireNom', 'Julien');
  const voirPar = (s) => String(s || '').replace(/\{([^|}]*)\|([^|}]*)(?:\|[^}]*)?\}/g, '$2').replace(/\{autre\}/g, partenaire);
  const qui = t('bilan-questions:qui', []);
  const demos = demoQ.map((q) => {
    const d = t('bilan-questions:domaines.' + q.dom + '.questions.' + q.id, null);
    if (!d) return null;
    return { domaine: domTitre(q.dom), q: voirPar(d.q), o: (d.o || qui).map(voirPar), pourquoi: voirPar(d.pourquoi || '') };
  }).filter(Boolean);

  const chiffres = liste('chiffres');
  const pages = liste('rapport.pages');
  const etapes = liste('etapes.liste');
  const inclus = liste('prix.inclus');
  const confiance = liste('confiance.points');
  const facons = L('facons', {}) || {};

  // La preuve sous le bouton (23 octobre 2026, Thomas : « ne met pas
  // 120 000, tu dis, Quiz Couple, des milliers de visiteurs chaque jour ») :
  // les deux personnages, puis la phrase, « Quiz Couple » en gras. Le site
  // fait plus de 5 000 visites par jour (mesure d'audience), et l'évaluation
  // n'a pas encore d'avis à citer.
  const preuve = e(ins(L('preuve'))).replace('{{nom}}', '<strong>Quiz Couple</strong>');
%>
<script type="application/ld+json"><%- JSON.stringify(appBilan) %></script>
<% if (faqEntrees.length) { %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntrees }) %></script>
<% } %>

<div class="blp" data-lang="<%= lang %>">

  <!-- La promesse : un titre, une phrase, un seul gros bouton -->
  <section class="blp-hero">
    <div class="blp-wrap blp-hero-grille">
      <div class="blp-hero-texte">
        <p class="blp-sur"><%- x('badge') %></p>
        <h1 class="blp-h1"><%- x('titre') %></h1>
        <p class="blp-lead"><%- x('sousTitre') %></p>
        <% if (promo) { %>
        <p class="blp-promo"><span class="promo-pastille"><%= promo.badge %></span><span class="blp-promo-prix"><%- promo.html %></span><span class="blp-promo-unite"><%- x('prix.unite') %></span></p>
        <% } %>
        <div class="blp-ctas">
          <button type="button" class="blp-btn blp-btn--grand" data-bilan-commencer="duo"><%- x('cta') %><%- fleche %></button>
        </div>
        <p class="blp-solo"><%- x('soloQuestion') %> <button type="button" class="blp-solo-lien" data-bilan-commencer="solo"><%- x('soloLien') %></button></p>
        <% if (moyens.length) { %>
        <div class="blp-paiements">
          <span class="blp-paiements-lib"><%- icone(iconesConfiance[3]) %><%- x('paiements') %></span>
          <ul class="blp-paiements-liste" role="list">
            <% for (const m of moyens) { %><li class="blp-paiement" title="<%= PICTOS_PAIEMENT[m].nom %>"><%- PICTOS_PAIEMENT[m].svg %><span class="sr-only"><%= PICTOS_PAIEMENT[m].nom %></span></li><% } %>
          </ul>
        </div>
        <% } %>
        <p class="blp-preuve"><span class="blp-preuve-persos" aria-hidden="true"><%- masc('rose', 'salut', 'blp-preuve-masc') %><%- masc('violet', 'mignon', 'blp-preuve-masc') %></span><span class="blp-preuve-texte"><%- preuve %></span></p>
        <div id="bilan-reprise" class="blp-reprise" hidden></div>
        <noscript><p class="blp-cta-note"><%= lang === 'fr' ? "L'évaluation a besoin de JavaScript pour fonctionner." : 'The assessment needs JavaScript to work.' %></p></noscript>
      </div>
      <div class="blp-hero-visuel">
        <div class="blp-radar-carte">
          <p class="blp-radar-sur"><%- x('visuel.sur') %></p>
          <p class="blp-radar-noms"><%- x('visuel.noms') %></p>
          <svg class="blp-radar" viewBox="0 0 380 300" role="img" aria-label="<%- x('visuel.legende') %>">
            <%- grilleRadar %><%- axesRadar %>
            <% FORMES.forEach((f, i) => { %><polygon points="<%= poly(f) %>" class="blp-radar-forme blp-radar-forme--<%= i + 1 %>"/><% }) %>
            <%- libellesRadar %>
          </svg>
          <div class="blp-radar-pied">
            <div class="blp-anneau" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" class="blp-anneau-fond"/><circle cx="32" cy="32" r="26" class="blp-anneau-trait" stroke-dasharray="<%= anneauPlein %> <%= anneauTour %>" transform="rotate(-90 32 32)"/></svg>
              <span class="blp-anneau-val">83<small>%</small></span>
            </div>
            <p class="blp-radar-lib"><%- x('visuel.alignement') %></p>
          </div>
          <%- masc('rose', 'salut', 'blp-masc blp-masc--rose') %>
          <%- masc('violet', 'mignon', 'blp-masc blp-masc--violet') %>
        </div>
      </div>
    </div>
  </section>

  <!-- Quelques chiffres -->
  <section class="blp-chiffres" aria-label="<%- x('badge') %>">
    <div class="blp-wrap blp-chiffres-grille">
      <% for (const c of chiffres) { %>
      <div class="blp-chiffre"><p class="blp-chiffre-n"><%= c.n %></p><p class="blp-chiffre-l"><%- tx(c.l) %></p></div>
      <% } %>
    </div>
  </section>

  <!-- Le ruban des douze domaines -->
  <div class="blp-ruban" aria-hidden="true">
    <% for (const k of [0, 1]) { %>
    <div class="blp-ruban-piste">
      <% for (const d of DOMS) { %><span class="blp-ruban-puce"><%- icone(ICONES_DOM[d], 'blp-ruban-ico') %><%- tx(domTitre(d)) %></span><% } %>
    </div>
    <% } %>
  </div>

  <!-- Comment ça marche : trois étapes -->
  <section class="blp-section blp-etapes">
    <div class="blp-wrap blp-etroit">
      <h2 class="blp-h2"><%- x('etapes.titre') %></h2>
      <ol class="blp-tl">
        <% etapes.forEach((s, i) => { %>
        <li class="blp-tl-etape animate-on-scroll">
          <div class="blp-tl-rail" aria-hidden="true"><span class="blp-tl-num"><%= i + 1 %></span></div>
          <div class="blp-tl-corps">
            <p class="blp-tl-duree"><%- tx(s.duree) %></p>
            <h3 class="blp-h3"><%- tx(s.titre) %></h3>
            <p><%- tx(s.texte) %></p>
          </div>
          <div class="blp-tl-mock blp-tl-mock--<%= i + 1 %>" aria-hidden="true">
            <% if (i === 0) { %><span class="blp-mock-chip blp-mock-chip--on"><%- tx((facons.duo || {}).titre) %></span><span class="blp-mock-chip"><%- tx((facons.solo || {}).titre) %></span>
            <% } else if (i === 1) { %><span class="blp-mock-q"></span><span class="blp-mock-opt blp-mock-opt--on"></span><span class="blp-mock-opt"></span><span class="blp-mock-opt"></span>
            <% } else { %><span class="blp-mock-prix"><%- promo ? promo.html : e(prix) %></span><span class="blp-mock-cadenas"><%- icone(iconesConfiance[3]) %></span><% } %>
          </div>
        </li>
        <% }) %>
      </ol>
      <p class="blp-note blp-centre"><%- x('etapes.note') %></p>
      <div class="blp-ctas blp-ctas--centre blp-ctas--section">
        <button type="button" class="blp-btn" data-bilan-commencer="duo"><%- x('cta') %><%- fleche %></button>
      </div>
    </div>
  </section>

  <!-- Le rapport, page par page -->
  <section class="blp-section blp-rapport" id="rapport">
    <div class="blp-wrap">
      <h2 class="blp-h2"><%- x('rapport.titre') %></h2>
      <p class="blp-intro"><%- x('rapport.intro') %></p>
    </div>
    <div class="blp-wrap blp-wrap--large">
      <div class="quiz-slider blp-slider" data-slider>
        <button type="button" class="quiz-slider__nav quiz-slider__nav--prev" data-slider-prev aria-label="<%= t('common:buttons.previous', 'Précédent') %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="quiz-slider__track blp-slider-piste" data-slider-track>
          <% pages.forEach((p, i) => { %>
          <figure class="quiz-slide blp-slide">
            <div class="blp-slide-image"><img src="<%= apercu(p.img) %>" alt="<%- tx(p.titre) %>" width="240" height="340" loading="<%= i < 2 ? 'eager' : 'lazy' %>" decoding="async" draggable="false"></div>
            <figcaption class="blp-slide-texte">
              <p class="blp-slide-num"><%= String(i + 1).padStart(2, '0') %></p>
              <h3 class="blp-h3"><%- tx(p.titre) %></h3>
              <p><%- tx(p.texte) %></p>
            </figcaption>
          </figure>
          <% }) %>
        </div>
        <button type="button" class="quiz-slider__nav quiz-slider__nav--next" data-slider-next aria-label="<%= t('common:buttons.next', 'Suivant') %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <div class="quiz-slider__pied" aria-hidden="true">
          <div class="quiz-slider__barre"><span class="quiz-slider__avance"></span></div>
          <span class="quiz-slider__compteur" data-slider-compteur></span>
        </div>
      </div>
      <p class="blp-legende"><%- x('rapport.legende') %></p>
    </div>
  </section>

  <!-- À deux ou seul(e) -->
  <section class="blp-section blp-facons" id="facons">
    <div class="blp-wrap">
      <%# Le prix d'une séance, en citation (Thomas, 19 octobre 2026 : « cette phrase est super ! Il faudrait la mettre en citation juste avant »). %>
      <blockquote class="blp-citation"><p><%- x('facons.citation') %></p></blockquote>
      <h2 class="blp-h2"><%- x('facons.titre') %></h2>
      <p class="blp-intro"><%- x('facons.intro') %></p>
      <div class="blp-facons-grille">
        <% for (const m of ['duo', 'solo']) { const f = facons[m] || {}; %>
        <article class="blp-facon blp-facon--<%= m %> animate-on-scroll">
          <div class="blp-facon-persos" aria-hidden="true"><%- m === 'duo' ? masc('rose', 'salut', 'blp-masc-s') + masc('violet', 'mignon', 'blp-masc-s') : masc('rose', 'mignon', 'blp-masc-s') %></div>
          <p class="blp-facon-sous"><%- tx(f.sous) %></p>
          <h3 class="blp-facon-titre"><%- tx(f.titre) %></h3>
          <ul class="blp-coches">
            <% for (const p of (f.points || [])) { %><li><span class="blp-coche"><%- coche %></span><span><%- tx(p) %></span></li><% } %>
          </ul>
          <button type="button" class="blp-btn<%= m === 'solo' ? ' blp-btn--violet' : '' %>" data-bilan-commencer="<%= m %>"><%- tx(f.cta) %><%- fleche %></button>
        </article>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Une question à essayer -->
  <% if (demos.length) { %>
  <section class="blp-section blp-demo">
    <div class="blp-wrap blp-etroit">
      <h2 class="blp-h2"><%- x('demo.titre') %></h2>
      <p class="blp-intro"><%- x('demo.intro') %></p>
      <div class="blp-dqs">
        <% demos.forEach((d, i) => { %>
        <article class="blp-dq">
          <p class="blp-dq-dom"><%- tx(d.domaine) %></p>
          <h3 class="blp-dq-q"><%- tx(d.q) %></h3>
          <div class="blp-dq-opts" role="group">
            <% d.o.forEach((o, j) => { %><button type="button" class="blp-dq-opt" data-demo-option aria-pressed="false"><span class="blp-dq-rond" aria-hidden="true"></span><span><%- tx(o) %></span></button><% }) %>
          </div>
          <div class="blp-dq-face">
            <div class="blp-dq-faces">
              <div class="blp-dq-col blp-dq-col--rose"><p class="blp-dq-qui"><%- x('demo.vous') %></p><p class="blp-dq-rep" data-demo-vous></p></div>
              <div class="blp-dq-col blp-dq-col--violet"><p class="blp-dq-qui"><%- x('demo.partenaire') %></p><p class="blp-dq-rep blp-dq-rep--attente"><%- x('demo.attente') %></p></div>
            </div>
            <% if (d.pourquoi) { %><p class="blp-dq-pourquoi-titre"><%- x('demo.pourquoi') %></p><p class="blp-dq-pourquoi"><%- tx(d.pourquoi) %></p><% } %>
            <p class="blp-dq-apres"><%- x('demo.apres') %></p>
          </div>
        </article>
        <% }) %>
      </div>
      <div class="blp-ctas blp-ctas--centre blp-ctas--section">
        <button type="button" class="blp-btn" data-bilan-commencer="duo"><%- x('demo.cta') %><%- fleche %></button>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Le prix -->
  <section class="blp-section blp-prix-section" id="prix">
    <div class="blp-wrap">
      <%# La promesse, avec les mots de Thomas (22 octobre 2026) : pourquoi ce
          prix vaut d'être payé, juste avant de le lire. %>
      <blockquote class="blp-citation blp-citation--prix"><p><%- x('prix.accroche') %></p></blockquote>
      <div class="blp-prix">
        <div class="blp-prix-tete">
          <h2 class="blp-h2"><%- x('prix.titre') %></h2>
          <% if (promo) { %><p class="blp-prix-pastille"><span class="promo-pastille"><%= promo.badge %></span></p><% } %>
          <p class="blp-prix-montant"><%- promo ? promo.html : e(prix) %></p>
          <p class="blp-prix-unite"><%- x('prix.unite') %></p>
          <% if (promo) { %><p class="blp-prix-code"><%= promo.codeTexte %></p><% } %>
        </div>
        <div class="blp-prix-corps">
          <ul class="blp-coches blp-coches--sombre">
            <% for (const p of inclus) { %><li><span class="blp-coche"><%- coche %></span><span><%- tx(p) %></span></li><% } %>
          </ul>
          <p class="blp-prix-aide"><%- x('prix.aide') %></p>
          <% if (jours > 0) { %><p class="blp-garantie"><%- x('prix.garantie') %></p><% } %>
          <div class="blp-ctas">
            <button type="button" class="blp-btn" data-bilan-commencer="duo"><%- x('cta') %><%- fleche %></button>
          </div>
          <p class="blp-solo"><%- x('soloQuestion') %> <button type="button" class="blp-solo-lien" data-bilan-commencer="solo"><%- x('soloLien') %></button></p>
        </div>
      </div>
    </div>
  </section>

  <!-- La confiance -->
  <section class="blp-section blp-confiance">
    <div class="blp-wrap">
      <h2 class="blp-h2"><%- x('confiance.titre') %></h2>
      <div class="blp-confiance-grille">
        <% confiance.forEach((c, i) => { %>
        <div class="blp-confiance-point">
          <span class="blp-carte-ico"><%- icone(iconesConfiance[i % iconesConfiance.length]) %></span>
          <h3 class="blp-h3"><%- tx(c.titre) %></h3>
          <p><%- tx(c.texte) %></p>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Questions fréquentes -->
  <section class="blp-section blp-faq">
    <div class="blp-wrap blp-etroit">
      <h2 class="blp-h2"><%- x('faq.titre') %></h2>
      <div class="blp-faq-liste">
        <% for (const f of faqItems) { %>
        <details class="blp-faq-item">
          <summary><%- tx(f.q) %></summary>
          <p><%- tx(f.a) %></p>
        </details>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Dernier appel -->
  <section class="blp-final">
    <div class="blp-wrap blp-etroit">
      <h2 class="blp-h2"><%- x('final.titre') %></h2>
      <p class="blp-lead"><%- x('final.texte') %></p>
      <div class="blp-ctas blp-ctas--centre">
        <button type="button" class="blp-btn blp-btn--grand" data-bilan-commencer="duo"><%- x('cta') %><%- fleche %></button>
      </div>
      <p class="blp-solo"><%- x('soloQuestion') %> <button type="button" class="blp-solo-lien" data-bilan-commencer="solo"><%- x('soloLien') %></button></p>
    </div>
  </section>

  <p class="blp-avertissement blp-wrap"><%- x('avertissement') %></p>

  <!-- La barre collée en bas, sur téléphone, dès que le haut de page est passé -->
  <div class="blp-colle" id="blp-colle" hidden>
    <% if (promo) { %>
    <%# Avec une réduction : le nom sur une ligne, le prix barré et le nouveau dessous (« Évaluation de couple » sans le « · » du texte d'origine). %>
    <span class="blp-colle-texte"><span class="blp-colle-nom"><%- tx(String(L('colle.texte')).split('{{prix}}')[0].replace(/\s*·\s*$/, '')) %></span><span class="blp-colle-prix"><%- promo.html %></span></span>
    <% } else { %>
    <span class="blp-colle-texte"><%- x('colle.texte') %></span>
    <% } %>
    <button type="button" class="blp-btn blp-btn--petit" data-bilan-commencer><%- x('colle.bouton') %><%- fleche %></button>
  </div>
</div>

<!-- L'application : masquée tant qu'on n'a pas commencé -->
<section class="bilan-scene" aria-live="polite">
  <div class="bilan-scene-barre">
    <button type="button" class="bilan-scene-retour" data-bilan-quitter>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg>
      <span><%= t(ns + ':app.accueil.quitter', 'Retour') %></span>
    </button>
    <span class="bilan-scene-titre"><%= t('quizzes:bilanCouple.shortTitle', pageTitle) %></span>
  </div>
  <div class="container mx-auto px-4">
    <div id="bilan-app" class="bilan" data-lang="<%= lang %>">
      <div class="bilan-carte bilan-chargement">
        <p><%= t(ns + ':app.chargement', 'Chargement...') %></p>
      </div>
    </div>
  </div>
</section>

<script>window.BILAN_CONFIG = <%- JSON.stringify(bilanConfig).replace(/</g, '\\u003c') %>;</script>
<script src="/js/quiz-slider.js" defer></script>
<script src="/js/bilan-lp.js" defer></script>
<script src="/js/mascottes.js" defer></script>
<script src="/js/bilan-coeur.js" defer></script>
<script src="/js/bilan-rapport.js" defer></script>
<script src="/js/bilan.js" defer></script>
