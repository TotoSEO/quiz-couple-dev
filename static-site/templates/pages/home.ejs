<%
  // Home page data
  const hero = {
    badge: t('home:hero.badge', '100% Gratuit'),
    title: t('home:hero.title', 'Le quiz pour couples qui vous rapproche'),
    titleHighlight: t('home:hero.titleHighlight', 'qui vous rapproche'),
    description: t('home:hero.description', ''),
    descriptionHighlight: t('home:hero.descriptionHighlight', ''),
    cta1: t('home:hero.cta1', 'Découvrir nos quiz'),
    cta2: t('home:hero.cta2', 'Tester son couple'),
    stat1Value: t('home:hero.stat1Value', '1000+'),
    stat1Label: t('home:hero.stat1Label', 'couples testés'),
    stat2Value: t('home:hero.stat2Value', '12'),
    stat2Label: t('home:hero.stat2Label', 'quiz disponibles'),
  };

  // Quiz grid data
  const tests = [
    { routeKey: 'testCouple', key: 'testCouple', icon: '💕' },
    { routeKey: 'testCommonPoints', key: 'testCommonPoints', icon: '🎯' },
    { routeKey: 'testDistance', key: 'testDistance', icon: '🌍' },
    { routeKey: 'testToxic', key: 'testToxic', icon: '⚠️' },
    { routeKey: 'testCoupleSain', key: 'testCoupleSain', icon: '💚' },
    { routeKey: 'testMariage', key: 'testMariage', icon: '💒' },
    { routeKey: 'testDivorce', key: 'testDivorce', icon: '⚖️' },
  ];
  const quizzes = [
    { routeKey: 'quizAmoureux', key: 'quizAmoureux', icon: '❤️' },
    { routeKey: 'quizCoquin', key: 'quizCoquin', icon: '🔥' },
    { routeKey: 'quizMarrant', key: 'quizMarrant', icon: '😂' },
    { routeKey: 'quizKnowledge', key: 'quizKnowledge', icon: '🧠' },
    { routeKey: 'quizMost', key: 'quizMost', icon: '🏆' },
    { routeKey: 'quizAdo', key: 'quizAdo', icon: '🌟' },
  ];

  // Why do quiz - 6 reasons
  const reasons = ['testRelation', 'haveFun', 'discover', 'strengthen', 'dialogue', 'memories'];
  const reasonIcons = ['💕', '🎉', '🔍', '💪', '💬', '📸'];

  // How it works - 3 steps
  const steps = ['choose', 'answer', 'results'];
  const stepIcons = ['🎯', '✏️', '🎉'];

  // JSON-LD
  const jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Quiz Couple",
      "url": "https://quiz-couple.com",
      "description": t('home:seo.schemaDescription', 'Plateforme de quiz gratuits pour tester votre relation de couple'),
      "publisher": { "@id": "https://quiz-couple.com/#organization" }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://quiz-couple.com/#organization",
      "name": "Quiz Couple",
      "url": "https://quiz-couple.com",
      "logo": { "@type": "ImageObject", "url": "https://quiz-couple.com/apple-touch-icon.png", "width": 180, "height": 180 },
      "image": "https://quiz-couple.com/og-image.webp",
      "description": t('home:seo.schemaDescription', 'Plateforme de quiz gratuits pour tester et renforcer votre relation de couple')
    }
  ];
%>

<!-- JSON-LD injected in head via base template -->
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero Section -->
<section class="relative overflow-hidden gradient-hero py-16 md:py-24">
  <!-- Decorative blobs -->
  <div class="absolute top-20 left-10 w-64 h-64 blob-primary animate-blob opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 right-10 w-48 h-48 blob-secondary animate-blob delay-500 opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge badge-primary mb-4"><%= hero.badge %></span>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <%- hero.title.replace(hero.titleHighlight, '<span class="text-gradient">' + hero.titleHighlight + '</span>') %>
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
        <% if (hero.descriptionHighlight && hero.description.includes(hero.descriptionHighlight)) { %>
          <%- hero.description.replace(hero.descriptionHighlight, '<strong class="text-foreground">' + hero.descriptionHighlight + '</strong>') %>
        <% } else { %>
          <%= hero.description %>
        <% } %>
      </p>

      <!-- Stats -->
      <div class="flex justify-center gap-8 mb-8">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary tabular-nums"><%= hero.stat1Value %></div>
          <div class="text-sm text-muted-foreground"><%= hero.stat1Label %></div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary tabular-nums"><%= hero.stat2Value %></div>
          <div class="text-sm text-muted-foreground"><%= hero.stat2Label %></div>
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#quiz-section" class="btn btn-cta"><%= hero.cta1 %></a>
        <a href="<%= getLocalizedUrl('testCouple', lang) %>" class="btn btn-outline btn-lg"><%= hero.cta2 %></a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Quiz Section -->
<section id="quiz-section" class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:quizSection.title', 'Nos quiz pour couples') %></h2>
      <p class="text-muted-foreground max-w-2xl mx-auto"><%= t('home:quizSection.description', '') %></p>
    </div>

    <!-- Tests -->
    <h3 class="text-xl font-semibold mb-6"><%= t('home:quizGrid.testsTitle', 'Tests de couple') %></h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      <% for (const item of tests) { %>
      <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="glass-card rounded-2xl p-6 card-hover no-underline block">
        <div class="text-3xl mb-3"><%= item.icon %></div>
        <h4 class="text-lg font-semibold mb-2 text-foreground"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
        <p class="text-sm text-muted-foreground line-clamp-2"><%= t('home:quizGrid.' + item.key + '.description', t('quizzes:' + item.key + '.description', '')) %></p>
      </a>
      <% } %>
    </div>

    <!-- Quizzes -->
    <h3 class="text-xl font-semibold mb-6"><%= t('home:quizGrid.quizzesTitle', 'Quiz pour couples') %></h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% for (const item of quizzes) { %>
      <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="glass-card rounded-2xl p-6 card-hover no-underline block">
        <div class="text-3xl mb-3"><%= item.icon %></div>
        <h4 class="text-lg font-semibold mb-2 text-foreground"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
        <p class="text-sm text-muted-foreground line-clamp-2"><%= t('home:quizGrid.' + item.key + '.description', t('quizzes:' + item.key + '.description', '')) %></p>
      </a>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'background', direction: 'up' }) %>

<!-- AI Resolver Section -->
<section class="section-padding">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge badge-secondary mb-4"><%= t('home:aiResolver.badge', 'Nouveau') %></span>
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:aiResolver.title', 'Résolvez vos problèmes de couple avec l\'IA') %></h2>
      <p class="text-muted-foreground mb-8 max-w-2xl mx-auto"><%= t('home:aiResolver.description', '') %></p>
      <a href="<%= getLocalizedUrl('problemResolver', lang) %>" class="btn btn-cta"><%= t('home:aiResolver.cta', 'Essayer gratuitement') %></a>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- What Is Quiz Couple -->
<section class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 text-center"><%= t('home:whatIs.title', 'Qu\'est-ce qu\'un quiz pour couples ?') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t('home:whatIs.p1', '') %></p>
        <p><%- t('home:whatIs.p2', '') %></p>
        <p><%- t('home:whatIs.p3', '') %></p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Why Do Quiz -->
<section class="section-padding">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:whyDoQuiz.title', 'Pourquoi faire un quiz de couple ?') %></h2>
      <p class="text-muted-foreground max-w-2xl mx-auto"><%= t('home:whyDoQuiz.description', '') %></p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <% for (let i = 0; i < reasons.length; i++) { %>
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="text-3xl mb-3"><%= reasonIcons[i] %></div>
        <h3 class="text-lg font-semibold mb-2"><%= t('home:whyDoQuiz.' + reasons[i] + '.title', reasons[i]) %></h3>
        <p class="text-sm text-muted-foreground"><%= t('home:whyDoQuiz.' + reasons[i] + '.description', '') %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'background', direction: 'up' }) %>

<!-- How It Works -->
<section class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:howItWorks.title', 'Comment ça marche ?') %></h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <% for (let i = 0; i < steps.length; i++) { %>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
          <span class="text-2xl"><%= stepIcons[i] %></span>
        </div>
        <div class="text-sm font-medium text-primary mb-2"><%= t('home:howItWorks.step', 'Étape') %> <%= i + 1 %></div>
        <h3 class="text-lg font-semibold mb-2"><%= t('home:howItWorks.' + steps[i] + '.title', steps[i]) %></h3>
        <p class="text-sm text-muted-foreground"><%= t('home:howItWorks.' + steps[i] + '.description', '') %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Latest Articles (loaded dynamically via JS from Supabase) -->
<section class="section-padding" id="latest-articles">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:latestArticles.title', 'Derniers articles') %></h2>
      <p class="text-muted-foreground"><%= t('home:latestArticles.description', '') %></p>
    </div>
    <div class="blog-grid" id="articles-grid">
      <!-- Articles loaded by JS -->
      <div class="text-center text-muted-foreground col-span-full py-8">
        <div class="spinner mx-auto mb-4"></div>
        <p><%= t('common:blog.loading', 'Chargement des articles...') %></p>
      </div>
    </div>
    <div class="text-center mt-8">
      <a href="<%= getLocalizedUrl('blog', lang) %>" class="btn btn-outline"><%= t('common:blog.seeAll', 'Voir tous les articles') %></a>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Reviews Section (loaded dynamically) -->
<section class="section-padding bg-muted/20" id="avis">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('common:reviews.title', 'Avis des utilisateurs') %></h2>
      <p class="text-muted-foreground"><%= t('common:reviews.description', '') %></p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto" id="reviews-grid">
      <!-- Reviews loaded by JS -->
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Final CTA -->
<section class="section-padding">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl text-center glass-card-strong rounded-3xl p-8 md:p-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:finalCTA.title', 'Prêts à mieux vous connaître ?') %></h2>
      <p class="text-muted-foreground mb-8"><%= t('home:finalCTA.description', '') %></p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="<%= getLocalizedUrl('testCouple', lang) %>" class="btn btn-cta"><%= t('home:finalCTA.cta1', 'Commencer le test') %></a>
        <a href="#quiz-section" class="btn btn-outline btn-lg"><%= t('home:finalCTA.cta2', 'Voir tous les quiz') %></a>
      </div>
    </div>
  </div>
</section>

<!-- Home page dynamic scripts -->
<script>
  // Load latest blog articles
  (function() {
    var SUPABASE_URL = '<%= supabaseUrl %>';
    var SUPABASE_KEY = '<%= supabaseKey %>';
    var LANG = '<%= lang %>';
    var grid = document.getElementById('articles-grid');
    if (!grid) return;

    var blogUrl = '<%= getLocalizedUrl("blog", lang) %>';

    fetch(SUPABASE_URL + '/rest/v1/blog_article_translations?select=slug,title,excerpt,featured_image_alt,article_id,blog_articles(featured_image_url,status,published_at)&lang=eq.' + LANG + '&blog_articles.status=eq.published&order=blog_articles(published_at).desc&limit=3', {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
    })
    .then(function(res) { return res.json(); })
    .then(function(articles) {
      if (!articles || articles.length === 0) {
        grid.innerHTML = '<p class="text-center text-muted-foreground col-span-full py-8"><%= t("common:blog.noArticles", "Aucun article disponible.") %></p>';
        return;
      }
      var html = '';
      articles.forEach(function(a) {
        if (!a.blog_articles) return;
        var imgUrl = a.blog_articles.featured_image_url || '/placeholder.svg';
        var date = new Date(a.blog_articles.published_at).toLocaleDateString(LANG === 'fr' ? 'fr-FR' : LANG + '-' + LANG.toUpperCase(), { year: 'numeric', month: 'long', day: 'numeric' });
        var articleUrl = (LANG === 'fr' ? '/blog/' : '/' + LANG + '/blog/') + a.slug;
        html += '<article class="blog-card">';
        html += '<a href="' + articleUrl + '" class="blog-card-image-link no-underline"><div class="blog-card-image-wrapper"><img src="' + imgUrl + '" alt="' + (a.featured_image_alt || a.title) + '" class="blog-card-image" loading="lazy"></div></a>';
        html += '<h3 class="blog-card-title"><a href="' + articleUrl + '">' + a.title + '</a></h3>';
        html += '<div class="blog-card-meta"><span>' + date + '</span></div>';
        html += '<p class="blog-card-excerpt">' + (a.excerpt || '') + '</p>';
        html += '<a href="' + articleUrl + '" class="blog-card-cta no-underline"><%= t("common:blog.readArticle", "Lire l\'article") %></a>';
        html += '</article>';
      });
      grid.innerHTML = html;
    })
    .catch(function() {
      grid.innerHTML = '<p class="text-center text-muted-foreground col-span-full py-8"><%= t("common:blog.noArticles", "Aucun article disponible.") %></p>';
    });
  })();

  // Load reviews
  (function() {
    var SUPABASE_URL = '<%= supabaseUrl %>';
    var SUPABASE_KEY = '<%= supabaseKey %>';
    var grid = document.getElementById('reviews-grid');
    if (!grid) return;

    fetch(SUPABASE_URL + '/rest/v1/reviews?select=*&is_approved=eq.true&order=created_at.desc&limit=6', {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
    })
    .then(function(res) { return res.json(); })
    .then(function(reviews) {
      if (!reviews || reviews.length === 0) return;
      var html = '';
      reviews.forEach(function(r) {
        var stars = '';
        for (var i = 1; i <= 5; i++) {
          stars += '<svg viewBox="0 0 24 24" class="w-4 h-4 ' + (i <= r.rating ? 'star-filled' : 'star-empty') + '"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
        }
        html += '<div class="glass-card rounded-2xl p-6">';
        html += '<div class="flex items-center gap-1 mb-3">' + stars + '</div>';
        html += '<p class="text-sm text-muted-foreground mb-3">' + (r.comment || '') + '</p>';
        html += '<p class="text-sm font-medium text-foreground">' + (r.author_name || 'Anonyme') + '</p>';
        html += '</div>';
      });
      grid.innerHTML = html;
    })
    .catch(function() {});
  })();
</script>
