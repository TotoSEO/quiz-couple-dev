    testPretRelation: { icon: '🌱', img: 'quiz-amoureux' },
    testSuisJeAmoureux: { icon: '💗', img: 'quiz-amoureux' },
    testCrush: { icon: '💘', img: 'quiz-amoureux' },
    testAmourAmitie: { icon: '👫', img: 'quiz-amoureux' },
    testAmourAmi: { icon: '🧡', img: 'quiz-amoureux' },
    testSecret: { icon: '💌', img: 'quiz-amoureux' },
    testEx: { icon: '🕰️', img: 'quiz-amoureux' },
    quizAmoureux: { icon: '❤️', img: 'quiz-amoureux' },
    quizTypeCouple: { icon: '🧩', img: 'quiz-amoureux' },
