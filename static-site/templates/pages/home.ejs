<!-- Latest Articles (statically rendered at build time) -->
<%
  const latestArticles = (typeof blogArticlesList !== 'undefined' ? blogArticlesList : []).slice(0, 3);
  const dateLocaleHome = lang === 'fr' ? 'fr-FR' : lang === 'en' ? 'en-US' : lang === 'es' ? 'es-ES' : lang === 'de' ? 'de-DE' : 'it-IT';
%>
<section class="section-padding" id="latest-articles">
