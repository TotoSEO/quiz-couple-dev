  ];

  // Filter out tests/quizzes not available in current language
  const testsFiltered = tests.filter(item => getLocalizedUrl(item.routeKey, lang));
  const quizzesFiltered = quizzes.filter(item => getLocalizedUrl(item.routeKey, lang));
  const jeuxFiltered = jeux.filter(item => getLocalizedUrl(item.routeKey, lang));

  // Why do quiz - 6 reasons
  const reasons = ['testRelation', 'haveFun', 'discover', 'strengthen', 'dialogue', 'memories'];
  // Glyphes maison, tracés au trait : ils se dessinent à l'entrée dans l'écran
  // et se déforment au survol. Les emojis rendaient six pastilles bariolées
  // qui ne parlaient ni la langue du site ni celle du thème sombre.
  const reasonIcons = [
    // jauge : savoir où vous en êtes
    '<path d="M4 18a8 8 0 1 1 16 0"/><path d="M12 18l4.5-5"/><circle cx="12" cy="18" r="1.4"/>',
    // lune et éclats : la soirée
    '<path d="M20 14.5A8.5 8.5 0 1 1 10.2 4a6.8 6.8 0 0 0 9.8 10.5z"/><path d="M17 4.2v2.6M15.7 5.5h2.6"/>',
    // loupe sur un cœur : apprendre encore
    '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path d="M10.5 13.2s-2.8-1.9-2.8-3.6a1.7 1.7 0 0 1 2.8-1.2 1.7 1.7 0 0 1 2.8 1.2c0 1.7-2.8 3.6-2.8 3.6z"/>',
    // deux anneaux liés : la complicité
    '<circle cx="9" cy="12" r="5.2"/><circle cx="15" cy="12" r="5.2"/>',
    // deux bulles : dire ce qui ne se dit pas
    '<path d="M3 8.5A3.5 3.5 0 0 1 6.5 5h6A3.5 3.5 0 0 1 16 8.5v2A3.5 3.5 0 0 1 12.5 14H8l-3.5 3v-3A3.5 3.5 0 0 1 3 10.5z"/><path d="M18 9.5h.5A2.5 2.5 0 0 1 21 12v2.5a2.5 2.5 0 0 1-2 2.45V20l-2.6-2.5H13"/>',
    // marque-page : en garder quelque chose
    '<path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v15.5L12 16.4 5.5 20.5V5A1.5 1.5 0 0 1 7 3.5z"/><path d="M9.2 9.3h5.6"/>'
  ];

  // How it works - 3 steps
  const steps = ['choose', 'answer', 'results'];
  const stepIcons = [
    // cible : choisir
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.4"/><path d="M12 4v2.6M12 17.4V20M4 12h2.6M17.4 12H20"/>',
    // liste cochée : répondre
    '<path d="M6.5 4.5h11a1.5 1.5 0 0 1 1.5 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19V6a1.5 1.5 0 0 1 1.5-1.5z"/><path d="M8.6 10.2l1.6 1.6 3.2-3.2"/><path d="M8.6 15.6h6.8"/>',
    // courbe qui monte : découvrir
