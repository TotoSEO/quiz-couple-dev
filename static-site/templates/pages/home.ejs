<%
  // Home page data
  const hero = {
    badge: t('home:hero.badge', '100% Gratuit'),
    title: t('home:hero.title', 'Testez votre relation avec nos'),
    titleHighlight: t('home:hero.titleHighlight', 'quiz spécial couples'),
    description: t('home:hero.description', ''),
    descriptionHighlight: t('home:hero.descriptionHighlight', ''),
    cta1: t('home:hero.cta', 'Découvrir nos quiz'),
    cta2: t('home:hero.ctaSecondary', 'Tester son couple'),
  };

  // Bandeau décoratif de la ligne de flottaison. Purement visuel : il est
  // masqué aux lecteurs d'écran et ne contient aucun lien.
  const marqueeItems = [];
  for (let mi = 1; mi <= 12; mi++) {
    const txt = t('home:marquee.item' + mi, '');
    if (txt) marqueeItems.push(txt);
  }

  // Quiz grid data
  const tests = [
    { routeKey: 'testCouple', key: 'testCouple', icon: '💕', img: 'test-couple' },
    { routeKey: 'testCommonPoints', key: 'testCommonPoints', icon: '🎯', img: 'test-common-points' },
    { routeKey: 'testCompatibilite', key: 'testCompatibilite', icon: '💘', img: 'quiz-amoureux' },
    { routeKey: 'testDistance', key: 'testDistance', icon: '🌍', img: 'test-distance' },
    { routeKey: 'testToxic', key: 'testToxic', icon: '⚠️', img: 'test-toxic' },
    { routeKey: 'testPervers', key: 'testPervers', icon: '🎭', img: 'test-toxic' },
    { routeKey: 'testAmourHabitude', key: 'testAmourHabitude', icon: '☕', img: 'test-couple' },
    { routeKey: 'testCoupleSain', key: 'testCoupleSain', icon: '💚', img: 'test-couple-sain' },
    { routeKey: 'testMariage', key: 'testMariage', icon: '💒', img: 'test-mariage' },
    { routeKey: 'testDivorce', key: 'testDivorce', icon: '⚖️', img: 'test-divorce' },
    { routeKey: 'testParentalite', key: 'testParentalite', icon: '👶', img: 'test-parentalite' },
    { routeKey: 'testEmmenager', key: 'testEmmenager', icon: '🏠', img: 'test-couple' },
    { routeKey: 'testBebe', key: 'testBebe', icon: '🍼', img: 'test-parentalite' },
    { routeKey: 'testAstroPrenoms', key: 'testAstroPrenoms', icon: '♈', img: 'test-astro-prenoms' },
    { routeKey: 'testKarmique', key: 'testKarmique', icon: '🔮', img: 'test-astro-prenoms' },
    { routeKey: 'testSuisJeAmoureux', key: 'testSuisJeAmoureux', icon: '💗', img: 'quiz-amoureux' },
    { routeKey: 'testJalousie', key: 'testJalousie', icon: '🫣', img: 'test-jalousie' },
    { routeKey: 'testInfidelite', key: 'testInfidelite', icon: '💔', img: 'test-jalousie' },
    { routeKey: 'testLangageAmour', key: 'testLangageAmour', icon: '💬', img: 'test-langage-amour' },
    { routeKey: 'testAttachement', key: 'testAttachement', icon: '🔗', img: 'test-attachement' },
    { routeKey: 'testConfiance', key: 'testConfiance', icon: '🤝', img: 'test-confiance' },
  ];
  const quizzes = [
    { routeKey: 'quizAmoureux', key: 'quizAmoureux', icon: '❤️', img: 'quiz-amoureux' },
    { routeKey: 'quizCoquin', key: 'quizCoquin', icon: '🔥', img: 'quiz-coquin' },
    { routeKey: 'quizMarrant', key: 'quizMarrant', icon: '😂', img: 'quiz-marrant' },
    { routeKey: 'quizKnowledge', key: 'quizKnowledge', icon: '🧠', img: 'quiz-knowledge' },
    { routeKey: 'quizMost', key: 'quizMost', icon: '🏆', img: 'quiz-most' },
    { routeKey: 'quizAdo', key: 'quizAdo', icon: '🌟', img: 'quiz-ado' },
    { routeKey: 'quizGenant', key: 'quizGenant', icon: '😳', img: 'quiz-genant' },
    { routeKey: 'quizVraiFaux', key: 'quizVraiFaux', icon: '✅', img: 'quiz-vrai-faux' },
    { routeKey: 'zamours', key: 'zamours', icon: '📺', img: 'quiz-knowledge' },
    { routeKey: 'quizTentation', key: 'quizTentation', icon: '🏝️', img: 'quiz-coquin' },
  ];
  // Les jeux forment leur propre categorie, distincte des quiz, et renvoient au hub.
  const jeux = [
    { routeKey: 'quizTuPreferes', key: 'quizTuPreferes', icon: '🤔', img: 'quiz-tu-preferes' },
    { routeKey: 'jeuActionVerite', key: 'jeuActionVerite', icon: '🎲', img: 'quiz-marrant' },
    { routeKey: 'jeuActionVeriteHot', key: 'jeuActionVeriteHot', icon: '🌶️', img: 'quiz-coquin' },
    { routeKey: 'jeuGages', key: 'jeuGages', icon: '🎡', img: 'quiz-most' },
    { routeKey: 'jeuPlateau', key: 'jeuPlateau', icon: '🎲', img: 'test-common-points' },
    { routeKey: 'jeuQuiDeNous', key: 'jeuQuiDeNous', icon: '👀', img: 'quiz-most' },
  ];

  // Filter out tests/quizzes not available in current language
  const testsFiltered = tests.filter(item => getLocalizedUrl(item.routeKey, lang));
  const quizzesFiltered = quizzes.filter(item => getLocalizedUrl(item.routeKey, lang));
  const jeuxFiltered = jeux.filter(item => getLocalizedUrl(item.routeKey, lang));

  // Why do quiz - 6 reasons
  const reasons = ['testRelation', 'haveFun', 'discover', 'strengthen', 'dialogue', 'memories'];
  const reasonIcons = ['💕', '🎉', '🔍', '💪', '💬', '📸'];

  // How it works - 3 steps
  const steps = ['choose', 'answer', 'results'];
  const stepIcons = ['🎯', '✏️', '🎉'];

  // JSON-LD is now generated by generate.js (WebSite + Organization + WebApplication schemas)
  // Removed duplicate inline JSON-LD to avoid conflicting structured data
%>

<!-- Hero Section, Full viewport radical -->
<section class="hero-home">
  <!-- Animated blobs -->
  <div class="hero-blob hero-blob--1"></div>
  <div class="hero-blob hero-blob--2"></div>
  <div class="hero-blob hero-blob--3"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="hero-grid">
      <!-- Left column: text content -->
      <div class="hero-content">
        <span class="badge badge-primary mb-4"><%= hero.badge %></span>

        <h1 class="hero-title">
          <%= hero.title %> <span class="text-gradient"><%= hero.titleHighlight %></span>
        </h1>
        <p class="hero-desc">
          <% if (hero.descriptionHighlight && hero.description.includes(hero.descriptionHighlight)) { %>
            <%- hero.description.replace(hero.descriptionHighlight, '<strong class="text-foreground">' + hero.descriptionHighlight + '</strong>') %>
          <% } else { %>
            <%= hero.description %>
          <% } %>
        </p>

        <div class="hero-ctas">
          <a href="#quiz-section" class="btn btn-cta btn-lg"><%= hero.cta1 %></a>
          <a href="<%= getLocalizedUrl('testCouple', lang) %>" class="btn btn-outline btn-lg"><%= hero.cta2 %></a>
        </div>

        <!-- Compteurs : le total joué domine, l'inventaire du catalogue suit -->
        <div class="hero-stats">
          <div class="hero-stat hero-stat--phare">
            <span class="hero-stat-nb" id="home-total-counter" data-total-counter data-baseline="3078">3&nbsp;078</span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.totalLabel', 'quiz &amp; tests réalisés') %></span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-nb"><%= testsFiltered.length %></span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.testsLabel', 'tests disponibles') %></span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-nb"><%= quizzesFiltered.length %></span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.quizzesLabel', 'quiz disponibles') %></span>
          </div>
        </div>
      </div>

      <!-- Right column: floating cards -->
      <div class="hero-visual">
        <div class="hero-float-card hero-float-card--1 animate-float">
          <span class="hero-float-icon">💕</span>
          <span><%= t('quizzes:testCouple.shortTitle', 'Test Couple') %></span>
        </div>
        <div class="hero-float-card hero-float-card--2 animate-float-slow">
          <span class="hero-float-icon">🔥</span>
          <span><%= t('quizzes:quizCoquin.shortTitle', 'Quiz Coquin') %></span>
        </div>
        <div class="hero-float-card hero-float-card--3 animate-float" style="animation-delay: 300ms">
          <span class="hero-float-icon">⚖️</span>
          <span><%= t('quizzes:testDivorce.shortTitle', 'Dois-je divorcer ?') %></span>
        </div>
        <div class="hero-float-card hero-float-card--4 animate-float-slow" style="animation-delay: 600ms">
          <span class="hero-float-icon">🧠</span>
          <span><%= t('quizzes:quizKnowledge.shortTitle', 'Quiz Knowledge') %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Bandeau décoratif, posé sur la ligne de flottaison. Aucun contenu utile
     n'y est enfermé : il est masqué aux lecteurs d'écran et la piste est
     dupliquée pour que la boucle se referme sans saut visible. -->
<% if (marqueeItems.length) { %>
<div class="ruban" aria-hidden="true">
  <div class="ruban-piste">
    <% for (let copie = 0; copie < 2; copie++) { %>
      <% marqueeItems.forEach(function(item) { %>
      <span class="ruban-item"><%= item %></span>
      <span class="ruban-sep">•</span>
      <% }) %>
    <% } %>
  </div>
</div>
<% } %>

<!-- Quiz Section -->
<section id="quiz-section" class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <!-- Section intro -->
    <p class="text-base text-muted-foreground max-w-2xl mx-auto text-center mb-8 md:mb-10"><%= t('home:quizSection.description', 'Choisissez le quiz ou le test qui vous correspond et découvrez-en plus sur votre relation. Tous nos quiz sont gratuits, sans inscription, et les résultats sont immédiats !') %></p>

    <!-- Tests block -->
    <div class="quiz-section-block quiz-section-tests">
      <div class="quiz-section-block-inner">
        <div class="bloc-entete">
          <span class="bloc-pastille">📝 <%= t('home:quizGrid.testsEyebrow', 'Les tests') %></span>
          <h2 class="bloc-titre"><%= t('home:quizGrid.testsTitle', 'Nos Tests pour les Couples') %></h2>
          <span class="bloc-trait" aria-hidden="true"></span>
          <p class="bloc-sous-titre"><%= t('home:quizGrid.testsDesc', '') %></p>
        </div>
        <div class="quiz-slider" data-slider>
          <button type="button" class="quiz-slider__nav quiz-slider__nav--prev" data-slider-prev aria-label="<%= t('common:buttons.previous', 'Précédent') %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="quiz-slider__track" data-slider-track>
          <% for (let ti = 0; ti < testsFiltered.length; ti++) { const item = testsFiltered[ti];
             const _f = quizFeatured && quizFeatured[item.routeKey];
             const tTitle = t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key));
             const fImg = _f ? '/quiz/featured/' + _f.file + '.webp' : '/quiz/' + item.img + '.webp';
             const fAlt = (_f && _f.alt) ? (_f.alt[lang] || _f.alt.fr) : tTitle; %>
          <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="homepage-quiz-card quiz-slide no-underline group">
            <div class="quiz-bubble-card quiz-bubble-card--test">
              <div class="quiz-bubble-media">
                <img src="<%= fImg %>" alt="<%= escapeHtml(fAlt) %>" loading="lazy" decoding="async" width="1200" height="630">
                <span class="quiz-bubble-chip"><%= item.icon %></span>
              </div>
              <div class="quiz-bubble-body">
                <h3 class="quiz-bubble-title"><%= tTitle %></h3>
                <p class="quiz-bubble-desc"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
                <span class="quiz-bubble-cta">
                  <%= t('common:buttons.startTest', 'Faire le test') %>
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
          <% } %>
          </div>
          <button type="button" class="quiz-slider__nav quiz-slider__nav--next" data-slider-next aria-label="<%= t('common:buttons.next', 'Suivant') %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Visual separator between tests and quizzes -->
    <div class="quiz-section-divider">
      <div class="quiz-section-divider-line"></div>
      <div class="quiz-section-divider-line"></div>
    </div>

    <!-- Quizzes block -->
    <div class="quiz-section-block quiz-section-quizzes">
      <div class="quiz-section-block-inner">
        <div class="bloc-entete">
          <span class="bloc-pastille">🎮 <%= t('home:quizGrid.quizzesEyebrow', 'Les quiz') %></span>
          <h2 class="bloc-titre"><%= t('home:quizGrid.quizzesTitle', 'Nos Quiz à Faire en Couple') %></h2>
          <span class="bloc-trait" aria-hidden="true"></span>
          <p class="bloc-sous-titre"><%= t('home:quizGrid.quizzesDesc', '') %></p>
        </div>
        <div class="quiz-slider" data-slider>
          <button type="button" class="quiz-slider__nav quiz-slider__nav--prev" data-slider-prev aria-label="<%= t('common:buttons.previous', 'Précédent') %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="quiz-slider__track" data-slider-track>
          <% for (let qi = 0; qi < quizzesFiltered.length; qi++) { const item = quizzesFiltered[qi];
             const _f = quizFeatured && quizFeatured[item.routeKey];
             const qTitle = t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key));
             const fImg = _f ? '/quiz/featured/' + _f.file + '.webp' : '/quiz/' + item.img + '.webp';
             const fAlt = (_f && _f.alt) ? (_f.alt[lang] || _f.alt.fr) : qTitle; %>
          <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="homepage-quiz-card quiz-slide no-underline group">
            <div class="quiz-bubble-card quiz-bubble-card--quiz">
              <div class="quiz-bubble-media">
                <img src="<%= fImg %>" alt="<%= escapeHtml(fAlt) %>" loading="lazy" decoding="async" width="1200" height="630">
                <span class="quiz-bubble-chip quiz-bubble-chip--quiz"><%= item.icon %></span>
              </div>
              <div class="quiz-bubble-body">
                <h3 class="quiz-bubble-title"><%= qTitle %></h3>
                <p class="quiz-bubble-desc"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
                <span class="quiz-bubble-cta quiz-bubble-cta--quiz">
                  <%= t('common:buttons.startQuiz', 'Faire le quiz') %>
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
          <% } %>
          </div>
          <button type="button" class="quiz-slider__nav quiz-slider__nav--next" data-slider-next aria-label="<%= t('common:buttons.next', 'Suivant') %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <% if (jeuxFiltered.length) { %>
    <!-- Visual separator between quizzes and games -->
    <div class="quiz-section-divider">
      <div class="quiz-section-divider-line"></div>
      <div class="quiz-section-divider-line"></div>
    </div>

    <!-- Games block -->
    <div class="quiz-section-block quiz-section-jeux">
      <div class="quiz-section-block-inner">
        <div class="bloc-entete">
          <span class="bloc-pastille">🎲 <%= t('home:quizGrid.jeuxEyebrow', 'Les jeux') %></span>
          <h2 class="bloc-titre"><%= t('home:quizGrid.jeuxTitle', 'Nos jeux à jouer à deux') %></h2>
          <span class="bloc-trait" aria-hidden="true"></span>
          <p class="bloc-sous-titre"><%= t('home:quizGrid.jeuxDesc', '').replace('{{n}}', jeuxFiltered.length) %></p>
        </div>
        <div class="jeux-board jeux-board--home">
          <% jeuxFiltered.forEach(function(item) {
             const _f = quizFeatured && quizFeatured[item.routeKey];
             const jTitle = t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key));
             const fImg = _f ? '/quiz/featured/' + _f.file + '.webp' : '/quiz/' + item.img + '.webp';
             const fAlt = (_f && _f.alt) ? (_f.alt[lang] || _f.alt.fr) : jTitle;
             const accents = { quizTuPreferes: '270 45% 58%', jeuActionVerite: '340 65% 62%', jeuActionVeriteHot: '12 78% 56%', jeuGages: '190 60% 45%', jeuPlateau: '160 50% 42%', jeuQuiDeNous: '210 60% 52%' }; %>
          <a class="jeu-card" href="<%= getLocalizedUrl(item.routeKey, lang) %>" style="--jeu-accent: <%= accents[item.routeKey] || '340 65% 62%' %>">
            <span class="jeu-card-visuel">
              <img src="<%= fImg %>" alt="<%= escapeHtml(fAlt) %>" width="600" height="315" loading="lazy" decoding="async">
            </span>
            <span class="jeu-card-corps">
              <span class="jeu-card-emoji" aria-hidden="true"><%= item.icon %></span>
              <h3 class="jeu-card-nom"><%= jTitle %></h3>
              <p class="jeu-card-tagline"><%= t('quizzes:' + item.key + '.description', '') %></p>
              <span class="jeu-card-cta">
                <%= t('common:buttons.startGame', 'Jouer') %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </span>
            </span>
          </a>
          <% }) %>
        </div>
        <div class="text-center mt-8">
          <a href="<%= getLocalizedUrl('jeuxCouple', lang) %>" class="btn btn-outline"><%= t('home:quizGrid.jeuxCta', '') %></a>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</section>

