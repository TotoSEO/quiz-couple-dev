    testMariage: { icon: '💒', img: 'test-mariage' },
    testDivorce: { icon: '⚖️', img: 'test-divorce' },
    testFinCouple: { icon: '🪢', img: 'test-divorce' },
    testParentalite: { icon: '👶', img: 'test-parentalite' },
    testEmmenager: { icon: '🏠', img: 'test-couple' },
    calculatriceAmour: { icon: '🧮', img: 'test-astro-prenoms' },
    compteurCouple: { icon: '📆', img: 'test-couple' },
    testAstroPrenoms: { icon: '♈', img: 'test-astro-prenoms' },
    testDateNaissance: { icon: '📅', img: 'test-astro-prenoms' },
    testSignesChinois: { icon: '🐉', img: 'test-astro-prenoms' },
    testKarmique: { icon: '🔮', img: 'test-astro-prenoms' },
    testAmeSoeur: { icon: '💫', img: 'quiz-amoureux' },
    testJalousie: { icon: '🫣', img: 'test-jalousie' },
    testInfidelite: { icon: '💔', img: 'test-jalousie' },
    testCouche: { icon: '🛏️', img: 'test-jalousie' },
    testAimeEncore: { icon: '💞', img: 'quiz-amoureux' },
    testDistanceAime: { icon: '📞', img: 'test-distance' },
    testChargeMentale: { icon: '🧠', img: 'test-couple-sain' },
    testLangageAmour: { icon: '💬', img: 'test-langage-amour' },
    testPersonnalite: { icon: '🪞', img: 'test-langage-amour' },
    testAttachement: { icon: '🔗', img: 'test-attachement' },
    testDependance: { icon: '⚓', img: 'test-attachement' },
    testConfiance: { icon: '🤝', img: 'test-confiance' },
    testPurete: { icon: '🌡️', img: 'quiz-coquin' },
    testVacances: { icon: '🌴', img: 'test-couple' },
