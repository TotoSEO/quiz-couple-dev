<%
  // Home page data
  const hero = {
    badge: t('home:hero.badge', '100% Gratuit'),
    title: t('home:hero.title', 'Testez votre relation avec nos'),
    titleHighlight: t('home:hero.titleHighlight', 'quiz spécial couples'),
    description: t('home:hero.description', ''),
    descriptionHighlight: t('home:hero.descriptionHighlight', ''),
    cta1: t('home:hero.cta', 'Découvrir nos quiz'),
    cta2: t('home:hero.ctaSecondary', 'Tester son couple'),
    stat1Value: t('home:hero.stats.couples', '1000+'),
    stat1Label: t('home:hero.stats.couplesLabel', 'couples testés'),
    stat2Value: t('home:hero.stats.quizzes', '12'),
    stat2Label: t('home:hero.stats.quizzesLabel', 'quiz disponibles'),
  };

  // Quiz grid data
  const tests = [
    { routeKey: 'testCouple', key: 'testCouple', icon: '💕' },
    { routeKey: 'testCommonPoints', key: 'testCommonPoints', icon: '🎯' },
    { routeKey: 'testDistance', key: 'testDistance', icon: '🌍' },
    { routeKey: 'testToxic', key: 'testToxic', icon: '⚠️' },
    { routeKey: 'testCoupleSain', key: 'testCoupleSain', icon: '💚' },
    { routeKey: 'testMariage', key: 'testMariage', icon: '💒' },
    { routeKey: 'testDivorce', key: 'testDivorce', icon: '⚖️' },
    { routeKey: 'testParentalite', key: 'testParentalite', icon: '👶' },
    { routeKey: 'testAstroPrenoms', key: 'testAstroPrenoms', icon: '♈' },
    { routeKey: 'testJalousie', key: 'testJalousie', icon: '🫣' },
    { routeKey: 'testLangageAmour', key: 'testLangageAmour', icon: '💬' },
  ];
  const quizzes = [
    { routeKey: 'quizAmoureux', key: 'quizAmoureux', icon: '❤️' },
    { routeKey: 'quizCoquin', key: 'quizCoquin', icon: '🔥' },
    { routeKey: 'quizMarrant', key: 'quizMarrant', icon: '😂' },
    { routeKey: 'quizKnowledge', key: 'quizKnowledge', icon: '🧠' },
    { routeKey: 'quizMost', key: 'quizMost', icon: '🏆' },
    { routeKey: 'quizAdo', key: 'quizAdo', icon: '🌟' },
    { routeKey: 'quizGenant', key: 'quizGenant', icon: '😳' },
    { routeKey: 'quizTuPreferes', key: 'quizTuPreferes', icon: '🤔' },
  ];

  // Why do quiz - 6 reasons
  const reasons = ['testRelation', 'haveFun', 'discover', 'strengthen', 'dialogue', 'memories'];
  const reasonIcons = ['💕', '🎉', '🔍', '💪', '💬', '📸'];

  // How it works - 3 steps
  const steps = ['choose', 'answer', 'results'];
  const stepIcons = ['🎯', '✏️', '🎉'];

  // JSON-LD
  const jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Quiz Couple",
      "url": "https://quiz-couple.com",
      "description": t('home:seo.schemaDescription', 'Plateforme de quiz gratuits pour tester votre relation de couple'),
      "publisher": { "@id": "https://quiz-couple.com/#organization" }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://quiz-couple.com/#organization",
      "name": "Quiz Couple",
      "url": "https://quiz-couple.com",
      "logo": { "@type": "ImageObject", "url": "https://quiz-couple.com/apple-touch-icon.png", "width": 180, "height": 180 },
      "image": "https://quiz-couple.com/og-image.webp",
      "description": t('home:seo.schemaDescription', 'Plateforme de quiz gratuits pour tester et renforcer votre relation de couple')
    }
  ];
%>

<!-- JSON-LD injected in head via base template -->
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero Section -->
<section class="relative overflow-hidden gradient-hero py-16 md:py-24">
  <!-- Decorative blobs -->
  <div class="absolute top-20 left-10 w-64 h-64 blob-primary animate-blob opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 right-10 w-48 h-48 blob-secondary animate-blob delay-500 opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge badge-primary mb-4"><%= hero.badge %></span>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <%= hero.title %> <span class="text-gradient"><%= hero.titleHighlight %></span>
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
        <% if (hero.descriptionHighlight && hero.description.includes(hero.descriptionHighlight)) { %>
          <%- hero.description.replace(hero.descriptionHighlight, '<strong class="text-foreground">' + hero.descriptionHighlight + '</strong>') %>
        <% } else { %>
          <%= hero.description %>
        <% } %>
      </p>

      <!-- Stats -->
      <div class="flex justify-center gap-8 mb-8">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary tabular-nums"><%= hero.stat1Value %></div>
          <div class="text-sm text-muted-foreground"><%= hero.stat1Label %></div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-primary tabular-nums"><%= hero.stat2Value %></div>
          <div class="text-sm text-muted-foreground"><%= hero.stat2Label %></div>
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="#quiz-section" class="btn btn-cta"><%= hero.cta1 %></a>
        <a href="<%= getLocalizedUrl('testCouple', lang) %>" class="btn btn-outline btn-lg"><%= hero.cta2 %></a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Quiz Section -->
<section id="quiz-section" class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <!-- Section header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4"><%= t('home:quizSection.title', 'Nos quiz gratuits pour') %> <span class="text-gradient"><%= t('home:quizSection.titleHighlight', 'les couples') %></span></h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto"><%= t('home:quizSection.description', '') %></p>
    </div>

    <!-- Tests block -->
    <div class="quiz-section-block quiz-section-tests">
      <div class="quiz-section-block-inner">
        <div class="text-center mb-10">
          <span class="quiz-section-badge quiz-section-badge--tests">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
            <%= t('home:quizGrid.testsTitle', 'Tests de couple') %>
          </span>
          <h3 class="text-xl md:text-2xl font-bold mt-4"><%= t('home:quizGrid.testsTitle', 'Tests de couple') %></h3>
          <p class="mt-2 text-muted-foreground max-w-lg mx-auto"><%= t('home:quizGrid.testsDesc', '') %></p>
        </div>
        <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 max-w-6xl mx-auto">
          <% for (let ti = 0; ti < tests.length; ti++) { const item = tests[ti]; %>
          <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="homepage-quiz-card no-underline group animate-card-fade-in">
            <div class="quiz-bubble-card quiz-bubble-card--test">
              <div class="quiz-bubble-emoji"><span><%= item.icon %></span></div>
              <h4 class="quiz-bubble-title"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
              <p class="quiz-bubble-desc"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
              <span class="quiz-bubble-cta">
                <%= t('common:buttons.startTest', 'Faire le test') %>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Visual separator between tests and quizzes -->
    <div class="quiz-section-divider">
      <div class="quiz-section-divider-line"></div>
      <div class="quiz-section-divider-icon">
        <span>VS</span>
      </div>
      <div class="quiz-section-divider-line"></div>
    </div>

    <!-- Quizzes block -->
    <div class="quiz-section-block quiz-section-quizzes">
      <div class="quiz-section-block-inner">
        <div class="text-center mb-10">
          <span class="quiz-section-badge quiz-section-badge--quizzes">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            <%= t('home:quizGrid.quizzesTitle', 'Quiz pour couples') %>
          </span>
          <h3 class="text-xl md:text-2xl font-bold mt-4"><%= t('home:quizGrid.quizzesTitle', 'Quiz pour couples') %></h3>
          <p class="mt-2 text-muted-foreground max-w-lg mx-auto"><%= t('home:quizGrid.quizzesDesc', '') %></p>
        </div>
        <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 max-w-6xl mx-auto">
          <% for (let qi = 0; qi < quizzes.length; qi++) { const item = quizzes[qi]; %>
          <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="homepage-quiz-card no-underline group animate-card-fade-in">
            <div class="quiz-bubble-card quiz-bubble-card--quiz">
              <div class="quiz-bubble-emoji quiz-bubble-emoji--quiz"><span><%= item.icon %></span></div>
              <h4 class="quiz-bubble-title"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
              <p class="quiz-bubble-desc"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
              <span class="quiz-bubble-cta quiz-bubble-cta--quiz">
                <%= t('common:buttons.startQuiz', 'Faire le quiz') %>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'background', direction: 'up' }) %>

<!-- AI Resolver Section -->
<section class="section-padding">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge badge-secondary mb-4"><%= t('home:aiResolver.badge', 'Nouveau') %></span>
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:aiResolver.title', 'Résolvez vos problèmes de couple') %> <span class="text-gradient"><%= t('home:aiResolver.titleHighlight', 'avec l\'I.A !') %></span></h2>
      <p class="text-muted-foreground mb-8 max-w-2xl mx-auto"><%= t('home:aiResolver.description', '') %> <strong class="text-foreground"><%= t('home:aiResolver.descriptionHighlight', '') %></strong> <%= t('home:aiResolver.descriptionEnd', '') %></p>
      <a href="<%= getLocalizedUrl('problemResolver', lang) %>" class="btn btn-cta"><%= t('home:aiResolver.cta', 'Essayer gratuitement') %></a>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- What Is Quiz Couple -->
<section class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 grid-cols-1 lg:grid-cols-2 items-center">
        <!-- Content -->
        <div class="space-y-6">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold"><%= t('home:whatIs.title', 'Qu\'est-ce qu\'un') %> <span class="text-gradient"><%= t('home:whatIs.titleHighlight', 'quiz pour couples') %></span> ?</h2>
          <p class="text-lg text-muted-foreground leading-relaxed"><%= t('home:whatIs.paragraph1', '') %> <strong class="text-foreground"><%= t('home:whatIs.paragraph1Highlight', '') %></strong> <%= t('home:whatIs.paragraph1End', '') %></p>
          <p class="text-lg text-muted-foreground leading-relaxed"><%= t('home:whatIs.paragraph2', '') %> <strong class="text-foreground"><%= t('home:whatIs.paragraph2Highlight', '') %></strong> <%= t('home:whatIs.paragraph2End', '') %></p>
          <% const whatIsFeatures = t('home:whatIs.features', []); if (Array.isArray(whatIsFeatures) && whatIsFeatures.length > 0) { %>
          <ul class="space-y-3 pt-2">
            <% for (const feat of whatIsFeatures) { %>
            <li class="flex items-center gap-3 text-foreground"><svg class="w-5 h-5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><%= feat %></li>
            <% } %>
          </ul>
          <% } %>
        </div>
        <!-- Illustration -->
        <div class="relative">
          <div class="glass-card rounded-3xl p-4 overflow-hidden aspect-video">
            <img src="/assets/quiz-couple-hero.webp" alt="<%= t('home:whatIs.imageAlt', 'Quiz Couple') %>" class="w-full h-full rounded-2xl object-cover" loading="lazy" width="1920" height="1072">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Why Do Quiz -->
<section class="section-padding">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:whyDoQuiz.title', 'À quoi ça sert de faire') %> <span class="text-gradient"><%= t('home:whyDoQuiz.titleHighlight', 'ces quiz') %></span></h2>
      <p class="text-muted-foreground max-w-2xl mx-auto"><%= t('home:whyDoQuiz.subtitle', '') %></p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <% for (let i = 0; i < reasons.length; i++) { %>
      <div class="glass-card rounded-2xl p-6 text-center">
        <div class="text-3xl mb-3"><%= reasonIcons[i] %></div>
        <h3 class="text-lg font-semibold mb-2"><%= t('home:whyDoQuiz.reasons.' + reasons[i] + '.title', reasons[i]) %></h3>
        <p class="text-sm text-muted-foreground"><%= t('home:whyDoQuiz.reasons.' + reasons[i] + '.description', '') %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'background', direction: 'up' }) %>

<!-- How It Works -->
<section class="section-padding bg-muted/20">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:howItWorks.title', 'Comment ça') %> <span class="text-gradient"><%= t('home:howItWorks.titleHighlight', 'marche') %></span></h2>
      <p class="text-muted-foreground max-w-2xl mx-auto"><%= t('home:howItWorks.subtitle', '') %></p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <% for (let i = 0; i < steps.length; i++) { %>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-primary/10 flex items-center justify-center">
          <span class="text-2xl"><%= stepIcons[i] %></span>
        </div>
        <div class="text-sm font-medium text-primary mb-2"><%= t('home:howItWorks.step', 'Étape') %> <%= i + 1 %></div>
        <h3 class="text-lg font-semibold mb-2"><%= t('home:howItWorks.steps.' + steps[i] + '.title', steps[i]) %></h3>
        <p class="text-sm text-muted-foreground"><%= t('home:howItWorks.steps.' + steps[i] + '.description', '') %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Latest Articles (statically rendered at build time) -->
<%
  const latestArticles = (typeof blogArticlesList !== 'undefined' ? blogArticlesList : []).slice(0, 3);
  const dateLocaleHome = lang === 'fr' ? 'fr-FR' : lang === 'en' ? 'en-US' : lang === 'es' ? 'es-ES' : lang === 'de' ? 'de-DE' : 'it-IT';
%>
<section class="section-padding" id="latest-articles">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4"><%= t('home:latestArticles.title', 'Les derniers articles') %> <span class="text-gradient"><%= t('home:latestArticles.titleHighlight', 'du blog') %></span></h2>
      <p class="text-muted-foreground max-w-3xl mx-auto text-base md:text-lg leading-relaxed"><%= t('home:latestArticles.intro', '') %></p>
    </div>
    <% if (latestArticles.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% for (const article of latestArticles) { %>
      <article class="group rounded-2xl overflow-hidden border border-border bg-card/60 shadow-sm hover:shadow-lg transition-shadow duration-300">
        <a href="<%= article.url %>" class="block no-underline" tabindex="-1" aria-hidden="true">
          <div class="blog-img-wrap" style="margin:0">
            <img src="<%= article.featuredImage %>" alt="<%= escapeHtml(article.featuredImageAlt) %>" class="group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="225">
          </div>
        </a>
        <div class="p-5 space-y-3">
          <time datetime="<%= article.publishedAt %>" class="text-xs text-muted-foreground"><%= new Date(article.publishedAt).toLocaleDateString(dateLocaleHome, { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
          <h3 class="font-semibold text-lg leading-snug line-clamp-2"><a href="<%= article.url %>" class="hover:text-primary transition-colors"><%= article.title %></a></h3>
          <p class="text-sm text-muted-foreground line-clamp-2"><%= article.excerpt %></p>
          <a href="<%= article.url %>" class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline mt-2 no-underline">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
            <%= t('common:blog.readArticle', 'Lire l\'article') %>
          </a>
        </div>
      </article>
      <% } %>
    </div>
    <% } else { %>
    <p class="text-center text-muted-foreground py-8"><%= t('common:blog.noArticles', 'Aucun article disponible.') %></p>
    <% } %>
    <div class="text-center mt-8">
      <a href="<%= getLocalizedUrl('blog', lang) %>" class="btn btn-outline"><%= t('common:blog.seeAll', 'Voir tous les articles') %></a>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Reviews Section -->
<section class="section-padding bg-muted/20" id="avis">
  <div id="reviews-config" data-url="<%= supabaseUrl %>" data-key="<%= supabaseKey %>" class="hidden"></div>
  <div class="container mx-auto px-4">
    <!-- Header with stats -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary mb-4">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        <%= t('common:reviews.badge', 'Avis vérifiés') %>
      </div>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4"><%= t('common:reviews.title', 'Ce que les couples') %> <span class="text-gradient"><%= t('common:reviews.titleHighlight', 'en pensent') %></span></h2>
      <div class="flex items-center gap-3 justify-center mt-4">
        <div id="reviews-stars-display" class="flex items-center gap-0.5">
          <% for (var si = 0; si < 5; si++) { %>
          <svg viewBox="0 0 24 24" class="w-5 h-5 star-filled"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <% } %>
        </div>
        <span class="text-2xl font-bold text-foreground" id="reviews-avg">-</span>
        <span class="text-sm text-muted-foreground" id="reviews-count"></span>
      </div>
    </div>

    <!-- Two column layout: form LEFT + reviews RIGHT -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 max-w-6xl mx-auto">
      <!-- Review Form (2 cols - LEFT on desktop, first on mobile) -->
      <div class="lg:col-span-2 order-1">
        <div class="lg:sticky lg:top-24 glass-card rounded-2xl p-6" id="review-form-section">
          <h3 class="text-lg font-bold mb-5 text-center"><%= t('common:reviews.leaveReview', 'Laissez votre avis') %></h3>
          <form id="review-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium mb-1.5" for="review-name"><%= t('common:reviews.yourName', 'Votre prénom') %></label>
              <input type="text" id="review-name" class="input w-full" placeholder="<%= t('common:reviews.namePlaceholder', 'Prénom ou pseudo') %>" maxlength="60" autocomplete="off">
              <div class="flex justify-end mt-1"><span id="review-name-counter" class="text-xs text-muted-foreground">0/60</span></div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1.5"><%= t('common:reviews.ratingLabel', 'Votre note') %></label>
              <div class="flex gap-1" id="review-stars">
                <% for (var s = 1; s <= 5; s++) { %>
                <button type="button" data-star="<%= s %>" class="star-btn p-0.5 transition-transform hover:scale-110" aria-label="<%= s %> étoiles">
                  <svg viewBox="0 0 24 24" class="w-7 h-7 star-empty"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </button>
                <% } %>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1.5" for="review-comment"><%= t('common:reviews.commentLabel', 'Votre commentaire') %> <span class="text-muted-foreground font-normal">(<%= t('common:reviews.optional', 'optionnel') %>)</span></label>
              <textarea id="review-comment" class="textarea w-full" rows="3" placeholder="<%= t('common:reviews.commentPlaceholder', 'Partagez votre expérience...') %>" maxlength="200"></textarea>
              <div class="flex justify-end mt-1"><span id="review-comment-counter" class="text-xs text-muted-foreground">0/200</span></div>
            </div>
            <button type="submit" class="btn btn-cta w-full" id="review-submit">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              <%= t('common:reviews.submit', 'Envoyer mon avis') %>
            </button>
            <p id="review-error" class="hidden text-sm text-destructive text-center"></p>
          </form>
        </div>
      </div>

      <!-- Reviews List (3 cols - RIGHT on desktop) -->
      <div class="lg:col-span-3 order-2">
        <div class="space-y-4 max-h-[500px] overflow-y-auto pr-2 scrollbar-thin" id="reviews-grid">
          <!-- Reviews loaded by JS -->
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/reviews.js" defer></script>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Final CTA -->
