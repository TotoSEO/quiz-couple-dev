<script>
/* Déclenche l'arrivée des cartes et le tracé des glyphes quand le bloc entre
   dans l'écran. Le repli est volontairement du bon côté : la classe a-animer
   n'est posée que si le script tourne ET que l'observateur existe, donc sans
   JavaScript les cartes sont visibles d'emblée, jamais masquées.
   Une seule animation par bloc : on n'observe plus après le déclenchement. */
(function () {
  var blocs = document.querySelectorAll('[data-anime-groupe]');
  if (!blocs.length) return;
  var doux = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (doux || !('IntersectionObserver' in window)) {
    for (var k = 0; k < blocs.length; k++) blocs[k].classList.add('est-visible');
    return;
  }
  for (var i = 0; i < blocs.length; i++) blocs[i].classList.add('a-animer');
  var obs = new IntersectionObserver(function (entrees) {
    entrees.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add('est-visible');
      obs.unobserve(e.target);
    });
  }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
  for (var j = 0; j < blocs.length; j++) obs.observe(blocs[j]);
})();
</script>
<script src="/js/home-dynamic.js" defer></script>
