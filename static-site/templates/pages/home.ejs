    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t('home:quizSection.title', 'Nos quiz gratuits pour') %> <span class="text-gradient"><%= t('home:quizSection.titleHighlight', 'les couples') %></span></h2>
      <p class="text-muted-foreground max-w-2xl mx-auto"><%= t('home:quizSection.description', '') %></p>
    </div>

    <!-- Tests -->
    <h3 class="text-xl font-semibold mb-6 text-center"><%= t('home:quizGrid.testsTitle', 'Tests de couple') %></h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mb-12">
      <% for (const item of tests) { %>
      <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="quiz-card glass-card rounded-2xl p-5 card-hover no-underline block text-center group">
        <div class="w-14 h-14 mx-auto mb-3 rounded-xl bg-primary/10 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform"><%= item.icon %></div>
        <h4 class="text-base font-semibold mb-1 text-foreground"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
        <p class="text-xs text-muted-foreground line-clamp-2"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
      </a>
      <% } %>
    </div>

    <!-- Quizzes -->
    <h3 class="text-xl font-semibold mb-6 text-center"><%= t('home:quizGrid.quizzesTitle', 'Quiz pour couples') %></h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% for (const item of quizzes) { %>
      <a href="<%= getLocalizedUrl(item.routeKey, lang) %>" class="quiz-card glass-card rounded-2xl p-5 card-hover no-underline block text-center group">
        <div class="w-14 h-14 mx-auto mb-3 rounded-xl bg-secondary/10 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform"><%= item.icon %></div>
        <h4 class="text-base font-semibold mb-1 text-foreground"><%= t('quizzes:' + item.key + '.shortTitle', t('quizzes:' + item.key + '.title', item.key)) %></h4>
        <p class="text-xs text-muted-foreground line-clamp-2"><%= t('home:quizGrid.cards.' + item.key, t('quizzes:' + item.key + '.description', '')) %></p>
      </a>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'background', direction: 'up' }) %>

<!-- AI Resolver Section -->
