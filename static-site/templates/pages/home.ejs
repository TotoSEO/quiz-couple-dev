<!-- Hero Section, Full viewport radical -->
<section class="hero-home">
  <%# Le decor (taches et trame) est dans le fond CSS de la section, pas dans
      des elements : voir .hero-home dans styles.css et la note sur le LCP. %>
  <div class="container mx-auto px-4 relative z-10">
    <div class="hero-grid">
      <!-- Left column: text content -->
      <div class="hero-content">
        <span class="badge badge-primary mb-4"><%= hero.badge %></span>

        <h1 class="hero-title">
          <%= hero.title %> <span class="text-gradient"><%= hero.titleHighlight %></span>
        </h1>
        <p class="hero-desc">
          <% if (hero.descriptionHighlight && hero.description.includes(hero.descriptionHighlight)) { %>
            <%- hero.description.replace(hero.descriptionHighlight, '<strong class="text-foreground">' + hero.descriptionHighlight + '</strong>') %>
          <% } else { %>
            <%= hero.description %>
          <% } %>
        </p>

        <div class="hero-ctas">
          <a href="#quiz-section" class="btn btn-cta btn-lg"><%= hero.cta1 %></a>
          <a href="<%= getLocalizedUrl('testCouple', lang) %>" class="btn btn-outline btn-lg"><%= hero.cta2 %></a>
          <%# Le test de pureté a droit à sa place dans le hero : même anneau
              néon que sa pastille du menu, pour qu'on le reconnaisse. %>
          <% if (getLocalizedUrl('testPurete', lang)) { %>
          <a href="<%= getLocalizedUrl('testPurete', lang) %>" class="btn btn-purete btn-lg">
            <span class="btn-purete-emoji" aria-hidden="true">🌡️</span>
            <span class="btn-purete-texte"><%= t('quizzes:testPurete.shortTitle', 'Test de pureté') %></span>
          </a>
          <% } %>
        </div>

        <!-- Compteurs : le total joué domine, l'inventaire du catalogue suit -->
        <div class="hero-stats">
          <div class="hero-stat hero-stat--phare">
            <span class="hero-stat-nb" id="home-total-counter" data-total-counter data-baseline="3078">3&nbsp;078</span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.totalLabel', 'quiz &amp; tests réalisés') %></span>
          </div>
          <%# Les quatre familles du catalogue, pas deux : les tests célibataires
              comptent avec les tests de couple, les jeux avec les quiz. Sans ça
              le hero annonçait 31 tests et 11 quiz alors que la page en propose
              39 et 23. %>
          <div class="hero-stat">
            <span class="hero-stat-nb"><%= testsFiltered.length + celibFiltered.length %></span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.testsLabel', 'tests disponibles') %></span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-nb"><%= quizzesFiltered.length + jeuxFiltered.length %></span>
            <span class="hero-stat-txt"><%= t('home:hero.stats.quizzesLabel', 'quiz & jeux disponibles') %></span>
          </div>
        </div>

        <%/* Note moyenne du site, juste sous les compteurs. Les valeurs sont
             celles calculées à la construction, les mêmes que la section avis
             plus bas, pour que la note soit dans le HTML servi. reviews.js
             (updateHero) la reprend ensuite avec les chiffres exacts, comme la
             section du bas : un avis validé entre deux constructions compte
             tout de suite. Les classes et le format du libellé
             (« … : 4,8/5, 258 avis ») sont lus par ce script. Le bloc disparaît
             tant qu'aucun avis n'est publié plutôt que d'afficher un zéro. */%>
        <%
          var noteHero = parseFloat(reviewStats.avg) || 0;
          var nbAvisHero = parseInt(reviewStats.count, 10) || 0;
          var noteLocale = noteHero.toFixed(1).replace('.', lang === 'en' ? '.' : ',');
        %>
        <% if (nbAvisHero > 0) { %>
        <div class="note-site" role="img" aria-label="<%= t('home:noteSite.label', 'Note moyenne du site') %> : <%= noteLocale %>/5, <%= nbAvisHero %> <%= t('common:reviews.reviews', 'avis') %>">
          <span class="note-site-etoiles" aria-hidden="true">
            <% for (var ns = 1; ns <= 5; ns++) {
                 var plein = Math.max(0, Math.min(1, noteHero - (ns - 1))); %>
            <span class="note-site-etoile" style="--plein: <%= (plein * 100).toFixed(0) %>%">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </span>
            <% } %>
          </span>
          <span class="note-site-valeur"><%= noteLocale %></span>
          <span class="note-site-detail">
            <span class="note-site-sur"><%= t('common:reviews.basedOn', 'Basé sur') %> <%= nbAvisHero %> <%= t('common:reviews.reviews', 'avis') %></span>
          </span>
        </div>
        <% } %>
      </div>

      <!-- Colonne de droite : les deux mascottes jouent un quiz à deux, en
           boucle (un test, un « tu préfères », le résultat). Scène décorative
           en CSS seul, transform et opacity, masquée aux lecteurs d'écran ;
           les textes viennent de home.json et les personnages sont dessinés
           à la construction (mascotteSvg). -->
      <%
        const sc = {
          etiquette: t('home:heroScene.etiquette', 'Test de couple'),
          progression: t('home:heroScene.progression', 'Question 12/20'),
          question: t('home:heroScene.question', ''),
          a: t('home:heroScene.a', ''),
          b: t('home:heroScene.b', ''),
          c: t('home:heroScene.c', ''),
          match: t('home:heroScene.match', 'Même réponse !'),
          jeu: t('home:heroScene.jeu', 'Tu préfères…'),
          ou: t('home:heroScene.ou', 'ou'),
          choixA: t('home:heroScene.choixA', ''),
          choixB: t('home:heroScene.choixB', ''),
          desaccord: t('home:heroScene.desaccord', 'Pas d\'accord !'),
          resultat: t('home:heroScene.resultat', 'Votre résultat'),
          pct: t('home:heroScene.pct', '87'),
          verdict: t('home:heroScene.verdict', ''),
          detail: t('home:heroScene.detail', '')
        };
        const anneauPct = Math.max(0, Math.min(100, parseInt(sc.pct, 10) || 87));
        // circonference du cercle de rayon 42 : 2 * pi * 42
        const anneauOffset = (263.9 * (1 - anneauPct / 100)).toFixed(1);
      %>
      <div class="hero-visual" aria-hidden="true">
        <div class="scene" style="--scene-anneau: <%= anneauOffset %>">
          <div class="scene-perso scene-perso--rose">
            <%- mascotteSvg('rose', 'repos', { regard: [7, 1] }, 'scene-pose scene-pose--a') %>
            <%- mascotteSvg('rose', 'amoureux', {}, 'scene-pose scene-pose--b') %>
            <%- mascotteSvg('rose', 'boude', {}, 'scene-pose scene-pose--c') %>
            <%- mascotteSvg('rose', 'joie', {}, 'scene-pose scene-pose--d') %>
          </div>
          <div class="scene-carte">
            <div class="scene-ecran scene-ecran--test">
              <div class="scene-tete">
                <span class="scene-pilule"><%= sc.etiquette %></span>
                <span class="scene-pilule scene-pilule--pct"><%= sc.progression %></span>
              </div>
              <div class="scene-barre"><span class="scene-barre-fill"></span></div>
              <p class="scene-question"><%= sc.question %></p>
              <ul class="scene-options">
                <li class="scene-option"><span class="scene-lettre">A</span><span class="scene-option-txt"><%= sc.a %></span></li>
                <li class="scene-option scene-option--choisie"><span class="scene-lettre">B</span><span class="scene-option-txt"><%= sc.b %></span><span class="scene-coche scene-coche--rose"></span><span class="scene-coche scene-coche--violet"></span></li>
                <li class="scene-option"><span class="scene-lettre">C</span><span class="scene-option-txt"><%= sc.c %></span></li>
              </ul>
              <span class="scene-badge scene-badge--ok">💞 <%= sc.match %></span>
            </div>
            <div class="scene-ecran scene-ecran--jeu">
              <div class="scene-tete scene-tete--centre"><span class="scene-pilule scene-pilule--jeu"><%= sc.jeu %></span></div>
              <div class="scene-choix">
                <div class="scene-choix-carte scene-choix-carte--a"><span class="scene-choix-emoji">🎬</span><span class="scene-choix-txt"><%= sc.choixA %></span></div>
                <span class="scene-ou"><%= sc.ou %></span>
                <div class="scene-choix-carte scene-choix-carte--b"><span class="scene-choix-emoji">🍝</span><span class="scene-choix-txt"><%= sc.choixB %></span></div>
              </div>
              <span class="scene-badge scene-badge--ko">🤭 <%= sc.desaccord %></span>
            </div>
            <div class="scene-ecran scene-ecran--resultat">
              <div class="scene-tete scene-tete--centre"><span class="scene-pilule"><%= sc.resultat %></span></div>
              <div class="scene-anneau">
                <svg viewBox="0 0 100 100">
                  <defs>
                    <linearGradient id="scene-degrade" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" style="stop-color: hsl(var(--primary))"/>
                      <stop offset="1" style="stop-color: hsl(var(--secondary))"/>
                    </linearGradient>
                  </defs>
                  <circle class="scene-anneau-fond" cx="50" cy="50" r="42"/>
                  <circle class="scene-anneau-fill" cx="50" cy="50" r="42"/>
                </svg>
                <span class="scene-anneau-nb"><%= anneauPct %><small>%</small></span>
              </div>
              <p class="scene-verdict"><%= sc.verdict %></p>
              <p class="scene-detail"><%= sc.detail %></p>
            </div>
            <div class="scene-coeurs"><span>💗</span><span>💕</span><span>💖</span><span>💗</span><span>💕</span></div>
          </div>
          <div class="scene-perso scene-perso--violet">
            <%- mascotteSvg('violet', 'repos', { regard: [-7, 1] }, 'scene-pose scene-pose--a') %>
            <%- mascotteSvg('violet', 'amoureux', {}, 'scene-pose scene-pose--b') %>
            <%- mascotteSvg('violet', 'surprise', {}, 'scene-pose scene-pose--c') %>
            <%- mascotteSvg('violet', 'joie', {}, 'scene-pose scene-pose--d') %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Bandeau décoratif, posé sur la ligne de flottaison. Aucun contenu utile
     n'y est enfermé : il est masqué aux lecteurs d'écran et la piste est
     dupliquée pour que la boucle se referme sans saut visible. -->
<%
  // L'émoji de tête devient une pastille ronde, le reste du libellé le texte
  // de la puce. Un libellé sans émoji donne une puce sans pastille.
  const rubanPuces = marqueeItems.map(function (item) {
    const m = String(item).match(/^([^\p{L}\p{N}\s]+)\s+(.+)$/u);
    return m ? { emoji: m[1], texte: m[2] } : { emoji: '', texte: String(item) };
  });
  // La seconde piste part du milieu de la liste : deux rangs qui défilent en
  // sens inverse avec les mêmes mots au même moment feraient répétitif.
  const rubanMoitie = Math.ceil(rubanPuces.length / 2);
  const rubanRangs = rubanPuces.length
    ? [rubanPuces, rubanPuces.slice(rubanMoitie).concat(rubanPuces.slice(0, rubanMoitie))]
    : [];
%>
<% if (rubanRangs.length) { %>
<div class="ruban" aria-hidden="true">
  <div class="ruban-rangs">
    <% rubanRangs.forEach(function (rang, ri) { %>
    <div class="ruban-piste<%= ri ? ' ruban-piste--retour' : '' %>">
      <% for (let copie = 0; copie < 2; copie++) { %>
        <% rang.forEach(function (puce) { %>
        <span class="ruban-puce"><% if (puce.emoji) { %><span class="ruban-emoji"><%= puce.emoji %></span><% } %><span class="ruban-txt"><%= puce.texte %></span></span><span class="ruban-point"></span>
        <% }) %>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<!-- Quiz Section -->
<%# Les images de tete existent en deux largeurs (1200 et 720 px, voir
    QUIZ_FEATURED). Une carte du curseur mesure au plus 340 px : servir le
    1200 px partout coutait 50 a 60 % du poids de chaque image. Le navigateur
    choisit d'apres la largeur reelle de la carte a chaque point de rupture
    (.quiz-slide dans styles.css). %>
<% const TAILLES_CARTE = '(min-width: 1200px) 286px, (min-width: 900px) 31vw, (min-width: 640px) 46vw, 82vw';
