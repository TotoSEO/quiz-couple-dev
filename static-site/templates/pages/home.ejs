    { routeKey: 'testCrush', key: 'testCrush', icon: '💘', img: 'quiz-amoureux' },
    { routeKey: 'testJalousie', key: 'testJalousie', icon: '🫣', img: 'test-jalousie' },
    { routeKey: 'testInfidelite', key: 'testInfidelite', icon: '💔', img: 'test-jalousie' },
    { routeKey: 'testCouche', key: 'testCouche', icon: '🛏️', img: 'test-jalousie' },
    { routeKey: 'testSecret', key: 'testSecret', icon: '💌', img: 'quiz-amoureux' },
    { routeKey: 'testDistanceAime', key: 'testDistanceAime', icon: '📞', img: 'test-distance' },
    { routeKey: 'testEx', key: 'testEx', icon: '🕰️', img: 'quiz-amoureux' },
