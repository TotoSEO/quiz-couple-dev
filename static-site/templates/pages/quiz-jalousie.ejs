<%
  const quizKey = 'testJalousie';
  const ns = 'quiz-jalousie';
  const quizTitle = t('quizzes:testJalousie.title', 'Test Jalousie Couple');
  const quizDesc = t('quizzes:testJalousie.metaDescription', '');

  // Build hasPart with actual quiz questions from jalousie1 prefix
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd'];
  for (let qi = 1; qi <= 20; qi++) {
    const qText = tgd('jalousie1.q' + qi, '');
    if (!qText || qText === 'jalousie1.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local ? tgd.local('jalousie1.q' + qi + optLetters[oi], '') : tgd('jalousie1.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'jalousie1.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "datePublished": "2026-03-09", "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', 'couple jealousy') },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 40 },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [1,2,3].map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':jsonLd.faq' + i + 'Q', ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':jsonLd.faq' + i + 'A', '') }
        };
      })
    }
  ];

  // Translated labels for the tab selector
  const tabLabels = {
    fr: { tab1: 'Je veux tester ma jalousie', tab2: 'Je veux \u00e9valuer la jalousie de mon/ma partenaire', title1: 'Suis-je jaloux(se) ? Test de jalousie personnel', sub1: 'R\u00e9pondez spontan\u00e9ment. Ce qui compte, c\'est votre premi\u00e8re r\u00e9action.', title2: 'Mon/ma partenaire est-il/elle jaloux(se) ?', sub2: 'R\u00e9pondez en pensant \u00e0 ses comportements r\u00e9els, pas \u00e0 ce que vous imaginez.' },
    en: { tab1: 'I want to test my own jealousy', tab2: 'I want to evaluate my partner\'s jealousy', title1: 'Am I jealous? Personal jealousy test', sub1: 'Answer spontaneously. Your first reaction is what counts.', title2: 'Is my partner jealous?', sub2: 'Answer based on their actual behaviours, not what you imagine.' },
    es: { tab1: 'Quiero evaluar mis propios celos', tab2: 'Quiero evaluar los celos de mi pareja', title1: '\u00bfSoy celoso/a? Test de celos personal', sub1: 'Responde de forma espont\u00e1nea. Lo que cuenta es tu primera reacci\u00f3n.', title2: '\u00bfMi pareja es celosa?', sub2: 'Responde pensando en sus comportamientos reales, no en lo que imaginas.' },
    de: { tab1: 'Ich m\u00f6chte meine eigene Eifersucht testen', tab2: 'Ich m\u00f6chte die Eifersucht meines Partners einsch\u00e4tzen', title1: 'Bin ich eifers\u00fcchtig? Pers\u00f6nlicher Eifersucht-Test', sub1: 'Antworte spontan. Deine erste Reaktion z\u00e4hlt.', title2: 'Ist mein Partner eifers\u00fcchtig?', sub2: 'Antworte basierend auf tats\u00e4chlich beobachtetem Verhalten, nicht auf Annahmen.' },
    it: { tab1: 'Voglio testare la mia gelosia', tab2: 'Voglio valutare la gelosia del mio/della mia partner', title1: 'Sono geloso/a? Test di gelosia personale', sub1: 'Rispondi spontaneamente. Conta la tua prima reazione.', title2: 'Il mio partner \u00e8 geloso/a?', sub2: 'Rispondi pensando ai suoi comportamenti reali, non a ci\u00f2 che immagini.' }
  };
  const labels = tabLabels[lang] || tabLabels.fr;
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

