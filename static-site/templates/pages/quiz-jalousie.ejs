<script src="/js/quiz-engine-core.js" defer></script>
<script>
// Custom jalousie quiz initializer - handles two quiz engines on one page
(function() {
  'use strict';

  var JALOUSIE_QUIZ_CONFIG = {
    'jalousie1': { prefix: 'jalousie1', engine: 'solo', totalQ: 20, pool: 20, quizType: 'jalousie1' },
    'jalousie2': { prefix: 'jalousie2', engine: 'solo', totalQ: 20, pool: 20, quizType: 'jalousie2' }
  };

  var initialized = {};

  function parseGdQuestions(prefix, maxQ) {
    var questions = [];
    var consecutiveMisses = 0;
    for (var i = 1; i <= (maxQ || 50); i++) {
      var qText = QuizEngine.tgd(prefix + '.q' + i, null);
      if (!qText || qText === prefix + '.q' + i) {
        consecutiveMisses++;
        if (questions.length > 0 && consecutiveMisses >= 3) break;
        continue;
      }
      consecutiveMisses = 0;
      var options = [];
      var optLetters = ['a', 'b', 'c', 'd'];
      for (var j = 0; j < optLetters.length; j++) {
        var oText = QuizEngine.tgd(prefix + '.q' + i + optLetters[j], null);
        if (oText && oText !== prefix + '.q' + i + optLetters[j]) {
          options.push({ id: optLetters[j], text: oText });
        }
      }
      if (options.length > 0) {
        // Ascending: a (calm) = 0 points, d (jealous) = max points
        for (var k = 0; k < options.length; k++) options[k].points = k;
        questions.push({ id: i, text: qText, options: options });
      }
    }
    return questions;
  }

  function parseGdResults(prefix) {
    var results = [];
    for (var i = 1; i <= 10; i++) {
      var title = QuizEngine.tgd(prefix + '.r' + i + '_t', null);
      if (!title || title === prefix + '.r' + i + '_t') break;
      results.push({
        title: title,
        description: QuizEngine.tgd(prefix + '.r' + i + '_d', ''),
        advice: QuizEngine.tgd(prefix + '.r' + i + '_a', '')
      });
    }
    if (results.length === 0) return results;
    // Score ranges: 5 levels for 0-60 (20 questions * 3 pts max)
    var maxScore = 60;
    var ranges = [[0,12],[13,24],[25,36],[37,48],[49,60]];
    for (var r = 0; r < results.length && r < ranges.length; r++) {
      results[r].min = ranges[r][0];
      results[r].max = ranges[r][1];
    }
    return results;
  }

  function initJalousieQuiz(testNum) {
    if (initialized[testNum]) return;
    var containerId = testNum === 1 ? 'quiz-engine' : 'quiz-engine-2';
    var container = document.getElementById(containerId);
    if (!container) return;

    var configKey = 'jalousie' + testNum;
    var cfg = JALOUSIE_QUIZ_CONFIG[configKey];
    var lang = container.dataset.lang || 'fr';

    QuizEngine.loadTranslations(lang, function() {
      var questions = parseGdQuestions(cfg.prefix, cfg.pool + 10);
      if (questions.length === 0) {
        container.innerHTML = '<p class="text-center text-muted-foreground py-8">Quiz loading...</p>';
        return;
      }
      var results = parseGdResults(cfg.prefix);
      new QuizEngine.SoloTest({
        container: container,
        questions: questions,
        results: results,
        prefix: cfg.prefix,
        lang: lang,
        quizType: cfg.quizType || 'solo'
      });
      initialized[testNum] = true;
    }, [cfg.prefix]);
  }

  // Initialize test 1 on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { initJalousieQuiz(1); });
  } else {
    initJalousieQuiz(1);
  }

  // Switch between tests
  window.switchJalousieTest = function(testNum) {
    var test1 = document.getElementById('jalousie-test-1');
    var test2 = document.getElementById('jalousie-test-2');
    var tab1 = document.getElementById('tab-jalousie1');
    var tab2 = document.getElementById('tab-jalousie2');

    if (testNum === 1) {
      test1.classList.remove('hidden');
      test2.classList.add('hidden');
      tab1.classList.add('active');
      tab2.classList.remove('active');
      tab1.setAttribute('aria-pressed', 'true');
      tab2.setAttribute('aria-pressed', 'false');
    } else {
      test1.classList.add('hidden');
      test2.classList.remove('hidden');
      tab2.classList.add('active');
      tab1.classList.remove('active');
      tab2.setAttribute('aria-pressed', 'true');
      tab1.setAttribute('aria-pressed', 'false');
      initJalousieQuiz(2);
    }

    // Scroll to tabs
    document.getElementById('jalousie-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
})();
</script>
