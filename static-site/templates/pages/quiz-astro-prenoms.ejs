<%
  const quizKey = 'testAstroPrenoms';
  const ns = 'quiz-astro-prenoms';
  const quizTitle = t('quizzes:testAstroPrenoms.title', 'Compatibilité amoureuse par prénom et signe astrologique');
  const quizDesc = t('quizzes:testAstroPrenoms.metaDescription', '');

  // JSON-LD
  const jsonLd = [
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": quizTitle,
      "description": quizDesc,
      "inLanguage": lang,
      "applicationCategory": "EntertainmentApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [1,2,3].map(function(i) {
        return {
          "@type": "Question",
          "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];

  // Zodiac signs data for the form
  const signKeys = ['aries','taurus','gemini','cancer','leo','virgo','libra','scorpio','sagittarius','capricorn','aquarius','pisces'];
  const signEmojis = { aries:'♈', taurus:'♉', gemini:'♊', cancer:'♋', leo:'♌', virgo:'♍', libra:'♎', scorpio:'♏', sagittarius:'♐', capricorn:'♑', aquarius:'♒', pisces:'♓' };
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero with celestial theme -->
<section class="relative overflow-hidden astro-hero py-20 md:py-32">
  <!-- Decorative stars -->
  <div class="astro-stars" aria-hidden="true">
    <div class="astro-star" style="top:10%;left:15%;animation-delay:0s"></div>
    <div class="astro-star" style="top:20%;left:75%;animation-delay:0.5s"></div>
    <div class="astro-star" style="top:60%;left:85%;animation-delay:1s"></div>
    <div class="astro-star" style="top:70%;left:10%;animation-delay:1.5s"></div>
    <div class="astro-star" style="top:40%;left:50%;animation-delay:2s"></div>
    <div class="astro-star" style="top:85%;left:60%;animation-delay:0.3s"></div>
    <div class="astro-star" style="top:15%;left:40%;animation-delay:1.2s"></div>
    <div class="astro-star" style="top:50%;left:25%;animation-delay:0.8s"></div>
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <span class="astro-badge mb-6">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <%= t(ns + ':hero.badge', 'Numérologie & Astrologie') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="astro-text-glow">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl max-w-2xl mx-auto"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Interactive Tool -->
<section class="py-12 md:py-16 relative">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div class="astro-form-card" id="astro-form-wrapper">
        <!-- Form -->
        <form id="astro-compatibility-form" class="space-y-8" onsubmit="return false;">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Person 1 -->
            <div class="astro-person-card">
              <div class="astro-person-header">
                <span class="astro-person-icon">1</span>
                <span class="font-semibold"><%= t(ns + ':form.person1Title', 'Personne 1') %></span>
              </div>
              <div class="space-y-4">
                <div>
                  <input type="text" id="name1" class="astro-input" placeholder="<%= t(ns + ':form.namePlaceholder', 'Prénom') %>" required autocomplete="off">
                </div>
                <div>
                  <label class="block text-sm font-medium text-muted-foreground mb-2"><%= t(ns + ':form.signLabel', 'Signe astrologique') %></label>
                  <div class="astro-select-wrapper">
                    <select id="sign1" class="astro-select" required>
                      <option value="" disabled selected><%= t(ns + ':form.signPlaceholder', 'Choisir un signe') %></option>
                      <% for (const sk of signKeys) { %>
                      <option value="<%= sk %>"><%= signEmojis[sk] %> <%= t(ns + ':form.signs.' + sk, sk) %></option>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- Person 2 -->
            <div class="astro-person-card">
              <div class="astro-person-header">
                <span class="astro-person-icon">2</span>
                <span class="font-semibold"><%= t(ns + ':form.person2Title', 'Personne 2') %></span>
              </div>
              <div class="space-y-4">
                <div>
                  <input type="text" id="name2" class="astro-input" placeholder="<%= t(ns + ':form.namePlaceholder', 'Prénom') %>" required autocomplete="off">
                </div>
                <div>
                  <label class="block text-sm font-medium text-muted-foreground mb-2"><%= t(ns + ':form.signLabel', 'Signe astrologique') %></label>
                  <div class="astro-select-wrapper">
                    <select id="sign2" class="astro-select" required>
                      <option value="" disabled selected><%= t(ns + ':form.signPlaceholder', 'Choisir un signe') %></option>
                      <% for (const sk of signKeys) { %>
                      <option value="<%= sk %>"><%= signEmojis[sk] %> <%= t(ns + ':form.signs.' + sk, sk) %></option>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <button type="button" id="astro-submit-btn" class="astro-submit-btn w-full">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span><%= t(ns + ':form.submitButton', 'Vérifier la compatibilité') %></span>
          </button>
        </form>

        <!-- Results (hidden by default) -->
        <div id="astro-results" class="hidden">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold mb-2"><%= t(ns + ':results.title', 'Votre compatibilité') %></h2>
            <p class="text-muted-foreground" id="astro-results-names"></p>
          </div>

          <!-- Overall Score -->
          <div class="astro-score-main mb-8">
            <div class="astro-score-circle" id="astro-score-overall">
              <svg viewBox="0 0 120 120" class="astro-score-svg">
                <defs>
                  <linearGradient id="astroGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:hsl(270,60%,60%)"/>
                    <stop offset="100%" style="stop-color:hsl(340,60%,60%)"/>
                  </linearGradient>
                </defs>
                <circle cx="60" cy="60" r="54" class="astro-score-bg"/>
                <circle cx="60" cy="60" r="54" class="astro-score-fill" id="astro-score-ring" stroke-dasharray="339.292" stroke-dashoffset="339.292"/>
              </svg>
              <div class="astro-score-value">
                <span id="astro-score-number">0</span>
                <span class="astro-score-unit"><%= t(ns + ':results.outOf10', '/10') %></span>
              </div>
            </div>
            <p class="text-lg font-semibold mt-4"><%= t(ns + ':results.overallTitle', 'Score global') %></p>
          </div>

          <!-- Detail Scores -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="astro-detail-card">
              <div class="astro-detail-icon">♈</div>
              <h3 class="font-semibold mb-2"><%= t(ns + ':results.astroTitle', 'Compatibilité astrologique') %></h3>
              <div class="astro-detail-score" id="astro-score-astro">0<%= t(ns + ':results.outOf10', '/10') %></div>
              <p class="text-sm text-muted-foreground mt-2" id="astro-explanation-astro"></p>
            </div>
            <div class="astro-detail-card">
              <div class="astro-detail-icon">🔢</div>
              <h3 class="font-semibold mb-2"><%= t(ns + ':results.numerologyTitle', 'Compatibilité numérologique') %></h3>
              <div class="astro-detail-score" id="astro-score-num">0<%= t(ns + ':results.outOf10', '/10') %></div>
              <p class="text-sm text-muted-foreground mt-2" id="astro-explanation-num"></p>
            </div>
          </div>

          <!-- Name Vibrations -->
          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="text-center p-4 rounded-lg bg-muted/30">
              <p class="text-xs text-muted-foreground mb-1"><%= t(ns + ':results.nameVibration', 'Vibration du prénom') %></p>
              <p class="font-bold text-lg" id="astro-name1-display"></p>
              <p class="text-primary font-bold text-2xl" id="astro-num1"></p>
            </div>
            <div class="text-center p-4 rounded-lg bg-muted/30">
              <p class="text-xs text-muted-foreground mb-1"><%= t(ns + ':results.nameVibration', 'Vibration du prénom') %></p>
              <p class="font-bold text-lg" id="astro-name2-display"></p>
              <p class="text-primary font-bold text-2xl" id="astro-num2"></p>
            </div>
          </div>

          <button type="button" id="astro-retry-btn" class="astro-submit-btn w-full">
            <span><%= t(ns + ':results.tryAgain', 'Tester un autre couple') %></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

