<%
  const ns = 'quiz-astro-prenoms';
  const quizTitle = t('quizzes:testAstroPrenoms.title', 'Compatibilité amoureuse');
  const quizDesc = t('quizzes:testAstroPrenoms.metaDescription', '');
%>
<%- jsonLdHtml %>

<!-- Hero with celestial background -->
<section class="relative overflow-hidden astro-hero-section py-16 md:py-24">
  <!-- Animated stars background -->
  <div class="astro-stars" aria-hidden="true">
    <div class="astro-star astro-star-1"></div>
    <div class="astro-star astro-star-2"></div>
    <div class="astro-star astro-star-3"></div>
    <div class="astro-star astro-star-4"></div>
    <div class="astro-star astro-star-5"></div>
    <div class="astro-star astro-star-6"></div>
    <div class="astro-star astro-star-7"></div>
    <div class="astro-star astro-star-8"></div>
    <div class="astro-star astro-star-9"></div>
    <div class="astro-star astro-star-10"></div>
    <div class="astro-star astro-star-11"></div>
    <div class="astro-star astro-star-12"></div>
    <div class="astro-star astro-star-13"></div>
    <div class="astro-star astro-star-14"></div>
    <div class="astro-star astro-star-15"></div>
    <div class="astro-star astro-star-16"></div>
    <div class="astro-star astro-star-17"></div>
    <div class="astro-star astro-star-18"></div>
    <div class="astro-star astro-star-19"></div>
    <div class="astro-star astro-star-20"></div>
  </div>
  <!-- Constellation lines -->
  <svg class="astro-constellation" viewBox="0 0 800 400" fill="none" aria-hidden="true">
    <line x1="120" y1="80" x2="250" y2="150" stroke="currentColor" stroke-width="0.5" opacity="0.15"/>
    <line x1="250" y1="150" x2="380" y2="90" stroke="currentColor" stroke-width="0.5" opacity="0.12"/>
    <line x1="380" y1="90" x2="500" y2="180" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
    <line x1="500" y1="180" x2="650" y2="120" stroke="currentColor" stroke-width="0.5" opacity="0.13"/>
    <line x1="650" y1="120" x2="720" y2="250" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
    <line x1="200" y1="300" x2="350" y2="260" stroke="currentColor" stroke-width="0.5" opacity="0.12"/>
    <line x1="350" y1="260" x2="480" y2="320" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
    <line x1="480" y1="320" x2="600" y2="280" stroke="currentColor" stroke-width="0.5" opacity="0.15"/>
  </svg>
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <%= t(ns + ':hero.badge', 'Astrologie & Numérologie') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.highlight', 'Compatibilité amoureuse');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
      <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':hero.subtitle', '') %></p>
    </div>
  </div>
</section>

<!-- Compatibility Tool -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="astro-tool" class="astro-form-card rounded-2xl p-6 md:p-10">
        <!-- Form -->
        <div id="astro-form">
          <div class="astro-form-grid">
            <!-- Person 1 -->
            <div class="astro-person-block astro-person-1">
              <div class="astro-person-header">
                <span class="astro-person-number astro-person-number-1">1</span>
                <span class="astro-person-label"><%= lang === 'fr' ? 'Personne 1' : lang === 'es' ? 'Persona 1' : lang === 'de' ? 'Person 1' : lang === 'it' ? 'Persona 1' : 'Person 1' %></span>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="name1"><%= lang === 'fr' ? 'Prénom' : lang === 'es' ? 'Nombre' : lang === 'de' ? 'Vorname' : lang === 'it' ? 'Nome' : 'First name' %></label>
                <input type="text" id="name1" class="astro-input" placeholder="<%= t(ns + ':form.name1Placeholder', 'Prénom') %>" autocomplete="off" maxlength="30">
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="sign1"><%= t(ns + ':form.sign1Label', 'Signe astrologique') %></label>
                <div class="astro-select-wrap">
                  <select id="sign1" class="astro-input astro-select">
                    <option value="" disabled selected><%= t(ns + ':form.selectSign', 'Choisir un signe') %></option>
                    <option value="belier"><%= t(ns + ':form.signs.belier', 'Bélier ♈') %></option>
                    <option value="taureau"><%= t(ns + ':form.signs.taureau', 'Taureau ♉') %></option>
                    <option value="gemeaux"><%= t(ns + ':form.signs.gemeaux', 'Gémeaux ♊') %></option>
                    <option value="cancer"><%= t(ns + ':form.signs.cancer', 'Cancer ♋') %></option>
                    <option value="lion"><%= t(ns + ':form.signs.lion', 'Lion ♌') %></option>
                    <option value="vierge"><%= t(ns + ':form.signs.vierge', 'Vierge ♍') %></option>
                    <option value="balance"><%= t(ns + ':form.signs.balance', 'Balance ♎') %></option>
                    <option value="scorpion"><%= t(ns + ':form.signs.scorpion', 'Scorpion ♏') %></option>
                    <option value="sagittaire"><%= t(ns + ':form.signs.sagittaire', 'Sagittaire ♐') %></option>
                    <option value="capricorne"><%= t(ns + ':form.signs.capricorne', 'Capricorne ♑') %></option>
                    <option value="verseau"><%= t(ns + ':form.signs.verseau', 'Verseau ♒') %></option>
                    <option value="poissons"><%= t(ns + ':form.signs.poissons', 'Poissons ♓') %></option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Heart separator -->
            <div class="astro-heart-divider">
              <div class="astro-heart-line"></div>
              <span class="astro-heart-icon">&#10084;&#65039;</span>
              <div class="astro-heart-line"></div>
            </div>

            <!-- Person 2 -->
            <div class="astro-person-block astro-person-2">
              <div class="astro-person-header">
                <span class="astro-person-number astro-person-number-2">2</span>
                <span class="astro-person-label"><%= lang === 'fr' ? 'Personne 2' : lang === 'es' ? 'Persona 2' : lang === 'de' ? 'Person 2' : lang === 'it' ? 'Persona 2' : 'Person 2' %></span>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="name2"><%= lang === 'fr' ? 'Prénom' : lang === 'es' ? 'Nombre' : lang === 'de' ? 'Vorname' : lang === 'it' ? 'Nome' : 'First name' %></label>
                <input type="text" id="name2" class="astro-input" placeholder="<%= t(ns + ':form.name2Placeholder', 'Prénom') %>" autocomplete="off" maxlength="30">
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="sign2"><%= t(ns + ':form.sign2Label', 'Signe astrologique') %></label>
                <div class="astro-select-wrap">
                  <select id="sign2" class="astro-input astro-select">
                    <option value="" disabled selected><%= t(ns + ':form.selectSign', 'Choisir un signe') %></option>
                    <option value="belier"><%= t(ns + ':form.signs.belier', 'Bélier ♈') %></option>
                    <option value="taureau"><%= t(ns + ':form.signs.taureau', 'Taureau ♉') %></option>
                    <option value="gemeaux"><%= t(ns + ':form.signs.gemeaux', 'Gémeaux ♊') %></option>
                    <option value="cancer"><%= t(ns + ':form.signs.cancer', 'Cancer ♋') %></option>
                    <option value="lion"><%= t(ns + ':form.signs.lion', 'Lion ♌') %></option>
                    <option value="vierge"><%= t(ns + ':form.signs.vierge', 'Vierge ♍') %></option>
                    <option value="balance"><%= t(ns + ':form.signs.balance', 'Balance ♎') %></option>
                    <option value="scorpion"><%= t(ns + ':form.signs.scorpion', 'Scorpion ♏') %></option>
                    <option value="sagittaire"><%= t(ns + ':form.signs.sagittaire', 'Sagittaire ♐') %></option>
                    <option value="capricorne"><%= t(ns + ':form.signs.capricorne', 'Capricorne ♑') %></option>
                    <option value="verseau"><%= t(ns + ':form.signs.verseau', 'Verseau ♒') %></option>
                    <option value="poissons"><%= t(ns + ':form.signs.poissons', 'Poissons ♓') %></option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Submit -->
          <div class="mt-8 text-center">
            <button id="astro-submit" class="btn btn-cta btn-gradient astro-submit-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':form.submitButton', 'Vérifier la compatibilité') %>
            </button>
          </div>
        </div>

        <!-- Results (hidden initially) -->
        <div id="astro-results" class="hidden">
          <!-- Overall Score -->
          <div class="quiz-result-card rounded-2xl p-8 mb-8">
            <h2 class="text-2xl font-bold mb-6 text-foreground"><%= t(ns + ':results.title', 'Votre compatibilité') %></h2>
            <p id="result-names" class="text-lg text-muted-foreground mb-6"></p>
            <div class="quiz-score-circle mx-auto mb-4">
              <span id="result-overall"></span>
            </div>
            <p class="text-sm text-muted-foreground mt-2"><%= t(ns + ':results.overall', 'Score global') %></p>
          </div>

          <!-- Breakdown -->
          <div class="grid gap-6 md:grid-cols-2 mb-8">
            <!-- Astro Score -->
            <div class="glass-card rounded-xl p-6 text-center">
              <div class="quiz-score-circle quiz-score-sm mx-auto mb-3">
                <span id="result-astro-score"></span>
              </div>
              <h3 class="font-semibold text-foreground mb-1"><%= t(ns + ':results.astroLabel', 'Astrologie') %></h3>
              <p class="text-sm text-muted-foreground"><%= t(ns + ':results.astroScore', 'Compatibilité astrale') %></p>
            </div>
            <!-- Numero Score -->
            <div class="glass-card rounded-xl p-6 text-center">
              <div class="quiz-score-circle quiz-score-sm mx-auto mb-3">
                <span id="result-numero-score"></span>
              </div>
              <h3 class="font-semibold text-foreground mb-1"><%= t(ns + ':results.numeroLabel', 'Numérologie') %></h3>
              <p class="text-sm text-muted-foreground"><%= t(ns + ':results.numeroScore', 'Compatibilité des prénoms') %></p>
            </div>
          </div>

          <!-- Astro Explanation -->
          <div class="glass-card rounded-xl p-6 md:p-8 mb-6">
            <h3 class="text-xl font-bold text-foreground mb-4 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 text-primary"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':results.detailTitle', 'Analyse détaillée de vos signes') %>
            </h3>
            <p id="result-astro-detail" class="text-muted-foreground leading-relaxed"></p>
          </div>

          <!-- Numero Explanation -->
          <div class="glass-card rounded-xl p-6 md:p-8 mb-8">
            <h3 class="text-xl font-bold text-foreground mb-4 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 text-primary"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <%= t(ns + ':results.numeroTitle', 'Ce que vos prénoms révèlent') %>
            </h3>
            <p id="result-numero-detail" class="text-muted-foreground leading-relaxed"></p>
          </div>

          <!-- Try Again + CTAs -->
          <div class="text-center space-y-3">
            <button id="astro-retry" class="btn btn-outline px-8 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              <%= t(ns + ':results.tryAgain', 'Tester un autre couple') %>
            </button>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-3">
              <a href="<%= getLocalizedUrl('home', lang) %>#review-form-section" class="btn btn-outline px-6 py-2.5 text-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <%= lang === 'fr' ? 'Laisser un avis' : lang === 'es' ? 'Dejar una opinión' : lang === 'de' ? 'Bewertung abgeben' : lang === 'it' ? 'Lascia una recensione' : 'Leave a review' %>
              </a>
              <% if (lang === 'fr') { %>
              <a href="#ebook-form-section" class="btn btn-primary px-6 py-2.5 text-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                Apprendre l'astrologie gratuitement en 30 minutes
              </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- E-Book Lead Magnet (FR only) -->
<% if (lang === 'fr') { %>
<section class="ebook-section py-16 md:py-20" id="ebook-astro">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="ebook-card">
      <div class="ebook-layout">
        <!-- Left column: Text (70%) -->
        <div class="ebook-text">
          <h2 class="text-2xl md:text-3xl font-bold mb-4">E-Book gratuit : Apprendre les bases de l'astrologie</h2>
          <p class="text-muted-foreground leading-relaxed mb-4">Vous avez l'impression que la description de votre signe astrologique ne vous correspond pas toujours ? C'est normal : vous êtes bien plus qu'un simple signe solaire.</p>
          <p class="text-muted-foreground leading-relaxed mb-4">Pour comprendre vos réactions, vos relations et vos besoins profonds, vous devez regarder l'image complète : votre thème natal.</p>
          <p class="text-muted-foreground leading-relaxed mb-6">On a condensé les bases de l'astrologie dans un e-book pratique, sans jargon et sans prise de tête. Et bonne nouvelle : on vous l'offre aujourd'hui.</p>
          <p class="font-semibold text-foreground mb-3">Ce que vous allez découvrir à l'intérieur :</p>
          <ul class="ebook-features">
            <li><strong>Le secret du "Big Three" :</strong> Pourquoi votre Soleil, votre Lune et votre Ascendant contrôlent 80 % de votre personnalité.</li>
            <li><strong>Le décodeur des 12 Signes :</strong> Les forces et les failles de chaque profil (et le mythe de la "compatibilité" amoureuse enfin brisé).</li>
            <li><strong>La carte de votre vie :</strong> Comment utiliser les 12 Maisons pour savoir exactement où vous êtes fait pour briller (carrière, amour, argent...).</li>
            <li><strong>La "Formule Magique" :</strong> La technique infaillible pour lire votre carte du ciel de A à Z, même si vous n'y connaissez rien.</li>
          </ul>
        </div>
        <!-- Right column: Cover (30%) -->
        <div class="ebook-cover">
          <img src="/assets/ebook-astrologie-cover.webp" alt="Couverture de l'e-book Apprendre les bases de l'astrologie" loading="lazy" width="940" height="1500">
        </div>
      </div>

      <!-- Email capture form -->
      <div class="ebook-form-section" id="ebook-form-section">
        <h3 class="text-xl font-bold mb-2">Recevez votre guide gratuit immédiatement</h3>
        <p class="text-muted-foreground mb-6">Pas de théorie ennuyeuse, juste des exercices pratiques et des déclics sur vous-même. Entrez simplement votre prénom et votre adresse e-mail ci-dessous, et téléchargez votre e-book.</p>
        <form id="ebook-lead-form" class="ebook-form">
          <div class="ebook-form-fields">
            <input type="text" id="ebook-firstname" class="input" placeholder="Prénom" required maxlength="50" autocomplete="given-name">
            <input type="email" id="ebook-email" class="input" placeholder="Adresse e-mail" required maxlength="100" autocomplete="email">
          </div>
          <!-- Honeypot anti-spam -->
          <div style="position:absolute;left:-9999px;" aria-hidden="true">
            <input type="text" id="ebook-website" name="website" tabindex="-1" autocomplete="off">
          </div>
          <label class="ebook-consent">
            <input type="checkbox" id="ebook-consent-cb" required>
            <span class="text-sm text-muted-foreground">En recevant mon E-Book, j'accepte que QuizCouple me contacte occasionnellement à des fins informationnelles, et conserve mes informations en accord avec la <a href="<%= getLocalizedUrl('privacy', lang) %>" target="_blank" class="text-primary hover:underline">politique de confidentialité</a>.</span>
          </label>
          <button type="submit" id="ebook-submit-btn" class="btn btn-cta btn-gradient ebook-submit-btn">
            <span>OUI ! JE VEUX MON E-BOOK GRATUIT</span>
          </button>
          <p id="ebook-form-status" class="text-sm mt-3 hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- SEO Content -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <!-- Section 1 -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%= t(ns + ':section1.p1') %></p>
        <p><%- t(ns + ':section1.p2') %></p>
      </div>
    </section>

    <!-- Section 2 -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section2.p1') %></p>
        <p><%= t(ns + ':section2.p2') %></p>
      </div>
      <% const tip2 = t(ns + ':section2.tip', ''); if (tip2) { %>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%= tip2 %></p>
      </div>
      <% } %>
    </section>

    <!-- Section 3 -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section3.p1') %></p>
        <p><%- t(ns + ':section3.p2') %></p>
      </div>
      <% const sub3 = t(ns + ':section3.subtitle', ''); if (sub3) { %>
      <div class="mt-8">
        <h3 class="text-xl font-semibold mb-3"><%= sub3 %></h3>
        <p class="text-muted-foreground leading-relaxed"><%- t(ns + ':section3.p3', '') %></p>
      </div>
      <% } %>
    </section>

    <!-- Section 4 -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section4.p1') %></p>
        <p><%= t(ns + ':section4.p2') %></p>
      </div>
      <% const tip4 = t(ns + ':section4.tip', ''); if (tip4) { %>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%= tip4 %></p>
      </div>
      <% } %>
    </section>

    <!-- Section 5 -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section5.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section5.p1') %></p>
        <p><%= t(ns + ':section5.p2') %></p>
      </div>
      <% const tip5 = t(ns + ':section5.tip', ''); if (tip5) { %>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%= tip5 %></p>
      </div>
      <% } %>
    </section>

    <!-- FAQ -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', 'FAQ') %></h2>
      <div class="space-y-3">
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= t(ns + ':faq.q1') %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= t(ns + ':faq.a1') %></div>
        </details>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= t(ns + ':faq.q2') %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= t(ns + ':faq.a2') %></div>
        </details>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= t(ns + ':faq.q3') %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- t(ns + ':faq.a3') %></div>
        </details>
      </div>
    </section>

  </div>
</article>

<!-- Zodiac Compatibility Data & Logic -->
<script>
(function() {
  // ═══════════════════════════════════════════════════════
  // ZODIAC COMPATIBILITY DATA — 144 combinations
  // ═══════════════════════════════════════════════════════
  var ZODIAC_DATA = <%- zodiacDataJson %>;

  // ═══════════════════════════════════════════════════════
  // NUMEROLOGY
  // ═══════════════════════════════════════════════════════
  var LETTER_VALUES = {
    a:1,b:2,c:3,d:4,e:5,f:6,g:7,h:8,i:9,
    j:1,k:2,l:3,m:4,n:5,o:6,p:7,q:8,r:9,
    s:1,t:2,u:3,v:4,w:5,x:6,y:7,z:8
  };

  function reduceToSingle(n) {
    while (n > 9 && n !== 11 && n !== 22) {
      var sum = 0;
      while (n > 0) { sum += n % 10; n = Math.floor(n / 10); }
      n = sum;
    }
    return n;
  }

  function getNameNumber(name) {
    var sum = 0;
    var clean = name.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z]/g, '');
    for (var i = 0; i < clean.length; i++) {
      sum += LETTER_VALUES[clean[i]] || 0;
    }
    return reduceToSingle(sum);
  }

  // Numerology compatibility matrix (1-9, 11, 22)
  var NUMERO_COMPAT = {
    '1_1':7,'1_2':6,'1_3':9,'1_4':4,'1_5':8,'1_6':5,'1_7':5,'1_8':7,'1_9':6,'1_11':8,'1_22':6,
    '2_2':7,'2_3':8,'2_4':7,'2_5':4,'2_6':9,'2_7':4,'2_8':6,'2_9':7,'2_11':9,'2_22':8,
    '3_3':7,'3_4':3,'3_5':8,'3_6':9,'3_7':5,'3_8':4,'3_9':8,'3_11':8,'3_22':5,
    '4_4':6,'4_5':3,'4_6':7,'4_7':6,'4_8':8,'4_9':4,'4_11':5,'4_22':9,
    '5_5':7,'5_6':4,'5_7':7,'5_8':5,'5_9':8,'5_11':7,'5_22':5,
    '6_6':7,'6_7':5,'6_8':5,'6_9':9,'6_11':8,'6_22':8,
    '7_7':7,'7_8':4,'7_9':6,'7_11':9,'7_22':7,
    '8_8':7,'8_9':5,'8_11':6,'8_22':9,
    '9_9':7,'9_11':8,'9_22':7,
    '11_11':8,'11_22':8,
    '22_22':8
  };

  function getNumeroCompat(n1, n2) {
    var key = Math.min(n1,n2) + '_' + Math.max(n1,n2);
    return NUMERO_COMPAT[key] || 5;
  }

  // Number meanings for explanations
  var NUMBER_TRAITS = {
    1: { fr: "leader, indépendant, pionnier", en: "leader, independent, pioneer", es: "líder, independiente, pionero", de: "Anführer, unabhängig, Pionier", it: "leader, indipendente, pioniere" },
    2: { fr: "diplomate, sensible, partenaire", en: "diplomat, sensitive, partner", es: "diplomático, sensible, compañero", de: "Diplomat, sensibel, Partner", it: "diplomatico, sensibile, partner" },
    3: { fr: "créatif, sociable, expressif", en: "creative, sociable, expressive", es: "creativo, sociable, expresivo", de: "kreativ, gesellig, ausdrucksvoll", it: "creativo, socievole, espressivo" },
    4: { fr: "stable, organisé, loyal", en: "stable, organized, loyal", es: "estable, organizado, leal", de: "stabil, organisiert, loyal", it: "stabile, organizzato, leale" },
    5: { fr: "aventurier, libre, dynamique", en: "adventurous, free, dynamic", es: "aventurero, libre, dinámico", de: "abenteuerlustig, frei, dynamisch", it: "avventuriero, libero, dinamico" },
    6: { fr: "protecteur, harmonieux, responsable", en: "protective, harmonious, responsible", es: "protector, armonioso, responsable", de: "beschützend, harmonisch, verantwortungsvoll", it: "protettivo, armonioso, responsabile" },
    7: { fr: "spirituel, analytique, introspectif", en: "spiritual, analytical, introspective", es: "espiritual, analítico, introspectivo", de: "spirituell, analytisch, introspektiv", it: "spirituale, analitico, introspettivo" },
    8: { fr: "ambitieux, puissant, déterminé", en: "ambitious, powerful, determined", es: "ambicioso, poderoso, determinado", de: "ehrgeizig, kraftvoll, entschlossen", it: "ambizioso, potente, determinato" },
    9: { fr: "altruiste, sage, universel", en: "altruistic, wise, universal", es: "altruista, sabio, universal", de: "altruistisch, weise, universell", it: "altruistisch, weise, universell" },
    11: { fr: "visionnaire, inspiré, intuitif", en: "visionary, inspired, intuitive", es: "visionario, inspirado, intuitivo", de: "visionär, inspiriert, intuitiv", it: "visionario, ispirato, intuitivo" },
    22: { fr: "bâtisseur, visionnaire, maître", en: "builder, visionary, master", es: "constructor, visionario, maestro", de: "Erbauer, Visionär, Meister", it: "costruttore, visionario, maestro" }
  };

  var LANG = '<%= lang %>';

  function getNumeroExplanation(name1, name2, n1, n2, score) {
    var t1 = NUMBER_TRAITS[n1] ? (NUMBER_TRAITS[n1][LANG] || NUMBER_TRAITS[n1].fr) : '';
    var t2 = NUMBER_TRAITS[n2] ? (NUMBER_TRAITS[n2][LANG] || NUMBER_TRAITS[n2].fr) : '';

    var templates = {
      fr: name1 + ' porte le nombre ' + n1 + ' (' + t1 + ') et ' + name2 + ' porte le nombre ' + n2 + ' (' + t2 + '). ',
      en: name1 + ' carries the number ' + n1 + ' (' + t1 + ') and ' + name2 + ' carries the number ' + n2 + ' (' + t2 + '). ',
      es: name1 + ' lleva el número ' + n1 + ' (' + t1 + ') y ' + name2 + ' lleva el número ' + n2 + ' (' + t2 + '). ',
      de: name1 + ' trägt die Zahl ' + n1 + ' (' + t1 + ') und ' + name2 + ' trägt die Zahl ' + n2 + ' (' + t2 + '). ',
      it: name1 + ' porta il numero ' + n1 + ' (' + t1 + ') e ' + name2 + ' porta il numero ' + n2 + ' (' + t2 + '). '
    };
    var base = templates[LANG] || templates.fr;

    var high = { fr: 'Ces vibrations se complètent naturellement, créant une belle harmonie entre vos prénoms.', en: 'These vibrations complement each other naturally, creating beautiful harmony between your names.', es: 'Estas vibraciones se complementan naturalmente, creando una hermosa armonía entre vuestros nombres.', de: 'Diese Schwingungen ergänzen sich auf natürliche Weise und schaffen eine schöne Harmonie zwischen euren Namen.', it: 'Queste vibrazioni si completano naturalmente, creando una bella armonia tra i vostri nomi.' };
    var med = { fr: 'Vos vibrations sont différentes mais peuvent créer une dynamique intéressante si vous apprenez à apprécier vos différences.', en: 'Your vibrations are different but can create an interesting dynamic if you learn to appreciate your differences.', es: 'Vuestras vibraciones son diferentes pero pueden crear una dinámica interesante si aprendéis a apreciar vuestras diferencias.', de: 'Eure Schwingungen sind unterschiedlich, können aber eine interessante Dynamik schaffen, wenn ihr lernt, eure Unterschiede zu schätzen.', it: 'Le vostre vibrazioni sono diverse ma possono creare una dinamica interessante se imparate ad apprezzare le vostre differenze.' };
    var low = { fr: 'Vos vibrations sont contrastées, ce qui peut créer de la tension mais aussi une forte attirance magnétique. L\'effort de compréhension mutuelle sera la clé.', en: 'Your vibrations are contrasting, which can create tension but also strong magnetic attraction. Mutual understanding will be key.', es: 'Vuestras vibraciones son contrastadas, lo que puede crear tensión pero también una fuerte atracción magnética. La comprensión mutua será la clave.', de: 'Eure Schwingungen sind gegensätzlich, was Spannung aber auch eine starke magnetische Anziehung erzeugen kann. Gegenseitiges Verständnis wird der Schlüssel sein.', it: 'Le vostre vibrazioni sono contrastanti, il che può creare tensione ma anche una forte attrazione magnetica. La comprensione reciproca sarà la chiave.' };

    if (score >= 7) return base + (high[LANG] || high.fr);
    if (score >= 5) return base + (med[LANG] || med.fr);
    return base + (low[LANG] || low.fr);
  }

  // ═══════════════════════════════════════════════════════
  // UI LOGIC
  // ═══════════════════════════════════════════════════════
  var form = document.getElementById('astro-form');
  var results = document.getElementById('astro-results');
  var submitBtn = document.getElementById('astro-submit');
  var retryBtn = document.getElementById('astro-retry');

  submitBtn.addEventListener('click', function() {
    var name1 = document.getElementById('name1').value.trim();
    var name2 = document.getElementById('name2').value.trim();
    var sign1 = document.getElementById('sign1').value;
    var sign2 = document.getElementById('sign2').value;

    if (!name1 || !name2 || !sign1 || !sign2) {
      // Shake the button
      submitBtn.classList.add('animate-shake');
      setTimeout(function(){ submitBtn.classList.remove('animate-shake'); }, 500);
      return;
    }

    // Calculate astro score
    var astroKey = sign1 + '_' + sign2;
    var astroData = ZODIAC_DATA[astroKey] || { score: 5, text: '' };
    var astroScore = astroData.score;

    // Calculate numerology score
    var n1 = getNameNumber(name1);
    var n2 = getNameNumber(name2);
    var numeroScore = getNumeroCompat(n1, n2);

    // Overall score (weighted: 60% astro, 40% numero) — out of 10
    var overall = Math.round((astroScore * 0.6 + numeroScore * 0.4) * 10) / 10;
    var overallPct = Math.round(overall * 10);

    // Display results
    document.getElementById('result-names').textContent = name1 + ' & ' + name2;
    document.getElementById('result-overall').textContent = overallPct + '%';
    document.getElementById('result-astro-score').textContent = (astroScore * 10) + '%';
    document.getElementById('result-numero-score').textContent = (numeroScore * 10) + '%';
    document.getElementById('result-astro-detail').textContent = astroData.text;
    document.getElementById('result-numero-detail').textContent = getNumeroExplanation(name1, name2, n1, n2, numeroScore);

    // Animate score circle color
    var overallCircle = results.querySelector('.quiz-score-circle');
    if (overallPct >= 70) overallCircle.style.borderColor = 'hsl(142 71% 45%)';
    else if (overallPct >= 50) overallCircle.style.borderColor = 'hsl(45 93% 47%)';
    else overallCircle.style.borderColor = 'hsl(0 84% 60%)';

    // Show results, hide form
    form.classList.add('hidden');
    results.classList.remove('hidden');
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  retryBtn.addEventListener('click', function() {
    results.classList.add('hidden');
    form.classList.remove('hidden');
    document.getElementById('name1').value = '';
    document.getElementById('name2').value = '';
    document.getElementById('sign1').selectedIndex = 0;
    document.getElementById('sign2').selectedIndex = 0;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ═══════════════════════════════════════════════════════
  // E-BOOK LEAD CAPTURE
  // ═══════════════════════════════════════════════════════
  var ebookForm = document.getElementById('ebook-lead-form');
  if (ebookForm) {
    ebookForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var firstName = document.getElementById('ebook-firstname').value.trim();
      var email = document.getElementById('ebook-email').value.trim();
      var honeypot = document.getElementById('ebook-website');
      var consent = document.getElementById('ebook-consent-cb');
      var statusEl = document.getElementById('ebook-form-status');
      var submitBtn = document.getElementById('ebook-submit-btn');

      // Anti-spam: honeypot field must be empty
      if (honeypot && honeypot.value) return;

      if (!firstName || !email) return;
      if (!consent || !consent.checked) return;

      submitBtn.disabled = true;
      submitBtn.querySelector('span').textContent = 'Envoi en cours...';
      statusEl.classList.add('hidden');

      var SUPA_URL = '<%= supabaseUrl %>';
      var SUPA_KEY = '<%= supabaseKey %>';

      fetch(SUPA_URL + '/functions/v1/ebook-verify?action=submit', {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + SUPA_KEY,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ first_name: firstName, email: email })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Erreur ' + res.status);
        return res.json();
      })
      .then(function(data) {
        if (data.already_verified) {
          statusEl.textContent = 'Cet e-mail a déjà été vérifié. L\'e-book vous a déjà été envoyé. Vérifiez votre boîte mail !';
          statusEl.style.color = 'hsl(210 80% 55%)';
        } else {
          statusEl.textContent = 'Un e-mail de vérification vient d\'être envoyé ! Cliquez sur le lien dans le mail pour recevoir votre e-book.';
          statusEl.style.color = 'hsl(142 71% 45%)';
        }
        statusEl.classList.remove('hidden');
        submitBtn.querySelector('span').textContent = 'VÉRIFIEZ VOS E-MAILS !';
        ebookForm.querySelector('#ebook-firstname').disabled = true;
        ebookForm.querySelector('#ebook-email').disabled = true;
      })
      .catch(function() {
        statusEl.textContent = 'Une erreur est survenue. Veuillez réessayer.';
        statusEl.style.color = 'hsl(0 84% 60%)';
        statusEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.querySelector('span').textContent = 'OUI ! JE VEUX MON E-BOOK GRATUIT';
      });
    });
  }
})();
</script>
