<!-- Zodiac Compatibility Data & Logic -->
<script>
(function() {
  // ═══════════════════════════════════════════════════════
  // ZODIAC COMPATIBILITY DATA, 144 combinations
  // ═══════════════════════════════════════════════════════
  var ZODIAC_DATA = <%- zodiacDataJson %>;

  // ═══════════════════════════════════════════════════════
  // NUMEROLOGY
  // ═══════════════════════════════════════════════════════
  var LETTER_VALUES = {
    a:1,b:2,c:3,d:4,e:5,f:6,g:7,h:8,i:9,
    j:1,k:2,l:3,m:4,n:5,o:6,p:7,q:8,r:9,
    s:1,t:2,u:3,v:4,w:5,x:6,y:7,z:8
  };

  function reduceToSingle(n) {
    while (n > 9 && n !== 11 && n !== 22) {
      var sum = 0;
      while (n > 0) { sum += n % 10; n = Math.floor(n / 10); }
      n = sum;
    }
    return n;
  }

  function getNameNumber(name) {
    var sum = 0;
    var clean = name.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z]/g, '');
    for (var i = 0; i < clean.length; i++) {
      sum += LETTER_VALUES[clean[i]] || 0;
    }
    return reduceToSingle(sum);
  }

  // Numerology compatibility matrix (1-9, 11, 22)
  var NUMERO_COMPAT = {
    '1_1':7,'1_2':6,'1_3':9,'1_4':4,'1_5':8,'1_6':5,'1_7':5,'1_8':7,'1_9':6,'1_11':8,'1_22':6,
    '2_2':7,'2_3':8,'2_4':7,'2_5':4,'2_6':9,'2_7':4,'2_8':6,'2_9':7,'2_11':9,'2_22':8,
    '3_3':7,'3_4':3,'3_5':8,'3_6':9,'3_7':5,'3_8':4,'3_9':8,'3_11':8,'3_22':5,
    '4_4':6,'4_5':3,'4_6':7,'4_7':6,'4_8':8,'4_9':4,'4_11':5,'4_22':9,
    '5_5':7,'5_6':4,'5_7':7,'5_8':5,'5_9':8,'5_11':7,'5_22':5,
    '6_6':7,'6_7':5,'6_8':5,'6_9':9,'6_11':8,'6_22':8,
    '7_7':7,'7_8':4,'7_9':6,'7_11':9,'7_22':7,
    '8_8':7,'8_9':5,'8_11':6,'8_22':9,
    '9_9':7,'9_11':8,'9_22':7,
    '11_11':8,'11_22':8,
    '22_22':8
  };

  function getNumeroCompat(n1, n2) {
    var key = Math.min(n1,n2) + '_' + Math.max(n1,n2);
    return NUMERO_COMPAT[key] || 5;
  }

  // Number meanings for explanations
  var NUMBER_TRAITS = {
    1: { fr: "leader, indépendant, pionnier", en: "leader, independent, pioneer", es: "líder, independiente, pionero", de: "Anführer, unabhängig, Pionier", it: "leader, indipendente, pioniere", nl: "leider, onafhankelijk, pionier" },
    2: { fr: "diplomate, sensible, partenaire", en: "diplomat, sensitive, partner", es: "diplomático, sensible, compañero", de: "Diplomat, sensibel, Partner", it: "diplomatico, sensibile, partner", nl: "diplomaat, gevoelig, partner" },
    3: { fr: "créatif, sociable, expressif", en: "creative, sociable, expressive", es: "creativo, sociable, expresivo", de: "kreativ, gesellig, ausdrucksvoll", it: "creativo, socievole, espressivo", nl: "creatief, sociaal, expressief" },
    4: { fr: "stable, organisé, loyal", en: "stable, organized, loyal", es: "estable, organizado, leal", de: "stabil, organisiert, loyal", it: "stabile, organizzato, leale", nl: "stabiel, georganiseerd, trouw" },
    5: { fr: "aventurier, libre, dynamique", en: "adventurous, free, dynamic", es: "aventurero, libre, dinámico", de: "abenteuerlustig, frei, dynamisch", it: "avventuriero, libero, dinamico", nl: "avontuurlijk, vrij, dynamisch" },
    6: { fr: "protecteur, harmonieux, responsable", en: "protective, harmonious, responsible", es: "protector, armonioso, responsable", de: "beschützend, harmonisch, verantwortungsvoll", it: "protettivo, armonioso, responsabile", nl: "beschermend, harmonieus, verantwoordelijk" },
    7: { fr: "spirituel, analytique, introspectif", en: "spiritual, analytical, introspective", es: "espiritual, analítico, introspectivo", de: "spirituell, analytisch, introspektiv", it: "spirituale, analitico, introspettivo", nl: "spiritueel, analytisch, naar binnen gekeerd" },
    8: { fr: "ambitieux, puissant, déterminé", en: "ambitious, powerful, determined", es: "ambicioso, poderoso, determinado", de: "ehrgeizig, kraftvoll, entschlossen", it: "ambizioso, potente, determinato", nl: "ambitieus, krachtig, vastberaden" },
    9: { fr: "altruiste, sage, universel", en: "altruistic, wise, universal", es: "altruista, sabio, universal", de: "altruistisch, weise, universell", it: "altruista, saggio, universale", nl: "onbaatzuchtig, wijs, universeel" },
    11: { fr: "visionnaire, inspiré, intuitif", en: "visionary, inspired, intuitive", es: "visionario, inspirado, intuitivo", de: "visionär, inspiriert, intuitiv", it: "visionario, ispirato, intuitivo", nl: "visionair, geïnspireerd, intuïtief" },
    22: { fr: "bâtisseur, visionnaire, maître", en: "builder, visionary, master", es: "constructor, visionario, maestro", de: "Erbauer, Visionär, Meister", it: "costruttore, visionario, maestro", nl: "bouwer, visionair, meester" }
  };

  var LANG = '<%= lang %>';

  function getNumeroExplanation(name1, name2, n1, n2, score) {
    var t1 = NUMBER_TRAITS[n1] ? (NUMBER_TRAITS[n1][LANG] || NUMBER_TRAITS[n1].fr) : '';
    var t2 = NUMBER_TRAITS[n2] ? (NUMBER_TRAITS[n2][LANG] || NUMBER_TRAITS[n2].fr) : '';

    var templates = {
      fr: name1 + ' porte le nombre ' + n1 + ' (' + t1 + ') et ' + name2 + ' porte le nombre ' + n2 + ' (' + t2 + '). ',
      en: name1 + ' carries the number ' + n1 + ' (' + t1 + ') and ' + name2 + ' carries the number ' + n2 + ' (' + t2 + '). ',
      es: name1 + ' lleva el número ' + n1 + ' (' + t1 + ') y ' + name2 + ' lleva el número ' + n2 + ' (' + t2 + '). ',
      de: name1 + ' trägt die Zahl ' + n1 + ' (' + t1 + ') und ' + name2 + ' trägt die Zahl ' + n2 + ' (' + t2 + '). ',
      it: name1 + ' porta il numero ' + n1 + ' (' + t1 + ') e ' + name2 + ' porta il numero ' + n2 + ' (' + t2 + '). ',
      nl: name1 + ' heeft het getal ' + n1 + ' (' + t1 + ') en ' + name2 + ' heeft het getal ' + n2 + ' (' + t2 + '). '
    };
    var base = templates[LANG] || templates.fr;

    var high = { fr: 'Ces vibrations se complètent naturellement, créant une belle harmonie entre vos prénoms.', en: 'These vibrations complement each other naturally, creating beautiful harmony between your names.', es: 'Estas vibraciones se complementan naturalmente, creando una hermosa armonía entre vuestros nombres.', de: 'Diese Schwingungen ergänzen sich auf natürliche Weise und schaffen eine schöne Harmonie zwischen euren Namen.', it: 'Queste vibrazioni si completano naturalmente, creando una bella armonia tra i vostri nomi.', nl: 'Die getallen vullen elkaar vanzelf aan: jullie namen passen mooi bij elkaar.' };
    var med = { fr: 'Vos vibrations sont différentes mais peuvent créer une dynamique intéressante si vous apprenez à apprécier vos différences.', en: 'Your vibrations are different but can create an interesting dynamic if you learn to appreciate your differences.', es: 'Vuestras vibraciones son diferentes pero pueden crear una dinámica interesante si aprendéis a apreciar vuestras diferencias.', de: 'Eure Schwingungen sind unterschiedlich, können aber eine interessante Dynamik schaffen, wenn ihr lernt, eure Unterschiede zu schätzen.', it: 'Le vostre vibrazioni sono diverse ma possono creare una dinamica interessante se imparate ad apprezzare le vostre differenze.', nl: 'Jullie getallen verschillen, maar dat kan juist goed uitpakken als jullie die verschillen leren waarderen.' };
    var low = { fr: 'Vos vibrations sont contrastées, ce qui peut créer de la tension mais aussi une forte attirance magnétique. L\'effort de compréhension mutuelle sera la clé.', en: 'Your vibrations are contrasting, which can create tension but also strong magnetic attraction. Mutual understanding will be key.', es: 'Vuestras vibraciones son contrastadas, lo que puede crear tensión pero también una fuerte atracción magnética. La comprensión mutua será la clave.', de: 'Eure Schwingungen sind gegensätzlich, was Spannung aber auch eine starke magnetische Anziehung erzeugen kann. Gegenseitiges Verständnis wird der Schlüssel sein.', it: 'Le vostre vibrazioni sono contrastanti, il che può creare tensione ma anche una forte attrazione magnetica. La comprensione reciproca sarà la chiave.', nl: 'Jullie getallen liggen ver uit elkaar. Dat kan voor spanning zorgen, maar ook voor een sterke aantrekking. Elkaar proberen te begrijpen is hier het belangrijkste.' };

    if (score >= 7) return base + (high[LANG] || high.fr);
    if (score >= 5) return base + (med[LANG] || med.fr);
    return base + (low[LANG] || low.fr);
  }

  // ═══════════════════════════════════════════════════════
  // UI LOGIC
  // ═══════════════════════════════════════════════════════
  // Les prenoms gardes d'un test a l'autre : meme cle et meme forme que
  // prenomsGardes et garderPrenom de quiz-engine-core.js, que cette page ne
  // charge pas. Ceux du test d'avant reviennent ici, ceux tapes ici servent au
  // suivant, pendant 24 heures, dans ce navigateur seulement.
  var PRENOMS = {
    lire: function () {
      try {
        var d = JSON.parse(localStorage.getItem('qc-joueurs') || 'null');
        if (!d || !Array.isArray(d.j) || !(Date.now() - (+d.t || 0) < 864e5)) return [];
        return d.j;
      } catch (e) { return []; }
    },
    remplir: function (champs) {
      var j = PRENOMS.lire();
      champs.forEach(function (champ, i) {
        var p = j[i];
        if (champ && !champ.value && p && typeof p.n === 'string' && p.n) {
          champ.value = p.n.slice(0, champ.maxLength > 0 ? champ.maxLength : 30);
        }
      });
    },
    garder: function (noms) {
      try {
        var j = PRENOMS.lire();
        localStorage.setItem('qc-joueurs', JSON.stringify({ t: Date.now(), j: [0, 1].map(function (i) {
          var p = j[i] || {};
          var n = String(noms[i] || '').trim().slice(0, 30);
          var meme = n.toLowerCase() === String(p.n || '').toLowerCase();
          return { n: n, g: meme && (p.g === 'homme' || p.g === 'femme') ? p.g : null };
        }) }));
      } catch (e) {}
    }
  };

  var form = document.getElementById('astro-form');
  var results = document.getElementById('astro-results');
  var suite = document.getElementById('astro-suite');
  var outil = document.getElementById('astro-tool');
  var submitBtn = document.getElementById('astro-submit');
  var retryBtn = document.getElementById('astro-retry');
  var erreur = document.getElementById('astro-erreur');
  var T = window.__QC_AP || {};
  function champ(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function lettres(nom) {
    return String(nom || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z]/g, '');
  }
  function traits(n) { return NUMBER_TRAITS[n] ? (NUMBER_TRAITS[n][LANG] || NUMBER_TRAITS[n].fr) : ''; }

  // L'anneau et les jauges, dessinés comme ceux des autres outils
  // (date de naissance, signes chinois) : mêmes classes, même style.
  function anneau(pct) {
    var r = 52, c = 2 * Math.PI * r, off = c * (1 - pct / 100);
    return '<svg class="dn-anneau" viewBox="0 0 120 120" role="img" aria-label="' + pct + '%">' +
      '<circle cx="60" cy="60" r="' + r + '" class="dn-anneau-fond"></circle>' +
      '<circle cx="60" cy="60" r="' + r + '" class="dn-anneau-trait" ' +
      'stroke-dasharray="' + c.toFixed(1) + '" stroke-dashoffset="' + off.toFixed(1) + '" style="--c:' + c.toFixed(1) + '"></circle>' +
      '</svg><span class="dn-anneau-valeur"><span data-compte="' + pct + '">' + pct + '</span><small>%</small></span>';
  }
  function barre(note, libelle, valeur) {
    return '<div class="dn-axe">' +
      '<div class="dn-axe-tete"><span class="dn-axe-nom">' + esc(libelle) + '</span>' +
      '<span class="dn-axe-note">' + Math.round(note * 10) + '%</span></div>' +
      '<div class="dn-axe-piste"><span class="dn-axe-jauge" style="width:' + Math.round(note * 10) + '%"></span></div>' +
      '<p class="dn-axe-valeur">' + esc(valeur) + '</p></div>';
  }

  // L'aperçu en direct (18 novembre 2026) : dès qu'un prénom est écrit, son
  // nombre et ce qu'il dit s'affichent sous lui ; le bouton le dit quand les
  // deux prénoms et les deux signes sont là.
  function apercu() {
    if (!window.QCOutil) return;
    var tout = true;
    [1, 2].forEach(function (n) {
      var nom = champ('name' + n).value.trim(), html = '';
      if (lettres(nom)) {
        var k = getNameNumber(nom);
        html = '<span class="outil-puce">🔢 <b>' + k + '</b> ' + esc(traits(k)) + '</span>';
      } else {
        tout = false;
      }
      if (!champ('sign' + n).value) tout = false;
      window.QCOutil.apercu(champ('ap-apercu' + n), html);
    });
    window.QCOutil.pret(outil, tout);
  }
  [1, 2].forEach(function (n) {
    champ('name' + n).addEventListener('input', apercu);
    champ('sign' + n).addEventListener('change', apercu);
  });
  PRENOMS.remplir([champ('name1'), champ('name2')]);
  // Le petit script commun des outils (js/outils.js) est différé : il est là
  // au plus tard quand le document est prêt.
  if (window.QCOutil) apercu();
  else document.addEventListener('DOMContentLoaded', apercu);

  function versLOutil() {
    var haut = outil.getBoundingClientRect().top + window.pageYOffset - 80;
    window.scrollTo({ top: haut, behavior: 'smooth' });
  }

  function calculer() {
    var name1 = champ('name1').value.trim();
    var name2 = champ('name2').value.trim();
    var sign1 = champ('sign1').value;
    var sign2 = champ('sign2').value;

    if (!name1 || !name2 || !sign1 || !sign2) {
      erreur.textContent = T.erreurVide || '';
      erreur.classList.remove('hidden');
      submitBtn.classList.add('animate-shake');
      setTimeout(function () { submitBtn.classList.remove('animate-shake'); }, 500);
      return;
    }
    erreur.classList.add('hidden');

    PRENOMS.garder([name1, name2]);

    // Calculate astro score
    var astroData = ZODIAC_DATA[sign1 + '_' + sign2] || { score: 5, text: '' };
    var astroScore = astroData.score;

    // Calculate numerology score
    var n1 = getNameNumber(name1);
    var n2 = getNameNumber(name2);
    var numeroScore = getNumeroCompat(n1, n2);

    // Overall score (weighted: 60% astro, 40% numero), out of 10
    var overall = Math.round((astroScore * 0.6 + numeroScore * 0.4) * 10) / 10;
    var overallPct = Math.round(overall * 10);

    // La classe quiz-result-card n'est pas décorative : c'est elle que
    // guettent le compteur de parties et le module de notation.
    var html = '<div class="dn-verdict quiz-result-card ap-carte">' +
      '<p class="ap-noms">' + esc(name1) + ' &amp; ' + esc(name2) + '</p>' +
      '<div class="dn-anneau-boite">' + anneau(overallPct) + '</div>' +
      '<h2 class="dn-verdict-titre">' + esc(T.titre || '') + '</h2>' +
      '</div>' +
      '<div class="dn-axes ap-axes">' +
      barre(astroScore, T.astroLabel || '', T.astroScore || '') +
      barre(numeroScore, T.numeroLabel || '', T.numeroScore || '') +
      '</div>' +
      '<section class="dn-bloc"><h3 class="dn-bloc-titre">⭐ ' + esc(T.detailTitle || '') + '</h3><p>' + esc(astroData.text) + '</p></section>' +
      '<section class="dn-bloc"><h3 class="dn-bloc-titre">🔢 ' + esc(T.numeroTitle || '') + '</h3><p>' + esc(getNumeroExplanation(name1, name2, n1, n2, numeroScore)) + '</p></section>';

    results.innerHTML = '<div class="outil-resultat">' + html + '</div>';
    form.classList.add('hidden');
    results.classList.remove('hidden');
    suite.classList.remove('hidden');
    if (window.QCOutil) window.QCOutil.resultat(results.firstChild, results.querySelector('.ap-carte'));

    // Ce test a son propre moteur et ne passe pas par le noyau : on signale
    // nous-mêmes que le résultat est là, pour qu'il prenne son adresse et
    // compte comme une page vue. Fichier absent ? On remonte simplement sur
    // le résultat, comme avant.
    if (window.QCResultat) {
      window.QCResultat.arrivee(results, {
        lang: document.documentElement.lang || 'fr',
        apres: versLOutil
      });
    } else {
      versLOutil();
    }
  }
  submitBtn.addEventListener('click', calculer);
  form.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && e.target && e.target.tagName === 'INPUT') { e.preventDefault(); calculer(); }
  });

  retryBtn.addEventListener('click', function() {
    // Le formulaire revient sur place, sans rechargement : l'adresse
    // annoncerait sinon un résultat devant un formulaire vide.
    if (window.QCResultat) window.QCResultat.retour();
    results.classList.add('hidden');
    suite.classList.add('hidden');
    form.classList.remove('hidden');
    champ('name1').value = '';
    champ('name2').value = '';
    champ('sign1').selectedIndex = 0;
    champ('sign2').selectedIndex = 0;
    apercu();
    versLOutil();
  });

  // ═══════════════════════════════════════════════════════
  // E-BOOK LEAD CAPTURE
  // ═══════════════════════════════════════════════════════
  var ebookForm = document.getElementById('ebook-lead-form');
  if (ebookForm) {
    ebookForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var firstName = document.getElementById('ebook-firstname').value.trim();
      var email = document.getElementById('ebook-email').value.trim();
      var honeypot = document.getElementById('ebook-hp-f');
      var consent = document.getElementById('ebook-consent-cb');
      var statusEl = document.getElementById('ebook-form-status');
      var submitBtn = document.getElementById('ebook-submit-btn');

      // Anti-spam: honeypot field must be empty
      if (honeypot && honeypot.value) return;

      // Validation with visible feedback
      if (!firstName || !email) {
        statusEl.textContent = 'Veuillez remplir votre prénom et votre adresse e-mail.';
        statusEl.style.color = 'hsl(0 84% 60%)';
        statusEl.classList.remove('hidden');
        return;
      }
      if (!consent || !consent.checked) {
        statusEl.textContent = 'Veuillez accepter les conditions pour recevoir l\'e-book.';
        statusEl.style.color = 'hsl(0 84% 60%)';
        statusEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.querySelector('span').textContent = 'Envoi en cours...';
      statusEl.classList.add('hidden');

      var SUPA_URL = '<%= supabaseUrl %>';
      var SUPA_KEY = '<%= supabaseKey %>';

      fetch(SUPA_URL + '/functions/v1/ebook-verify?action=submit', {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + SUPA_KEY,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ first_name: firstName, email: email })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Erreur ' + res.status);
        return res.json();
      })
      .then(function(data) {
        if (data.already_verified) {
          statusEl.textContent = 'Cet e-mail a déjà été vérifié. Vous pouvez télécharger votre e-book depuis le lien envoyé par mail.';
          statusEl.style.color = 'hsl(210 80% 55%)';
        } else {
          statusEl.textContent = 'Un e-mail de vérification vient d\'être envoyé ! Cliquez sur le lien dans le mail pour accéder à votre e-book.';
          statusEl.style.color = 'hsl(142 71% 45%)';
        }
        statusEl.classList.remove('hidden');
        // L'adresse est donnée avec l'accord e-mails : la porte des résultats
        // (capture.js, clé qc-abonne) ne la redemandera pas sur cet appareil.
        try { localStorage.setItem('qc-abonne', JSON.stringify({ at: Date.now(), lang: document.documentElement.lang || 'fr', via: 'ebook' })); } catch (e) { /* navigation privée */ }
        submitBtn.querySelector('span').textContent = 'VÉRIFIEZ VOS E-MAILS !';
        ebookForm.querySelector('#ebook-firstname').disabled = true;
        ebookForm.querySelector('#ebook-email').disabled = true;
      })
      .catch(function() {
        statusEl.textContent = 'Une erreur est survenue. Veuillez réessayer.';
        statusEl.style.color = 'hsl(0 84% 60%)';
        statusEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.querySelector('span').textContent = 'OUI ! JE VEUX MON E-BOOK GRATUIT';
      });
    });
  }
})();
</script>
