<!-- Astro Compatibility Script -->
<script>
(function(){
  // Zodiac compatibility matrix [sign1][sign2] = score/10
  var ASTRO_COMPAT = {
    aries:       {aries:8,taurus:5,gemini:8,cancer:4,leo:9,virgo:4,libra:9,scorpio:6,sagittarius:9,capricorn:5,aquarius:8,pisces:6},
    taurus:      {aries:5,taurus:9,gemini:3,cancer:9,leo:4,virgo:9,libra:5,scorpio:8,sagittarius:3,capricorn:9,aquarius:3,pisces:8},
    gemini:      {aries:8,taurus:3,gemini:8,cancer:4,leo:8,virgo:4,libra:9,scorpio:4,sagittarius:9,capricorn:4,aquarius:9,pisces:4},
    cancer:      {aries:4,taurus:9,gemini:4,cancer:8,leo:3,virgo:8,libra:4,scorpio:9,sagittarius:4,capricorn:9,aquarius:2,pisces:8},
    leo:         {aries:9,taurus:4,gemini:8,cancer:3,leo:8,virgo:4,libra:8,scorpio:4,sagittarius:9,capricorn:3,aquarius:8,pisces:4},
    virgo:       {aries:4,taurus:9,gemini:4,cancer:8,leo:4,virgo:8,libra:4,scorpio:9,sagittarius:4,capricorn:9,aquarius:2,pisces:8},
    libra:       {aries:8,taurus:5,gemini:9,cancer:4,leo:8,virgo:4,libra:8,scorpio:4,sagittarius:7,capricorn:3,aquarius:9,pisces:4},
    scorpio:     {aries:6,taurus:8,gemini:4,cancer:9,leo:4,virgo:9,libra:4,scorpio:8,sagittarius:4,capricorn:8,aquarius:3,pisces:8},
    sagittarius: {aries:9,taurus:3,gemini:9,cancer:4,leo:9,virgo:4,libra:7,scorpio:4,sagittarius:8,capricorn:3,aquarius:8,pisces:3},
    capricorn:   {aries:5,taurus:9,gemini:4,cancer:9,leo:3,virgo:9,libra:3,scorpio:8,sagittarius:3,capricorn:8,aquarius:2,pisces:8},
    aquarius:    {aries:8,taurus:3,gemini:9,cancer:2,leo:8,virgo:2,libra:9,scorpio:3,sagittarius:8,capricorn:2,aquarius:8,pisces:2},
    pisces:      {aries:6,taurus:8,gemini:4,cancer:9,leo:4,virgo:8,libra:4,scorpio:8,sagittarius:3,capricorn:8,aquarius:2,pisces:8}
  };

  // Numerology: letter to number (A=1..I=9,J=1..R=9,S=1..Z=8)
  function letterToNum(ch) {
    var c = ch.toUpperCase().charCodeAt(0);
    if (c < 65 || c > 90) return 0;
    return ((c - 65) % 9) + 1;
  }

  // Reduce to single digit (keep 11, 22 as master numbers)
  function reduceToDigit(n) {
    while (n > 9 && n !== 11 && n !== 22) {
      var s = 0;
      while (n > 0) { s += n % 10; n = Math.floor(n / 10); }
      n = s;
    }
    return n;
  }

  // Calculate name number from full name
  function nameNumber(name) {
    var sum = 0;
    for (var i = 0; i < name.length; i++) {
      sum += letterToNum(name[i]);
    }
    return reduceToDigit(sum);
  }

  // Numerology compatibility between two numbers
  function numCompat(n1, n2) {
    var matrix = {
      1: {1:7,2:6,3:8,4:5,5:7,6:6,7:5,8:7,9:8,11:7,22:6},
      2: {1:6,2:7,3:7,4:8,5:5,6:9,7:4,8:8,9:6,11:9,22:8},
      3: {1:8,2:7,3:7,4:5,5:8,6:8,7:6,8:5,9:9,11:8,22:6},
      4: {1:5,2:8,3:5,4:7,5:4,6:7,7:7,8:9,9:5,11:7,22:9},
      5: {1:7,2:5,3:8,4:4,5:7,6:5,7:8,8:6,9:8,11:6,22:5},
      6: {1:6,2:9,3:8,4:7,5:5,6:8,7:5,8:6,9:9,11:9,22:8},
      7: {1:5,2:4,3:6,4:7,5:8,6:5,7:8,8:5,9:7,11:8,22:7},
      8: {1:7,2:8,3:5,4:9,5:6,6:6,7:5,8:7,9:6,11:7,22:9},
      9: {1:8,2:6,3:9,4:5,5:8,6:9,7:7,8:6,9:8,11:8,22:7},
      11:{1:7,2:9,3:8,4:7,5:6,6:9,7:8,8:7,9:8,11:9,22:9},
      22:{1:6,2:8,3:6,4:9,5:5,6:8,7:7,8:9,9:7,11:9,22:9}
    };
    if (matrix[n1] && matrix[n1][n2] !== undefined) return matrix[n1][n2];
    return 5;
  }

  // Animate score ring
  function animateRing(score) {
    var ring = document.getElementById('astro-score-ring');
    var circumference = 339.292;
    var offset = circumference - (score / 10) * circumference;
    ring.style.transition = 'stroke-dashoffset 1.5s ease-out';
    ring.style.strokeDashoffset = offset;
  }

  // Animate number counting
  function animateNumber(el, target) {
    var current = 0;
    var step = target / 30;
    var interval = setInterval(function() {
      current += step;
      if (current >= target) { current = target; clearInterval(interval); }
      el.textContent = Math.round(current * 10) / 10;
    }, 50);
  }

  var form = document.getElementById('astro-compatibility-form');
  var results = document.getElementById('astro-results');
  var submitBtn = document.getElementById('astro-submit-btn');
  var retryBtn = document.getElementById('astro-retry-btn');

  submitBtn.addEventListener('click', function() {
    var n1 = document.getElementById('name1').value.trim();
    var n2 = document.getElementById('name2').value.trim();
    var s1 = document.getElementById('sign1').value;
    var s2 = document.getElementById('sign2').value;

    if (!n1 || !n2 || !s1 || !s2) return;

    // Calculate scores
    var astroScore = ASTRO_COMPAT[s1] ? ASTRO_COMPAT[s1][s2] || 5 : 5;
    var num1 = nameNumber(n1);
    var num2 = nameNumber(n2);
    var numScore = numCompat(num1, num2);
    var overall = Math.round((astroScore * 0.5 + numScore * 0.5) * 10) / 10;

    // Show results
    form.classList.add('hidden');
    results.classList.remove('hidden');

    // Populate
    document.getElementById('astro-results-names').textContent = n1 + ' & ' + n2;
    document.getElementById('astro-name1-display').textContent = n1;
    document.getElementById('astro-name2-display').textContent = n2;
    document.getElementById('astro-num1').textContent = num1;
    document.getElementById('astro-num2').textContent = num2;

    // Astro explanation from matrix
    var signNames = {};
    var selects = document.getElementById('sign1');
    for (var i = 0; i < selects.options.length; i++) {
      if (selects.options[i].value) signNames[selects.options[i].value] = selects.options[i].textContent.trim();
    }
    document.getElementById('astro-explanation-astro').textContent = (signNames[s1] || s1) + ' × ' + (signNames[s2] || s2);
    document.getElementById('astro-explanation-num').textContent = n1 + ' (' + num1 + ') × ' + n2 + ' (' + num2 + ')';

    // Animate scores
    var outOf = document.querySelector('[id="astro-score-astro"]');
    if (outOf) outOf.textContent = astroScore + '/10';
    var numEl = document.querySelector('[id="astro-score-num"]');
    if (numEl) numEl.textContent = numScore + '/10';

    // Animate overall
    animateRing(overall);
    animateNumber(document.getElementById('astro-score-number'), overall);

    // Scroll to results
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  retryBtn.addEventListener('click', function() {
    results.classList.add('hidden');
    form.classList.remove('hidden');
    // Reset ring
    document.getElementById('astro-score-ring').style.transition = 'none';
    document.getElementById('astro-score-ring').style.strokeDashoffset = '339.292';
    document.getElementById('astro-score-number').textContent = '0';
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
})();
</script>
