<%
  // Le thème astral de couple (23 novembre 2026, Thomas : « une LP ultra
  // design, avec de la 3D, les constellations et tout, genre quand on scroll
  // la page [...] ça anime un truc qui fait apparaître un bouton à la fin de
  // l'animation, si on scroll vers le haut ça rembobine »). Une page de vente
  // en noindex, hors du plan du site, où l'on arrive par la carte sous le
  // résultat du test des signes astrologiques (les prénoms et les signes sont
  // gardés dans le navigateur, qc-astro-couple). La scène (js/astro-scene.js)
  // dessine le ciel en WebGL au fil du défilement ; js/astro.js personnalise
  // la page, calcule le ciel des deux dates de naissance (js/astro-ciel.js,
  // le même calcul que la fonction serveur `astro`), ouvre le paiement et
  // affiche le rapport (js/astro-rapport.js). Textes : {lang}/theme-astral.json.
  // Styles : css/pages/themeAstral.css, mis en ligne par le gabarit de base.
  const T = (typeof translations !== 'undefined' && translations['theme-astral']) || {};
  const P = (chemin, defaut) => chemin.split('.').reduce((o, k) => (o && o[k] !== undefined ? o[k] : undefined), T) ?? defaut;
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const PRIX = 490;
  const prixTexte = (c) => (c / 100).toFixed(2).replace('.', lang === 'en' ? '.' : ',') + (lang === 'en' ? '' : ' ') + '€';
  const astroConfig = {
    lang,
    fonction: supabaseUrl + '/functions/v1/astro',
    cle: supabaseKey,
    prix: PRIX,
    prixRegions: { latam: 199 },
    v: 'EMPREINTE_RESSOURCES',
    textes: T,
    chemins: {
      cgv: getLocalizedPath('cgv', lang),
      test: getLocalizedPath('testAstroPrenoms', lang),
      page: getLocalizedPath('themeAstral', lang),
    },
  };
  const chapitres = P('contenu.chapitres', []);
  const faq = P('faq.items', []);
%>
<div class="as-page" id="as-page" data-lang="<%= lang %>">
  <section class="as-scene" id="as-scene" aria-label="<%= P('scene.aria', '') %>">
    <div class="as-stage">
      <canvas class="as-canvas" aria-hidden="true"></canvas>
      <div class="as-etiquettes" aria-hidden="true"></div>
      <div class="as-voile" aria-hidden="true"></div>
      <div class="as-etapes">
        <div class="as-etape as-etape--intro" data-de="0" data-a="0.095">
          <p class="as-kicker"><%= P('scene.intro.kicker', '') %></p>
          <h1 class="as-titre"><span data-nom="a"><%= P('scene.inconnu.a', '') %></span> <span class="as-et" aria-hidden="true">&amp;</span><span class="as-lecteur">et</span> <span data-nom="b"><%= P('scene.inconnu.b', '') %></span></h1>
          <p class="as-texte"><%= P('scene.intro.texte', '') %></p>
          <p class="as-indice" aria-hidden="true"><span><%= P('scene.intro.indice', '') %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v16M6 14l6 6 6-6"/></svg></p>
        </div>
        <div class="as-etape as-etape--personne est-a" data-de="0.15" data-a="0.31" data-qui="a">
          <p class="as-kicker" data-texte="kicker-a"></p>
          <p class="as-prenom" data-nom="a"><%= P('scene.inconnu.a', '') %></p>
          <p class="as-signe"><span class="as-signe-glyphe" data-glyphe="a"></span><span data-texte="signe-a"></span></p>
          <p class="as-texte" data-texte="ligne-a"></p>
        </div>
        <div class="as-etape as-etape--personne est-b" data-de="0.37" data-a="0.53" data-qui="b">
          <p class="as-kicker" data-texte="kicker-b"></p>
          <p class="as-prenom" data-nom="b"><%= P('scene.inconnu.b', '') %></p>
          <p class="as-signe"><span class="as-signe-glyphe" data-glyphe="b"></span><span data-texte="signe-b"></span></p>
          <p class="as-texte" data-texte="ligne-b"></p>
        </div>
        <div class="as-etape" data-de="0.59" data-a="0.715">
          <p class="as-grand" data-texte="elements-titre"></p>
          <p class="as-texte" data-texte="elements-texte"></p>
        </div>
        <div class="as-etape" data-de="0.745" data-a="0.86">
          <p class="as-grand"><%= P('scene.planetes.titre', '') %></p>
          <p class="as-texte"><%= P('scene.planetes.texte', '') %></p>
        </div>
        <div class="as-etape as-etape--final" data-de="0.885" data-a="1.2">
          <p class="as-grand"><%= P('scene.final.titre', '') %></p>
          <p class="as-texte"><%= P('scene.final.texte', '') %></p>
          <a class="as-bouton as-bouton--final" href="#as-dates" data-vers="as-dates"><%= P('scene.final.bouton', '') %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <p class="as-sous" data-texte="final-sous"><%= P('scene.final.sous', '').replace('{{prix}}', prixTexte(PRIX)) %></p>
        </div>
      </div>
      <a class="as-passer" href="#as-contenu" data-vers="as-contenu"><%= P('scene.passer', '') %></a>
      <div class="as-progression" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="as-section as-contenu" id="as-contenu">
    <p class="as-kicker"><%= P('contenu.kicker', '') %></p>
    <h2 class="as-h2"><%= P('contenu.titre', '') %></h2>
    <ol class="as-chapitres">
      <% chapitres.forEach(function (c, i) { %>
      <li class="as-chapitre">
        <span class="as-chapitre-num"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <h3 class="as-chapitre-titre"><%= c.t %></h3>
          <p class="as-chapitre-texte"><%= c.d %></p>
        </div>
      </li>
      <% }) %>
    </ol>
  </section>

  <section class="as-section as-dates" id="as-dates">
    <p class="as-kicker"><%= P('dates.kicker', '') %></p>
    <h2 class="as-h2"><%= P('dates.titre', '') %></h2>
    <p class="as-intro"><%= P('dates.texte', '') %></p>
    <form class="as-formulaire" id="as-formulaire" novalidate>
      <div class="as-personnes">
        <% ['a', 'b'].forEach(function (qui) { %>
        <fieldset class="as-personne est-<%= qui %>">
          <legend class="as-lecteur"><%= qui === 'a' ? P('dates.prenomA', '') : P('dates.prenomB', '') %></legend>
          <div class="as-ligne">
            <label class="as-champ as-champ--prenom">
              <span class="as-etiquette-champ"><%= qui === 'a' ? P('dates.prenomA', '') : P('dates.prenomB', '') %></span>
              <input type="text" name="prenom-<%= qui %>" maxlength="30" autocomplete="<%= qui === 'a' ? 'given-name' : 'off' %>" required>
            </label>
            <div class="as-genre" role="radiogroup" aria-label="<%= P('dates.erreurs.genre', '') %>">
              <button type="button" class="as-genre-btn" data-genre="f" aria-pressed="false"><%= P('dates.elle', '') %></button>
              <button type="button" class="as-genre-btn" data-genre="m" aria-pressed="false"><%= P('dates.il', '') %></button>
            </div>
          </div>
          <div class="as-date">
            <label class="as-champ"><span class="as-etiquette-champ"><%= P('dates.jour', '') %></span>
              <select name="jour-<%= qui %>" required><option value=""><%= P('dates.jour', '') %></option><% for (let j = 1; j <= 31; j++) { %><option value="<%= j %>"><%= j %></option><% } %></select></label>
            <label class="as-champ as-champ--mois"><span class="as-etiquette-champ"><%= P('dates.mois', '') %></span>
              <select name="mois-<%= qui %>" required><option value=""><%= P('dates.mois', '') %></option><% P('dates.moisNoms', []).forEach(function (m, i) { %><option value="<%= i + 1 %>"><%= m %></option><% }) %></select></label>
            <label class="as-champ"><span class="as-etiquette-champ"><%= P('dates.annee', '') %></span>
              <select name="annee-<%= qui %>" required><option value=""><%= P('dates.annee', '') %></option><% for (let a = 2012; a >= 1930; a--) { %><option value="<%= a %>"><%= a %></option><% } %></select></label>
          </div>
          <label class="as-champ as-champ--heure">
            <span class="as-etiquette-champ"><%= P('dates.heure', '') %> <em><%= P('dates.heureAide', '') %></em></span>
            <input type="time" name="heure-<%= qui %>" step="60">
          </label>
          <p class="as-erreur" data-erreur="<%= qui %>" hidden></p>
        </fieldset>
        <% }) %>
      </div>
      <button type="submit" class="as-bouton"><%= P('dates.bouton', '') %></button>
    </form>
  </section>

  <section class="as-section as-ciel" id="as-ciel" hidden>
    <p class="as-kicker"><%= P('ciel.kicker', '') %></p>
    <h2 class="as-h2"><%= P('ciel.titre', '') %></h2>
    <p class="as-intro"><%= P('ciel.texte', '') %></p>
    <div class="as-roue" id="as-roue"></div>
    <div class="as-placements" id="as-placements"></div>
    <div class="as-profil" id="as-profil"></div>
    <div class="as-verrou" id="as-verrou"></div>
    <button type="button" class="as-lien" id="as-modifier"><%= P('ciel.modifier', '') %></button>
  </section>

  <section class="as-section as-prix" id="as-prix" hidden>
    <div class="as-prix-carte">
      <p class="as-kicker"><%= P('prix.titre', '') %></p>
      <p class="as-prix-montant" id="as-prix-montant"><%= prixTexte(PRIX) %></p>
      <p class="as-prix-pour"><%= P('prix.pourDeux', '') %></p>
      <p class="as-prix-region" id="as-prix-region" hidden><%= P('prix.region', '') %></p>
      <ul class="as-prix-liste">
        <% P('prix.liste', []).forEach(function (l) { %><li><%= l %></li><% }) %>
      </ul>
      <label class="as-case"><input type="checkbox" id="as-majeur"><span><%= P('prix.majeur', '') %></span></label>
      <label class="as-case"><input type="checkbox" id="as-renonciation"><span><%= P('prix.renonciation', '') %></span></label>
      <p class="as-erreur" id="as-erreur-prix" hidden></p>
      <button type="button" class="as-bouton as-bouton--payer" id="as-payer"><span><%= P('prix.bouton', '') %></span> <b id="as-payer-prix"><%= prixTexte(PRIX) %></b></button>
      <p class="as-securise"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><%= P('prix.securise', '') %></p>
      <p class="as-prix-note"><%= P('prix.note', '') %> <a href="<%= astroConfig.chemins.cgv %>"><%= P('prix.cgv', '') %></a></p>
    </div>
  </section>

  <section class="as-section as-faq">
    <h2 class="as-h2"><%= P('faq.titre', '') %></h2>
    <% faq.forEach(function (f) { %>
    <details class="as-faq-item"><summary><%= f.q %></summary><p><%= f.r %></p></details>
    <% }) %>
    <p class="as-credits"><%= P('credits', '') %></p>
  </section>

  <div class="as-rapport" id="as-rapport" hidden></div>
</div>
<script>window.QC_ASTRO = <%- JSON.stringify(astroConfig).replace(/</g, '\\u003c') %>;</script>
<script src="/js/vendor/astronomy.js" defer></script>
<script src="/js/astro-ciel.js" defer></script>
<script src="/js/astro-scene.js" defer></script>
<script src="/js/astro-roue.js" defer></script>
<script src="/js/astro.js" defer></script>
