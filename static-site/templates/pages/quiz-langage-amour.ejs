<script src="/js/quiz-engine-core.js" defer></script>
<script>
// Custom Love Language quiz engine - multi-category scoring
(function() {
  'use strict';

  // Love language keys in order
  var LANGS = ['words', 'acts', 'gifts', 'time', 'touch'];

  // Mapping: which option index (0-4) maps to which language index for each question
  // Uses 5 permutations cycling every 5 questions for perfect balance
  var PERMS = [
    [0,1,2,3,4], // words, acts, gifts, time, touch
    [3,4,0,1,2], // time, touch, words, acts, gifts
    [1,2,3,4,0], // acts, gifts, time, touch, words
    [4,0,1,2,3], // touch, words, acts, time, gifts
    [2,3,4,0,1]  // gifts, time, touch, words, acts
  ];

  // UI labels from template
  var UI = <%- JSON.stringify(ui) %>;
  var LANG_NAMES = <%- JSON.stringify(names) %>;
  var LANG_ICONS = <%- JSON.stringify(langIcons) %>;
  var LANG_COLORS = <%- JSON.stringify(langColors) %>;

  function parseQuestions() {
    var questions = [];
    for (var i = 1; i <= 40; i++) {
      var qText = QuizEngine.tgd('loveLanguage.q' + i, null);
      if (!qText || qText === 'loveLanguage.q' + i) {
        if (questions.length > 0 && i > questions[questions.length - 1].id + 3) break;
        continue;
      }
      var options = [];
      var letters = ['a', 'b', 'c', 'd', 'e'];
      for (var j = 0; j < letters.length; j++) {
        var oText = QuizEngine.tgd('loveLanguage.q' + i + letters[j], null);
        if (oText && oText !== 'loveLanguage.q' + i + letters[j]) {
          options.push({ id: letters[j], text: oText, langIdx: PERMS[(i - 1) % 5][j] });
        }
      }
      if (options.length >= 3) {
        questions.push({ id: i, text: qText, options: options });
      }
    }
    return questions;
  }

  function parseResults() {
    var results = {};
    for (var k = 0; k < LANGS.length; k++) {
      var key = LANGS[k];
      results[key] = {
        title: QuizEngine.tgd('loveLanguage.r_' + key + '_t', LANG_NAMES[key]),
        description: QuizEngine.tgd('loveLanguage.r_' + key + '_d', ''),
        advice: QuizEngine.tgd('loveLanguage.r_' + key + '_a', '')
      };
    }
    return results;
  }

  function init() {
    var container = document.getElementById('love-language-quiz');
    if (!container) return;
    var lang = container.dataset.lang || 'fr';

    QuizEngine.loadTranslations(lang, function() {
      var questions = parseQuestions();
      if (questions.length === 0) {
        container.innerHTML = '<p class="text-center text-muted-foreground py-8">Loading...</p>';
        return;
      }
      var results = parseResults();
      new LoveLanguageTest(container, questions, results);
    });
  }

  function LoveLanguageTest(container, questions, results) {
    this.container = container;
    this.questions = questions;
    this.results = results;
    this.scores = { words: 0, acts: 0, gifts: 0, time: 0, touch: 0 };
    this.currentQ = 0;
    this.phase = 'intro';
    this.render();
  }

  LoveLanguageTest.prototype.render = function() {
    if (this.phase === 'intro') this.renderIntro();
    else if (this.phase === 'playing') this.renderQuestion();
    else if (this.phase === 'results') this.renderResults();
  };

  LoveLanguageTest.prototype.renderIntro = function() {
    var self = this;
    var html = '<div class="glass-card rounded-xl p-6 text-center">';
    html += '<div class="text-5xl mb-4">💕</div>';
    html += '<h2 class="text-2xl font-bold mb-3">' + UI.yourProfile + '</h2>';
    html += '<p class="text-muted-foreground mb-2">' + this.questions.length + ' questions</p>';
    html += '<p class="text-sm text-muted-foreground mb-6">~5 min</p>';
    html += '<button type="button" class="btn btn-cta" id="ll-start">' + UI.start + '</button>';
    html += '</div>';
    this.container.innerHTML = html;
    document.getElementById('ll-start').addEventListener('click', function() {
      self.phase = 'playing';
      self.render();
    });
  };

  LoveLanguageTest.prototype.renderQuestion = function() {
    var self = this;
    var q = this.questions[this.currentQ];
    var progress = Math.round(((this.currentQ) / this.questions.length) * 100);

    var html = '<div class="glass-card rounded-xl p-6">';
    // Progress bar
    html += '<div class="mb-6">';
    html += '<div class="flex justify-between text-sm text-muted-foreground mb-2">';
    html += '<span>' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.questions.length + '</span>';
    html += '<span>' + progress + '%</span>';
    html += '</div>';
    html += '<div class="w-full bg-muted rounded-full h-2">';
    html += '<div class="bg-primary h-2 rounded-full transition-all duration-300" style="width:' + progress + '%"></div>';
    html += '</div></div>';
    // Question
    html += '<h3 class="text-lg font-semibold mb-6 text-foreground">' + q.text + '</h3>';
    // Options
    html += '<div class="space-y-3">';
    for (var i = 0; i < q.options.length; i++) {
      var opt = q.options[i];
      html += '<button type="button" class="ll-option w-full text-left p-4 rounded-lg border border-border bg-card hover:border-primary hover:bg-primary/5 transition-all cursor-pointer" data-idx="' + i + '">';
      html += '<span class="text-muted-foreground">' + opt.text + '</span>';
      html += '</button>';
    }
    html += '</div></div>';

    this.container.innerHTML = html;

    // Bind click events
    var buttons = this.container.querySelectorAll('.ll-option');
    for (var b = 0; b < buttons.length; b++) {
      buttons[b].addEventListener('click', function() {
        var idx = parseInt(this.getAttribute('data-idx'));
        self.selectOption(idx);
      });
    }
  };

  LoveLanguageTest.prototype.selectOption = function(optIdx) {
    var q = this.questions[this.currentQ];
    var opt = q.options[optIdx];
    // Add score for the corresponding language
    var langKey = LANGS[opt.langIdx];
    this.scores[langKey]++;

    // Visual feedback
    var buttons = this.container.querySelectorAll('.ll-option');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].style.pointerEvents = 'none';
      if (i === optIdx) {
        buttons[i].classList.add('border-primary', 'bg-primary/10');
        buttons[i].classList.remove('border-border');
      } else {
        buttons[i].style.opacity = '0.5';
      }
    }

    var self = this;
    setTimeout(function() {
      self.currentQ++;
      if (self.currentQ >= self.questions.length) {
        self.phase = 'results';
      }
      self.render();
    }, 400);
  };

  LoveLanguageTest.prototype.renderResults = function() {
    var self = this;
    var total = this.questions.length;

    // Sort languages by score (descending)
    var sorted = LANGS.slice().sort(function(a, b) { return self.scores[b] - self.scores[a]; });
    var dominant = sorted[0];
    var secondary = sorted[1];
    var dominantResult = this.results[dominant];
    var secondaryResult = this.results[secondary];
    var dominantPct = Math.round((this.scores[dominant] / total) * 100);

    var html = '<div class="glass-card rounded-xl p-6">';

    // Dominant language hero
    html += '<div class="text-center mb-8">';
    html += '<div class="text-5xl mb-3">' + LANG_ICONS[dominant] + '</div>';
    html += '<p class="text-sm text-muted-foreground mb-2">' + UI.dominant + '</p>';
    html += '<h2 class="text-2xl md:text-3xl font-bold mb-2" style="color:' + LANG_COLORS[dominant] + '">' + LANG_NAMES[dominant] + '</h2>';
    html += '<p class="text-3xl font-bold text-primary">' + dominantPct + '%</p>';
    html += '</div>';

    // Bar chart for all 5 languages
    html += '<div class="mb-8">';
    html += '<h3 class="text-lg font-semibold mb-4">' + UI.allLangs + '</h3>';
    for (var i = 0; i < sorted.length; i++) {
      var key = sorted[i];
      var pct = total > 0 ? Math.round((this.scores[key] / total) * 100) : 0;
      var barWidth = pct > 0 ? Math.max(pct, 5) : 2;
      html += '<div class="mb-3">';
      html += '<div class="flex justify-between items-center mb-1">';
      html += '<span class="text-sm font-medium flex items-center gap-2">' + LANG_ICONS[key] + ' ' + LANG_NAMES[key] + '</span>';
      html += '<span class="text-sm font-bold" style="color:' + LANG_COLORS[key] + '">' + pct + '% (' + this.scores[key] + '/' + total + ')</span>';
      html += '</div>';
      html += '<div class="w-full bg-muted rounded-full h-3">';
      html += '<div class="h-3 rounded-full transition-all duration-700" style="width:' + barWidth + '%;background:' + LANG_COLORS[key] + '"></div>';
      html += '</div></div>';
    }
    html += '</div>';

    // Dominant language description
    html += '<div class="bg-card border-2 rounded-lg p-6 mb-6" style="border-color:' + LANG_COLORS[dominant] + '">';
    html += '<h3 class="text-xl font-bold mb-3" style="color:' + LANG_COLORS[dominant] + '">' + LANG_ICONS[dominant] + ' ' + dominantResult.title + '</h3>';
    html += '<p class="text-muted-foreground leading-relaxed mb-4">' + dominantResult.description + '</p>';
    if (dominantResult.advice) {
      html += '<div class="bg-primary/5 rounded-lg p-4">';
      html += '<p class="text-sm font-semibold text-primary mb-1">' + UI.advice + '</p>';
      html += '<p class="text-sm text-muted-foreground">' + dominantResult.advice + '</p>';
      html += '</div>';
    }
    html += '</div>';

    // Secondary language
    if (this.scores[secondary] > 0) {
      html += '<div class="bg-card border border-border rounded-lg p-5 mb-6">';
      html += '<p class="text-sm text-muted-foreground mb-1">' + UI.secondary + '</p>';
      html += '<h3 class="text-lg font-semibold mb-2" style="color:' + LANG_COLORS[secondary] + '">' + LANG_ICONS[secondary] + ' ' + LANG_NAMES[secondary] + '</h3>';
      html += '<p class="text-sm text-muted-foreground">' + secondaryResult.description + '</p>';
      html += '</div>';
    }

    // Actions
    html += '<div class="flex flex-col sm:flex-row gap-3 mt-6">';
    html += '<button type="button" class="btn btn-outline flex-1" id="ll-retake">' + UI.retake + '</button>';
    html += '</div>';

    html += '</div>';
    this.container.innerHTML = html;

    // Retake button
    document.getElementById('ll-retake').addEventListener('click', function() {
      self.scores = { words: 0, acts: 0, gifts: 0, time: 0, touch: 0 };
      self.currentQ = 0;
      self.phase = 'intro';
      self.render();
      self.container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Smooth scroll to results
    this.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
