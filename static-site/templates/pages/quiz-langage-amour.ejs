<%
  const quizKey = 'testLangageAmour';
  const ns = 'quiz-langage-amour';
  const quizTitle = t('quizzes:testLangageAmour.title', 'Test des 5 Langages de l\'Amour');
  const quizDesc = t('quizzes:testLangageAmour.metaDescription', '');

  // Build hasPart with actual quiz questions from loveLanguage prefix
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= 30; qi++) {
    const qText = tgd('loveLanguage.q' + qi, '');
    if (!qText || qText === 'loveLanguage.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local ? tgd.local('loveLanguage.q' + qi + optLetters[oi], '') : tgd('loveLanguage.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'loveLanguage.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "datePublished": "2026-03-10", "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": "5 love languages" },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 30 },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [1,2,3,4].map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':jsonLd.faq' + i + 'Q', ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':jsonLd.faq' + i + 'A', '') }
        };
      })
    },
    {
      "@context": "https://schema.org", "@type": "WebPage",
      "name": quizTitle, "description": quizDesc, "url": canonical, "inLanguage": lang,
      "isPartOf": { "@type": "WebSite", "name": "Quiz Couple", "url": baseUrl },
      "datePublished": "2026-03-10", "dateModified": "2026-03-10",
      "publisher": { "@type": "Organization", "name": "Quiz Couple", "url": baseUrl }
    }
  ];

  // Translated UI labels
  const uiLabels = {
    fr: { start: 'Commencer le test', qOf: 'sur', next: 'Suivant', yourProfile: 'Votre profil amoureux', dominant: 'Votre langage dominant', secondary: 'Langage secondaire', allLangs: 'Votre profil complet', advice: 'Conseil', retake: 'Refaire le test', share: 'Partager mon résultat' },
    en: { start: 'Start the test', qOf: 'of', next: 'Next', yourProfile: 'Your love profile', dominant: 'Your dominant language', secondary: 'Secondary language', allLangs: 'Your full profile', advice: 'Advice', retake: 'Retake the test', share: 'Share my result' },
    es: { start: 'Comenzar el test', qOf: 'de', next: 'Siguiente', yourProfile: 'Tu perfil amoroso', dominant: 'Tu lenguaje dominante', secondary: 'Lenguaje secundario', allLangs: 'Tu perfil completo', advice: 'Consejo', retake: 'Repetir el test', share: 'Compartir mi resultado' },
    de: { start: 'Test starten', qOf: 'von', next: 'Weiter', yourProfile: 'Dein Liebesprofil', dominant: 'Deine dominante Sprache', secondary: 'Zweitsprache', allLangs: 'Dein vollständiges Profil', advice: 'Ratschlag', retake: 'Test wiederholen', share: 'Mein Ergebnis teilen' },
    it: { start: 'Inizia il test', qOf: 'di', next: 'Avanti', yourProfile: 'Il tuo profilo amoroso', dominant: 'Il tuo linguaggio dominante', secondary: 'Linguaggio secondario', allLangs: 'Il tuo profilo completo', advice: 'Consiglio', retake: 'Ripeti il test', share: 'Condividi il mio risultato' }
  };
  const ui = uiLabels[lang] || uiLabels.fr;

  // Language names per locale
  const langNames = {
    fr: { words: 'Paroles valorisantes', acts: 'Services rendus', gifts: 'Cadeaux', time: 'Moments de qualité', touch: 'Toucher physique' },
    en: { words: 'Words of Affirmation', acts: 'Acts of Service', gifts: 'Receiving Gifts', time: 'Quality Time', touch: 'Physical Touch' },
    es: { words: 'Palabras de afirmación', acts: 'Actos de servicio', gifts: 'Regalos', time: 'Tiempo de calidad', touch: 'Contacto físico' },
    de: { words: 'Worte der Bestätigung', acts: 'Hilfsbereitschaft', gifts: 'Geschenke', time: 'Zweisamkeit', touch: 'Körperliche Nähe' },
    it: { words: 'Parole di affermazione', acts: 'Atti di servizio', gifts: 'Regali', time: 'Tempo di qualità', touch: 'Contatto fisico' }
  };
  const names = langNames[lang] || langNames.fr;

  // Icons for each language
  const langIcons = { words: '💬', acts: '🤝', gifts: '🎁', time: '⏰', touch: '🫶' };
  const langColors = { words: '#6366f1', acts: '#10b981', gifts: '#f59e0b', time: '#3b82f6', touch: '#ec4899' };
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

