<%
  const quizKey = 'testLangageAmour';
  const ns = 'quiz-langage-amour';
  const quizTitle = t('quizzes:testLangageAmour.title', 'Test des 5 Langages de l\'Amour');
  const quizDesc = t('quizzes:testLangageAmour.metaDescription', '');

  // Build hasPart with actual quiz questions from loveLanguage prefix
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= 30; qi++) {
    const qText = tgd('loveLanguage.q' + qi, '');
    if (!qText || qText === 'loveLanguage.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local ? tgd.local('loveLanguage.q' + qi + optLetters[oi], '') : tgd('loveLanguage.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'loveLanguage.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "datePublished": "2026-03-10", "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', '5 love languages') },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 30 },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [1,2,3,4].map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':jsonLd.faq' + i + 'Q', ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':jsonLd.faq' + i + 'A', '') }
        };
      })
    },
    {
      "@context": "https://schema.org", "@type": "WebPage",
      "name": quizTitle, "description": quizDesc, "url": canonical, "inLanguage": lang,
      "isPartOf": { "@type": "WebSite", "name": "Quiz Couple", "url": baseUrl },
      "datePublished": "2026-03-10", "dateModified": "2026-03-10",
      "publisher": { "@type": "Organization", "name": "Quiz Couple", "url": baseUrl }
    }
  ];

%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <%- include('../partials/quiz-saut-mobile', { ns, t }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <%# Le fil d'Ariane prend le nom court : le title complet porte des
              arguments de recherche (gratuit, sans inscription) qui n'ont
              rien à faire dans un chemin de navigation. %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:testLangageAmour.shortTitle', quizTitle) %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Intro -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="space-y-4 text-muted-foreground leading-relaxed text-center">
      <p><%- t(ns + ':intro.p1', '') %></p>
      <p><%- t(ns + ':intro.p2', '') %></p>
    </div>
  </div>
</section>

<!-- Quiz Engine -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl mx-auto">
      <div id="quiz-engine" data-quiz="langage-amour" data-lang="<%= lang %>"><%- include('../partials/quiz-loading', { lang, routeKey }) %></div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- SEO Article -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <!-- Section 1: What are the 5 love languages -->
    <%# La définition courte ouvre la section : quarante mots qui répondent
        à la question posée par le H2, avant tout développement. C'est ce
        format que les moteurs reprennent en encadré. %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <% const defTexte = t(ns + ':definition.texte', ''); if (defTexte) { %>
      <div class="la-definition">
        <p class="la-definition-titre"><%= t(ns + ':definition.titre', '') %></p>
        <p class="la-definition-texte"><%- defTexte %></p>
      </div>
      <% } %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section1.p1', '') %></p>
        <p><%- t(ns + ':section1.p2', '') %></p>
        <p><%- t(ns + ':section1.p3', '') %></p>
      </div>

      <%# Tableau comparatif : ce que chaque langage attend et ce qui le
          blesse, côte à côte. Format directement repris en position zéro,
          et de loin le bloc le plus consulté d'une page comme celle-ci. %>
      <% const tabEntete = t(ns + ':tableau.entete', null); if (Array.isArray(tabEntete)) { %>
      <figure class="mt-10">
        <figcaption class="text-lg font-semibold mb-3"><%= t(ns + ':tableau.titre', '') %></figcaption>
        <div class="quiz-table-wrap">
          <table class="quiz-table">
            <thead><tr><% tabEntete.forEach(function (h) { %><th><%= h %></th><% }); %></tr></thead>
            <tbody>
              <% (t(ns + ':tableau.lignes', []) || []).forEach(function (l) { %>
              <tr><% l.forEach(function (c, ci) { %><td<%= ci === 0 ? ' class="font-semibold"' : '' %>><%= c %></td><% }); %></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-muted-foreground mt-3"><%- t(ns + ':tableau.note', '') %></p>
      </figure>
      <% } %>
    </section>

    <%# Statistiques réelles : la seule chose que cette page peut dire et
        qu'aucun concurrent ne publie. Le bloc reste masqué tant que
        l'échantillon est trop mince pour qu'un pourcentage ait un sens. %>
    <% const statsTitre = t(ns + ':stats.titre', ''); if (statsTitre) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= statsTitre %></h2>
      <div id="la-stats"
           class="la-stats"
           hidden
           data-quiz-slug="<%= quizKey %>"
           data-supabase-url="<%= supabaseUrl %>"
           data-supabase-key="<%= supabaseKey %>"
           data-libelles="<%- escapeHtml(JSON.stringify(t(ns + ':stats.labels', {}) || {})) %>"
           data-textes="<%- escapeHtml(JSON.stringify({ intro: t(ns + ':stats.intro', ''), note: t(ns + ':stats.note', '') })) %>"></div>
      <%# Visible tant que l'échantillon est trop mince ; le script la retire
          dès qu'il a de vrais chiffres à mettre à la place. %>
      <p class="text-muted-foreground leading-relaxed" id="la-stats-attente"><%= t(ns + ':stats.attente', '') %></p>
    </section>
    <% } %>

    <!-- Section 2: The 5 languages explained -->
    <%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: (typeof quizTitle !== 'undefined' ? quizTitle : (typeof rawTitle !== 'undefined' ? rawTitle : '')) }) %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section2.intro', '') %></p>
      <div class="space-y-6">
        <% for (let i = 1; i <= 5; i++) { %>
        <div class="bg-card border border-border rounded-lg p-6">
          <h3 class="text-xl font-semibold mb-3 text-primary"><%= t(ns + ':section2.lang' + i + 'Title', '') %></h3>
          <p class="text-muted-foreground mb-3"><%- t(ns + ':section2.lang' + i + 'Text', '') %></p>
          <p class="text-sm text-muted-foreground/80 italic"><%- t(ns + ':section2.lang' + i + 'Examples', '') %></p>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Section 3: Why knowing your love language changes everything -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section3.p1', '') %></p>
        <p><%- t(ns + ':section3.p2', '') %></p>
        <p><%- t(ns + ':section3.p3', '') %></p>
        <blockquote class="border-l-4 border-primary pl-6 py-2 bg-muted/30 rounded-r-lg my-6">
          <p class="text-lg italic"><%- t(ns + ':section3.quote', '') %></p>
        </blockquote>
      </div>
    </section>

    <!-- Section 4: How to interpret results -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-8">
        <p><%- t(ns + ':section4.p1', '') %></p>
        <p><%- t(ns + ':section4.p2', '') %></p>
      </div>
      <div class="space-y-6">
        <% for (let i = 1; i <= 3; i++) { %>
        <div class="bg-card border border-border rounded-lg p-6">
          <h3 class="text-xl font-semibold mb-3 text-primary"><%= t(ns + ':section4.tip' + i + 'Title', '') %></h3>
          <p class="text-muted-foreground"><%- t(ns + ':section4.tip' + i + 'Text', '') %></p>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Section 5: When languages are different -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section5.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section5.intro', '') %></p>
      <div class="space-y-6">
        <% for (let i = 1; i <= 4; i++) { %>
        <div class="flex items-start gap-4 p-4 bg-card border border-border rounded-lg">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-primary/20 text-primary font-bold flex-shrink-0"><%= i %></span>
          <div>
            <h3 class="text-lg font-semibold mb-2"><%= t(ns + ':section5.step' + i + 'Title', '') %></h3>
            <p class="text-muted-foreground"><%- t(ns + ':section5.step' + i + 'Text', '') %></p>
          </div>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Section 6: Integrating love languages daily -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section6.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-8">
        <p><%- t(ns + ':section6.p1', '') %></p>
        <p><%- t(ns + ':section6.p2', '') %></p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% for (let i = 1; i <= 4; i++) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2"><%= t(ns + ':section6.idea' + i + 'Title', '') %></h3>
          <p class="text-sm text-muted-foreground"><%- t(ns + ':section6.idea' + i + 'Text', '') %></p>
        </div>
        <% } %>
      </div>
    </section>

    <!-- Section 7: Is this test reliable -->
    <section class="mb-16 bg-gradient-to-br from-primary/10 to-secondary/10 rounded-lg p-8 border border-primary/20">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t(ns + ':section7.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section7.p1', '') %></p>
        <p><%- t(ns + ':section7.p2', '') %></p>
        <p class="text-foreground font-semibold"><%- t(ns + ':section7.p3', '') %></p>
      </div>
    </section>

    <!-- Section 8: ce qu'on se demande après le test -->
    <% const s8Title = t(ns + ':section8.title', ''); if (s8Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s8Title %></h2>
      <div class="space-y-4">
        <% for (let si = 1; si <= 4; si++) {
          const sTitle = t(ns + ':section8.sub' + si + 'Title', '');
          if (!sTitle) continue;
          const sText = t(ns + ':section8.sub' + si + 'Text', ''); %>
        <div class="bg-card border border-border rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= sTitle %></h3>
          <% if (sText) { %><p class="text-muted-foreground leading-relaxed"><%- sText %></p><% } %>
        </div>
        <% } %>
      </div>
      <% const s8Outro = t(ns + ':section8.outro', ''); if (s8Outro) { %>
      <p class="text-muted-foreground leading-relaxed mt-6"><%- s8Outro %></p>
      <% } %>
    </section>
    <% } %>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
<script src="/js/langage-amour-stats.js" defer></script>
