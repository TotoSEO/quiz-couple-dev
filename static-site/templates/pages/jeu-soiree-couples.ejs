<%
  // Le jeu de soirée pour couples (27 octobre 2026, Thomas : « Le jeu à
  // plusieurs couples de Quiz Couple ! Multijoueur jusqu'à 10 personnes »).
  // Un maître du jeu crée la partie, les autres rejoignent avec un code, et
  // chaque couple joue depuis son téléphone (js/soiree.js, Supabase
  // Realtime, aucune table). Comme les autres jeux, le moteur passe avant
  // l'article ; les textes de l'application et les deux banques de
  // questions sont écrits dans la page (window.__QC_SOIREE), dans la langue
  // de la page.
  const ns = 'jeu-soiree-couples';
  const pageTitle = t('quizzes:jeuSoireeCouples.title', 'Jeu de soirée pour couples');

  // Les liens d'une section : {{routeKey}} devient l'adresse de la page.
  const avecLiens = function(texte) {
    return String(texte || '').replace(/\{\{([a-zA-Z]+)\}\}/g, function(_, cle) { return getLocalizedUrl(cle, lang) || '#'; });
  };
  // Les tests à deux proposés à un couple seul (dans l'application).
  const liensSeul = ['testCouple', 'testCommonPoints', 'jeuQuiDeNous', 'jeuxCouple'].map(function(cle) {
    return { url: getLocalizedUrl(cle, lang), texte: t('common:nav.' + cle, t('quizzes:' + cle + '.shortTitle', cle)) };
  }).filter(function(l) { return l.url; });

  const config = {
    lang: lang,
    t: t(ns + ':app', {}),
    questions: t(ns + ':questions', []),
    speciales: t(ns + ':speciales', []),
    liens: liensSeul
  };
  const configJson = JSON.stringify(config).replace(/<\//g, '<\\/');

  const etapes = (function() { const e = t(ns + ':section2.etapes', ''); return Array.isArray(e) ? e : []; })();
  const exemples = (function() { const e = t(ns + ':section3.exemples', ''); return Array.isArray(e) ? e : []; })();
  const faqNums = [1, 2, 3, 4, 5, 6];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Game",
      "name": t(ns + ':jsonLd.name', pageTitle),
      "description": t('quizzes:jeuSoireeCouples.metaDescription', ''),
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "gamePlatform": "Web browser",
      "numberOfPlayers": { "@type": "QuantitativeValue", "minValue": 4, "maxValue": 10 }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% if (getLocalizedUrl('jeuxCouple', lang)) { %>
          <li><a href="<%= getLocalizedUrl('jeuxCouple', lang) %>"><%= t('quizzes:jeuxCouple.shortTitle', 'Jeux de couple') %></a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% } %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:jeuSoireeCouples.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l5-14 9 9z"/><path d="M14 6l1-2"/><path d="M18 10l2-1"/><path d="M17 5l3-3"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- escapeHtml(heroTitle).replace(escapeHtml(heroHighlight), '<span class="text-gradient">' + escapeHtml(heroHighlight) + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
  <%# L'image de tete vient en dernier dans le code : sur mobile, elle s'affiche sous le texte (order: 99) et sur grand ecran elle est posee en absolu. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
</section>

<!-- Le jeu -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="soiree-app" class="quiz-engine soiree" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- avecLiens(t(ns + ':section1.p1', '')) %></p>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- avecLiens(t(ns + ':section1.p2', '')) %></p>
      <p class="text-muted-foreground leading-relaxed"><%- avecLiens(t(ns + ':section1.p3', '')) %></p>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section2.intro', '') %></p>
      <ol class="soiree-etapes">
        <% etapes.forEach(function(e, i) { %>
        <li class="soiree-etape">
          <span class="soiree-etape-num" aria-hidden="true"><%= i + 1 %></span>
          <div>
            <h3 class="font-semibold mb-1"><%= e.titre %></h3>
            <p class="text-muted-foreground"><%- e.texte %></p>
          </div>
        </li>
        <% }) %>
      </ol>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section2.apres', '') %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <h3 class="text-xl font-semibold mb-3"><%= t(ns + ':section3.accordTitre', '') %></h3>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section3.accordTexte', '') %></p>
      <h3 class="text-xl font-semibold mb-3"><%= t(ns + ':section3.specialeTitre', '') %></h3>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- t(ns + ':section3.specialeTexte', '') %></p>
      <ul class="soiree-exemples">
        <% exemples.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
      <p class="text-muted-foreground leading-relaxed mt-6"><%- t(ns + ':section3.apres', '') %></p>
    </section>

    <section class="mb-16 soiree-seul-section">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':seul.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed"><%- avecLiens(t(ns + ':seul.texte', '')) %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- avecLiens(t(ns + ':section4.p1', '')) %></p>
        <p><%- avecLiens(t(ns + ':section4.p2', '')) %></p>
        <p><%- avecLiens(t(ns + ':section4.p3', '')) %></p>
      </div>
    </section>

    <section class="mb-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= t(ns + ':faq.q' + i, '') %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<script>window.__QC_SOIREE=<%- configJson %>;</script>
<script src="/js/mascottes.js" defer></script>
<script src="/js/soiree.js" defer></script>
