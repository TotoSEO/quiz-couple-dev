<section class="container mx-auto px-4 py-12 md:py-16">
  <article class="max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-8"><%= t('legal:mentions.title', 'Mentions Légales') %></h1>
    <p class="text-muted-foreground mb-8"><%= t('legal:mentions.intro', '') %></p>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s1Title', '') %></h2>
      <div class="bg-card rounded-lg p-6 border border-border">
        <ul class="list-none space-y-2 text-foreground">
          <%# L'éditeur est une entreprise : son nom (« Thomas Owaller EI », nom commercial), son statut, son SIRET et son adresse viennent de VENDEUR (config.js). %>
          <% const _v = (typeof vendeur !== 'undefined' && vendeur && vendeur.siret) ? vendeur : null; %>
          <li><strong><%= t('legal:mentions.s1Name', '') %></strong> <%= _v ? (_v.dirigeant ? _v.dirigeant + ' EI · ' : '') + _v.nom : t('legal:mentions.s1NameValue', '') %></li>
          <li><strong><%= t('legal:mentions.s1Status', '') %></strong> <%= _v ? (_v.statut[lang] || _v.statut.fr) : t('legal:mentions.s1StatusValue', '') %></li>
          <% if (_v) { %><li><strong><%= t('cgv:vendeur.siret', lang === 'fr' ? 'SIRET :' : 'SIRET:') %></strong> <%= _v.siret %></li><% } %>
          <% if (_v && _v.adresse) { %><li><strong><%= t('cgv:vendeur.adresse', lang === 'fr' ? 'Adresse :' : 'Address:') %></strong> <%= _v.adresse %></li><% } %>
          <%# Le numéro de téléphone (LCEN, art. 6-III, et L221-5 du Code de la consommation) : affiché dès que VENDEUR.telephone est rempli. %>
          <% if (_v && _v.telephone) { %><li><strong><%= t('cgv:vendeur.telephone', lang === 'fr' ? 'Téléphone :' : 'Phone:') %></strong> <a href="tel:<%= _v.telephone.replace(/[^+\d]/g, '') %>" class="text-primary hover:underline"><%= _v.telephone %></a></li><% } %>
          <li><strong><%= t('legal:mentions.s1Email', '') %></strong> <a href="mailto:infoquizcouple@gmail.com" class="text-primary hover:underline">infoquizcouple@gmail.com</a></li>
          <li><strong><%= t('legal:mentions.s1Website', '') %></strong> quiz-couple.com</li>
        </ul>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s2Title', '') %></h2>
      <p class="text-foreground"><%- t('legal:mentions.s2Text', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s3Title', '') %></h2>
      <div class="bg-card rounded-lg p-6 border border-border">
        <ul class="list-none space-y-2 text-foreground">
          <li><strong><%= t('legal:mentions.s3Company', '') %></strong> <%= t('legal:mentions.s3CompanyValue', '') %></li>
          <li><strong><%= t('legal:mentions.s3Address', '') %></strong> <%= t('legal:mentions.s3AddressValue', '') %></li>
          <li><strong><%= t('legal:mentions.s3Website', '') %></strong> <%= t('legal:mentions.s3WebsiteValue', 'github.com') %></li>
        </ul>
      </div>
      <p class="text-foreground mt-4"><strong><%= t('legal:mentions.s3HostingLabel', '') %></strong> <%= t('legal:mentions.s3HostingText', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s4Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s4P1', '') %></p>
      <p class="text-foreground"><%= t('legal:mentions.s4P2', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s5Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s5Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:mentions.s5Item1Label', '') %></strong> <%= t('legal:mentions.s5Item1Text', '') %></li>
        <li><strong><%= t('legal:mentions.s5Item2Label', '') %></strong> <%= t('legal:mentions.s5Item2Text', '') %></li>
        <li><strong><%= t('legal:mentions.s5Item3Label', '') %></strong> <%= t('legal:mentions.s5Item3Text', '') %></li>
        <li><strong><%= t('legal:mentions.s5Item4Label', '') %></strong> <%= t('legal:mentions.s5Item4Text', '') %></li>
        <li><strong><%= t('legal:mentions.s5Item5Label', '') %></strong> <%= t('legal:mentions.s5Item5Text', '') %></li>
      </ul>
      <div class="bg-primary/10 rounded-lg p-4 border border-primary/20">
        <p class="text-foreground text-sm"><%= t('legal:mentions.s5Warning', '') %></p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s6Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s6P1', '') %></p>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s6P2', '') %></p>
      <p class="text-foreground"><%= t('legal:mentions.s6P3', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s7Title', '') %></h2>
      <p class="text-foreground"><%= t('legal:mentions.s7Text', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s8Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s8P1', '') %></p>
      <p class="text-foreground mb-4"><%= t('legal:mentions.s8P2', '') %></p>
      <p class="text-foreground"><%= t('legal:mentions.s8P3', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s9Title', '') %></h2>
      <p class="text-foreground"><%= t('legal:mentions.s9Text', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:mentions.s10Title', '') %></h2>
      <p class="text-foreground"><%= t('legal:mentions.s10Text', '') %><a href="<%= getLocalizedUrl('contact', lang) %>" class="text-primary hover:underline"><%= t('legal:mentions.s10Lien', 'contact') %></a><%= t('legal:mentions.s10Fin', '.') %></p>
    </section>

    <p class="text-sm text-muted-foreground mt-12 pt-6 border-t border-border"><%= t('legal:mentions.lastUpdated', '') %></p>
  </article>
</section>
