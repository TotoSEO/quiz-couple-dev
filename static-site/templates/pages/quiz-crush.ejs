<%
  // Test amour ou crush. Public 13-18 ans : le contenu tutoie, comme le
  // moteur. Le balisage Quiz reprend la série crushH, celle où le crush est
  // un garçon : c'est la perspective la plus recherchée (« son crush » vu
  // par une fille), et une seule série suffit à un robot.
  const ns = 'quiz-crush';
  const pageTitle = t('quizzes:testCrush.title', 'Amour ou en Crush ?');

  const tableauLignes = [1, 2, 3, 4, 5, 6];
  const faqNums = [1, 2, 3, 4, 5, 6, 7];

  const hasPart = [];
  const lettres = ['a', 'b', 'c', 'd'];
  for (let qi = 1; qi <= 35; qi++) {
    const cle = 'crushH.q' + qi;
    const qText = tgd(cle, '');
    if (!qText || qText === cle) break;
    const question = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const reponses = [];
    for (let oi = 0; oi < lettres.length; oi++) {
      const cleOpt = cle + lettres[oi];
      const oText = tgd.local(cleOpt, '');
      if (!oText || oText === cleOpt) break;
      reponses.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (reponses.length) question.suggestedAnswer = reponses;
    hasPart.push(question);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": t(ns + ':jsonLd.name', pageTitle),
    "description": t('quizzes:testCrush.metaDescription', ''),
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', 'Faire la différence entre un crush et des sentiments amoureux') },
    "educationalLevel": "beginner",
    "learningResourceType": "Quiz",
    "interactivityType": "active",
    "inLanguage": lang,
    "isAccessibleForFree": true,
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 35 }
    ]
  };
  if (hasPart.length) quizSchema.hasPart = hasPart;

  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:testCrush.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Le test -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="crush" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section1.p1', '') %></p>
        <p><%- t(ns + ':section1.p2', '') %></p>
        <p><%- t(ns + ':section1.p3', '') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-8">
        <p><%- t(ns + ':section2.p1', '') %></p>
        <p><%- t(ns + ':section2.p2', '') %></p>
      </div>
      <div class="jeux-table-wrap">
        <table class="jeux-table">
          <thead>
            <tr>
              <th scope="col"><%= t(ns + ':section2.headerSituation', '') %></th>
              <th scope="col"><%= t(ns + ':section2.headerCrush', '') %></th>
              <th scope="col"><%= t(ns + ':section2.headerAmour', '') %></th>
            </tr>
          </thead>
          <tbody>
            <% tableauLignes.forEach(function(i) { %>
            <tr>
              <th scope="row"><%= t(ns + ':section2.row' + i + 'Situation', '') %></th>
              <td><%= t(ns + ':section2.row' + i + 'Crush', '') %></td>
              <td><%= t(ns + ':section2.row' + i + 'Amour', '') %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section2.apres', '') %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-8">
        <p><%- t(ns + ':section3.p1', '') %></p>
      </div>
      <div class="quiz-resume">
        <p class="quiz-resume-titre"><%= t(ns + ':section3.resumeTitre', '') %></p>
        <ul>
          <% for (let i = 1; i <= 6; i++) { %>
          <li><%- t(ns + ':section3.resume' + i, '') %></li>
          <% } %>
        </ul>
      </div>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section3.apres', '') %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section4.p1', '') %></p>
        <p><%- t(ns + ':section4.p2', '') %></p>
        <p><%- t(ns + ':section4.p3', '') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section5.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-8">
        <p><%- t(ns + ':section5.p1', '') %></p>
        <p><%- t(ns + ':section5.p2', '') %></p>
      </div>
      <div class="quiz-resume">
        <p class="quiz-resume-titre"><%= t(ns + ':section5.resumeTitre', '') %></p>
        <ul>
          <% for (let i = 1; i <= 4; i++) { %>
          <li><%- t(ns + ':section5.resume' + i, '') %></li>
          <% } %>
        </ul>
      </div>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section5.apres', '') %></p>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= t(ns + ':faq.q' + i, '') %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

    <section class="mb-4 bg-gradient-to-br from-primary/10 to-secondary/10 rounded-lg p-8 border border-primary/20">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t(ns + ':section6.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section6.p1', '') %></p>
        <p class="text-foreground font-semibold"><%- t(ns + ':section6.p2', '') %></p>
      </div>
    </section>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
