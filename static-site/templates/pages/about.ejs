      <p class="apr-manifeste-texte"><%- p.whyText %></p>
    </div>
  </div>
</section>

<!-- ═══════ RÉCIT ═══════ -->
<section class="apr-section apr-section--douce">
  <div class="container mx-auto px-4">
    <div class="apr-recit">
      <div class="apr-recit-titre">
        <span class="apr-filet" aria-hidden="true"></span>
        <h2><%= p.storyTitle %></h2>
      </div>
      <div class="apr-recit-corps">
        <p class="apr-chapo"><%= p.storyP1 %></p>
        <blockquote class="about-blockquote">
          <p><%- p.storyQuote %></p>
        </blockquote>
        <p><%= p.storyP2 %></p>
        <p class="apr-accroche"><%- p.storyP3 %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ CE QU'ON FAIT ═══════ -->
<section class="apr-section">
  <div class="container mx-auto px-4">
    <div class="apr-large">
      <div class="apr-recit-titre apr-recit-titre--centre">
        <span class="apr-filet apr-filet--secondaire" aria-hidden="true"></span>
        <h2><%= p.doTitle %></h2>
      </div>

      <div class="apr-duo-cartes">
        <div class="apr-carte apr-carte--oui">
          <div class="apr-carte-tete">
            <span class="apr-pastille apr-pastille--oui">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <h3><%= p.doLabel %></h3>
          </div>
          <p><%= p.doText %></p>
        </div>

        <div class="apr-carte apr-carte--non">
          <div class="apr-carte-tete">
            <span class="apr-pastille apr-pastille--non">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </span>
            <h3><%= p.dontLabel %></h3>
          </div>
          <p><%- p.dontText %></p>
        </div>
      </div>

      <div class="apr-suite">
        <p class="apr-suite-principal"><%= p.doExtra %></p>
        <p class="apr-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <span><%= p.doDisclaimer %></span>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ ÉQUIPE ═══════ -->
<section class="apr-section apr-section--douce">
  <div class="container mx-auto px-4">
    <div class="apr-large">
      <div class="apr-equipe-entete">
        <span class="badge badge-primary mb-4"><%= p.teamBadge %></span>
        <h2><%= p.teamTitle %></h2>
      </div>

      <article class="apr-profil apr-profil--seul">
        <div class="apr-profil-aside apr-profil-aside--primaire">
          <div class="apr-profil-carte">
            <h3>Thomas</h3>
            <p class="apr-profil-role"><%= p.thomasRole %></p>
          </div>
        </div>
        <div class="apr-profil-corps">
          <p><%= p.thomasP1 %></p>
          <p><%- p.thomasP2 %></p>
          <blockquote class="apr-citation"><%= p.thomasQuote %></blockquote>
          <p><%= p.thomasP3 %></p>
          <div class="apr-terrain apr-terrain--primaire">
            <p class="apr-terrain-titre"><%= p.thomasSpecLabel %></p>
            <p><%= p.thomasSpecText %></p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ═══════ MÉTHODE ═══════ -->
<section class="apr-section">
  <div class="container mx-auto px-4">
    <div class="apr-large">
      <div class="apr-recit-titre apr-recit-titre--centre">
        <span class="apr-filet" aria-hidden="true"></span>
        <h2><%= p.workTitle %></h2>
      </div>

      <ol class="apr-etapes">
        <li class="apr-etape">
          <span class="apr-etape-num">1</span>
          <span class="apr-etape-icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <h3><%= p.workCard1Title %></h3>
          <p><%= p.workCard1Text %></p>
        </li>
        <li class="apr-etape">
          <span class="apr-etape-num">2</span>
          <span class="apr-etape-icone apr-etape-icone--secondaire">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <h3><%= p.workCard2Title %></h3>
          <p><%= p.workCard2Text %></p>
        </li>
        <li class="apr-etape">
          <span class="apr-etape-num">3</span>
          <span class="apr-etape-icone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </span>
          <h3><%= p.workCard3Title %></h3>
          <p><%= p.workCard3Text %></p>
        </li>
      </ol>

      <p class="apr-devise"><%- p.workHighlight %></p>
    </div>
  </div>
</section>

<!-- ═══════ CONCLUSION ═══════ -->
<section class="apr-final">
  <div class="container mx-auto px-4">
    <div class="apr-final-bloc">
      <svg class="apr-final-icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
      <p><%- p.conclusion %></p>
    </div>
  </div>
</section>
