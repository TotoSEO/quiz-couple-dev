<%
  // Compteur de couple : une date de début, et ce qu'elle donne aujourd'hui.
  // Les jours ensemble, la durée en années, mois et jours, les prochaines
  // dates à fêter (anniversaire et noces, mois ronds, caps de jours) et un
  // lien à garder. Outil autonome (js/compteur-couple.js), hors quiz-loader,
  // bâti sur le gabarit des outils par date (classes astro-* et dn-*).
  const ns = 'compteur-couple';
  const pageTitle = t('quizzes:compteurCouple.title', 'Compteur de couple');
  // Tout ce que le script doit pouvoir afficher, dans la langue de la page.
  const ccI18n = {
    form: {
      jour: t(ns + ':form.jour', 'Jour'),
      moisLabel: t(ns + ':form.moisLabel', 'Mois'),
      annee: t(ns + ':form.annee', 'Année'),
      mois: t(ns + ':form.mois', []),
      moisDate: t(ns + ':form.moisDate', []),
      joursSemaine: t(ns + ':form.joursSemaine', []),
      dateAffichee: t(ns + ':form.dateAffichee', '{{j}} {{mois}} {{a}}'),
      dateAvecJour: t(ns + ':form.dateAvecJour', '{{js}} {{date}}'),
      erreur: t(ns + ':form.erreur', ''),
      erreurVide: t(ns + ':form.erreurVide', ''),
      erreurFutur: t(ns + ':form.erreurFutur', ''),
    },
    unites: t(ns + ':unites', {}),
    et: t(ns + ':et', ' et '),
    virgule: t(ns + ':virgule', ', '),
    quand: t(ns + ':quand', {}),
    etapes: t(ns + ':etapes', {}),
    fete: t(ns + ':fete', {}),
    noces: t(ns + ':noces', []),
    resultat: t(ns + ':resultat', {}),
    partage: t(ns + ':partage', {}),
  };

  const faqEntrees = [];
  for (let i = 1; i <= 6; i++) {
    const q = t(ns + ':faq.q' + i, '');
    const a = t(ns + ':faq.a' + i, '');
    if (q && a) faqEntrees.push({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } });
  }

  const baseUrl = 'https://quiz-couple.com';
  const imageCC = (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : baseUrl + '/og-image.webp';
  const appCC = {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: t(ns + ':jsonLd.name', pageTitle),
    description: t('quizzes:compteurCouple.metaDescription', t('quizzes:compteurCouple.description', '')),
    applicationCategory: 'EntertainmentApplication',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: lang,
    url: canonical,
    image: imageCC,
    isAccessibleForFree: true,
    about: { '@type': 'Thing', name: t(ns + ':jsonLd.about', '') },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    author: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl },
    publisher: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl, logo: { '@type': 'ImageObject', url: baseUrl + '/apple-touch-icon.png' } }
  };
%>
<script type="application/ld+json"><%- JSON.stringify(appCC) %></script>
<% if (faqEntrees.length) { %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntrees }) %></script>
<% } %>

<!-- Hero -->
<section class="quiz-page-hero relative overflow-hidden hero-gradient">
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:compteurCouple.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M12 14.5l-1.2-1.1a1.6 1.6 0 1 1 2.4 0z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.highlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
      <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':hero.subtitle', '') %></p>
    </div>
  </div>
  <%# L'image de tête vient en dernier dans le code, comme sur les autres pages de test. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', featuredImageSrcset: typeof featuredImageSrcset !== 'undefined' ? featuredImageSrcset : null }) %>
</section>

<!-- Le compteur -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="cc-outil" class="astro-form-card rounded-2xl p-6 md:p-10" data-lang="<%= lang %>">

        <div id="cc-formulaire">
          <h2 class="text-xl md:text-2xl font-bold text-center mb-6"><%= t(ns + ':form.titre', '') %></h2>

          <div class="dn-personne">
            <p class="dn-personne-titre"><span class="dn-personne-num dn-personne-num-1">1</span><%= t(ns + ':form.dateTitre', '') %></p>
            <div class="dn-champs">
              <div class="astro-field">
                <label class="astro-field-label" for="cc-jour"><%= t(ns + ':form.jour', 'Jour') %></label>
                <div class="astro-select-wrap"><select id="cc-jour" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="cc-mois"><%= t(ns + ':form.moisLabel', 'Mois') %></label>
                <div class="astro-select-wrap"><select id="cc-mois" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="cc-annee"><%= t(ns + ':form.annee', 'Année') %></label>
                <div class="astro-select-wrap"><select id="cc-annee" class="astro-input astro-select"></select></div>
              </div>
            </div>
            <p class="text-sm text-muted-foreground"><%= t(ns + ':form.dateAide', '') %></p>
          </div>

          <div class="astro-heart-divider">
            <div class="astro-heart-line"></div>
            <span class="astro-heart-icon">&#10084;&#65039;</span>
            <div class="astro-heart-line"></div>
          </div>

          <div class="dn-personne">
            <p class="dn-personne-titre"><span class="dn-personne-num dn-personne-num-2">2</span><%= t(ns + ':form.prenomsTitre', '') %></p>
            <div class="cc-prenoms">
              <div class="astro-field">
                <label class="astro-field-label" for="cc-prenom1"><%= t(ns + ':form.prenom1', '') %></label>
                <input type="text" id="cc-prenom1" class="astro-input" maxlength="24" autocomplete="off" spellcheck="false" placeholder="<%= t(ns + ':form.prenom1Ex', '') %>">
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="cc-prenom2"><%= t(ns + ':form.prenom2', '') %></label>
                <input type="text" id="cc-prenom2" class="astro-input" maxlength="24" autocomplete="off" spellcheck="false" placeholder="<%= t(ns + ':form.prenom2Ex', '') %>">
              </div>
            </div>
          </div>

          <p id="cc-erreur" class="dn-erreur hidden" role="alert"></p>

          <div class="mt-6 text-center">
            <button id="cc-lancer" type="button" class="btn btn-cta btn-gradient astro-submit-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <%= t(ns + ':form.lancer', '') %>
            </button>
            <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':form.aide', '') %></p>
          </div>
        </div>

        <div id="cc-resultat" class="hidden"></div>

        <div id="cc-suite" class="hidden">
          <div class="cc-actions">
            <button id="cc-partager" type="button" class="btn btn-cta btn-gradient px-8 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
              <%= t(ns + ':partage.bouton', '') %>
            </button>
            <button id="cc-copier" type="button" class="btn btn-outline px-6 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              <%= t(ns + ':partage.lienBouton', '') %>
            </button>
          </div>
          <p id="cc-copie" class="cc-copie hidden" role="status"></p>

          <div class="dn-suite-carte">
            <h3 class="dn-suite-titre"><%= t(ns + ':suite.titre', '') %></h3>
            <p class="dn-suite-texte"><%= t(ns + ':suite.texte', '') %></p>
            <a class="btn btn-cta btn-gradient" href="<%= getLocalizedUrl('testAmourHabitude', lang) %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>
              <%= t(ns + ':suite.bouton', '') %>
            </a>
          </div>
          <div class="text-center mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button id="cc-refaire" type="button" class="btn btn-outline px-8 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              <%= t(ns + ':resultat.modifier', '') %>
            </button>
            <a href="#pq-reviews" class="btn btn-outline px-6 py-2.5 text-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':resultat.avis', '') %>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# Sous le compteur, jamais au-dessus. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu SEO -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <%
      // Un tableau par section quand la section en déclare un : en-têtes et
      // lignes viennent du fichier de langue.
      function tableau(cle) {
        const h = t(ns + ':' + cle + '.tableHeaders', []);
        const rows = t(ns + ':' + cle + '.tableRows', []);
        if (!h.length || !rows.length) return '';
        let out = '<div class="overflow-x-auto mb-6"><table class="quiz-table"><thead><tr>';
        for (const x of h) out += '<th>' + x + '</th>';
        out += '</tr></thead><tbody>';
        for (const row of rows) {
          out += '<tr>';
          for (let ci = 0; ci < row.length; ci++) out += '<td class="' + (ci === 0 ? 'font-medium' : 'text-sm text-muted-foreground') + '">' + row[ci] + '</td>';
          out += '</tr>';
        }
        return out + '</tbody></table></div>';
      }
      const points2 = t(ns + ':section2.points', []);
    %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section1.p1') %></p>
        <p><%- t(ns + ':section1.p2') %></p>
        <p><%- t(ns + ':section1.p3') %></p>
      </div>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section2.p1') %></p>
      </div>
      <% if (points2.length) { %>
      <ul class="space-y-3 text-muted-foreground leading-relaxed list-disc pl-6 mb-6">
        <% for (const pt of points2) { %><li><%- pt %></li><% } %>
      </ul>
      <% } %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section2.p2') %></p>
      </div>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%- t(ns + ':section2.tip') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section3.p1') %></p>
        <p><%- t(ns + ':section3.p2') %></p>
        <p><%- t(ns + ':section3.p3') %></p>
      </div>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%- t(ns + ':section3.tip') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section4.p1') %></p>
      </div>
      <%- tableau('section4') %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section4.p2') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section5.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed mb-6">
        <p><%- t(ns + ':section5.p1') %></p>
      </div>
      <%- tableau('section5') %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section5.p2') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section6.title') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section6.p1') %></p>
        <p><%- t(ns + ':section6.p2') %></p>
      </div>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%- t(ns + ':section6.tip') %></p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', 'FAQ') %></h2>
      <div class="space-y-3">
        <% for (let i = 1; i <= 6; i++) { %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= t(ns + ':faq.q' + i) %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- t(ns + ':faq.a' + i) %></div>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<script>window.CC_I18N = <%- JSON.stringify(ccI18n) %>;</script>
<script src="/js/compteur-couple.js" defer></script>
