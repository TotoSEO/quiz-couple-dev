<%
  var quizType = 'common-points';
  var ns = 'quiz-common-points';
  const quizTitle = t('quizzes:' + routeKey + '.title', 'Test Points Communs');
  const quizDesc = t('quizzes:' + routeKey + '.metaDescription', '');

  const faqItems = t(ns + ':seo.faq', []);

  // Build hasPart with actual quiz questions using tgd() for proper translations
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= 220; qi++) {
    const qText = tgd('commonPoints.q' + qi, '');
    if (!qText || qText === 'commonPoints.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local('commonPoints.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'commonPoints.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', 'couple compatibility test') },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 153 },
      { "@type": "PropertyValue", "name": "questionsPerSession", "value": 20 }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [quizSchema];
  if (Array.isArray(faqItems) && faqItems.length > 0) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqItems.map(function(f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Quiz Engine -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="<%= quizType %>" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- SEO Content -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <% const intro = t(ns + ':seo.intro', ''); if (intro) { %>
    <p class="text-lg text-muted-foreground leading-relaxed mb-12"><%- intro %></p>
    <% } %>

    <%/* Section 1: Pourquoi les points communs comptent */%>
    <% const s1Title = t(ns + ':seo.s1.title', ''); if (s1Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s1Title %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% const s1p1 = t(ns + ':seo.s1.p1', ''); if (s1p1) { %><p><%- s1p1 %></p><% } %>
        <% const s1p2 = t(ns + ':seo.s1.p2', ''); if (s1p2) { %><p><%- s1p2 %></p><% } %>
      </div>
    </section>
    <% } %>

    <%/* Section 2: À quoi sert un test de points communs */%>
    <% const s2Title = t(ns + ':seo.s2.title', ''); if (s2Title) { %>
    <%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: (typeof quizTitle !== 'undefined' ? quizTitle : (typeof rawTitle !== 'undefined' ? rawTitle : '')) }) %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s2Title %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% const s2p1 = t(ns + ':seo.s2.p1', ''); if (s2p1) { %><p><%- s2p1 %></p><% } %>
        <% const s2p2 = t(ns + ':seo.s2.p2', ''); if (s2p2) { %><p><%- s2p2 %></p><% } %>
      </div>
    </section>
    <% } %>

    <%/* Section 3: Comment fonctionne le test (steps) */%>
    <% const s3Title = t(ns + ':seo.s3.title', ''); const s3Steps = t(ns + ':seo.s3.steps', []); if (s3Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s3Title %></h2>
      <% if (Array.isArray(s3Steps) && s3Steps.length > 0) { %>
      <div class="space-y-4">
        <% for (let i = 0; i < s3Steps.length; i++) { const step = s3Steps[i]; %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= (i + 1) + '. ' + step.title %></h3>
          <p class="text-muted-foreground"><%= step.desc %></p>
        </div>
        <% } %>
      </div>
      <% } %>
    </section>
    <% } %>

    <%/* Section 4: 153 questions (categories) */%>
    <% const s4Title = t(ns + ':seo.s4.title', ''); if (s4Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s4Title %></h2>
      <% const s4p1 = t(ns + ':seo.s4.p1', ''); if (s4p1) { %>
      <p class="text-muted-foreground leading-relaxed mb-6"><%- s4p1 %></p>
      <% } %>
      <% const categories = t(ns + ':seo.s4.categories', []); if (Array.isArray(categories) && categories.length > 0) { %>
      <div class="space-y-4">
        <% for (const cat of categories) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= cat.title %></h3>
          <p class="text-muted-foreground"><%= cat.desc %></p>
        </div>
        <% } %>
      </div>
      <% } %>
    </section>
    <% } %>

    <%/* Section 5: Comment interpréter les réponses */%>
    <% const s5Title = t(ns + ':seo.s5.title', ''); if (s5Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s5Title %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% const s5p1 = t(ns + ':seo.s5.p1', ''); if (s5p1) { %><p><%- s5p1 %></p><% } %>
        <% const s5p2 = t(ns + ':seo.s5.p2', ''); if (s5p2) { %><p><%- s5p2 %></p><% } %>
      </div>
    </section>
    <% } %>

    <%/* Section 6: Faut-il beaucoup de points communs */%>
    <% const s6Title = t(ns + ':seo.s6.title', ''); if (s6Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s6Title %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% const s6p1 = t(ns + ':seo.s6.p1', ''); if (s6p1) { %><p><%- s6p1 %></p><% } %>
        <% const s6p2 = t(ns + ':seo.s6.p2', ''); if (s6p2) { %><p><%- s6p2 %></p><% } %>
      </div>
    </section>
    <% } %>

    <%/* Section 7: Quand faire le test (items list) */%>
    <% const s7Title = t(ns + ':seo.s7.title', ''); if (s7Title) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= s7Title %></h2>
      <% const s7p1 = t(ns + ':seo.s7.p1', ''); if (s7p1) { %>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- s7p1 %></p>
      <% } %>
      <% const items = t(ns + ':seo.s7.items', []); if (Array.isArray(items) && items.length > 0) { %>
      <ul class="space-y-3 ml-4">
        <% for (const item of items) { %>
        <li class="flex items-start gap-2"><span class="text-primary font-bold mt-1">&bull;</span><span class="text-muted-foreground"><%- item %></span></li>
        <% } %>
      </ul>
      <% } %>
    </section>
    <% } %>

    <%/* CTA */%>
    <% const ctaTitle = t(ns + ':seo.ctaTitle', ''); if (ctaTitle) { %>
    <section class="mb-16 text-center">
      <div class="glass-card-strong rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-4"><%= ctaTitle %></h2>
        <p class="text-muted-foreground mb-6"><%= t(ns + ':seo.ctaDesc', '') %></p>
        <a href="#quiz-engine" class="btn btn-cta"><%= t('common:buttons.startQuiz', 'Commencer le test') %></a>
      </div>
    </section>
    <% } %>

    <%/* FAQ */%>
    <% if (Array.isArray(faqItems) && faqItems.length > 0) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':seo.faqTitle', 'FAQ') %></h2>
      <div class="space-y-4">
        <% for (const faq of faqItems) { %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= faq.q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= faq.a %></div>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
