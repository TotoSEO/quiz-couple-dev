<section class="py-20 min-h-[60vh] flex items-center">
  <div class="container mx-auto px-4 max-w-lg text-center">
    <div id="ebook-confirm-loading">
      <div class="text-4xl mb-4" role="status" aria-label="Chargement">&#9203;</div>
      <h1 class="text-2xl font-bold mb-2">Vérification en cours...</h1>
      <p class="text-muted-foreground">Merci de patienter quelques secondes.</p>
    </div>
    <div id="ebook-confirm-result" class="hidden">
      <div id="ebook-confirm-icon" class="text-4xl mb-4"></div>
      <h1 id="ebook-confirm-title" class="text-2xl font-bold mb-2"></h1>
      <p id="ebook-confirm-message" class="text-muted-foreground mb-6"></p>
      <div id="ebook-download-section" class="hidden" style="margin-bottom:2rem;">
        <a href="/assets/ebook-astrologie.pdf" download="Apprendre-les-bases-de-l-Astrologie-QuizCouple.pdf" class="btn btn-cta btn-gradient" style="padding:0.875rem 2rem;font-size:1.0625rem;display:inline-flex;align-items:center;gap:0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1.25rem;height:1.25rem;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          T&eacute;l&eacute;charger mon E-Book (PDF)
        </a>
      </div>
      <a href="/" style="color:#d6336c;text-decoration:none;font-size:0.9375rem;">Retourner sur Quiz Couple</a>
    </div>
  </div>
</section>

<script>
(function() {
  var params = new URLSearchParams(window.location.search);
  var token = params.get('token');
  var loading = document.getElementById('ebook-confirm-loading');
  var result = document.getElementById('ebook-confirm-result');
  var icon = document.getElementById('ebook-confirm-icon');
  var title = document.getElementById('ebook-confirm-title');
  var message = document.getElementById('ebook-confirm-message');

  var downloadSection = document.getElementById('ebook-download-section');

  function showResult(i, t, m, showDownload) {
    icon.textContent = i;
    title.textContent = t;
    message.textContent = m;
    loading.classList.add('hidden');
    result.classList.remove('hidden');
    if (showDownload && downloadSection) downloadSection.classList.remove('hidden');
  }

  if (!token) {
    showResult('\u274C', 'Lien invalide', 'Ce lien de confirmation est invalide ou incomplet.', false);
    return;
  }

  var SUPA_URL = '<%= supabaseUrl %>';
  var SUPA_KEY = '<%= supabaseKey %>';

  fetch(SUPA_URL + '/functions/v1/ebook-verify?action=confirm&token=' + encodeURIComponent(token), {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + SUPA_KEY,
      'Content-Type': 'application/json'
    }
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.error) {
      showResult('\u274C', 'Oups...', data.error, false);
    } else if (data.already_verified) {
      showResult('\u2139\uFE0F', 'D\u00E9j\u00E0 confirm\u00E9 !', data.first_name + ', votre e-mail a d\u00E9j\u00E0 \u00E9t\u00E9 confirm\u00E9. Vous pouvez t\u00E9l\u00E9charger votre E-Book ci-dessous.', true);
    } else {
      showResult('\u2705', 'E-mail confirm\u00E9 !', 'Merci ' + data.first_name + ' ! Votre E-Book est pr\u00EAt, cliquez ci-dessous pour le t\u00E9l\u00E9charger.', true);
    }
  })
  .catch(function() {
    showResult('\u274C', 'Erreur', 'Une erreur est survenue. Veuillez r\u00E9essayer plus tard.', false);
  });
})();
</script>
