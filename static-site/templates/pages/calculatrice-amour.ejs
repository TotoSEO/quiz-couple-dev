<%
  // Calculatrice de l'amour : deux prenoms, un pourcentage, et le detail du calcul.
  // Outil autonome ecrit dans ce gabarit, comme la compatibilite astro : il ne
  // passe pas par quiz-loader, il n'a ni question ni ecran intermediaire.
  const ns = 'calculatrice-amour';
  const pageTitle = t('quizzes:calculatriceAmour.title', "Calculatrice de l'amour");
  const faqNums = [1, 2, 3, 4, 5, 6, 7];

  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "WebApplication",
      "name": t(ns + ':jsonLd.name', "Calculatrice de l'amour"),
      "description": t('quizzes:calculatriceAmour.metaDescription', ''),
      "applicationCategory": "EntertainmentApplication",
      "operatingSystem": "All",
      "browserRequirements": "JavaScript",
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', '') },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function (i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];

  // Tout ce que le script a besoin de lire est prepare ici, dans la langue de la
  // page seulement : le gabarit n'embarque jamais les cinq langues.
  const donneesJs = {
    lang: lang,
    mot: t(ns + ':calcul.mot', 'amour'),
    dims: ['lettres', 'mot', 'rythme', 'numero', 'longueur'].map(function (k) {
      return { cle: k, nom: t(ns + ':dimensions.' + k + 'Nom', k), desc: t(ns + ':dimensions.' + k + 'Desc', '') };
    }),
    verdicts: [1, 2, 3, 4, 5, 6].map(function (i) {
      return { titre: t(ns + ':verdicts.v' + i + 'Titre', ''), texte: t(ns + ':verdicts.v' + i + 'Texte', '') };
    }),
    couples: t(ns + ':couples', []),
    dose: t(ns + ':dose', {}),
    textes: {
      compat: t(ns + ':resultat.compat', ''),
      detailIntro: t(ns + ':resultat.detailIntro', ''),
      partageTexte: t(ns + ':resultat.partageTexte', ''),
      copie: t(ns + ':resultat.copie', ''),
      erreur: t(ns + ':form.erreur', ''),
      celebreTitre: t(ns + ':celebres.titre', ''),
      chemin: t(ns + ':resultat.chemin', '')
    }
  };
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero + outil -->
<section class="relative overflow-hidden hero-gradient py-12 md:py-16 calc-hero">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:calculatriceAmour.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
    </div>

    <%# L'outil est dans le premier ecran : c'est ce que la personne est venue chercher. %>
    <div class="mx-auto max-w-2xl mt-8 md:mt-10">
      <div id="calc-carte" class="calc-carte">
        <form id="calc-form" novalidate>
          <div class="calc-champs">
            <div class="calc-champ">
              <label class="calc-label" for="calc-a"><%= t(ns + ':form.label1', '') %></label>
              <input type="text" id="calc-a" class="calc-input" maxlength="24" autocomplete="off" spellcheck="false"
                     placeholder="<%= t(ns + ':form.placeholder1', '') %>">
            </div>
            <div class="calc-coeur" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div class="calc-champ">
              <label class="calc-label" for="calc-b"><%= t(ns + ':form.label2', '') %></label>
              <input type="text" id="calc-b" class="calc-input" maxlength="24" autocomplete="off" spellcheck="false"
                     placeholder="<%= t(ns + ':form.placeholder2', '') %>">
            </div>
          </div>
          <p id="calc-erreur" class="calc-erreur" role="alert" hidden></p>
          <button type="submit" id="calc-go" class="btn btn-cta btn-gradient calc-go"><%= t(ns + ':form.submit', '') %></button>
          <p class="calc-aide"><%= t(ns + ':form.aide', '') %></p>
        </form>

        <div id="calc-resultat" class="calc-resultat" hidden>
          <p id="calc-noms" class="calc-noms"></p>
          <div class="calc-anneau">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle class="calc-anneau-fond" cx="60" cy="60" r="52"></circle>
              <circle id="calc-anneau-trait" class="calc-anneau-trait" cx="60" cy="60" r="52"></circle>
            </svg>
            <div class="calc-anneau-texte">
              <span id="calc-pct" class="calc-pct">0<span class="calc-pct-signe">%</span></span>
              <span class="calc-anneau-label"><%= t(ns + ':resultat.compat', '') %></span>
            </div>
          </div>
          <h2 id="calc-verdict-titre" class="calc-verdict-titre"></h2>
          <p id="calc-verdict-texte" class="calc-verdict-texte"></p>

          <div class="calc-detail">
            <h3 class="calc-detail-titre"><%= t(ns + ':resultat.detailTitre', '') %></h3>
            <p id="calc-detail-intro" class="calc-detail-intro"></p>
            <ul id="calc-barres" class="calc-barres"></ul>
          </div>

          <div class="calc-actions">
            <button type="button" id="calc-partage" class="btn btn-cta btn-gradient calc-action"><%= t(ns + ':resultat.partageBouton', '') %></button>
            <button type="button" id="calc-rejouer" class="btn btn-outline calc-action"><%= t(ns + ':form.retry', '') %></button>
          </div>
          <p id="calc-copie" class="calc-copie" hidden><%= t(ns + ':resultat.copie', '') %></p>
        </div>
      </div>
    </div>

    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
  <%# L'image de tete vient en dernier dans le code : sous le texte sur telephone, en absolu a droite sur grand ecran. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
</section>

