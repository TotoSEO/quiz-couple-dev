<%
  var quizType = 'tu-preferes';
  var ns = 'quiz-tu-preferes';
  // Le pool compte 100 dilemmes ; une partie en tire PAR_PARTIE au hasard.
  var PAR_PARTIE = 30;
  var sectionCount = 5;

  const quizTitle = t('quizzes:quizTuPreferes.title', 'Tu Préfères Couple');
  const quizDesc = t('quizzes:quizTuPreferes.metaDescription', '');

  // ── FAQ entries ──
  var faqEntries = [];
  for (var fi = 1; fi <= 6; fi++) {
    var fq = t(ns + ':faq.q' + fi, '');
    var fa = t(ns + ':faq.a' + fi, '');
    if (fq) faqEntries.push({ q: fq, a: fa });
  }

  // ── JSON-LD ──
  // On n'expose qu'un échantillon dans le balisage : la taille d'une partie.
  const hasPart = [];
  for (var qi = 1; qi <= PAR_PARTIE; qi++) {
    var qText = tgd('wyr.q' + qi, '');
    if (!qText || qText === 'wyr.q' + qi) break;
    var questionObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    var answers = [];
    var oA = tgd('wyr.q' + qi + 'a', '');
    var oB = tgd('wyr.q' + qi + 'b', '');
    if (oA && oA !== 'wyr.q' + qi + 'a') answers.push({ "@type": "Answer", "position": 1, "text": oA });
    if (oB && oB !== 'wyr.q' + qi + 'b') answers.push({ "@type": "Answer", "position": 2, "text": oB });
    if (answers.length > 0) questionObj.suggestedAnswer = answers;
    hasPart.push(questionObj);
  }

  var jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Quiz",
      "name": quizTitle, "description": quizDesc, "inLanguage": lang,
      "datePublished": "2026-03-10", "isAccessibleForFree": true,
      "learningResourceType": "Quiz", "interactivityType": "active",
      "about": { "@type": "Thing", "name": "would you rather couple" },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "totalQuestions", "value": PAR_PARTIE },
        { "@type": "PropertyValue", "name": "questionPool", "value": 100 },
        { "@type": "PropertyValue", "name": "audience", "value": "couples" }
      ]
    }
  ];
  if (hasPart.length > 0) jsonLd[0].hasPart = hasPart;
  if (faqEntries.length > 0) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqEntries.map(function(f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }

  // UI labels
  var uiLabels = {
    fr: { start: 'Commencer', qOf: 'sur', or: 'OU', match: 'En accord !', diff: 'Avis différents !', next: 'Question suivante', done: 'Voir les résultats', agree: 'En accord', disagree: 'Pas d\'accord', result: 'Votre compatibilité', retake: 'Rejouer', p1Turn: 'C\'est au tour de', p2Turn: 'C\'est au tour de', chooseA: 'Option A', chooseB: 'Option B', yourChoice: 'Votre choix', partnerChoice: 'Son choix', matchRate: 'Taux d\'accord', name1: 'Joueur 1', name2: 'Joueur 2', namePlaceholder: 'Prénom', both: 'Vous deux', intro: 'Un choix, deux réponses, zéro bonne réponse.', startGame: 'Lancer le jeu', passPhone: 'Passe le téléphone à', ready: 'Je suis prêt(e)', sameChoice: 'Même choix !', diffChoice: 'Choix différent !' },
    en: { start: 'Start', qOf: 'of', or: 'OR', match: 'You agree!', diff: 'Different picks!', next: 'Next question', done: 'See results', agree: 'Agree', disagree: 'Disagree', result: 'Your compatibility', retake: 'Play again', p1Turn: 'It\'s your turn,', p2Turn: 'It\'s your turn,', chooseA: 'Option A', chooseB: 'Option B', yourChoice: 'Your choice', partnerChoice: 'Their choice', matchRate: 'Agreement rate', name1: 'Player 1', name2: 'Player 2', namePlaceholder: 'First name', both: 'Both of you', intro: 'One choice, two answers, zero right answers.', startGame: 'Start the game', passPhone: 'Pass the phone to', ready: 'I\'m ready', sameChoice: 'Same choice!', diffChoice: 'Different choice!' },
    es: { start: 'Empezar', qOf: 'de', or: 'O', match: '¡De acuerdo!', diff: '¡Opiniones diferentes!', next: 'Siguiente pregunta', done: 'Ver resultados', agree: 'De acuerdo', disagree: 'En desacuerdo', result: 'Vuestra compatibilidad', retake: 'Volver a jugar', p1Turn: 'Es tu turno,', p2Turn: 'Es tu turno,', chooseA: 'Opción A', chooseB: 'Opción B', yourChoice: 'Tu elección', partnerChoice: 'Su elección', matchRate: 'Tasa de acuerdo', name1: 'Jugador 1', name2: 'Jugador 2', namePlaceholder: 'Nombre', both: 'Los dos', intro: 'Una elección, dos respuestas, cero respuestas correctas.', startGame: 'Empezar el juego', passPhone: 'Pasa el móvil a', ready: 'Estoy listo/a', sameChoice: '¡Misma elección!', diffChoice: '¡Elección diferente!' },
    de: { start: 'Starten', qOf: 'von', or: 'ODER', match: 'Einig!', diff: 'Unterschiedlich!', next: 'Nächste Frage', done: 'Ergebnisse anzeigen', agree: 'Einig', disagree: 'Uneinig', result: 'Eure Kompatibilität', retake: 'Nochmal spielen', p1Turn: 'Du bist dran,', p2Turn: 'Du bist dran,', chooseA: 'Option A', chooseB: 'Option B', yourChoice: 'Deine Wahl', partnerChoice: 'Seine/ihre Wahl', matchRate: 'Übereinstimmungsrate', name1: 'Spieler 1', name2: 'Spieler 2', namePlaceholder: 'Vorname', both: 'Ihr beide', intro: 'Eine Wahl, zwei Antworten, null richtige Antworten.', startGame: 'Spiel starten', passPhone: 'Gib das Handy an', ready: 'Ich bin bereit', sameChoice: 'Gleiche Wahl!', diffChoice: 'Andere Wahl!' },
    it: { start: 'Inizia', qOf: 'di', or: 'O', match: 'D\'accordo!', diff: 'Opinioni diverse!', next: 'Prossima domanda', done: 'Vedi risultati', agree: 'D\'accordo', disagree: 'In disaccordo', result: 'La vostra compatibilità', retake: 'Rigioca', p1Turn: 'Tocca a te,', p2Turn: 'Tocca a te,', chooseA: 'Opzione A', chooseB: 'Opzione B', yourChoice: 'La tua scelta', partnerChoice: 'La sua scelta', matchRate: 'Tasso di accordo', name1: 'Giocatore 1', name2: 'Giocatore 2', namePlaceholder: 'Nome', both: 'Entrambi', intro: 'Una scelta, due risposte, zero risposte giuste.', startGame: 'Inizia il gioco', passPhone: 'Passa il telefono a', ready: 'Sono pronto/a', sameChoice: 'Stessa scelta!', diffChoice: 'Scelta diversa!' }
  };
  var ui = uiLabels[lang] || uiLabels.fr;

  // Section helpers (same as quiz-generic)
  function tryKeys() {
    for (var i = 0; i < arguments.length; i++) {
      var val = t(ns + ':' + arguments[i], '');
      if (val) return val;
    }
    return '';
  }
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

