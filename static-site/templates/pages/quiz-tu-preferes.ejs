        <% for (var fe = 0; fe < faqEntries.length; fe++) { %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= faqEntries[fe].q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- faqEntries[fe].a %></div>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>
  </div>
</article>

