  <div class="container mx-auto px-4 max-w-3xl">

    <% for (var s = 1; s <= sectionCount; s++) {
      var sTitle = tryKeys('section' + s + '.title');
      if (!sTitle) continue;
    %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= sTitle %></h2>

      <% var paragraphs = [];
        for (var p = 1; p <= 5; p++) { var pText = tryKeys('section' + s + '.p' + p); if (pText) paragraphs.push(pText); }
        if (paragraphs.length > 0) { %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% for (var pi = 0; pi < paragraphs.length; pi++) { %>
        <p><%- paragraphs[pi] %></p>
        <% } %>
      </div>
      <% } %>

      <% for (var sub = 1; sub <= 4; sub++) {
        var subTitle = tryKeys('section' + s + '.sub' + sub + 'Title');
        if (!subTitle) continue; %>
      <div class="mt-6">
        <h3 class="text-xl font-semibold mb-3"><%= subTitle %></h3>
        <% for (var sp = 1; sp <= 2; sp++) {
          var spText = tryKeys('section' + s + '.sub' + sub + 'P' + sp);
          if (spText) { %>
        <p class="text-muted-foreground leading-relaxed mb-3"><%- spText %></p>
        <% } } %>
      </div>
      <% } %>
    </section>
    <% } %>

    <% if (faqEntries.length > 0) { %>
    <%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: (typeof quizTitle !== 'undefined' ? quizTitle : (typeof rawTitle !== 'undefined' ? rawTitle : '')) }) %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">FAQ</h2>
