<script src="/js/quiz-engine-core.js" defer></script>
<script>
// Would You Rather - Custom Duo Quiz Engine
(function() {
  'use strict';

  var UI = <%- JSON.stringify(ui) %>;

  function init() {
    var container = document.getElementById('wyr-quiz');
    if (!container) return;
    var lang = container.dataset.lang || 'fr';

    QuizEngine.loadTranslations(lang, function() {
      var questions = parseQuestions();
      if (questions.length === 0) {
        container.innerHTML = '<p class="text-center text-muted-foreground py-8">Loading...</p>';
        return;
      }
      // Le pool complet est mélangé, la partie n'en garde qu'un extrait :
      // deux parties de suite ne tombent pas sur les mêmes dilemmes.
      var parPartie = <%= PAR_PARTIE %>;
      questions = QuizEngine.shuffleArray(questions);
      if (questions.length > parPartie) questions = questions.slice(0, parPartie);
      new WYRGame(container, questions);
    }, ['wyr']);
  }

  function parseQuestions() {
    var questions = [];
    for (var i = 1; i <= 100; i++) {
      var qText = QuizEngine.tgd('wyr.q' + i, null);
      if (!qText || qText === 'wyr.q' + i) {
        if (questions.length > 0 && i > questions[questions.length - 1].id + 3) break;
        continue;
      }
      var optA = QuizEngine.tgd('wyr.q' + i + 'a', null);
      var optB = QuizEngine.tgd('wyr.q' + i + 'b', null);
      if (optA && optB && optA !== 'wyr.q' + i + 'a' && optB !== 'wyr.q' + i + 'b') {
        questions.push({ id: i, text: qText, a: optA, b: optB });
      }
    }
    return questions;
  }

  // ── Game constructor ──
  function WYRGame(container, questions) {
    this.container = container;
    this.questions = questions;
    this.totalQ = questions.length;
    this.currentQ = 0;
    this.p1Name = '';
    this.p2Name = '';
    this.p1Answers = [];
    this.p2Answers = [];
    this.currentPlayer = 1; // 1 or 2
    this.phase = 'setup'; // setup, handoff, playing, reveal, results
    this.render();
  }

  WYRGame.prototype.render = function() {
    switch (this.phase) {
      case 'setup': this.renderSetup(); break;
      case 'handoff': this.renderHandoff(); break;
      case 'playing': this.renderQuestion(); break;
      case 'reveal': this.renderReveal(); break;
      case 'results': this.renderResults(); break;
    }
  };

  // ── Setup: enter names ──
  WYRGame.prototype.renderSetup = function() {
    var self = this;
    var html = '<div class="glass-card rounded-xl p-8 text-center animate-fade-in">';
    html += '<div class="text-5xl mb-4">🤔</div>';
    html += '<h2 class="text-2xl font-bold mb-2">' + UI.or + '...</h2>';
    html += '<p class="text-muted-foreground mb-6">' + UI.intro + '</p>';
    html += '<div class="max-w-xs mx-auto space-y-3 mb-6">';
    html += '<input type="text" id="wyr-p1" class="w-full px-4 py-3 rounded-lg border border-border bg-card text-foreground text-center" placeholder="' + UI.name1 + ', ' + UI.namePlaceholder + '" maxlength="20" />';
    html += '<input type="text" id="wyr-p2" class="w-full px-4 py-3 rounded-lg border border-border bg-card text-foreground text-center" placeholder="' + UI.name2 + ', ' + UI.namePlaceholder + '" maxlength="20" />';
    html += '</div>';
    html += '<button type="button" class="btn btn-cta" id="wyr-start">' + UI.startGame + '</button>';
    html += '</div>';
    this.container.innerHTML = html;

    document.getElementById('wyr-start').addEventListener('click', function() {
      self.p1Name = (document.getElementById('wyr-p1').value || '').trim() || UI.name1;
      self.p2Name = (document.getElementById('wyr-p2').value || '').trim() || UI.name2;
      self.currentPlayer = 1;
      self.currentQ = 0;
      self.phase = 'handoff';
      self.render();
    });
  };

  // ── Handoff screen ──
  WYRGame.prototype.renderHandoff = function() {
    var self = this;
    var name = this.currentPlayer === 1 ? this.p1Name : this.p2Name;
    var emoji = this.currentPlayer === 1 ? '👋' : '🫣';
    var html = '<div class="glass-card rounded-xl p-8 text-center animate-fade-in">';
    html += '<div class="text-5xl mb-4">' + emoji + '</div>';
    html += '<p class="text-lg text-muted-foreground mb-2">' + UI.passPhone + '</p>';
    html += '<h2 class="text-2xl font-bold mb-6" style="color: var(--primary)">' + QuizEngine.esc(name) + '</h2>';
    html += '<p class="text-sm text-muted-foreground mb-6">' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.totalQ + '</p>';
    html += '<button type="button" class="btn btn-cta" id="wyr-ready">' + UI.ready + '</button>';
    html += '</div>';
    this.container.innerHTML = html;

    document.getElementById('wyr-ready').addEventListener('click', function() {
      self.phase = 'playing';
      self.render();
    });
  };

  // ── Question screen ──
  WYRGame.prototype.renderQuestion = function() {
    var self = this;
    var q = this.questions[this.currentQ];
    var totalSteps = this.totalQ * 2;
    var doneSteps = this.currentQ * 2 + (this.currentPlayer === 2 ? 1 : 0);
    var progress = Math.round((doneSteps / totalSteps) * 100);
    var name = this.currentPlayer === 1 ? this.p1Name : this.p2Name;

    var html = '<div class="glass-card rounded-xl p-6 animate-fade-in">';

    // Player indicator + progress
    html += '<div class="mb-5">';
    html += '<div class="flex justify-between items-center text-sm text-muted-foreground mb-2">';
    html += '<span class="font-medium" style="color: var(--primary)">' + QuizEngine.esc(name) + '</span>';
    html += '<span>' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.totalQ + '</span>';
    html += '</div>';
    html += '<div class="w-full bg-muted rounded-full h-1.5">';
    html += '<div class="bg-primary h-1.5 rounded-full transition-all duration-500" style="width:' + progress + '%"></div>';
    html += '</div></div>';

    // Question
    html += '<h3 class="text-lg md:text-xl font-semibold mb-8 text-foreground text-center leading-relaxed">' + q.text + '</h3>';

    // Options A/B with VS divider
    html += '<div class="wyr-options">';

    // Option A
    html += '<button type="button" class="wyr-option wyr-option-a" data-choice="a">';
    html += '<span class="wyr-option-label">A</span>';
    html += '<span class="wyr-option-text">' + q.a + '</span>';
    html += '</button>';

    // VS divider
    html += '<div class="wyr-vs"><span>' + UI.or + '</span></div>';

    // Option B
    html += '<button type="button" class="wyr-option wyr-option-b" data-choice="b">';
    html += '<span class="wyr-option-label">B</span>';
    html += '<span class="wyr-option-text">' + q.b + '</span>';
    html += '</button>';

    html += '</div></div>';

    this.container.innerHTML = html;

    // Bind clicks
    var buttons = this.container.querySelectorAll('.wyr-option');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener('click', function() {
        var choice = this.getAttribute('data-choice');
        self.selectOption(choice, this);
      });
    }
  };

  WYRGame.prototype.selectOption = function(choice, btn) {
    // pointer-events ne bloque que la souris : au clavier, deux « Entrée »
    // rapides déclenchaient deux fois la transition et sautaient le tour du
    // joueur 2. On verrouille donc explicitement le temps de l'animation.
    if (this.locked) return;
    this.locked = true;

    // Visual feedback
    var buttons = this.container.querySelectorAll('.wyr-option');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].style.pointerEvents = 'none';
      if (buttons[i] === btn) {
        buttons[i].classList.add('wyr-selected');
      } else {
        buttons[i].classList.add('wyr-not-selected');
      }
    }

    // Store answer
    if (this.currentPlayer === 1) {
      this.p1Answers[this.currentQ] = choice;
    } else {
      this.p2Answers[this.currentQ] = choice;
    }

    var self = this;
    setTimeout(function() {
      if (self.currentPlayer === 1) {
        // P1 just answered → handoff to P2 for same question
        self.currentPlayer = 2;
        self.phase = 'handoff';
      } else {
        // P2 just answered → show reveal for this question
        self.phase = 'reveal';
      }
      self.locked = false;
      self.render();
    }, 350);
  };

  // ── Reveal: show both answers for the current question ──
  WYRGame.prototype.renderReveal = function() {
    var self = this;
    var q = this.questions[this.currentQ];
    var p1 = this.p1Answers[this.currentQ];
    var p2 = this.p2Answers[this.currentQ];
    var same = p1 === p2;

    var html = '<div class="glass-card rounded-xl p-6 text-center animate-fade-in">';
    html += '<div class="text-4xl mb-3">' + (same ? '🎉' : '😅') + '</div>';
    html += '<h3 class="text-lg font-semibold mb-1">' + (same ? UI.sameChoice : UI.diffChoice) + '</h3>';
    html += '<p class="text-sm text-muted-foreground mb-6">' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.totalQ + '</p>';

    // Question text
    html += '<p class="text-base text-muted-foreground mb-5">' + q.text + '</p>';

    // Show both answers side by side
    html += '<div class="grid grid-cols-2 gap-3 mb-6">';

    html += '<div class="p-3 rounded-lg ' + (same ? 'bg-green-500/10 border border-green-500/20' : 'bg-muted') + '">';
    html += '<p class="text-xs font-medium text-muted-foreground mb-1">' + QuizEngine.esc(this.p1Name) + '</p>';
    html += '<p class="text-sm font-semibold text-foreground">' + (p1 === 'a' ? q.a : q.b) + '</p>';
    html += '</div>';

    html += '<div class="p-3 rounded-lg ' + (same ? 'bg-green-500/10 border border-green-500/20' : 'bg-muted') + '">';
    html += '<p class="text-xs font-medium text-muted-foreground mb-1">' + QuizEngine.esc(this.p2Name) + '</p>';
    html += '<p class="text-sm font-semibold text-foreground">' + (p2 === 'a' ? q.a : q.b) + '</p>';
    html += '</div>';

    html += '</div>';

    // Next button
    var isLast = this.currentQ >= this.totalQ - 1;
    html += '<button type="button" class="btn btn-cta" id="wyr-next">' + (isLast ? UI.done : UI.next) + '</button>';
    html += '</div>';

    this.container.innerHTML = html;

    document.getElementById('wyr-next').addEventListener('click', function() {
      if (isLast) {
        self.phase = 'results';
      } else {
        self.currentQ++;
        self.currentPlayer = 1;
        self.phase = 'handoff';
      }
      self.render();
    });
  };

  // ── Results ──
  WYRGame.prototype.renderResults = function() {
    var self = this;
    var matches = 0;
    var details = [];

    for (var i = 0; i < this.totalQ; i++) {
      var same = this.p1Answers[i] === this.p2Answers[i];
      if (same) matches++;
      details.push({
        q: this.questions[i],
        p1: this.p1Answers[i],
        p2: this.p2Answers[i],
        match: same
      });
    }

    var pct = Math.round((matches / this.totalQ) * 100);
    var emoji = pct >= 80 ? '🔥' : pct >= 60 ? '💕' : pct >= 40 ? '😄' : '🤷';

    var html = '<div class="glass-card rounded-xl p-6 animate-fade-in">';

    // Score hero
    html += '<div class="text-center mb-8">';
    html += '<div class="text-5xl mb-3">' + emoji + '</div>';
    html += '<p class="text-sm text-muted-foreground mb-2">' + UI.matchRate + '</p>';
    html += '<h2 class="text-4xl md:text-5xl font-bold text-primary mb-1">' + pct + '%</h2>';
    html += '<p class="text-muted-foreground">' + matches + '/' + this.totalQ + ' ' + UI.agree + '</p>';
    html += '</div>';

    // Agreement bar
    html += '<div class="mb-8">';
    html += '<div class="w-full bg-muted rounded-full h-4 overflow-hidden">';
    html += '<div class="h-4 rounded-full transition-all duration-1000" style="width:' + pct + '%;background:linear-gradient(90deg, hsl(340,65%,65%), hsl(270,40%,70%))"></div>';
    html += '</div></div>';

    // Question-by-question breakdown
    html += '<div class="space-y-3 mb-8">';
    for (var d = 0; d < details.length; d++) {
      var det = details[d];
      var matchIcon = det.match ? '✅' : '❌';
      var matchClass = det.match ? 'border-green-500/30 bg-green-500/5' : 'border-red-500/30 bg-red-500/5';

      html += '<details class="border rounded-lg ' + matchClass + '">';
      html += '<summary class="p-3 cursor-pointer flex items-center gap-2 text-sm">';
      html += '<span>' + matchIcon + '</span>';
      html += '<span class="font-medium text-foreground flex-1">' + (d + 1) + '. ' + det.q.text + '</span>';
      html += '</summary>';
      html += '<div class="px-3 pb-3 grid grid-cols-2 gap-2 text-sm">';

      // P1 choice
      html += '<div class="p-2 rounded-lg ' + (det.p1 === 'a' ? 'bg-primary/10 border border-primary/20' : 'bg-muted') + '">';
      html += '<p class="font-medium text-xs text-muted-foreground mb-1">' + QuizEngine.esc(this.p1Name) + '</p>';
      html += '<p class="text-foreground">' + (det.p1 === 'a' ? det.q.a : det.q.b) + '</p>';
      html += '</div>';

      // P2 choice
      html += '<div class="p-2 rounded-lg ' + (det.p2 === 'a' ? 'bg-primary/10 border border-primary/20' : 'bg-muted') + '">';
      html += '<p class="font-medium text-xs text-muted-foreground mb-1">' + QuizEngine.esc(this.p2Name) + '</p>';
      html += '<p class="text-foreground">' + (det.p2 === 'a' ? det.q.a : det.q.b) + '</p>';
      html += '</div>';

      html += '</div></details>';
    }
    html += '</div>';

    // Retake
    html += '<div class="text-center">';
    html += '<button type="button" class="btn btn-outline" id="wyr-retake">' + UI.retake + '</button>';
    html += '</div>';

    html += '</div>';
    this.container.innerHTML = html;

    document.getElementById('wyr-retake').addEventListener('click', function() {
      self.p1Answers = [];
      self.p2Answers = [];
      self.currentQ = 0;
      self.currentPlayer = 1;
      self.questions = QuizEngine.shuffleArray(self.questions);
      self.phase = 'setup';
      self.render();
      self.container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    this.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
