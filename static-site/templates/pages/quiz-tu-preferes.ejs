        </details>
        <% } %>
      </div>
    </section>
    <% } %>
    </div>
    <%# La colonne laterale n'existe qu'au-dela de 1440 px, la ou il reste
        de la place a cote d'un texte qui reste centre. En dessous elle
        n'est pas affichee : le contenu garde sa mise en page d'avant. %>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %>
    <aside class="avec-colonne__aside"><%- include('../partials/pub', { format: 3 }) %></aside>
    <% } %>
