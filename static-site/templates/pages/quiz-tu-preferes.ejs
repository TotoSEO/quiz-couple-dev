<script src="/js/quiz-engine-core.js" defer></script>
<script>
// Would You Rather - Custom Duo Quiz Engine
(function() {
  'use strict';

  var UI = <%- JSON.stringify(ui) %>;

  function init() {
    var container = document.getElementById('wyr-quiz');
    if (!container) return;
    var lang = container.dataset.lang || 'fr';

    QuizEngine.loadTranslations(lang, function() {
      var questions = parseQuestions();
      if (questions.length === 0) {
        container.innerHTML = '<p class="text-center text-muted-foreground py-8">Loading...</p>';
        return;
      }
      // Le pool complet est mélangé, la partie n'en garde qu'un extrait :
      // deux parties de suite ne tombent pas sur les mêmes dilemmes. On tire
      // toujours la longueur maximale, la partie courte s'arrête simplement
      // plus tôt : c'est ce qui permet de prolonger sans retirer au sort.
      var parPartie = <%= PAR_PARTIE %>;
      questions = QuizEngine.shuffleArray(questions);
      if (questions.length > parPartie) questions = questions.slice(0, parPartie);
      new WYRGame(container, questions);
    }, ['wyr']);
  }

  function parseQuestions() {
    var questions = [];
    for (var i = 1; i <= 100; i++) {
      var qText = QuizEngine.tgd('wyr.q' + i, null);
      if (!qText || qText === 'wyr.q' + i) {
        if (questions.length > 0 && i > questions[questions.length - 1].id + 3) break;
        continue;
      }
      var optA = QuizEngine.tgd('wyr.q' + i + 'a', null);
      var optB = QuizEngine.tgd('wyr.q' + i + 'b', null);
      if (optA && optB && optA !== 'wyr.q' + i + 'a' && optB !== 'wyr.q' + i + 'b') {
        questions.push({ id: i, text: qText, a: optA, b: optB });
      }
    }
    return questions;
  }

  // ── Game constructor ──
  function WYRGame(container, questions) {
    this.container = container;
    this.questions = questions;
    // Nombre de dilemmes réellement joués. Il vaut 15 ou 30 selon le format
    // choisi au départ, et peut passer de 15 à 30 au palier. this.questions
    // en contient toujours 30 : prolonger ne retire donc rien au sort.
    this.limite = Math.min(<%= PARTIE_COURTE %>, questions.length);
    this.currentQ = 0;
    this.p1Name = '';
    this.p2Name = '';
    this.p1Answers = [];
    this.p2Answers = [];
    this.currentPlayer = 1; // 1 or 2
    this.phase = 'setup'; // setup, handoff, playing, reveal, results
    this.render();
  }

  WYRGame.prototype.render = function() {
    switch (this.phase) {
      case 'setup': this.renderSetup(); break;
      case 'handoff': this.renderHandoff(); break;
      case 'playing': this.renderQuestion(); break;
      case 'reveal': this.renderReveal(); break;
      case 'results': this.renderResults(); break;
    }
  };

  // ── Setup: enter names ──
  // Le choix de la longueur est posé ici, avec les prénoms, plutôt que sur un
  // écran de plus : la page perd déjà largement au moment du lancement, il
  // n'était pas question d'y ajouter une étape.
  WYRGame.prototype.renderSetup = function() {
    var self = this;
    var court = Math.min(<%= PARTIE_COURTE %>, this.questions.length);
    var long = this.questions.length;
    var choisi = court;

    // « OU… » était un h2 : un titre de niveau deux vide de sens au milieu
    // d'une page qui a déjà sa hiérarchie. C'est une accroche, pas un titre.
    var html = '<div class="wyr-carte wyr-carte--depart">';
    html += '<div class="wyr-macaron" aria-hidden="true"><span>🤔</span></div>';
    html += '<p class="wyr-accroche">' + UI.or + '…</p>';
    html += '<p class="wyr-intro">' + UI.intro + '</p>';
    html += '<div class="wyr-champs">';
    html += '<input type="text" id="wyr-p1" class="wyr-champ" placeholder="' + UI.name1 + ', ' + UI.namePlaceholder + '" maxlength="20" />';
    html += '<input type="text" id="wyr-p2" class="wyr-champ" placeholder="' + UI.name2 + ', ' + UI.namePlaceholder + '" maxlength="20" />';
    html += '</div>';

    if (long > court) {
      html += '<p class="wyr-format-titre">' + UI.formatTitre + '</p>';
      html += '<div class="wyr-formats" role="radiogroup" aria-label="' + UI.formatTitre + '">';
      html += '<button type="button" class="wyr-format wyr-format--actif" data-taille="' + court + '" role="radio" aria-checked="true">' +
        '<span class="wyr-format-nb">' + court + '</span>' +
        '<span class="wyr-format-nom">' + UI.formatCourtNom + '</span>' +
        '<span class="wyr-format-sub">' + UI.formatCourtSub + '</span></button>';
      html += '<button type="button" class="wyr-format" data-taille="' + long + '" role="radio" aria-checked="false">' +
        '<span class="wyr-format-nb">' + long + '</span>' +
        '<span class="wyr-format-nom">' + UI.formatLongNom + '</span>' +
        '<span class="wyr-format-sub">' + UI.formatLongSub + '</span></button>';
      html += '</div>';
    }

    html += '<button type="button" class="wyr-cta" id="wyr-start">' + UI.startGame + '</button>';
    html += '</div>';
    this.container.innerHTML = html;

    var chips = this.container.querySelectorAll('.wyr-format');
    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener('click', function() {
        choisi = parseInt(this.getAttribute('data-taille'), 10) || court;
        for (var j = 0; j < chips.length; j++) {
          var actif = chips[j] === this;
          chips[j].classList.toggle('wyr-format--actif', actif);
          chips[j].setAttribute('aria-checked', actif ? 'true' : 'false');
        }
      });
    }

    document.getElementById('wyr-start').addEventListener('click', function() {
      self.p1Name = (document.getElementById('wyr-p1').value || '').trim() || UI.name1;
      self.p2Name = (document.getElementById('wyr-p2').value || '').trim() || UI.name2;
      self.limite = choisi;
      self.currentPlayer = 1;
      self.currentQ = 0;
      self.phase = 'handoff';
      self.render();
    });
  };

  // ── Prolongation, proposée sur l'écran de résultat ──
  // Le palier n'est pas un écran de plus avant les résultats : la partie
  // courte va jusqu'au bout, le couple voit son score, et c'est seulement
  // ensuite qu'on propose la suite. Celui qui vient d'enchaîner quinze
  // dilemmes a montré qu'il accrochait, l'offre tombe donc au bon moment, et
  // aucun bouton ne promet un écran qu'il ne donne pas.
  WYRGame.prototype.blocProlonger = function() {
    var restant = this.questions.length - this.limite;
    if (restant <= 0) return '';
    var html = '<div class="wyr-palier">';
    html += '<div class="wyr-palier-macaron" aria-hidden="true"><span>🔥</span></div>';
    html += '<p class="wyr-palier-titre">' + UI.palierTitre + '</p>';
    html += '<p class="wyr-palier-texte">' + UI.palierTexte + '</p>';
    html += '<button type="button" class="btn btn-cta wyr-palier-btn" id="wyr-plus">' +
      UI.palierContinuer.replace('15', restant) + '</button>';
    html += '</div>';
    return html;
  };

  WYRGame.prototype.brancheProlonger = function() {
    var self = this;
    var btn = document.getElementById('wyr-plus');
    if (!btn) return;
    btn.addEventListener('click', function() {
      // Les réponses déjà données sont conservées : la prolongation reprend
      // le dilemme suivant du même tirage, elle ne relance pas une partie.
      self.limite = self.questions.length;
      self.currentQ++;
      self.currentPlayer = 1;
      self.phase = 'handoff';
      self.render();
      self.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  // ── Relais entre les deux joueurs ──
  // L'ancien écran demandait un clic sur « Je suis prêt(e) » avant chaque
  // réponse, soit soixante clics sur une partie de trente dilemmes jouée à
  // deux. Le bandeau partagé annonce le joueur et s'efface seul au bout de
  // 1,3 s ; un appui dessus coupe l'attente pour qui va plus vite.
  WYRGame.prototype.renderHandoff = function() {
    var self = this;
    this.container.innerHTML = '';
    this.container.appendChild(QuizEngine.relaisJoueur(this, {
      nom: this.currentPlayer === 1 ? this.p1Name : this.p2Name,
      emoji: this.currentPlayer === 1 ? '👋' : '🫣',
      etape: (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.limite,
      suite: function() { self.phase = 'playing'; self.render(); }
    }));
  };

  // ── Question screen ──
  WYRGame.prototype.renderQuestion = function() {
    var self = this;
    var q = this.questions[this.currentQ];
    var totalSteps = this.limite * 2;
    var doneSteps = this.currentQ * 2 + (this.currentPlayer === 2 ? 1 : 0);
    var progress = Math.round((doneSteps / totalSteps) * 100);
    var name = this.currentPlayer === 1 ? this.p1Name : this.p2Name;

    var html = '<div class="wyr-carte wyr-carte--question">';

    html += '<div class="wyr-entete">';
    html += '<span class="wyr-joueur">' + QuizEngine.esc(name) + '</span>';
    html += '<span class="wyr-compteur">' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.limite + '</span>';
    html += '</div>';
    html += '<div class="wyr-barre" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + progress + '">';
    html += '<span style="width:' + progress + '%"></span></div>';

    html += '<h3 class="wyr-question">' + q.text + '</h3>';

    html += '<div class="wyr-options">';
    html += '<button type="button" class="wyr-option wyr-option--a" data-choice="a">';
    html += '<span class="wyr-option-lettre">A</span>';
    html += '<span class="wyr-option-texte">' + q.a + '</span>';
    html += '</button>';
    // Le médaillon « OU » chevauche les deux cartes : c'est lui qui fait lire
    // le duel comme un duel plutôt que comme une liste de deux réponses.
    html += '<div class="wyr-ou" aria-hidden="true"><span>' + UI.or + '</span></div>';
    html += '<button type="button" class="wyr-option wyr-option--b" data-choice="b">';
    html += '<span class="wyr-option-lettre">B</span>';
    html += '<span class="wyr-option-texte">' + q.b + '</span>';
    html += '</button>';

    html += '</div></div>';

    this.container.innerHTML = html;

    // Bind clicks
    var buttons = this.container.querySelectorAll('.wyr-option');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener('click', function() {
        var choice = this.getAttribute('data-choice');
        self.selectOption(choice, this);
      });
    }
  };

  WYRGame.prototype.selectOption = function(choice, btn) {
    // pointer-events ne bloque que la souris : au clavier, deux « Entrée »
    // rapides déclenchaient deux fois la transition et sautaient le tour du
    // joueur 2. On verrouille donc explicitement le temps de l'animation.
    if (this.locked) return;
    // Le relais vient de s'effacer tout seul : sans ce délai, un doigt déjà
    // parti vers le bandeau retombe sur une option et la valide à la place du
    // joueur. Le verrou est posé par QuizEngine.relaisJoueur.
    if (this.__answerLockUntil && Date.now() < this.__answerLockUntil) return;
    this.locked = true;

    // Visual feedback
    var buttons = this.container.querySelectorAll('.wyr-option');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].style.pointerEvents = 'none';
      if (buttons[i] === btn) {
        buttons[i].classList.add('wyr-option--pris');
      } else {
        buttons[i].classList.add('wyr-option--ecarte');
      }
    }

    // Store answer
    if (this.currentPlayer === 1) {
      this.p1Answers[this.currentQ] = choice;
    } else {
      this.p2Answers[this.currentQ] = choice;
    }

    var self = this;
    setTimeout(function() {
      if (self.currentPlayer === 1) {
        // P1 just answered → handoff to P2 for same question
        self.currentPlayer = 2;
        self.phase = 'handoff';
      } else {
        // P2 just answered → show reveal for this question
        self.phase = 'reveal';
      }
      self.locked = false;
      self.render();
    }, 350);
  };

  // ── Reveal: show both answers for the current question ──
  WYRGame.prototype.renderReveal = function() {
    var self = this;
    var q = this.questions[this.currentQ];
    var p1 = this.p1Answers[this.currentQ];
    var p2 = this.p2Answers[this.currentQ];
    var same = p1 === p2;

    // Accord et désaccord se lisaient au vert et au rouge de Tailwind, en
    // dur, sans équivalent sombre. Ils passent par les deux jetons du jeu.
    var ton = same ? 'ok' : 'non';

    var html = '<div class="wyr-carte wyr-carte--reveal wyr-carte--' + ton + '">';
    html += '<div class="wyr-macaron wyr-macaron--' + ton + '" aria-hidden="true"><span>' + (same ? '🎉' : '😅') + '</span></div>';
    html += '<p class="wyr-verdict">' + (same ? UI.sameChoice : UI.diffChoice) + '</p>';
    html += '<p class="wyr-compteur-seul">' + (this.currentQ + 1) + ' ' + UI.qOf + ' ' + this.limite + '</p>';
    html += '<p class="wyr-rappel">' + q.text + '</p>';

    html += '<div class="wyr-duel">';
    html += '<div class="wyr-duel-cote wyr-duel-cote--' + ton + '">';
    html += '<span class="wyr-duel-nom">' + QuizEngine.esc(this.p1Name) + '</span>';
    html += '<span class="wyr-duel-choix">' + (p1 === 'a' ? q.a : q.b) + '</span>';
    html += '</div>';
    html += '<div class="wyr-duel-cote wyr-duel-cote--' + ton + '">';
    html += '<span class="wyr-duel-nom">' + QuizEngine.esc(this.p2Name) + '</span>';
    html += '<span class="wyr-duel-choix">' + (p2 === 'a' ? q.a : q.b) + '</span>';
    html += '</div>';
    html += '</div>';

    // Next button
    var isLast = this.currentQ >= this.limite - 1;
    html += '<button type="button" class="wyr-cta" id="wyr-next">' + (isLast ? UI.done : UI.next) + '</button>';
    html += '</div>';

    this.container.innerHTML = html;

    document.getElementById('wyr-next').addEventListener('click', function() {
      if (isLast) {
        self.phase = 'results';
      } else {
        self.currentQ++;
        self.currentPlayer = 1;
        self.phase = 'handoff';
      }
      self.render();
    });
  };

  // ── Results ──
  WYRGame.prototype.renderResults = function() {
    var self = this;
    var matches = 0;
    var details = [];

    for (var i = 0; i < this.limite; i++) {
      var same = this.p1Answers[i] === this.p2Answers[i];
      if (same) matches++;
      details.push({
        q: this.questions[i],
        p1: this.p1Answers[i],
        p2: this.p2Answers[i],
        match: same
      });
    }

    var pct = Math.round((matches / this.limite) * 100);
    var emoji = pct >= 80 ? '🔥' : pct >= 60 ? '💕' : pct >= 40 ? '😄' : '🤷';

    // data-quiz-done signale la fin de partie au suivi des completions : cet
    // ecran a son propre habillage et ne peut pas porter .quiz-result-card.
    var html = '<div class="wyr-carte wyr-carte--resultat" data-quiz-done="1">';

    html += '<div class="wyr-macaron" aria-hidden="true"><span>' + emoji + '</span></div>';
    html += '<p class="wyr-score-label">' + UI.matchRate + '</p>';
    html += '<p class="wyr-score-nb">' + pct + '<span class="wyr-score-pct">%</span></p>';
    html += '<p class="wyr-score-sub">' + matches + '/' + this.limite + ' ' + UI.agree + '</p>';

    html += '<div class="wyr-jauge" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + pct + '">';
    html += '<span style="width:' + pct + '%"></span></div>';

    // Proposition de prolonger, avant le détail : c'est la seule chose sur
    // laquelle on veut que l'œil tombe juste après le score.
    html += this.blocProlonger();

    // Question-by-question breakdown
    html += '<div class="wyr-detail">';
    for (var d = 0; d < details.length; d++) {
      var det = details[d];
      var ton = det.match ? 'ok' : 'non';

      html += '<details class="wyr-ligne wyr-ligne--' + ton + '">';
      html += '<summary class="wyr-ligne-tete">';
      html += '<span class="wyr-ligne-pastille" aria-hidden="true">' + (det.match ? '✓' : '✗') + '</span>';
      html += '<span class="wyr-ligne-texte">' + (d + 1) + '. ' + det.q.text + '</span>';
      html += '</summary>';
      html += '<div class="wyr-duel wyr-duel--compact">';

      html += '<div class="wyr-duel-cote wyr-duel-cote--' + ton + '">';
      html += '<span class="wyr-duel-nom">' + QuizEngine.esc(this.p1Name) + '</span>';
      html += '<span class="wyr-duel-choix">' + (det.p1 === 'a' ? det.q.a : det.q.b) + '</span>';
      html += '</div>';

      html += '<div class="wyr-duel-cote wyr-duel-cote--' + ton + '">';
      html += '<span class="wyr-duel-nom">' + QuizEngine.esc(this.p2Name) + '</span>';
      html += '<span class="wyr-duel-choix">' + (det.p2 === 'a' ? det.q.a : det.q.b) + '</span>';
      html += '</div>';

      html += '</div></details>';
    }
    html += '</div>';

    html += '<button type="button" class="wyr-relance" id="wyr-retake">' + UI.retake + '</button>';
    html += '</div>';
    this.container.innerHTML = html;

    this.brancheProlonger();

    document.getElementById('wyr-retake').addEventListener('click', function() {
      // La partie repart sur place, sans rechargement : l'adresse annoncerait
      // sinon un résultat devant l'écran de départ.
      if (window.QCResultat) window.QCResultat.retour();
      self.p1Answers = [];
      self.p2Answers = [];
      self.currentQ = 0;
      self.currentPlayer = 1;
      // On revient à l'écran de départ, donc au choix de la longueur : la
      // limite est remise à la partie courte pour que les deux cases soient
      // dans le même état qu'à la première partie.
      self.limite = Math.min(<%= PARTIE_COURTE %>, self.questions.length);
      self.questions = QuizEngine.shuffleArray(self.questions);
      self.phase = 'setup';
      self.render();
      self.container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Les moteurs partagés signalent leur résultat depuis dispositionResultat ;
    // ce jeu construit son propre écran et ne passe donc jamais par là. Sans
    // cet appel, ce serait la seule page dont l'écran de résultat ne prendrait
    // pas son adresse.
    var self2 = this;
    if (window.QCResultat) {
      window.QCResultat.arrivee(this.container.firstElementChild, {
        lang: this.container.dataset.lang || document.documentElement.lang || 'fr',
        apres: function () {
          try { self2.container.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
          catch (e) { self2.container.scrollIntoView(); }
        }
      });
    } else {
      this.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<style>
/* ══ Habillage du jeu « tu préfères » ═══════════════════════════════════════
   Cette feuille écrivait var(--border), var(--card) et var(--foreground),
   alors que ces variables ne contiennent que des composantes HSL
   (« 280 20% 88% »). Le navigateur ignorait donc ces déclarations : le
   moteur s'affichait sans bordures, sur des cartes de verre héritées de
   l'ancienne direction artistique. Tout passe ici par hsl(var(--x)) et par
   la grammaire de la charte : bordure épaisse, ombre dure sans flou,
   éléments légèrement de travers, macaron qui déborde du cadre. */
.wyr-jeu {
  --ink: 268 45% 27%;
  --wyr-ok: 158 58% 38%;
  --wyr-non: 12 76% 55%;
}
.dark .wyr-jeu {
  --ink: 270 30% 62%;
  --wyr-ok: 158 52% 52%;
  --wyr-non: 12 78% 62%;
}

/* ── Le cadre commun aux quatre écrans ───────────────────────────────────── */
.wyr-carte {
  position: relative;
  max-width: 34rem;
  margin: 0 auto;
  padding: 2.4rem 1.15rem 1.6rem;
  border-radius: 1.8rem;
  border: 3px solid hsl(var(--ink));
  background: hsl(var(--card));
  box-shadow: 7px 8px 0 hsl(var(--ink));
  text-align: center;
  animation: wyrEntree 320ms cubic-bezier(.34, 1.42, .64, 1) both;
}
.wyr-carte--depart, .wyr-carte--reveal { transform: rotate(-0.7deg); }
.wyr-carte--question { transform: rotate(0.4deg); }
.wyr-carte--resultat { transform: rotate(-0.4deg); }

@keyframes wyrEntree {
  from { opacity: 0; transform: translateY(14px) scale(0.97); }
}

/* Le macaron déborde du cadre : c'est lui qui casse le rectangle et fait
   lire l'écran comme un objet posé sur la page. */
.wyr-macaron {
  position: absolute; top: -1.4rem; left: -0.9rem;
  width: 3.6rem; height: 3.6rem;
  display: grid; place-items: center;
  font-size: 1.7rem; line-height: 1;
  border-radius: 999px;
  border: 3px solid hsl(var(--ink));
  background: linear-gradient(150deg, hsl(338 84% 64%), hsl(16 92% 60%));
  box-shadow: 4px 4px 0 hsl(var(--ink));
  transform: rotate(-12deg);
}
.wyr-macaron > span { display: block; transform: rotate(12deg); }
.wyr-macaron--ok  { background: linear-gradient(150deg, hsl(var(--wyr-ok)), hsl(170 60% 45%)); }
.wyr-macaron--non { background: linear-gradient(150deg, hsl(var(--wyr-non)), hsl(38 92% 58%)); }

/* ── Écran de départ ─────────────────────────────────────────────────────── */
.wyr-accroche {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 2rem; font-weight: 800; letter-spacing: 0.04em;
  color: hsl(var(--primary));
  margin: 0 0 0.5rem;
}
.wyr-intro {
  color: hsl(var(--muted-foreground));
  margin: 0 0 1.5rem; font-size: 0.95rem; line-height: 1.55;
  text-wrap: pretty;
}
.wyr-champs {
  display: flex; flex-direction: column; gap: 0.7rem;
  max-width: 20rem; margin: 0 auto 1.6rem;
}
.wyr-champ {
  width: 100%;
  padding: 0.85rem 1rem;
  font: inherit; text-align: center;
  border-radius: 1rem;
  border: 2.5px solid hsl(var(--ink) / 0.8);
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  transition: border-color 160ms ease, box-shadow 160ms ease;
}
.wyr-champ::placeholder { color: hsl(var(--muted-foreground)); }
.wyr-champ:focus {
  outline: none;
  border-color: hsl(var(--primary));
  box-shadow: 4px 4px 0 hsl(var(--primary) / 0.45);
}

/* ── Choix de la longueur de partie ──────────────────────────────────────── */
.wyr-format-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 700; font-size: 0.95rem;
  color: hsl(var(--foreground));
  margin: 0 0 0.75rem;
}
.wyr-formats {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;
  align-items: stretch;
  max-width: 22rem; margin: 0 auto 1.7rem;
}
.wyr-format {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 0.15rem;
  padding: 0.9rem 0.5rem;
  border-radius: 1.1rem;
  border: 2.5px solid hsl(var(--ink) / 0.55);
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  cursor: pointer;
  transition: border-color 170ms ease, box-shadow 170ms ease, transform 170ms ease;
}
.wyr-format:hover { border-color: hsl(var(--primary)); }
.wyr-format--actif {
  border-color: hsl(var(--primary));
  box-shadow: 4px 4px 0 hsl(var(--primary) / 0.55);
  transform: translate(-1px, -1px);
}
.wyr-format:focus-visible { outline: 3px solid hsl(var(--primary)); outline-offset: 2px; }
.wyr-format-nb {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.6rem; font-weight: 800; line-height: 1;
  color: hsl(var(--muted-foreground));
  transition: color 170ms ease;
}
.wyr-format--actif .wyr-format-nb { color: hsl(var(--primary)); }
.wyr-format-nom { font-weight: 700; font-size: 0.86rem; line-height: 1.25; text-wrap: balance; }
.wyr-format-sub { font-size: 0.72rem; line-height: 1.3; color: hsl(var(--muted-foreground)); }

/* ── Bouton d'action, commun aux écrans ──────────────────────────────────── */
.wyr-cta, .wyr-relance {
  display: inline-flex; align-items: center; justify-content: center;
  width: 100%; max-width: 20rem;
  padding: 0.9rem 1.6rem;
  font: inherit; font-weight: 800;
  font-family: 'Poppins', 'Inter', sans-serif;
  border-radius: 1rem;
  border: 3px solid hsl(var(--ink));
  box-shadow: 5px 5px 0 hsl(var(--ink));
  cursor: pointer;
  transition: transform 140ms ease, box-shadow 140ms ease;
}
.wyr-cta {
  background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--secondary)));
  color: hsl(var(--primary-foreground));
}
.wyr-relance {
  margin-top: 0.4rem;
  background: hsl(var(--background));
  color: hsl(var(--foreground));
}
.wyr-cta:hover, .wyr-relance:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 hsl(var(--ink)); }
.wyr-cta:active, .wyr-relance:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 hsl(var(--ink)); }
.wyr-cta:focus-visible, .wyr-relance:focus-visible { outline: 3px solid hsl(var(--ink)); outline-offset: 3px; }

/* ── Écran de question ───────────────────────────────────────────────────── */
.wyr-entete {
  display: flex; align-items: center; justify-content: space-between;
  gap: 0.75rem; margin-bottom: 0.5rem;
}
.wyr-joueur {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 800; font-size: 0.95rem;
  color: hsl(var(--primary));
}
.wyr-compteur {
  font-size: 0.75rem; font-weight: 700;
  letter-spacing: 0.04em; text-transform: uppercase;
  color: hsl(var(--muted-foreground));
}
.wyr-barre {
  height: 0.55rem;
  border-radius: 999px;
  border: 2px solid hsl(var(--ink));
  background: hsl(var(--muted));
  overflow: hidden;
  margin-bottom: 1.7rem;
}
.wyr-barre > span {
  display: block; height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, hsl(var(--primary)), hsl(var(--secondary)));
  transition: width 420ms ease;
}
.wyr-question {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.15rem; font-weight: 700; line-height: 1.4;
  color: hsl(var(--foreground));
  margin: 0 0 2rem;
  text-wrap: balance;
}

/* Les deux options forment un duel : elles se touchent, et le médaillon
   « OU » les chevauche au point de contact. */
/* L'ombre est portée par le duel entier, pas par chaque option : les deux
   cartes se touchent, deux ombres séparées les auraient décollées l'une de
   l'autre et cassé la lecture du duel. */
.wyr-options {
  display: flex; flex-direction: column; gap: 0;
  position: relative;
  border-radius: 1.3rem;
  box-shadow: 6px 7px 0 hsl(var(--ink));
}
.wyr-option {
  display: flex; align-items: center; gap: 0.9rem;
  width: 100%;
  text-align: left;
  padding: 1.15rem 1.2rem;
  border: 3px solid hsl(var(--ink));
  background: hsl(var(--background));
  color: hsl(var(--foreground));
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, opacity 180ms ease;
}
.wyr-option--a { border-radius: 1.3rem 1.3rem 0 0; border-bottom-width: 1.5px; }
.wyr-option--b { border-radius: 0 0 1.3rem 1.3rem; border-top-width: 1.5px; }
.wyr-option:hover { background: hsl(var(--primary) / 0.08); }
.wyr-option:focus-visible { outline: 3px solid hsl(var(--primary)); outline-offset: 3px; }
.wyr-option-lettre {
  display: grid; place-items: center;
  width: 2.3rem; height: 2.3rem; flex-shrink: 0;
  border-radius: 999px;
  border: 2.5px solid hsl(var(--ink));
  background: hsl(var(--card));
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 800; font-size: 0.9rem;
  color: hsl(var(--muted-foreground));
  transition: background 180ms ease, color 180ms ease;
}
.wyr-option:hover .wyr-option-lettre {
