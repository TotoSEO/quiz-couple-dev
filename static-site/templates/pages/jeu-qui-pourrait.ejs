<%
  // Qui pourrait, version couple. Le jeu passe avant l'article : on doit
  // pouvoir entrer les prénoms sans faire défiler la page.
  const ns = 'jeu-qui-pourrait';
  const pageTitle = t('quizzes:jeuQuiPourrait.title', 'Qui pourrait ? Jeu de couple en ligne 100+ questions');

  // Une vingtaine des cent-huit questions, lues directement dans le réservoir
  // du jeu, avec l'amorce que le moteur affiche : les exemples de la page
  // sont mot pour mot ceux qui seront posés, dans toutes les langues.
  const amorce = t(ns + ':exemples.amorce', 'Qui pourrait');
  // Ponctuation de la question dans la langue de la page : « ... ? » en
  // français, "...?" ailleurs, et l'espagnol ouvre avec « ¿ ».
  const exAvant = t(ns + ':exemples.avant', '');
  const exApres = t(ns + ':exemples.apres', ' ?');
  const exemplesIds = [1, 5, 13, 17, 25, 30, 32, 38, 44, 50, 55, 58, 62, 66, 73, 76, 82, 86, 97, 106];
  const exemples = exemplesIds
    .map(function(i) { const v = tgd('quiPourrait.q' + i, ''); return v && v !== 'quiPourrait.q' + i ? v : null; })
    .filter(Boolean);

  const faqNums = [1, 2, 3, 4, 5];
  const jsonLd = [
    {
      "@context": "https://schema.org", "@type": "Game",
      "name": t(ns + ':jsonLd.name', pageTitle),
      "description": t('quizzes:jeuQuiPourrait.metaDescription', ''),
      "inLanguage": lang,
      "isAccessibleForFree": true,
      "gamePlatform": "Web browser",
      "numberOfPlayers": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 2 }
    },
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqNums.map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':faq.q' + i, ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':faq.a' + i, '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-14 md:py-20">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% if (getLocalizedUrl('jeuxCouple', lang)) { %>
          <li><a href="<%= getLocalizedUrl('jeuxCouple', lang) %>"><%= t('quizzes:jeuxCouple.shortTitle', 'Jeux de couple') %></a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <% } %>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:jeuQuiPourrait.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<!-- Le jeu -->
<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="qui-pourrait" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section1.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-4"><%- t(ns + ':section1.intro', '') %></p>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section1.intro2', '') %></p>
      <div class="space-y-4 mb-8">
        <% for (let i = 1; i <= 3; i++) { %>
        <div class="flex items-start gap-4 bg-card border border-border rounded-lg p-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center"><%= i %></span>
          <div>
            <h3 class="font-semibold mb-1"><%= t(ns + ':section1.etape' + i + 'Titre', '') %></h3>
            <p class="text-muted-foreground"><%- t(ns + ':section1.etape' + i + 'Texte', '') %></p>
          </div>
        </div>
        <% } %>
      </div>
      <p class="text-muted-foreground leading-relaxed"><%- t(ns + ':section1.apres', '') %></p>
    </section>
    <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section2.title', '') %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <p><%- t(ns + ':section2.p1', '') %></p>
        <p><%- t(ns + ':section2.p2', '') %></p>
        <p><%- t(ns + ':section2.p3', '') %></p>
      </div>
    </section>

    <% if (exemples.length) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section3.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section3.intro', '') %></p>
      <ol class="quiz-static-list">
        <% exemples.forEach(function(q) { %>
        <li class="quiz-static-item">
          <h3 class="quiz-static-q"><%= exAvant %><%= amorce %> <%= q %><%= exApres %></h3>
        </li>
        <% }) %>
      </ol>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section3.apres', '') %></p>
    </section>
    <% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':section4.title', '') %></h2>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- t(ns + ':section4.intro', '') %></p>
      <div class="quiz-resume">
        <p class="quiz-resume-titre"><%= t(ns + ':section4.resumeTitre', '') %></p>
        <ul>
          <% for (let i = 1; i <= 4; i++) { %>
          <li><%- t(ns + ':section4.resume' + i, '') %></li>
          <% } %>
        </ul>
      </div>
      <p class="text-muted-foreground leading-relaxed mt-8"><%- t(ns + ':section4.apres', '') %></p>
    </section>

    <section class="mb-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', '') %></h2>
      <div class="space-y-4">
        <% for (const i of faqNums) { %>
        <details class="bg-card border border-border rounded-lg p-5">
          <summary class="font-semibold cursor-pointer"><%= t(ns + ':faq.q' + i, '') %></summary>
          <p class="text-muted-foreground leading-relaxed mt-3"><%- t(ns + ':faq.a' + i, '') %></p>
        </details>
        <% } %>
      </div>
    </section>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
