<%
  // Gabarit propre au test de pureté. Aucune brique des autres pages de quiz
  // n'est reprise : pas de hero dégradé, pas de wave-divider, pas de bloc
  // « à faire ensuite ». Seuls l'en-tête et le pied de page du site restent,
  // parce que la page doit se lire comme un outil, pas comme un article de
  // plus. Le moteur est le premier élément après le titre.
  var ns = 'test-purete';
  function T(cle, repli) { return t(ns + ':' + cle, repli || ''); }

  var titreHero = T('hero.titre', 'Test de pureté');
  var accentHero = T('hero.titreAccent', 'spécial couple');

  // ── Sections ──
  var sections = [];
  for (var si = 1; si <= 5; si++) {
    var base = 'sections.s' + si + '.';
    var st = T(base + 'titre');
    if (!st) continue;
    var paras = [];
    for (var pi = 1; pi <= 3; pi++) { var pv = T(base + 'p' + pi); if (pv) paras.push(pv); }
    var sous = [];
    for (var bi = 1; bi <= 2; bi++) {
      var bt = T(base + 'sub' + bi + 'Titre');
      if (!bt) continue;
      var bp = [];
      for (var bj = 1; bj <= 2; bj++) { var bv = T(base + 'sub' + bi + 'P' + bj); if (bv) bp.push(bv); }
      sous.push({ titre: bt, paras: bp });
    }
    sections.push({ titre: st, paras: paras, sous: sous });
  }


  // ── Suites proposées en fin de test ──
  // Choisies à la main, pas tirées au sort. Quelqu'un qui vient de détailler
  // son passé seul n'a personne à côté de lui : on lui propose d'abord des
  // pages qu'il peut ouvrir tout de suite. Le mode couple, lui, a déjà les
  // deux personnes devant l'écran, donc on peut envoyer sur du jeu à deux.
  function suite(cle, emoji, accroche) {
    var url = getLocalizedUrl(cle, lang);
    if (!url) return null;
    return {
      url: url,
      nom: t('quizzes:' + cle + '.shortTitle', t('quizzes:' + cle + '.title', cle)),
      desc: accroche,
      emoji: emoji
    };
  }
  var suites = {
    solo: [
      suite('quizCoquin', '🔥', 'Trente questions pour voir si vos envies collent.'),
      suite('testInfidelite', '💔', 'Le doute a un nom. Vingt questions pour le poser.'),
      suite('testCouple', '💕', 'Le test de base, à faire à deux, sur votre couple.'),
      suite('jeuActionVerite', '🎲', 'Des gages et des vérités, pour quand il y a du monde.')
    ].filter(Boolean),
    couple: [
      suite('quizCoquin', '🔥', 'Vous êtes lancés ? Autant continuer sur ce terrain.'),
      suite('jeuActionVeriteHot', '🌶️', 'La version qui ne pose pas de questions faciles.'),
      suite('jeuGages', '🎡', 'La roue tourne, l\'un de vous exécute.'),
      suite('testCouple', '💕', 'On redescend d\'un cran : où en est votre couple ?')
    ].filter(Boolean)
  };

  // ── FAQ ──
  var faq = [];
  for (var fi = 1; fi <= 8; fi++) {
    var fq = T('faq.q' + fi), fa = T('faq.a' + fi);
    if (fq && fa) faq.push({ q: fq, a: fa });
  }

  // ── Données structurées ──
  // Un Quiz plutôt qu'un article : la page est un outil. On n'expose pas les
  // questions, elles n'ont aucun intérêt hors du barème et alourdiraient le
  // balisage de quarante kilo-octets.
  var jsonLd = [{
    "@context": "https://schema.org", "@type": "Quiz",
    "name": titreHero + ' ' + accentHero,
    "description": T('meta.description'),
    "inLanguage": "fr",
    "datePublished": "2026-08-12",
    "isAccessibleForFree": true,
    "learningResourceType": "Quiz",
    "interactivityType": "active",
    "educationalLevel": "adulte",
    "about": { "@type": "Thing", "name": "test de pureté couple" },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 50 },
      { "@type": "PropertyValue", "name": "modes", "value": "solo, couple" },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  }];
  if (faq.length) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faq.map(function (f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- ══ Hero ══════════════════════════════════════════════════════════════ -->
<section class="pu-hero">
  <div class="pu-hero-lueur" aria-hidden="true"></div>
  <div class="pu-hero-inner">

    <%# Les deux compteurs restent masqués tant que la base n'a pas répondu :
        un emplacement vide vaut mieux qu'un chiffre inventé. %>
    <p class="pu-hero-compteur" id="purete-compteur" hidden></p>

    <h1 class="pu-h1">
      <span class="pu-h1-mot"><%= titreHero %></span>
      <span class="pu-h1-bloc"><%= accentHero %> <span aria-hidden="true">🌡️</span></span>
    </h1>

    <p class="pu-hero-accroche"><%= T('hero.accroche') %></p>
    <p class="pu-hero-desc"><%= T('hero.description') %></p>

    <a href="#purete" class="pu-cta pu-cta--hero" id="purete-demarrer">
      <%= T('cta', 'Commencer le test') %>
      <span class="pu-cta-fleche" aria-hidden="true">→</span>
    </a>

    <p class="pu-hero-moyenne" id="purete-moyenne" hidden></p>
  </div>
</section>

<!-- ══ Moteur ════════════════════════════════════════════════════════════ -->
<section class="pu-section pu-section--moteur">
  <div class="pu-largeur">
    <div id="purete"
         data-quiz="purete"
         data-supabase-url="<%= supabaseUrl %>"
         data-supabase-key="<%= supabaseKey %>"
         data-suites="<%- escapeHtml(JSON.stringify(suites)) %>">
      <noscript>
        <p class="pu-noscript">Ce test a besoin de JavaScript pour fonctionner. Activez-le puis rechargez la page.</p>
      </noscript>
    </div>
  </div>
</section>

<!-- ══ Contenu ═══════════════════════════════════════════════════════════ -->
<article class="pu-section pu-article">
  <div class="pu-largeur">
    <% sections.forEach(function (s) { %>
    <section class="pu-bloc-texte">
      <h2 class="pu-h2"><%= s.titre %></h2>
      <% s.paras.forEach(function (p) { %><p class="pu-p"><%- p %></p><% }); %>
      <% s.sous.forEach(function (b) { %>
      <h3 class="pu-h3"><%= b.titre %></h3>
      <% b.paras.forEach(function (p) { %><p class="pu-p"><%- p %></p><% }); %>
      <% }); %>
    </section>
    <% }); %>

    <% if (faq.length) { %>
    <section class="pu-bloc-texte">
      <h2 class="pu-h2">Les questions qu'on nous pose</h2>
      <div class="pu-faq">
        <% faq.forEach(function (f) { %>
        <details class="pu-faq-item">
          <summary class="pu-faq-q"><%= f.q %></summary>
          <div class="pu-faq-a"><%- f.a %></div>
        </details>
        <% }); %>
      </div>
    </section>
    <% } %>
  </div>
</article>

<script src="/js/purete.js" defer></script>

<style>
/* ══ Test de pureté ═══════════════════════════════════════════════════════
   Habillage propre à cette page. Rien n'est repris des autres gabarits de
   quiz : la page doit se lire comme un outil posé sur fond sombre, avec le
   test juste sous le titre.

   Le hero porte son propre fond sombre dans les deux thèmes, comme une bande
   à part. Tout ce qui suit repose sur les jetons du site et suit donc le
   thème choisi par la personne. */
.pu-largeur { max-width: 46rem; margin: 0 auto; padding: 0 1.15rem; }
.pu-section { padding: 3rem 0; }
.pu-section--moteur { padding-top: 2.2rem; }

/* ── Hero ───────────────────────────────────────────────────────────────── */
.pu-hero {
  position: relative; isolation: isolate; overflow: hidden;
  background: radial-gradient(120% 90% at 50% -10%, hsl(338 60% 22%) 0%, hsl(300 45% 10%) 45%, hsl(280 50% 5%) 100%);
  color: #fff;
  padding: 4.5rem 1.15rem 4rem;
  text-align: center;
}
/* Halo qui décentre la lumière : sans lui le dégradé radial paraît plat. */
.pu-hero-lueur {
  position: absolute; inset: -30% -10% auto -10%; height: 70%;
  background: radial-gradient(60% 100% at 30% 0%, hsl(338 72% 62% / .3), transparent 70%),
              radial-gradient(50% 100% at 78% 12%, hsl(265 65% 58% / .28), transparent 72%);
  filter: blur(10px); z-index: -1; pointer-events: none;
}
.pu-hero-inner { max-width: 44rem; margin: 0 auto; }

.pu-hero-compteur, .pu-hero-moyenne {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .45rem 1rem; border-radius: 999px;
  border: 1px solid hsl(0 0% 100% / .22);
  background: hsl(0 0% 100% / .07);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  font-size: .82rem; font-weight: 700; letter-spacing: .01em;
  color: hsl(0 0% 100% / .92);
  margin: 0 0 1.4rem;
}
.pu-hero-moyenne { margin: 1.6rem 0 0; }
.pu-hero-compteur[hidden], .pu-hero-moyenne[hidden] { display: none; }

.pu-h1 {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(2rem, 8.5vw, 3.5rem);
  font-weight: 800; line-height: 1.06; letter-spacing: -.02em;
  margin: 0 0 1.1rem;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
  gap: .3em .45rem;
  text-wrap: balance;
}
/* Le second morceau du titre est posé dans un cartouche : c'est lui qui donne
   au H1 son relief, sans avoir à colorer tout le titre. */
.pu-h1-bloc {
  display: inline-flex; align-items: center; gap: .25em;
  padding: .06em .5em .12em;
  border-radius: .55em;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(265 60% 56%));
  box-shadow: 0 10px 34px hsl(338 72% 50% / .38);
}

.pu-hero-accroche {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(1.05rem, 3.4vw, 1.4rem); font-weight: 700;
  margin: 0 0 .9rem; color: hsl(0 0% 100% / .95);
  text-wrap: balance;
}
.pu-hero-desc {
  font-size: 1rem; line-height: 1.65;
  color: hsl(0 0% 100% / .72);
  margin: 0 auto 2rem; max-width: 33rem;
  text-wrap: pretty;
}

/* ── Bouton principal ───────────────────────────────────────────────────── */
.pu-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
  padding: 1rem 2rem;
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.05rem; font-weight: 800;
  border: none; border-radius: 999px; cursor: pointer;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(18 88% 58%));
  color: #fff; text-decoration: none;
  box-shadow: 0 12px 30px hsl(338 72% 50% / .45);
  transition: transform 160ms ease, box-shadow 160ms ease;
}
.pu-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 38px hsl(338 72% 50% / .55); }
.pu-cta:active { transform: translateY(1px); }
.pu-cta:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
.pu-cta-fleche { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 999px; background: hsl(0 0% 100% / .22); font-size: .9rem; }
.pu-cta--fantome {
  background: transparent; color: hsl(var(--foreground));
  border: 2px solid hsl(var(--border)); box-shadow: none;
}
.pu-cta--fantome:hover { border-color: hsl(var(--primary)); box-shadow: none; }

/* ── Cartes du moteur ───────────────────────────────────────────────────── */
.pu-carte {
  position: relative;
  border-radius: 1.5rem;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
  padding: 2.2rem 1.2rem 1.8rem;
  text-align: center;
  animation: puEntree 300ms ease both;
}
@keyframes puEntree { from { opacity: 0; transform: translateY(10px); } }
.pu-macaron {
  position: absolute; top: -1.2rem; left: 50%; transform: translateX(-50%);
  width: 3rem; height: 3rem; display: grid; place-items: center;
  border-radius: 999px; font-size: 1.4rem; line-height: 1;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(265 60% 56%));
  box-shadow: 0 8px 20px hsl(338 72% 50% / .4);
}
.pu-kicker {
  font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
  color: hsl(var(--primary)); margin: .8rem 0 .4rem;
}
.pu-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.4rem; font-weight: 800; line-height: 1.25;
  margin: 0 0 .7rem; color: hsl(var(--foreground)); text-wrap: balance;
}
.pu-sous {
  font-size: .93rem; line-height: 1.6; color: hsl(var(--muted-foreground));
  margin: 0 auto 1.5rem; max-width: 32rem; text-wrap: pretty;
}
.pu-lien {
  background: none; border: none; cursor: pointer;
  color: hsl(var(--muted-foreground)); font: inherit; font-size: .85rem;
  margin-top: 1.2rem; padding: .4rem;
}
.pu-lien:hover { color: hsl(var(--primary)); }

/* ── Choix du mode et de l'âge ──────────────────────────────────────────── */
.pu-modes { display: grid; gap: .85rem; }
.pu-mode {
  display: flex; flex-direction: column; gap: .3rem;
  padding: 1.15rem 1.1rem; text-align: left;
  border-radius: 1.15rem; border: 2px solid hsl(var(--border));
  background: hsl(var(--background)); color: hsl(var(--foreground));
  cursor: pointer; font: inherit;
  transition: border-color 170ms ease, transform 170ms ease, box-shadow 170ms ease;
}
.pu-mode:hover {
  border-color: hsl(var(--primary)); transform: translateY(-2px);
  box-shadow: 0 10px 26px hsl(338 72% 50% / .18);
}
.pu-mode:focus-visible { outline: 3px solid hsl(var(--primary)); outline-offset: 2px; }
.pu-mode-emoji { font-size: 1.6rem; line-height: 1; }
.pu-mode-nom { font-family: 'Poppins', 'Inter', sans-serif; font-weight: 800; font-size: 1.02rem; }
.pu-mode-desc { font-size: .85rem; line-height: 1.5; color: hsl(var(--muted-foreground)); }

.pu-ages { display: grid; gap: .7rem; }
.pu-age {
  display: flex; flex-direction: column; gap: .15rem; padding: .95rem 1rem;
  border-radius: 1rem; border: 2px solid hsl(var(--border));
  background: hsl(var(--background)); color: hsl(var(--foreground));
  cursor: pointer; font: inherit;
  transition: border-color 170ms ease, transform 170ms ease;
}
.pu-age:hover { border-color: hsl(var(--primary)); transform: translateY(-1px); }
.pu-age--oui { border-color: hsl(var(--primary) / .55); }
.pu-age-nom { font-weight: 800; font-size: .97rem; }
.pu-age-sous { font-size: .8rem; color: hsl(var(--muted-foreground)); }

/* ── Barre d'avancement ─────────────────────────────────────────────────── */
.pu-barre-zone { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.6rem; }
.pu-rond {
  width: 2.5rem; height: 2.5rem; flex-shrink: 0;
  display: grid; place-items: center;
  border-radius: 999px; border: 1px solid hsl(var(--border));
  background: hsl(var(--card)); color: hsl(var(--foreground));
  font-size: 1rem; cursor: pointer;
  transition: border-color 150ms ease, color 150ms ease;
}
.pu-rond:hover:not(:disabled) { border-color: hsl(var(--primary)); color: hsl(var(--primary)); }
.pu-rond:disabled { opacity: .35; cursor: default; }
.pu-rond--sortie:hover { border-color: hsl(var(--destructive)); color: hsl(var(--destructive)); }
.pu-piste {
  flex: 1; height: .5rem; border-radius: 999px;
  background: hsl(var(--muted)); overflow: hidden;
}
.pu-piste > span {
  display: block; height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, hsl(338 72% 62%), hsl(18 88% 58%));
  transition: width 320ms ease;
}

/* ── Question ───────────────────────────────────────────────────────────── */
.pu-carte--question { text-align: left; padding: 1.8rem 1.2rem 1.5rem; }
.pu-num {
  display: flex; align-items: center; justify-content: space-between; gap: .6rem;
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: .82rem; font-weight: 800; color: hsl(var(--primary));
  margin: 0 0 .7rem;
}
.pu-num-cat {
  font-size: .72rem; font-weight: 700; letter-spacing: .04em;
  color: hsl(var(--muted-foreground)); text-transform: uppercase;
}
.pu-question {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.28rem; font-weight: 800; line-height: 1.3;
  margin: 0 0 1.5rem; color: hsl(var(--foreground)); text-wrap: balance;
}
.pu-reponses { display: flex; flex-direction: column; gap: .6rem; }
/* Du vert au rouge selon ce que la réponse coûte : le barème se lit d'un
   coup d'œil, sans qu'on ait à l'expliquer. */
.pu-rep {
  width: 100%; padding: .95rem 1.1rem; text-align: left;
  border: none; border-radius: .95rem; cursor: pointer;
  font: inherit; font-size: .97rem; font-weight: 700; color: #fff;
  animation: puRep 260ms ease both;
  transition: transform 150ms ease, filter 150ms ease;
}
@keyframes puRep { from { opacity: 0; transform: translateX(-8px); } }
.pu-rep:hover { transform: translateX(3px); filter: brightness(1.12); }
.pu-rep:focus-visible { outline: 3px solid hsl(var(--foreground)); outline-offset: 2px; }
.pu-rep--0 { background: linear-gradient(135deg, hsl(150 52% 33%), hsl(158 48% 27%)); }
.pu-rep--1 { background: linear-gradient(135deg, hsl(120 40% 33%), hsl(132 40% 26%)); }
.pu-rep--2 { background: linear-gradient(135deg, hsl(38 72% 40%), hsl(30 70% 33%)); }
.pu-rep--3 { background: linear-gradient(135deg, hsl(14 68% 44%), hsl(6 64% 36%)); }
.pu-rep--4 { background: linear-gradient(135deg, hsl(352 60% 36%), hsl(348 62% 26%)); }
.pu-rep--pris { transform: scale(.98); filter: brightness(1.3); }

.pu-noscript { text-align: center; color: hsl(var(--muted-foreground)); padding: 2rem 1rem; }

/* ── Résultat ───────────────────────────────────────────────────────────── */
.pu-resultat { animation: puEntree 340ms ease both; }
.pu-verdict { text-align: center; margin-bottom: 2rem; }
.pu-verdict-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(1.6rem, 6vw, 2.4rem); font-weight: 800; line-height: 1.12;
  margin: 0 0 .9rem; text-wrap: balance;
  background: linear-gradient(120deg, hsl(338 72% 62%), hsl(18 88% 58%));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.pu-verdict-emoji { -webkit-text-fill-color: initial; color: initial; }
.pu-score-pastille {
  display: inline-block; padding: .5rem 1.1rem; border-radius: 999px;
  background: linear-gradient(135deg, hsl(338 72% 62% / .16), hsl(18 88% 58% / .16));
  border: 1px solid hsl(338 72% 62% / .4);
  font-size: 1.02rem; color: hsl(var(--foreground)); margin: 0 0 .5rem;
}
.pu-score-pastille strong { font-family: 'Poppins', 'Inter', sans-serif; font-size: 1.35rem; color: hsl(var(--primary)); }
.pu-score-note { font-size: .8rem; color: hsl(var(--muted-foreground)); margin: 0 0 1.1rem; }
.pu-verdict-texte {
  font-size: .98rem; line-height: 1.65; color: hsl(var(--muted-foreground));
  max-width: 34rem; margin: 0 auto; text-wrap: pretty;
}

.pu-colonnes { display: grid; gap: 1.1rem; margin-bottom: 1.1rem; }
.pu-bloc {
  border-radius: 1.3rem; border: 1px solid hsl(var(--border));
  background: hsl(var(--card)); padding: 1.4rem 1.15rem;
}
.pu-bloc-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.08rem; font-weight: 800; margin: 0 0 .35rem;
  color: hsl(var(--foreground));
}
.pu-bloc-sous {
  font-size: .87rem; line-height: 1.55; color: hsl(var(--muted-foreground));
  margin: 0 0 1.1rem; text-wrap: pretty;
}
.pu-bloc-sous strong { color: hsl(var(--primary)); }

/* Courbe de répartition */
.pu-courbe-boite { position: relative; }
.pu-courbe { width: 100%; height: auto; display: block; color: hsl(var(--muted-foreground)); overflow: visible; }
.pu-courbe-axe { font-size: 11px; fill: hsl(var(--muted-foreground)); }
.pu-courbe-repere {
  position: absolute; top: -.2rem; transform: translateX(-50%);
  padding: .18rem .55rem; border-radius: 999px;
  background: hsl(var(--foreground)); color: hsl(var(--background));
  font-size: .68rem; font-weight: 800; white-space: nowrap;
}

/* Partage */
.pu-partages { display: grid; grid-template-columns: repeat(2, 1fr); gap: .55rem; }
.pu-partage {
  padding: .8rem .7rem; border-radius: .85rem; cursor: pointer;
  border: 1px solid hsl(var(--border)); background: hsl(var(--background));
  color: hsl(var(--foreground)); font: inherit; font-size: .87rem; font-weight: 700;
  transition: border-color 150ms ease, transform 150ms ease;
}
.pu-partage:hover { border-color: hsl(var(--primary)); transform: translateY(-2px); }
.pu-partage--natif, .pu-partage--copie { grid-column: 1 / -1; }
.pu-partage--natif {
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(18 88% 58%));
  border-color: transparent; color: #fff;
}

/* Catégories */
.pu-bloc--cats { margin-bottom: 1.6rem; }
.pu-cats { display: grid; gap: 1rem; }
.pu-cat-tete { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; margin-bottom: .35rem; }
.pu-cat-nom { font-weight: 700; font-size: .93rem; }
.pu-cat-val { font-family: 'Poppins', 'Inter', sans-serif; font-weight: 800; color: hsl(var(--primary)); }
.pu-cat-piste { height: .5rem; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
.pu-cat-piste > span {
  display: block; height: 100%; border-radius: 999px;
