<%
  // Gabarit propre au test de pureté. Aucune brique des autres pages de quiz
  // n'est reprise : pas de hero dégradé, pas de wave-divider, pas de bloc
  // « à faire ensuite ». Seuls l'en-tête et le pied de page du site restent,
  // parce que la page doit se lire comme un outil, pas comme un article de
  // plus. Le moteur est le premier élément après le titre.
  var ns = 'test-purete';
  function T(cle, repli) { return t(ns + ':' + cle, repli || ''); }

  var titreHero = T('hero.titre', 'Test de pureté');
  var accentHero = T('hero.titreAccent', 'spécial couple');

  // Les liens contextuels sont écrits dans le contenu sous forme de jetons
  // {{routeKey}}, résolus ici. Les slugs restent ainsi au même endroit que
  // partout ailleurs, et un lien vers une page retirée devient inoffensif :
  // l'ancre reste, l'attribut href disparaît.
  function liens(html) {
    if (!html) return '';
    return String(html).replace(/\{\{(\w+)\}\}/g, function (_, cle) {
      return getLocalizedUrl(cle, lang) || '#';
    });
  }

  // ── Sections ──
  // Une section peut porter, en plus de ses paragraphes : un chapô, une
  // rangée de chiffres, un tableau, un comparatif à deux colonnes, des
  // listes et un encart. Un mur de paragraphes ne se lit pas.
  var sections = [];
  for (var si = 1; si <= 5; si++) {
    var base = 'sections.s' + si + '.';
    var st = T(base + 'titre');
    if (!st) continue;
    var paras = [];
    for (var pi = 1; pi <= 3; pi++) { var pv = T(base + 'p' + pi); if (pv) paras.push(liens(pv)); }
    var sous = [];
    for (var bi = 1; bi <= 2; bi++) {
      var bt = T(base + 'sub' + bi + 'Titre');
      if (!bt) continue;
      var bl = t(ns + ':' + base + 'liste' + bi, null);
      var bp = [];
      for (var bj = 1; bj <= 2; bj++) { var bv = T(base + 'sub' + bi + 'P' + bj); if (bv) bp.push(liens(bv)); }
      sous.push({ titre: bt, liste: Array.isArray(bl) ? bl.map(liens) : [], paras: bp });
    }
    sections.push({
      titre: st,
      lead: liens(T(base + 'lead')),
      citation: T(base + 'citation'),
      paras: paras,
      sous: sous,
      chiffres: t(ns + ':' + base + 'chiffres', null),
      tableau: t(ns + ':' + base + 'tableau', null),
      comparatif: t(ns + ':' + base + 'comparatif', null),
      encart: t(ns + ':' + base + 'encart', null)
    });
  }

  // Une sous-section rend sa liste si elle en a une, ses paragraphes sinon.
  // Sans ce choix, un titre sans liste posait un <ul> vide dans la page.
  function rendSous(b) {
    if (!b) return '';
    var out = '<h3 class="pu-h3">' + escapeHtml(b.titre) + '</h3>';
    if (b.liste && b.liste.length) {
      out += '<ul class="pu-liste">' + b.liste.map(function (li) { return '<li>' + li + '</li>'; }).join('') + '</ul>';
    }
    (b.paras || []).forEach(function (p) { out += '<p class="pu-p">' + p + '</p>'; });
    return out;
  }

  // ── Maillage interne, en dur dans le HTML ──
  // Les suggestions de fin de partie sont posées par le moteur : elles
  // n'existent pas pour un robot, qui ne trouvait donc aucun lien sortant
  // sur cette page en dehors de l'en-tête et du pied de page.
  var suiteBloc = t(ns + ':suite', null);
  var suiteLiens = [];
  if (suiteBloc && Array.isArray(suiteBloc.liens)) {
    suiteBloc.liens.forEach(function (item) {
      var url = getLocalizedUrl(item.cle, lang);
      if (!url) return;
      suiteLiens.push({
        url: url, emoji: item.emoji, texte: item.texte,
        nom: t('quizzes:' + item.cle + '.shortTitle', t('quizzes:' + item.cle + '.title', item.cle))
      });
    });
  }


  // ── Suites proposées en fin de test ──
  // Choisies à la main, pas tirées au sort. Quelqu'un qui vient de détailler
  // son passé seul n'a personne à côté de lui : on lui propose d'abord des
  // pages qu'il peut ouvrir tout de suite. Le mode couple, lui, a déjà les
  // deux personnes devant l'écran, donc on peut envoyer sur du jeu à deux.
  function suite(cle, emoji, accroche) {
    var url = getLocalizedUrl(cle, lang);
    if (!url) return null;
    return {
      url: url,
      nom: t('quizzes:' + cle + '.shortTitle', t('quizzes:' + cle + '.title', cle)),
      desc: accroche,
      emoji: emoji
    };
  }
  // Les accroches viennent du fichier de langue : elles étaient en dur ici,
  // ce qui rendait la page intraduisible sans toucher au gabarit.
  var suitesDef = {
    solo: [['quizCoquin', '🔥'], ['testInfidelite', '💔'], ['testCouple', '💕'], ['jeuActionVerite', '🎲']],
    couple: [['quizCoquin', '🔥'], ['jeuActionVeriteHot', '🌶️'], ['jeuGages', '🎡'], ['testCouple', '💕']]
  };
  var suites = {};
  Object.keys(suitesDef).forEach(function (m) {
    suites[m] = suitesDef[m].map(function (d, i) {
      return suite(d[0], d[1], T('moteur.suite_' + m + '_' + (i + 1), ''));
    }).filter(Boolean);
  });

  // ── FAQ ──
  var faq = [];
  for (var fi = 1; fi <= 8; fi++) {
    var fq = T('faq.q' + fi), fa = T('faq.a' + fi);
    if (fq && fa) faq.push({ q: fq, a: fa });
  }

  // ── Données structurées ──
  // Un Quiz plutôt qu'un article : la page est un outil.
  //
  // hasPart était vide, alors que toutes les autres pages de test le
  // remplissent : c'est la propriété sur laquelle Google construit son
  // résultat enrichi de questions, et cette page était la seule à ne rien
  // lui donner. On n'y met pas les cent questions, ce serait vingt-cinq
  // kilo-octets de balisage, mais un échantillon pris dans le pool tout
  // public : ce sont les seules qu'on veut voir citées dans un résultat de
  // recherche, et elles décrivent le test aussi bien que les autres.
  var ECHANTILLON = 12;
  var hasPart = [];
  var questionsStatiques = [];
  var pureteData = typeof pureteQuestions !== 'undefined' ? pureteQuestions : null;
  if (pureteData && pureteData.solo && Array.isArray(pureteData.solo.questions)) {
    questionsStatiques = pureteData.solo.questions.filter(function (q) { return q.ado; });
  }
  if (pureteData && pureteData.solo && Array.isArray(pureteData.solo.questions)) {
    pureteData.solo.questions.filter(function (q) { return q.ado; }).slice(0, ECHANTILLON)
      .forEach(function (q, i) {
        hasPart.push({
          "@type": "Question", "position": i + 1, "name": q.q,
          "suggestedAnswer": q.r.map(function (r, j) {
            return { "@type": "Answer", "position": j + 1, "text": r.t };
          })
        });
      });
  }

  var jsonLd = [{
    "@context": "https://schema.org", "@type": "Quiz",
    "name": titreHero + ' ' + accentHero,
    "description": T('meta.description'),
    "inLanguage": lang,
    "datePublished": "2026-08-12",
    "isAccessibleForFree": true,
    "image": (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : baseUrl + '/og-image.webp',
    "learningResourceType": "Quiz",
    "interactivityType": "active",
    "educationalLevel": "adult",
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', 'couple purity test') },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 50 },
      { "@type": "PropertyValue", "name": "modes", "value": "solo, couple" },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  }];
  if (hasPart.length) jsonLd[0].hasPart = hasPart;
  if (faq.length) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faq.map(function (f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }
%>
<%# Libellés du moteur. Ils voyagent dans la page plutôt que dans le
    fichier de données des questions : le moteur en a besoin dès le premier
    écran, avant tout appel réseau. %>
<script>window.PU_I18N = <%- JSON.stringify(t(ns + ':moteur', {}) || {}) %>;</script>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- ══ Hero ══════════════════════════════════════════════════════════════ -->
<section class="pu-hero">
  <div class="pu-hero-lueur" aria-hidden="true"></div>
  <div class="pu-hero-inner">

    <h1 class="pu-h1">
      <span class="pu-h1-mot"><%= titreHero %></span>
      <span class="pu-h1-bloc"><%= accentHero %> <span aria-hidden="true">🌡️</span></span>
    </h1>

    <p class="pu-hero-accroche"><%= T('hero.accroche') %></p>
    <p class="pu-hero-desc"><%= T('hero.description') %></p>

    <%# Les deux compteurs restent masqués tant que la base n'a pas répondu :
        un emplacement vide vaut mieux qu'un chiffre inventé. Le nombre de
        parties est collé au bouton, c'est là qu'il sert à quelque chose. %>
    <p class="pu-hero-compteur" id="purete-compteur" hidden></p>

    <a href="#purete" class="pu-cta pu-cta--hero" id="purete-demarrer">
      <%= T('cta', 'Commencer le test') %>
      <span class="pu-cta-fleche" aria-hidden="true">→</span>
    </a>

    <%# La jauge du score moyen : le même graphique que sur l'écran de
        résultat, curseur posé sur la moyenne des parties enregistrées. %>
    <div class="pu-hero-jauge" id="purete-moyenne" hidden></div>
  </div>
</section>

<!-- ══ Moteur ════════════════════════════════════════════════════════════ -->
<section class="pu-section pu-section--moteur">
  <div class="pu-largeur">
    <div id="purete"
         data-quiz="purete"
         data-lang="<%= lang %>"
         data-supabase-url="<%= supabaseUrl %>"
         data-supabase-key="<%= supabaseKey %>"
         data-suites="<%- escapeHtml(JSON.stringify(suites)) %>">
      <noscript>
        <p class="pu-noscript"><%= T('moteur.noscript', 'Ce test a besoin de JavaScript pour fonctionner. Activez-le puis rechargez la page.') %></p>
      </noscript>
    </div>
  </div>
</section>

<%# Sous le moteur, jamais au-dessus : une publicite devant le repousserait
    hors du premier ecran sur telephone. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>

<%# Les questions en dur, pour un robot. Le moteur les pose en JavaScript,
    donc sans ce bloc la page ne montrait aucune question à l'indexation,
    contrairement à toutes les autres pages de test.
    On ne publie que le pool tout public : ce sont les seules qu'on veut voir
    ressortir dans un résultat de recherche. Les explicites restent dans le
    test, elles ne sont simplement pas affichées ici. %>
<% if (questionsStatiques.length) { %>
<section class="quiz-static-questions">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="quiz-static-title"><%= T('moteur.statique_titre', 'Prêts pour le test ?') %></h2>
    <p class="quiz-static-intro"><%= T('moteur.statique_intro', 'Un aperçu des questions du test. Lancez-le ci-dessus pour obtenir votre score.') %></p>
    <ol class="quiz-static-list">
      <% questionsStatiques.forEach(function (q) { %>
      <li class="quiz-static-item">
        <h3 class="quiz-static-q"><%= q.q %></h3>
        <ul class="quiz-static-opts">
          <% q.r.forEach(function (r) { %><li><%= r.t %></li><% }); %>
        </ul>
      </li>
      <% }); %>
    </ol>
  </div>
</section>
<% } %>

<!-- ══ Contenu ═══════════════════════════════════════════════════════════ -->
<article class="pu-section pu-article">
  <div class="pu-largeur">
    <% sections.forEach(function (s, idx) { %>
    <section class="pu-bloc-texte">
      <h2 class="pu-h2"><%= s.titre %></h2>

      <% if (s.lead) { %><p class="pu-lead"><%- s.lead %></p><% } %>
      <% if (s.citation) { %>
      <blockquote class="pu-citation"><p><%- s.citation %></p></blockquote>
      <% } %>

      <% if (s.paras[0]) { %><p class="pu-p"><%- s.paras[0] %></p><% } %>

      <%# L'image à la une n'est pas dans le hero : elle porte déjà le titre du
          test, elle ferait doublon avec le H1 juste au-dessus. Elle illustre
          la première section, une fois le sujet posé. %>
      <% if (idx === 0 && typeof featuredImage !== 'undefined' && featuredImage) { %>
      <figure class="pu-figure">
        <img src="<%= featuredImage %>" alt="<%= featuredImageAlt %>"
             width="1200" height="630" loading="lazy" decoding="async">
      </figure>
      <% } %>

      <% if (s.chiffres) { %>
      <div class="pu-chiffres">
        <% s.chiffres.forEach(function (c) { %>
        <div class="pu-chiffre">
          <span class="pu-chiffre-val"><%= c.val %></span>
          <span class="pu-chiffre-lib"><%= c.lib %></span>
        </div>
        <% }); %>
      </div>
      <% } %>

      <% if (s.tableau) { %>
      <figure class="pu-tableau-boite">
        <figcaption class="pu-tableau-titre"><%= s.tableau.titre %></figcaption>
        <div class="pu-tableau-defile">
          <table class="pu-tableau">
            <thead><tr><% s.tableau.entete.forEach(function (h) { %><th><%= h %></th><% }); %></tr></thead>
            <tbody>
              <% s.tableau.lignes.forEach(function (l) { %>
              <tr><% l.forEach(function (c, i) { %><td<%= i ? ' class="pu-tableau-pts"' : '' %>><%= c %></td><% }); %></tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (s.tableau.note) { %><p class="pu-tableau-note"><%= s.tableau.note %></p><% } %>
      </figure>
      <% } %>

      <% if (s.comparatif) { %>
      <div class="pu-comparatif">
        <% s.comparatif.forEach(function (c) { %>
        <div class="pu-comparatif-carte">
          <span class="pu-comparatif-emoji" aria-hidden="true"><%= c.emoji %></span>
          <h3 class="pu-comparatif-titre"><%= c.titre %></h3>
          <p class="pu-comparatif-texte"><%- c.texte %></p>
        </div>
        <% }); %>
      </div>
      <% } %>

      <%# Ordre fixe et lisible : le reste des paragraphes, puis les
          sous-sections, chacune avec sa liste et son commentaire. L'ancien
          entrelacement plaçait un titre de niveau trois au milieu d'une idée. %>
      <% s.paras.slice(1).forEach(function (p) { %><p class="pu-p"><%- p %></p><% }); %>
      <% s.sous.forEach(function (b) { %><%- rendSous(b) %><% }); %>

      <% if (s.encart) { %>
      <aside class="pu-encart">
        <span class="pu-encart-puce" aria-hidden="true">💡</span>
        <div>
          <p class="pu-encart-titre"><%= s.encart.titre %></p>
          <p class="pu-encart-texte"><%- s.encart.texte %></p>
        </div>
      </aside>
      <% } %>
    </section>

<%# Un seul encart dans le texte, apres la premiere section : la boucle en
    produit cinq, l'encart n'en accompagne qu'une. %>
<% if (idx === 0 && typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>
    <% }); %>

    <% if (faq.length) { %>
    <section class="pu-bloc-texte">
      <h2 class="pu-h2"><%= T('faq.titre', "Les questions qu'on nous pose") %></h2>
      <div class="pu-faq">
        <% faq.forEach(function (f) { %>
        <details class="pu-faq-item">
          <summary class="pu-faq-q"><%= f.q %></summary>
          <div class="pu-faq-a"><%- f.a %></div>
        </details>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (suiteLiens.length) { %>
    <section class="pu-bloc-texte pu-suite-seo">
      <h2 class="pu-h2"><%= suiteBloc.titre %></h2>
      <p class="pu-p"><%= suiteBloc.sous %></p>
      <div class="pu-suite-grille">
        <% suiteLiens.forEach(function (l) { %>
        <a class="pu-suite-carte no-underline" href="<%= l.url %>">
          <span class="pu-suite-carte-emoji" aria-hidden="true"><%= l.emoji %></span>
          <span class="pu-suite-carte-nom"><%= l.nom %></span>
          <span class="pu-suite-carte-texte"><%= l.texte %></span>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>
  </div>
</article>

<script src="/js/purete.js" defer></script>

<style>
/* ══ Test de pureté ═══════════════════════════════════════════════════════
   Habillage propre à cette page. Rien n'est repris des autres gabarits de
   quiz : la page doit se lire comme un outil posé sur fond sombre, avec le
   test juste sous le titre.

   Le hero porte son propre fond sombre dans les deux thèmes, comme une bande
   à part. Tout ce qui suit repose sur les jetons du site et suit donc le
   thème choisi par la personne. */
.pu-largeur { max-width: 46rem; margin: 0 auto; padding: 0 1.15rem; }
.pu-section { padding: 3rem 0; }
.pu-section--moteur { padding-top: 2.2rem; }

/* ── Hero ───────────────────────────────────────────────────────────────── */
.pu-hero {
  position: relative; isolation: isolate; overflow: hidden;
  background: radial-gradient(120% 90% at 50% -10%, hsl(338 60% 22%) 0%, hsl(300 45% 10%) 45%, hsl(280 50% 5%) 100%);
  color: #fff;
  padding: 4.5rem 1.15rem 4rem;
  text-align: center;
}
/* Halo qui décentre la lumière : sans lui le dégradé radial paraît plat. */
.pu-hero-lueur {
  position: absolute; inset: -30% -10% auto -10%; height: 70%;
  background: radial-gradient(60% 100% at 30% 0%, hsl(338 72% 62% / .3), transparent 70%),
              radial-gradient(50% 100% at 78% 12%, hsl(265 65% 58% / .28), transparent 72%);
  filter: blur(10px); z-index: -1; pointer-events: none;
}
.pu-hero-inner { max-width: 44rem; margin: 0 auto; }

/* `inline-flex` mettait la pastille sur la même ligne que le bouton dès que
   la place le permettait : sur mobile ça passait à la ligne tout seul, sur
   PC les deux se retrouvaient côte à côte. `flex` est de niveau bloc, donc
   la pastille occupe sa propre ligne, et `width: fit-content` avec des
   marges automatiques la garde centrée sans s'étirer sur toute la largeur. */
/* Le compteur de parties : une pastille vivante collée au bouton, avec un
   point vert qui pulse comme un indicateur en direct. */
.pu-hero-compteur {
  display: flex; width: fit-content; align-items: center; gap: .55rem;
  margin: 0 auto 1.15rem; padding: .5rem 1.15rem; border-radius: 999px;
  border: 1px solid hsl(0 0% 100% / .28);
  background: linear-gradient(120deg, hsl(0 0% 100% / .16), hsl(0 0% 100% / .05));
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  font-size: .84rem; font-weight: 700; letter-spacing: .01em;
  color: hsl(0 0% 100% / .95);
  box-shadow: 0 4px 18px -8px rgb(0 0 0 / .4), inset 0 1px 0 hsl(0 0% 100% / .22);
}
.pu-compteur-point {
  width: .5rem; height: .5rem; border-radius: 999px; flex-shrink: 0;
  background: hsl(150 70% 55%);
  animation: puCompteurPouls 2.2s ease-out infinite;
}
@keyframes puCompteurPouls {
  0% { box-shadow: 0 0 0 0 hsl(150 70% 55% / .55); }
  70% { box-shadow: 0 0 0 7px hsl(150 70% 55% / 0); }
  100% { box-shadow: 0 0 0 0 hsl(150 70% 55% / 0); }
}
.pu-hero-compteur[hidden] { display: none; }

/* La jauge du score moyen sous le bouton : une carte claire qui porte le
   même graphique que l'écran de résultat, rien d'autre. */
.pu-hero-jauge {
  max-width: 30rem; margin: 1.6rem auto 0; padding: 1rem 1.15rem 1.15rem;
  border-radius: 1.1rem;
  background: hsl(var(--card));
  border: 1px solid hsl(var(--border) / .7);
  box-shadow: 0 18px 40px -18px rgb(0 0 0 / .5);
  text-align: left;
}
.pu-hero-jauge .pu-jauge { margin: 0; max-width: none; }
.pu-hero-jauge[hidden] { display: none; }

.pu-h1 {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(2rem, 8.5vw, 3.5rem);
  font-weight: 800; line-height: 1.06; letter-spacing: -.02em;
  margin: 0 0 1.1rem;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
  gap: .3em .45rem;
  text-wrap: balance;
}
/* Le second morceau du titre est posé dans un cartouche : c'est lui qui donne
   au H1 son relief, sans avoir à colorer tout le titre. */
.pu-h1-bloc {
  display: inline-flex; align-items: center; gap: .25em;
  padding: .06em .5em .12em;
  border-radius: .55em;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(265 60% 56%));
  box-shadow: 0 10px 34px hsl(338 72% 50% / .38);
}

.pu-hero-accroche {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(1.05rem, 3.4vw, 1.4rem); font-weight: 700;
  margin: 0 0 .9rem; color: hsl(0 0% 100% / .95);
  text-wrap: balance;
}
.pu-hero-desc {
  font-size: 1rem; line-height: 1.65;
  color: hsl(0 0% 100% / .72);
  margin: 0 auto 2rem; max-width: 33rem;
  text-wrap: pretty;
}

/* ── Bouton principal ───────────────────────────────────────────────────── */
.pu-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
  padding: 1rem 2rem;
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.05rem; font-weight: 800;
  border: none; border-radius: 999px; cursor: pointer;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(18 88% 58%));
  color: #fff; text-decoration: none;
  box-shadow: 0 12px 30px hsl(338 72% 50% / .45);
  transition: transform 160ms ease, box-shadow 160ms ease;
}
.pu-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 38px hsl(338 72% 50% / .55); }
.pu-cta:active { transform: translateY(1px); }
.pu-cta:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
.pu-cta-fleche { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 999px; background: hsl(0 0% 100% / .22); font-size: .9rem; }
.pu-cta--fantome {
  background: transparent; color: hsl(var(--foreground));
  border: 2px solid hsl(var(--border)); box-shadow: none;
}
.pu-cta--fantome:hover { border-color: hsl(var(--primary)); box-shadow: none; }

/* ── Cartes du moteur ───────────────────────────────────────────────────── */
.pu-carte {
  position: relative;
  border-radius: 1.5rem;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
  padding: 2.2rem 1.2rem 1.8rem;
  text-align: center;
  animation: puEntree 300ms ease both;
}
@keyframes puEntree { from { opacity: 0; transform: translateY(10px); } }
.pu-macaron {
  position: absolute; top: -1.2rem; left: 50%; transform: translateX(-50%);
  width: 3rem; height: 3rem; display: grid; place-items: center;
  border-radius: 999px; font-size: 1.4rem; line-height: 1;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(265 60% 56%));
  box-shadow: 0 8px 20px hsl(338 72% 50% / .4);
}
.pu-kicker {
  font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase;
  color: hsl(var(--primary)); margin: .8rem 0 .4rem;
}
.pu-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.4rem; font-weight: 800; line-height: 1.25;
  margin: 0 0 .7rem; color: hsl(var(--foreground)); text-wrap: balance;
}
.pu-sous {
  font-size: .93rem; line-height: 1.6; color: hsl(var(--muted-foreground));
  margin: 0 auto 1.5rem; max-width: 32rem; text-wrap: pretty;
}
.pu-lien {
  background: none; border: none; cursor: pointer;
  color: hsl(var(--muted-foreground)); font: inherit; font-size: .85rem;
  margin-top: 1.2rem; padding: .4rem;
}
.pu-lien:hover { color: hsl(var(--primary)); }

/* ── Choix du mode et de l'âge ──────────────────────────────────────────── */
/* Les deux cartes de mode ne se lisaient pas comme des boutons : bordure
   fine, fond identique à la carte parente, et un survol qui n'existe pas au
   doigt. Elles ont maintenant un liseré coloré, une ombre portée, un
   chevron et une mention d'action, plus un état pressé bien marqué. */
.pu-modes { display: grid; gap: .9rem; }
.pu-mode {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; align-items: center; gap: .35rem;
  padding: 1.35rem 1.15rem 1.3rem; text-align: center;
  border-radius: 1.15rem;
  border: 2px solid hsl(var(--primary) / .35);
  background:
    linear-gradient(hsl(var(--card)), hsl(var(--card))) padding-box,
    linear-gradient(140deg, hsl(338 72% 62% / .5), hsl(265 60% 56% / .5)) border-box;
  color: hsl(var(--foreground));
  cursor: pointer; font: inherit;
  box-shadow: 0 6px 18px hsl(338 72% 40% / .12);
  transition: transform 170ms ease, box-shadow 170ms ease, border-color 170ms ease;
}
/* Liseré horizontal en haut de carte : le liseré vertical ne marchait qu'avec
   un texte aligné à gauche, il déséquilibrait une carte centrée. */
.pu-mode::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px;
  background: linear-gradient(90deg, hsl(338 72% 62%), hsl(265 60% 56%));
}
.pu-mode:hover { transform: translateY(-3px); box-shadow: 0 14px 30px hsl(338 72% 40% / .24); }
.pu-mode:active { transform: translateY(0); box-shadow: 0 4px 12px hsl(338 72% 40% / .18); }
.pu-mode:focus-visible { outline: 3px solid hsl(var(--primary)); outline-offset: 3px; }
.pu-mode-emoji { font-size: 1.7rem; line-height: 1; }
.pu-mode-nom { font-family: 'Poppins', 'Inter', sans-serif; font-weight: 800; font-size: 1.05rem; }
.pu-mode-desc { font-size: .85rem; line-height: 1.5; color: hsl(var(--muted-foreground)); max-width: 17rem; margin-bottom: .7rem; }
/* La mention d'action devient une vraie pastille : c'est elle qui dit que la
   carte se clique, le chevron flottant en coin ne suffisait pas. */
/* `auto` plutôt qu'une marge fixe : la description de droite tient sur deux
   lignes, celle de gauche sur une, et les deux pastilles se retrouvaient à
   des hauteurs différentes. */
.pu-mode-action {
  margin-top: auto; padding-top: 0;
  display: inline-flex; align-items: center; gap: .35rem;
  padding: .45rem 1rem; border-radius: 999px;
  font-size: .74rem; font-weight: 800;
  letter-spacing: .06em; text-transform: uppercase;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(18 88% 58%));
  color: #fff;
  box-shadow: 0 4px 12px hsl(338 72% 50% / .35);
  transition: transform 170ms ease;
}
.pu-mode-action::after { content: '›'; font-size: 1.05rem; line-height: 0; padding-bottom: .1em; }
.pu-mode:hover .pu-mode-action { transform: translateX(2px); }

/* Même traitement, en plus sobre, pour le portail d'âge. */
.pu-age { position: relative; padding-right: 2.2rem; }
.pu-age::after {
  content: '›'; position: absolute; right: .9rem; top: 50%;
  transform: translateY(-50%); color: hsl(var(--primary));
  font-size: 1.3rem; font-weight: 800; line-height: 0; padding-bottom: .12em;
}
.pu-age:active { transform: translateY(0); }

.pu-ages { display: grid; gap: .7rem; }
.pu-age {
  display: flex; flex-direction: column; gap: .15rem; padding: .95rem 1rem;
  border-radius: 1rem; border: 2px solid hsl(var(--border));
  background: hsl(var(--background)); color: hsl(var(--foreground));
  cursor: pointer; font: inherit;
  transition: border-color 170ms ease, transform 170ms ease;
}
.pu-age:hover { border-color: hsl(var(--primary)); transform: translateY(-1px); }
.pu-age--oui { border-color: hsl(var(--primary) / .55); }
.pu-age-nom { font-weight: 800; font-size: .97rem; }
.pu-age-sous { font-size: .8rem; color: hsl(var(--muted-foreground)); }

/* ── Barre d'avancement ─────────────────────────────────────────────────── */
.pu-barre-zone { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.6rem; }
.pu-rond {
  width: 2.5rem; height: 2.5rem; flex-shrink: 0;
  display: grid; place-items: center;
  border-radius: 999px; border: 1px solid hsl(var(--border));
  background: hsl(var(--card)); color: hsl(var(--foreground));
  font-size: 1rem; cursor: pointer;
  transition: border-color 150ms ease, color 150ms ease;
}
.pu-rond:hover:not(:disabled) { border-color: hsl(var(--primary)); color: hsl(var(--primary)); }
.pu-rond:disabled { opacity: .35; cursor: default; }
.pu-rond--sortie:hover { border-color: hsl(var(--destructive)); color: hsl(var(--destructive)); }
.pu-piste {
  flex: 1; height: .5rem; border-radius: 999px;
  background: hsl(var(--muted)); overflow: hidden;
}
.pu-piste > span {
  display: block; height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, hsl(338 72% 62%), hsl(18 88% 58%));
  transition: width 320ms ease;
}

/* ── Question ───────────────────────────────────────────────────────────── */
.pu-carte--question { text-align: left; padding: 1.8rem 1.2rem 1.5rem; }
.pu-num {
  display: flex; align-items: center; justify-content: space-between; gap: .6rem;
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: .82rem; font-weight: 800; color: hsl(var(--primary));
  margin: 0 0 .7rem;
}
.pu-num-cat {
  font-size: .72rem; font-weight: 700; letter-spacing: .04em;
  color: hsl(var(--muted-foreground)); text-transform: uppercase;
}
.pu-question {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.28rem; font-weight: 800; line-height: 1.3;
  margin: 0 0 1.5rem; color: hsl(var(--foreground)); text-wrap: balance;
}
.pu-reponses { display: flex; flex-direction: column; gap: .6rem; }
/* Du vert au rouge selon ce que la réponse coûte : le barème se lit d'un
   coup d'œil, sans qu'on ait à l'expliquer. */
.pu-rep {
  width: 100%; padding: .95rem 1.1rem; text-align: left;
  border: none; border-radius: .95rem; cursor: pointer;
  font: inherit; font-size: .97rem; font-weight: 700; color: #fff;
  animation: puRep 260ms ease both;
  transition: transform 150ms ease, filter 150ms ease;
}
@keyframes puRep { from { opacity: 0; transform: translateX(-8px); } }
.pu-rep:hover { transform: translateX(3px); filter: brightness(1.12); }
.pu-rep:focus-visible { outline: 3px solid hsl(var(--foreground)); outline-offset: 2px; }
.pu-rep--0 { background: linear-gradient(135deg, hsl(150 52% 33%), hsl(158 48% 27%)); }
.pu-rep--1 { background: linear-gradient(135deg, hsl(120 40% 33%), hsl(132 40% 26%)); }
.pu-rep--2 { background: linear-gradient(135deg, hsl(38 72% 40%), hsl(30 70% 33%)); }
.pu-rep--3 { background: linear-gradient(135deg, hsl(14 68% 44%), hsl(6 64% 36%)); }
.pu-rep--4 { background: linear-gradient(135deg, hsl(352 60% 36%), hsl(348 62% 26%)); }
.pu-rep--pris { transform: scale(.98); filter: brightness(1.3); }

.pu-noscript { text-align: center; color: hsl(var(--muted-foreground)); padding: 2rem 1rem; }

/* ── Résultat ───────────────────────────────────────────────────────────── */
.pu-resultat { animation: puEntree 340ms ease both; }

/* Le verdict devient une vraie carte, avec un bandeau dégradé en haut.
   Auparavant c'était du texte posé sur le fond de la page : la section la
   plus importante de l'écran ne se démarquait de rien. */
.pu-verdict {
  position: relative; overflow: hidden;
  text-align: center; margin-bottom: 1.1rem;
  padding: 2.2rem 1.25rem 1.9rem;
  border-radius: 1.5rem;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
  box-shadow: 0 18px 44px -28px hsl(338 72% 40% / .5);
}
.pu-verdict::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px;
  background: linear-gradient(90deg, hsl(338 72% 62%), hsl(18 88% 58%), hsl(265 60% 56%));
}
.pu-verdict-kicker {
  font-size: .7rem; font-weight: 800; letter-spacing: .12em;
  text-transform: uppercase; color: hsl(var(--primary));
  margin: 0 0 .5rem;
}
.pu-verdict-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(1.6rem, 6vw, 2.4rem); font-weight: 800; line-height: 1.12;
  margin: 0 0 1.3rem; text-wrap: balance;
  background: linear-gradient(120deg, hsl(338 72% 62%), hsl(18 88% 58%));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.pu-verdict-emoji { -webkit-text-fill-color: initial; color: initial; }

/* Le score : un libellé discret, le chiffre en très gros, le maximum en
   dessous. Trois lignes de tailles franchement différentes valent mieux
   qu'une phrase dont chaque morceau se disputait l'attention. */
.pu-score { display: flex; flex-direction: column; align-items: center; gap: .1rem; margin-bottom: 1.4rem; }
.pu-score-lib {
  font-size: .78rem; font-weight: 700; letter-spacing: .06em;
  text-transform: uppercase; color: hsl(var(--muted-foreground));
}
.pu-score-val {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(3.2rem, 14vw, 4.6rem); font-weight: 800; line-height: 1;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(120deg, hsl(338 72% 62%), hsl(18 88% 58%));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.pu-score-max { font-size: .84rem; color: hsl(var(--muted-foreground)); }

/* Jauge de position, toujours affichée */
.pu-jauge { margin: 0 auto 1.5rem; max-width: 34rem; }
.pu-jauge-boite { position: relative; padding-top: 1.5rem; }
.pu-jauge-svg { width: 100%; height: auto; display: block; overflow: visible; }
.pu-jauge-axes {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-top: .3rem; padding: 0 .1rem;
  font-size: .72rem; font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: hsl(var(--muted-foreground));
}
.pu-jauge-ici {
  position: absolute; top: 0; transform: translateX(-50%);
  padding: .2rem .6rem; border-radius: 999px;
  background: hsl(var(--foreground)); color: hsl(var(--background));
  font-size: .68rem; font-weight: 800; white-space: nowrap;
}
.pu-jauge-sous {
  margin: .5rem 0 0; font-size: .85rem; line-height: 1.5;
  color: hsl(var(--muted-foreground)); text-wrap: pretty;
}
.pu-jauge-sous strong { color: hsl(var(--foreground)); }

.pu-verdict-texte {
  font-size: 1rem; line-height: 1.7; color: hsl(var(--muted-foreground));
  max-width: 34rem; margin: 0 auto; text-wrap: pretty;
}

.pu-bloc {
  border-radius: 1.3rem; border: 1px solid hsl(var(--border));
  background: hsl(var(--card)); padding: 1.4rem 1.15rem;
  margin-bottom: 1.1rem;
}
.pu-bloc-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.08rem; font-weight: 800; margin: 0 0 .35rem;
  color: hsl(var(--foreground));
}
.pu-bloc-sous {
  font-size: .87rem; line-height: 1.55; color: hsl(var(--muted-foreground));
  margin: 0 0 1.1rem; text-wrap: pretty;
}
.pu-bloc-sous strong { color: hsl(var(--primary)); }

/* Partage : le bloc est centré, titre compris, et ne porte plus qu'un
   bouton. Cinq boutons pour une seule action, c'était un mur de choix. */
.pu-bloc--partage { text-align: center; }
.pu-bloc--partage .pu-bloc-sous { max-width: 30rem; margin-left: auto; margin-right: auto; }
.pu-partage--seul {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: min(100%, 16rem); padding: .95rem 1.8rem;
  border-radius: 999px; border: none; cursor: pointer;
  font: inherit; font-size: 1rem; font-weight: 800;
  background: linear-gradient(135deg, hsl(338 72% 62%), hsl(18 88% 58%));
  color: #fff;
  box-shadow: 0 10px 26px -10px hsl(338 72% 50% / .7);
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.pu-partage--seul:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -10px hsl(338 72% 50% / .8); }
.pu-partage--seul:active { transform: translateY(0); }
.pu-partage--seul:focus-visible { outline: 3px solid hsl(var(--primary)); outline-offset: 3px; }

/* Catégories */
.pu-bloc--cats { margin-bottom: 1.6rem; }
.pu-cats { display: grid; gap: 1rem; }
.pu-cat-tete { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; margin-bottom: .35rem; }
.pu-cat-nom { font-weight: 700; font-size: .93rem; }
.pu-cat-val { font-family: 'Poppins', 'Inter', sans-serif; font-weight: 800; color: hsl(var(--primary)); }
.pu-cat-piste { height: .5rem; border-radius: 999px; background: hsl(var(--muted)); overflow: hidden; }
.pu-cat-piste > span {
  display: block; height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, hsl(338 72% 62%), hsl(18 88% 58%));
}
.pu-cat-detail { font-size: .75rem; color: hsl(var(--muted-foreground)); margin: .3rem 0 0; }

/* Suites proposées en fin de test */
.pu-bloc--suites { margin-bottom: 1.6rem; }
.pu-suites { display: grid; gap: .6rem; }
.pu-suite {
  display: flex; align-items: center; gap: .85rem;
  padding: .85rem .95rem; border-radius: 1rem;
  border: 1px solid hsl(var(--border)); background: hsl(var(--background));
  color: hsl(var(--foreground)); text-decoration: none;
  transition: border-color 160ms ease, transform 160ms ease;
}
.pu-suite:hover { border-color: hsl(var(--primary)); transform: translateX(3px); }
.pu-suite-emoji { font-size: 1.5rem; line-height: 1; flex-shrink: 0; }
.pu-suite-corps { display: flex; flex-direction: column; gap: .12rem; flex: 1; min-width: 0; }
.pu-suite-nom { font-weight: 800; font-size: .95rem; }
.pu-suite-desc { font-size: .8rem; line-height: 1.45; color: hsl(var(--muted-foreground)); }
.pu-suite-fleche { color: hsl(var(--primary)); font-weight: 800; flex-shrink: 0; }

.pu-reprise { text-align: center; }

/* ── Contenu rédactionnel ───────────────────────────────────────────────── */
.pu-article { border-top: 1px solid hsl(var(--border)); }
.pu-bloc-texte { margin-bottom: 2.6rem; }
.pu-h2 {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: clamp(1.3rem, 4.6vw, 1.75rem); font-weight: 800; line-height: 1.2;
  margin: 0 0 .9rem; color: hsl(var(--foreground)); text-wrap: balance;
}
.pu-h3 {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.05rem; font-weight: 800;
  margin: 1.6rem 0 .6rem; color: hsl(var(--foreground));
}
.pu-p { font-size: 1rem; line-height: 1.75; color: hsl(var(--muted-foreground)); margin: 0 0 1rem; text-wrap: pretty; }

.pu-figure { margin: 1.6rem 0 1.8rem; }
.pu-figure img {
  display: block; width: 100%; height: auto;
  border-radius: 1.15rem;
  border: 1px solid hsl(var(--border));
}

.pu-faq { display: flex; flex-direction: column; gap: .6rem; }
.pu-faq-item { border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--card)); overflow: hidden; }
.pu-faq-q { padding: .95rem 1.1rem; cursor: pointer; font-weight: 700; font-size: .96rem; list-style: none; }
.pu-faq-q::-webkit-details-marker { display: none; }
.pu-faq-q::after { content: '+'; float: right; color: hsl(var(--primary)); font-weight: 800; }
.pu-faq-item[open] .pu-faq-q::after { content: '−'; }
.pu-faq-a { padding: 0 1.1rem 1.05rem; font-size: .93rem; line-height: 1.65; color: hsl(var(--muted-foreground)); }

/* ── Blocs du contenu rédactionnel ──────────────────────────────────────── */
/* La page était un mur de paragraphes gris. Chaque section porte désormais
   au moins un objet qui casse la colonne : chapô, chiffres, tableau,
   comparatif, liste ou encart. */
.pu-lead {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.12rem; font-weight: 700; line-height: 1.55;
  color: hsl(var(--foreground));
  margin: 0 0 1.1rem; padding-left: 1rem;
  border-left: 4px solid hsl(var(--primary));
  text-wrap: pretty;
}
.pu-citation {
  margin: 0 0 1.2rem; padding: 1.1rem 1.2rem;
  border-radius: 1.1rem;
  border: 1px solid hsl(var(--primary) / .3);
  background: linear-gradient(135deg, hsl(338 72% 62% / .08), hsl(265 60% 56% / .08));
}
.pu-citation p {
  margin: 0; font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.08rem; font-weight: 700; line-height: 1.5;
  color: hsl(var(--foreground)); text-wrap: pretty;
}

/* Lien contextuel : souligné franc et couleur de marque, pour qu'on le voie
   au milieu d'un paragraphe sans avoir à passer la souris dessus. */
.pu-lien-int {
  color: hsl(var(--primary)); font-weight: 700;
  text-decoration: underline; text-decoration-thickness: 2px;
  text-underline-offset: .18em;
  text-decoration-color: hsl(var(--primary) / .4);
  transition: text-decoration-color 150ms ease;
}
.pu-lien-int:hover { text-decoration-color: hsl(var(--primary)); }

.pu-chiffres {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: .7rem;
  margin: 1.4rem 0;
}
.pu-chiffre {
  padding: .95rem .7rem; text-align: center;
  border-radius: 1rem; border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
}
.pu-chiffre-val {
  display: block; font-family: 'Poppins', 'Inter', sans-serif;
  font-size: 1.75rem; font-weight: 800; line-height: 1;
  background: linear-gradient(120deg, hsl(338 72% 62%), hsl(18 88% 58%));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.pu-chiffre-lib {
  display: block; margin-top: .25rem;
  font-size: .74rem; font-weight: 700; line-height: 1.3;
  letter-spacing: .02em; color: hsl(var(--muted-foreground));
}

.pu-tableau-boite {
  margin: 1.4rem 0; padding: 1.1rem;
  border-radius: 1.2rem; border: 1px solid hsl(var(--border));
  background: hsl(var(--card));
}
.pu-tableau-titre {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 800; font-size: .95rem; margin-bottom: .8rem;
  color: hsl(var(--foreground));
}
.pu-tableau-defile { overflow-x: auto; }
.pu-tableau { width: 100%; border-collapse: collapse; font-size: .9rem; }
.pu-tableau th {
  text-align: left; padding: .5rem .6rem;
  font-size: .7rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
  color: hsl(var(--muted-foreground));
  border-bottom: 2px solid hsl(var(--border));
}
.pu-tableau td {
  padding: .7rem .6rem; line-height: 1.45;
  border-bottom: 1px solid hsl(var(--border));
  color: hsl(var(--foreground));
}
.pu-tableau tr:last-child td { border-bottom: none; }
.pu-tableau-pts {
  font-family: 'Poppins', 'Inter', sans-serif;
  font-weight: 800; color: hsl(var(--primary)); white-space: nowrap;
}
.pu-tableau-note {
  margin: .8rem 0 0; font-size: .8rem; line-height: 1.5;
  color: hsl(var(--muted-foreground)); font-style: italic;
}

.pu-comparatif { display: grid; gap: .8rem; margin: 1.4rem 0; }
.pu-comparatif-carte {
  padding: 1.15rem; border-radius: 1.1rem;
  border: 1px solid hsl(var(--border)); background: hsl(var(--card));
}
.pu-comparatif-emoji { font-size: 1.7rem; line-height: 1; }
