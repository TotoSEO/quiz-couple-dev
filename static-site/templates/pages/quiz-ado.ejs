<%
  const ns = 'quiz-ado';
  const quizTitle = t('quizzes:quizAdo.title', 'Quiz Couple Ado');
  const quizDesc = t('quizzes:quizAdo.metaDescription', '');

  // Build hasPart with actual quiz questions using tgd() for proper translations
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= 100; qi++) {
    const qText = tgd('ado.q' + qi, '');
    if (!qText || qText === 'ado.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local('ado.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'ado.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "dateCreated": "2026-02-24", "datePublished": "2026-02-24",
    "isAccessibleForFree": true, "timeRequired": "PT10M",
    "learningResourceType": "Quiz", "interactivityType": "active",
    "educationalAlignment": {
      "@type": "AlignmentObject",
      "educationalFramework": "Couple relationships",
      "targetName": "Teen relationship assessment",
      "alignmentType": "teaches"
    },
    "about": { "@type": "Thing", "name": t(ns + ':jsonLd.about', 'teen couple quiz') },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 80 },
      { "@type": "PropertyValue", "name": "questionsPerSession", "value": 20 },
      { "@type": "PropertyValue", "name": "players", "value": 2 },
      { "@type": "PropertyValue", "name": "audience", "value": "teenagers" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [
    quizSchema,
    {
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [1,2,3,4].map(function(i) {
        return {
          "@type": "Question", "name": t(ns + ':seo.faq' + i + 'Q', ''),
          "acceptedAnswer": { "@type": "Answer", "text": t(ns + ':seo.faq' + i + 'A', '') }
        };
      })
    }
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative py-16 md:py-24 overflow-hidden hero-gradient">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4 relative">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
        <%= t(ns + ':hero.badge') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        <%= t(ns + ':hero.description') %>
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-sm">
        <span class="flex items-center gap-1 text-muted-foreground">
          <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <%= t(ns + ':hero.feat1') %>
        </span>
        <span class="flex items-center gap-1 text-muted-foreground">
          <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
          <%= t(ns + ':hero.feat2') %>
        </span>
        <span class="flex items-center gap-1 text-muted-foreground">
          <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          <%= t(ns + ':hero.feat3') %>
        </span>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Quiz Engine -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="quiz-engine" data-quiz="ado" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
      <% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>
    </div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'up' }) %>

