<%
  var quizType = 'most';
  var ns = 'quiz-most';
  const quizTitle = t('quizzes:quizMost.title', 'Qui est le plus ?');
  const quizDesc = t('quizzes:quizMost.metaDescription', '');

  // Build hasPart with actual quiz questions using tgd() for proper translations
  const hasPart = [];
  const optLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= 260; qi++) {
    const qText = tgd('most.q' + qi, '');
    if (!qText || qText === 'most.q' + qi) break;
    const qObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const ans = [];
    for (let oi = 0; oi < optLetters.length; oi++) {
      const oText = tgd.local('most.q' + qi + optLetters[oi], '');
      if (!oText || oText === 'most.q' + qi + optLetters[oi]) break;
      ans.push({ "@type": "Answer", "position": oi + 1, "text": oText });
    }
    if (ans.length > 0) qObj.suggestedAnswer = ans;
    hasPart.push(qObj);
  }

  const quizSchema = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "isAccessibleForFree": true,
    "learningResourceType": "Quiz", "interactivityType": "active",
    "about": { "@type": "Thing", "name": "who is most likely quiz" },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": 240 },
      { "@type": "PropertyValue", "name": "questionsPerSession", "value": 20 },
      { "@type": "PropertyValue", "name": "players", "value": "2-8" }
    ]
  };
  if (hasPart.length > 0) quizSchema.hasPart = hasPart;

  const jsonLd = [quizSchema];
  const faqQ1 = t(ns + ':faq.q1', '');
  const faqEntries = [];
  for (let i = 1; i <= 6; i++) {
    var q = t(ns + ':faq.q' + i, '');
    var a = t(ns + ':faq.a' + i, '');
    if (q) faqEntries.push({ q, a });
  }
  if (faqEntries.length > 0) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqEntries.map(function(f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%= t(ns + ':hero.description', '') %> <strong><%= t(ns + ':hero.descriptionBold', '') %></strong> <%= t(ns + ':hero.descriptionEnd', '') %></p>
    </div>
  </div>
</section>

<!-- Quiz Engine -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="most" data-lang="<%= lang %>"><%- include("../partials/quiz-loading", { lang, routeKey }) %></div>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- SEO Content -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">

    <!-- How to Play -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':howToPlay.title', '') %></h2>
      <div class="space-y-4">
        <% for (let i = 1; i <= 3; i++) { const sTitle = t(ns + ':howToPlay.step' + i + 'Title', ''); if (sTitle) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= sTitle %></h3>
          <p class="text-muted-foreground"><%= t(ns + ':howToPlay.step' + i + 'Text', '') %></p>
        </div>
        <% } } %>
      </div>
    </section>

    <!-- Why Popular -->
    <%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: (typeof quizTitle !== 'undefined' ? quizTitle : (typeof rawTitle !== 'undefined' ? rawTitle : '')) }) %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':whyPopular.title', '') %></h2>
      <div class="space-y-4">
        <% for (let i = 1; i <= 3; i++) { const iTitle = t(ns + ':whyPopular.item' + i + 'Title', ''); if (iTitle) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= iTitle %></h3>
          <p class="text-muted-foreground"><%- t(ns + ':whyPopular.item' + i + 'Text', '') %></p>
        </div>
        <% } } %>
      </div>
    </section>

    <!-- Examples -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t(ns + ':examples.title', '') %></h2>
      <% const exSub = t(ns + ':examples.subtitle', ''); if (exSub) { %>
      <p class="text-muted-foreground leading-relaxed mb-6"><%= exSub %></p>
      <% } %>
      <div class="space-y-6">
        <% const exSections = ['classic', 'fun', 'intimate'];
        for (const key of exSections) {
          const secTitle = t(ns + ':examples.' + key + 'Title', '');
          const secQuestions = t(ns + ':examples.' + key + 'Questions', []);
          if (secTitle && Array.isArray(secQuestions) && secQuestions.length > 0) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-3"><%= secTitle %></h3>
          <ul class="space-y-2 ml-4 list-disc text-muted-foreground">
            <% for (const q of secQuestions) { %>
            <li><%= q %></li>
            <% } %>
          </ul>
        </div>
        <% } } %>
      </div>
    </section>

    <!-- Tips -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':tips.title', '') %></h2>
      <div class="space-y-4">
        <% for (let i = 1; i <= 3; i++) { const tTitle = t(ns + ':tips.tip' + i + 'Title', ''); if (tTitle) { %>
        <div class="bg-card border border-border rounded-lg p-5">
          <h3 class="text-lg font-semibold mb-2 text-primary"><%= tTitle %></h3>
          <p class="text-muted-foreground"><%= t(ns + ':tips.tip' + i + 'Text', '') %></p>
        </div>
        <% } } %>
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-16 text-center">
      <div class="glass-card-strong rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':cta.title', '') %></h2>
        <p class="text-muted-foreground mb-6"><%= t(ns + ':cta.text', '') %></p>
        <a href="#quiz-engine" class="btn btn-cta"><%= t(ns + ':cta.button', t('common:buttons.startQuiz', 'Commencer le quiz')) %></a>
      </div>
    </section>

    <!-- FAQ -->
    <% if (faqEntries.length > 0) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', 'FAQ') %></h2>
      <div class="space-y-4">
        <% for (const faq of faqEntries) { %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= faq.q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= faq.a %></div>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
