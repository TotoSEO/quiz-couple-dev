<%
  const ns = 'activities';
  const faqItemsRaw = t(ns + ':faq', null);
  const faqItems = Array.isArray(faqItemsRaw) ? faqItemsRaw.filter(function(i) { return i.q && i.q !== '[placeholder]'; }) : [];
%>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<!-- ═══════ BLOC 1 — HERO BANNER ═══════ -->
<section class="act-hero">
  <div class="act-hero-inner">
    <div class="act-hero-content">
      <div class="act-hero-badge">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg> <%= t(ns + ':hero.badge', 'Gratuit') %></span>
        <span class="act-hero-sep">&middot;</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= t(ns + ':hero.badgeGeo', 'Géolocalisé') %></span>
        <span class="act-hero-sep">&middot;</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="10" r="5"/><line x1="3" y1="10" x2="1" y2="10"/><line x1="15" y1="10" x2="13" y2="10"/><line x1="8" y1="5" x2="8" y2="3"/><path d="M17.5 15.5A6 6 0 0122 12h-4"/><path d="M18 10h4"/></svg> <%= t(ns + ':hero.badgeWeather', 'Connecté à la météo') %></span>
      </div>
      <h1 class="act-hero-title"><%= t(ns + ':hero.title', 'Activités autour de moi') %></h1>
      <p class="act-hero-sub"><%= t(ns + ':hero.subtitle', 'Trouvez quoi faire près de chez vous — ce soir, ce week-end, ou là maintenant.') %></p>
      <a href="#outil" class="act-hero-cta" onclick="document.getElementById('outil').scrollIntoView({behavior:'smooth'});return false;"><%= t(ns + ':hero.cta', 'Lancer la recherche') %> &rarr;</a>
    </div>
    <div class="act-hero-illus" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="90" r="50" stroke="white" stroke-width="1" stroke-dasharray="6 4" opacity="0.2"/>
        <circle cx="100" cy="90" r="30" stroke="white" stroke-width="1" stroke-dasharray="4 3" opacity="0.15"/>
        <path d="M40 140 Q70 100 100 130 Q130 160 160 120" stroke="white" stroke-width="1.5" opacity="0.25" fill="none"/>
        <path d="M30 100 Q60 70 90 90 Q120 110 170 80" stroke="white" stroke-width="1.5" opacity="0.2" fill="none"/>
        <path d="M50 170 Q80 150 120 160 Q150 170 180 150" stroke="white" stroke-width="1" opacity="0.15" fill="none"/>
        <path d="M100 80 C100 74 106 68 100 62 C94 68 100 74 100 80z" fill="white" opacity="0.6"/>
        <circle cx="100" cy="72" r="4" fill="white" opacity="0.5"/>
      </svg>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 2 — INTRODUCTION ═══════ -->
<section class="act-intro">
  <div class="act-intro-inner">
    <p><%- t(ns + ':intro.text', '') %></p>
  </div>
</section>

<!-- ═══════ BLOC 3 — OUTIL INTERACTIF ═══════ -->
<section id="outil" class="act-tool">
  <div class="act-tool-inner">
    <div id="activities-engine"
         data-lang="<%= lang %>"
         data-supabase-url="<%= supabaseUrl %>"
         data-supabase-key="<%= supabaseKey %>">
      <div class="text-center py-12">
        <div class="spinner mx-auto mb-4"></div>
        <p class="text-muted-foreground"><%= t(ns + ':results.loading', 'Chargement...') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 4 — COMMENT ÇA MARCHE ═══════ -->
<section class="act-how">
  <div class="act-section-inner">
    <h2 class="act-section-title"><%= t(ns + ':howItWorks.title', 'Comment fonctionne l\'outil ?') %></h2>
    <p class="act-section-sub"><%= t(ns + ':howItWorks.subtitle', 'En quelques secondes, des suggestions adaptées à votre moment.') %></p>
    <div class="act-how-grid">
      <div class="act-how-card">
        <div class="act-how-icon" style="background:hsl(var(--primary)/0.12);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3><%= t(ns + ':howItWorks.step1Title', 'Votre position, vos critères') %></h3>
        <p><%= t(ns + ':howItWorks.step1Text', '') %></p>
      </div>
      <div class="act-how-card">
        <div class="act-how-icon" style="background:hsl(var(--primary)/0.12);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/><line x1="14" y1="7" x2="16" y2="5"/><line x1="15" y1="9" x2="17" y2="8"/><line x1="14.5" y1="11" x2="17" y2="11"/></svg>
        </div>
        <h3><%= t(ns + ':howItWorks.step2Title', 'Un moteur qui réfléchit') %></h3>
        <p><%= t(ns + ':howItWorks.step2Text', '') %></p>
      </div>
      <div class="act-how-card">
        <div class="act-how-icon" style="background:hsl(var(--primary)/0.12);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 7 Q12 12 16 7" fill="none"/><path d="M6 13 Q10 18 14 13" fill="none"/><circle cx="15" cy="16" r="2"/><line x1="15" y1="14" x2="15" y2="11"/></svg>
        </div>
        <h3><%= t(ns + ':howItWorks.step3Title', 'Des milliers de lieux référencés') %></h3>
        <p><%= t(ns + ':howItWorks.step3Text', '') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 5 — SEO / PROBLÉMATIQUE ═══════ -->
<section class="act-seo">
  <div class="act-section-inner">
    <h2 class="act-section-title"><%= t(ns + ':seoContent.title', '') %></h2>
    <div class="act-seo-intro">
      <p><%- t(ns + ':seoContent.p1', '') %></p>
      <p><%- t(ns + ':seoContent.p2', '') %></p>
    </div>
    <blockquote class="act-quote">
      <p>"<%= t(ns + ':seoContent.quote', '') %>"</p>
    </blockquote>
    <div class="act-seo-grid">
      <div class="act-seo-card">
        <h3><%= t(ns + ':seoContent.card1Title', '') %></h3>
        <p><%= t(ns + ':seoContent.card1Text', '') %></p>
      </div>
      <div class="act-seo-card">
        <h3><%= t(ns + ':seoContent.card2Title', '') %></h3>
        <p><%= t(ns + ':seoContent.card2Text', '') %></p>
      </div>
      <div class="act-seo-card">
        <h3><%= t(ns + ':seoContent.card3Title', '') %></h3>
        <p><%= t(ns + ':seoContent.card3Text', '') %></p>
      </div>
      <div class="act-seo-card">
        <h3><%= t(ns + ':seoContent.card4Title', '') %></h3>
        <p><%= t(ns + ':seoContent.card4Text', '') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 6 — CATÉGORIES ═══════ -->
