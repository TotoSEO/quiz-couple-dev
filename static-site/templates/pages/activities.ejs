<!-- ═══════ BLOC 7 — FILTRES ═══════ -->
<section class="act-filters-info">
  <div class="act-section-inner">
    <h2 class="act-section-title"><%= t(ns + ':filtersInfo.title', 'Des filtres pensés pour votre situation') %></h2>
    <p class="act-section-sub"><%= t(ns + ':filtersInfo.subtitle', '') %></p>
    <div class="act-filters-grid">
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f1Title', 'Localisation & rayon') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f1Text', '') %></p>
      </div>
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f2Title', 'Composition du groupe') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f2Text', '') %></p>
      </div>
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a3 3 0 015 0"/><line x1="9" y1="13" x2="15" y2="13"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f3Title', 'Budget par personne') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f3Text', '') %></p>
      </div>
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="10" r="5"/><line x1="3" y1="10" x2="1" y2="10"/><line x1="15" y1="10" x2="13" y2="10"/><line x1="8" y1="5" x2="8" y2="3"/><line x1="8" y1="17" x2="8" y2="15"/><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f4Title', 'Météo en temps réel') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f4Text', '') %></p>
      </div>
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f5Title', 'Ambiance souhaitée') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f5Text', '') %></p>
      </div>
      <div class="act-filter-card">
        <div class="act-filter-header">
          <span class="act-filter-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 12"/></svg></span>
          <h3><%= t(ns + ':filtersInfo.f6Title', 'Durée disponible') %></h3>
        </div>
        <p><%= t(ns + ':filtersInfo.f6Text', '') %></p>
