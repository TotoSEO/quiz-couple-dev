<%
  const ns = 'activities';
  const faqItemsRaw = t(ns + ':faq', null);
  const faqItems = Array.isArray(faqItemsRaw) ? faqItemsRaw.filter(function(i) { return i.q && i.q !== '[placeholder]'; }) : [];
%>

<!-- Leaflet CSS (non-blocking) -->
<link rel="preload" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" as="style" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""></noscript>

<!-- ═══════ BLOC 1 — HERO (standard site hero) ═══════ -->
<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t(ns + ':hero.title', 'Activités autour de moi') %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= t(ns + ':hero.badge', 'Gratuit') %> &middot; <%= t(ns + ':hero.badgeGeo', 'Géolocalisé') %>
      </span>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <%= t(ns + ':hero.title', 'Activités autour de moi') %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.subtitle', 'Trouvez quoi faire près de chez vous — ce soir, ce week-end, ou là maintenant.') %></p>
    </div>
    <div class="mx-auto max-w-3xl mt-8 space-y-4 text-muted-foreground leading-relaxed">
      <p><%- t(ns + ':intro.text', '') %></p>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 2 — OUTIL INTERACTIF ═══════ -->
<section id="outil" class="act-tool">
  <div class="act-tool-inner">
    <div id="activities-engine"
         data-lang="<%= lang %>"
         data-supabase-url="<%= supabaseUrl %>"
         data-supabase-key="<%= supabaseKey %>">
      <div class="text-center py-12">
        <div class="spinner mx-auto mb-4"></div>
        <p class="text-muted-foreground"><%= t(ns + ':results.loading', 'Chargement...') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 3 — COMMENT ÇA MARCHE ═══════ -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-5xl">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3"><%= t(ns + ':howItWorks.title', 'Comment fonctionne l\'outil ?') %></h2>
    <p class="text-center text-muted-foreground mb-12"><%= t(ns + ':howItWorks.subtitle', 'En quelques secondes, des suggestions adaptées à votre moment.') %></p>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center space-y-3">
        <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto" style="background:hsl(var(--primary)/0.1);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3 class="font-bold"><%= t(ns + ':howItWorks.step1Title', 'Votre position, vos critères') %></h3>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':howItWorks.step1Text', '') %></p>
      </div>
      <div class="text-center space-y-3">
        <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto" style="background:hsl(var(--primary)/0.1);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/></svg>
        </div>
        <h3 class="font-bold"><%= t(ns + ':howItWorks.step2Title', 'Un moteur qui réfléchit') %></h3>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':howItWorks.step2Text', '') %></p>
      </div>
      <div class="text-center space-y-3">
        <div class="w-14 h-14 rounded-full flex items-center justify-center mx-auto" style="background:hsl(var(--primary)/0.1);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M12 8v8"/></svg>
        </div>
        <h3 class="font-bold"><%= t(ns + ':howItWorks.step3Title', 'Des milliers de lieux référencés') %></h3>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':howItWorks.step3Text', '') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 4 — SEO / PROBLÉMATIQUE ═══════ -->
<section class="py-16 md:py-24 bg-muted/30">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-6"><%= t(ns + ':seoContent.title', '') %></h2>
    <div class="space-y-4 text-muted-foreground leading-relaxed">
      <p><%- t(ns + ':seoContent.p1', '') %></p>
      <p><%- t(ns + ':seoContent.p2', '') %></p>
    </div>
    <blockquote class="act-quote my-8">
      <p>"<%= t(ns + ':seoContent.quote', '') %>"</p>
    </blockquote>
  </div>
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="grid md:grid-cols-2 gap-6 mt-8">
      <div class="rounded-xl border border-border bg-card p-6 space-y-3">
        <h3 class="font-bold text-foreground"><%= t(ns + ':seoContent.card1Title', '') %></h3>
        <%- t(ns + ':seoContent.card1Text', '') %>
      </div>
      <div class="rounded-xl border border-border bg-card p-6 space-y-3">
        <h3 class="font-bold text-foreground"><%= t(ns + ':seoContent.card2Title', '') %></h3>
        <%- t(ns + ':seoContent.card2Text', '') %>
      </div>
      <div class="rounded-xl border border-border bg-card p-6 space-y-3">
        <h3 class="font-bold text-foreground"><%= t(ns + ':seoContent.card3Title', '') %></h3>
        <%- t(ns + ':seoContent.card3Text', '') %>
      </div>
      <div class="rounded-xl border border-border bg-card p-6 space-y-3">
        <h3 class="font-bold text-foreground"><%= t(ns + ':seoContent.card4Title', '') %></h3>
        <%- t(ns + ':seoContent.card4Text', '') %>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 5 — CATÉGORIES ═══════ -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-5xl">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3"><%= t(ns + ':categoriesShowcase.title', 'Quels types d\'activités sont référencés ?') %></h2>
    <p class="text-center text-muted-foreground mb-12"><%= t(ns + ':categoriesShowcase.subtitle', 'Sept grandes familles, des dizaines de sous-catégories.') %></p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#127963;&#65039;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.culture', 'Culture & Patrimoine') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.cultureSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#127807;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.nature', 'Nature & Plein air') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.natureSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#9889;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.sport', 'Sport & Aventure') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.sportSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#127918;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.divertissement', 'Divertissement') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.divertissementSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#129496;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.bienEtre', 'Bien-être & Détente') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.bienEtreSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5">
        <div class="text-3xl mb-2">&#127863;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.gastronomie', 'Gastronomie') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.gastronomieSub', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 text-center transition-all hover:shadow-md hover:-translate-y-0.5 md:col-span-2">
        <div class="text-3xl mb-2">&#127912;</div>
        <h3 class="font-bold text-sm mb-1"><%= t(ns + ':categories.ateliers', 'Ateliers & Expériences') %></h3>
        <p class="text-xs text-muted-foreground leading-relaxed"><%= t(ns + ':categoriesShowcase.ateliersSub', '') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 6 — FILTRES ═══════ -->
<section class="py-16 md:py-24 bg-muted/30">
  <div class="container mx-auto px-4 max-w-5xl">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-3"><%= t(ns + ':filtersInfo.title', 'Des filtres pensés pour votre situation') %></h2>
    <p class="text-center text-muted-foreground mb-12"><%= t(ns + ':filtersInfo.subtitle', '') %></p>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:hsl(var(--primary)/0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="font-bold text-sm"><%= t(ns + ':filtersInfo.f1Title', 'Localisation & rayon') %></h3>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':filtersInfo.f1Text', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:hsl(var(--primary)/0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3 class="font-bold text-sm"><%= t(ns + ':filtersInfo.f2Title', 'Composition du groupe') %></h3>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':filtersInfo.f2Text', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:hsl(var(--primary)/0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a3 3 0 015 0"/><line x1="9" y1="13" x2="15" y2="13"/></svg>
          </div>
          <h3 class="font-bold text-sm"><%= t(ns + ':filtersInfo.f3Title', 'Budget par personne') %></h3>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':filtersInfo.f3Text', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:hsl(var(--primary)/0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </div>
          <h3 class="font-bold text-sm"><%= t(ns + ':filtersInfo.f4Title', 'Ambiance souhaitée') %></h3>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':filtersInfo.f4Text', '') %></p>
      </div>
      <div class="rounded-xl border border-border bg-card p-5 md:col-span-2">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:hsl(var(--primary)/0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="hsl(var(--primary))" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 12"/></svg>
          </div>
          <h3 class="font-bold text-sm"><%= t(ns + ':filtersInfo.f5Title', 'Durée disponible') %></h3>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed"><%= t(ns + ':filtersInfo.f5Text', '') %></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ BLOC 7 — CTA FINAL ═══════ -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-2xl text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= t(ns + ':ctaFinal.title', 'Prêt à découvrir ce qui vous attend ?') %></h2>
    <p class="text-muted-foreground leading-relaxed mb-8"><%= t(ns + ':ctaFinal.text', '') %></p>
    <a href="#outil" class="btn btn-cta inline-flex items-center gap-2 text-lg px-8 py-4" onclick="document.getElementById('outil').scrollIntoView({behavior:'smooth'});return false;"><%= t(ns + ':ctaFinal.cta', 'Lancer la recherche') %> &rarr;</a>
    <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':ctaFinal.note', 'Gratuit, sans inscription.') %></p>
  </div>
</section>

<!-- FAQ -->
<% if (faqItems.length > 0) { %>
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">FAQ</h2>
    <div class="space-y-3">
      <% for (const item of faqItems) { %>
      <details class="group rounded-xl border border-border p-4 transition-colors open:bg-muted/30">
        <summary class="cursor-pointer font-semibold flex items-center justify-between gap-2">
          <span><%= item.q %></span>
          <svg class="h-4 w-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </summary>
        <p class="mt-3 text-muted-foreground leading-relaxed"><%- item.a %></p>
      </details>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- FAQPage JSON-LD -->
<% if (faqItems.length > 0) { %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(function(item) {
    return {
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    };
  })
}) %></script>
<% } %>

<!-- Leaflet JS (defer to avoid render-blocking) -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
<!-- Activities Engine -->
<script src="/js/activities.js" defer></script>
