      <div class="act-cat-card" style="background:#E8F5E9;">
        <span class="act-cat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-4 0-8 4-8 9s4 9 8 9"/><path d="M12 3c4 0 8 4 8 9s-4 9-8 9"/><line x1="12" y1="3" x2="12" y2="21"/></svg></span>
        <h3><%= t(ns + ':categories.nature', 'Nature & Plein air') %></h3>
        <p><%= t(ns + ':categoriesShowcase.natureSub', '') %></p>
      </div>
      <div class="act-cat-card" style="background:#E3F2FD;">
