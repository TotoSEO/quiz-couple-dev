        <h3><%= t(ns + ':categories.bienEtre', 'Bien-être & Détente') %></h3>
        <p><%= t(ns + ':categoriesShowcase.bienEtreSub', '') %></p>
      </div>
      <div class="act-cat-card" style="background:#FFFDE7;">
        <span class="act-cat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F57F17" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="3" x2="8" y2="12"/><line x1="6" y1="3" x2="6" y2="8"/><line x1="10" y1="3" x2="10" y2="8"/><path d="M6 8a2 2 0 004 0"/><line x1="16" y1="3" x2="16" y2="12"/><path d="M14 3c0 0 0 4 2 5s2 5 2 5"/><line x1="8" y1="12" x2="8" y2="22"/><line x1="16" y1="12" x2="16" y2="22"/></svg></span>
        <h3><%= t(ns + ':categories.gastronomie', 'Gastronomie') %></h3>
        <p><%= t(ns + ':categoriesShowcase.gastronomieSub', '') %></p>
      </div>
      <div class="act-cat-card" style="background:#E0F7FA;">
        <span class="act-cat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00838F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3L8 13"/><path d="M8 13l-3 8 8-3"/><circle cx="18" cy="3" r="2"/></svg></span>
