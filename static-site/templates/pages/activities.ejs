<!-- ═══════ BLOC 8 — CTA FINAL ═══════ -->
<section class="act-cta-final">
  <div class="act-cta-inner">
    <h2><%= t(ns + ':ctaFinal.title', 'Prêt à découvrir ce qui vous attend ?') %></h2>
    <p class="act-cta-text"><%= t(ns + ':ctaFinal.text', '') %></p>
    <a href="#outil" class="act-cta-btn" onclick="document.getElementById('outil').scrollIntoView({behavior:'smooth'});return false;"><%= t(ns + ':ctaFinal.cta', 'Lancer la recherche') %> &rarr;</a>
    <p class="act-cta-note"><%= t(ns + ':ctaFinal.note', 'Gratuit, sans inscription.') %></p>
  </div>
</section>

<!-- FAQ -->
<% if (faqItems.length > 0) { %>
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">FAQ</h2>
    <div class="space-y-3">
      <% for (const item of faqItems) { %>
      <details class="group rounded-xl border border-border p-4 transition-colors open:bg-muted/30">
        <summary class="cursor-pointer font-semibold flex items-center justify-between gap-2">
          <span><%= item.q %></span>
          <svg class="h-4 w-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </summary>
        <p class="mt-3 text-muted-foreground leading-relaxed"><%- item.a %></p>
      </details>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- FAQPage JSON-LD -->
<% if (faqItems.length > 0) { %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(function(item) {
    return {
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    };
  })
}) %></script>
<% } %>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<!-- Activities Engine -->
<script src="/js/activities.js" defer></script>
