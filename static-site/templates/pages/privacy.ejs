        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_2Important', '') %></strong> <%- t('legal:privacy.s2_2ImportantText', '') %></p>
      </div>

      <h3 class="text-xl font-medium text-foreground mb-3 mt-6"><%= t('legal:privacy.s2_3Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_3Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s2_3Item1Label', '') %></strong> <%= t('legal:privacy.s2_3Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_3Item2Label', '') %></strong> <%= t('legal:privacy.s2_3Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_3Item3Label', '') %></strong> <%= t('legal:privacy.s2_3Item3Text', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_3Important', '') %></strong> <%= t('legal:privacy.s2_3ImportantText', '') %></p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s3Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s3Intro', '') %></p>
      <h3 class="text-xl font-medium text-foreground mb-3"><%= t('legal:privacy.s3_1Title', '') %></h3>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><%= t('legal:privacy.s3_1Item1', '') %></li>
        <li><%= t('legal:privacy.s3_1Item2', '') %></li>
        <li><%= t('legal:privacy.s3_1Item3', '') %></li>
        <li><%= t('legal:privacy.s3_1Item4', '') %></li>
      </ul>
      <h3 class="text-xl font-medium text-foreground mb-3"><%= t('legal:privacy.s3_2Title', '') %></h3>
      <div class="bg-primary/10 rounded-lg p-4 border border-primary/20 mb-4">
        <p class="text-foreground text-sm"><%= t('legal:privacy.s3_2Warning', '') %></p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s4Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s4Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground">
        <li><strong><%= t('legal:privacy.s4Item1', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s4Item2', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s4Item3', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s4Item4', '') %></strong></li>
      </ul>
      <p class="text-foreground mt-4"><%- t('legal:privacy.s4Outro', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s5Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s5Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground">
        <li><strong><%= t('legal:privacy.s5Item1Label', '') %></strong> <%= t('legal:privacy.s5Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item2Label', '') %></strong> <%= t('legal:privacy.s5Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item3Label', '') %></strong> <%= t('legal:privacy.s5Item3Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item4Label', '') %></strong> <%= t('legal:privacy.s5Item4Text', '') %></li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s6Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s6Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s6Item1Label', '') %></strong> <%= t('legal:privacy.s6Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s6Item2Label', '') %></strong> <%= t('legal:privacy.s6Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s6Item3Label', '') %></strong> <%= t('legal:privacy.s6Item3Text', '') %></li>
        <li><strong><%= t('legal:privacy.s6Item4Label', '') %></strong> <%= t('legal:privacy.s6Item4Text', '') %></li>
        <li><strong><%= t('legal:privacy.s6Item5Label', '') %></strong> <%= t('legal:privacy.s6Item5Text', '') %></li>
      </ul>
      <p class="text-foreground"><%= t('legal:privacy.s6Outro', '') %></p>
    </section>

    <% for (let i = 7; i <= 10; i++) { %>
    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s' + i + 'Title', '') %></h2>
      <p class="text-foreground"><%= t('legal:privacy.s' + i + 'Text', '') %><% if (i === 10) { %> <a href="mailto:contact@neksin.com" class="text-primary hover:underline">contact@neksin.com</a><% } %></p>
    </section>
    <% } %>

    <p class="text-sm text-muted-foreground mt-12 pt-6 border-t border-border"><%= t('legal:privacy.lastUpdated', '') %></p>
  </article>
</section>
