<section class="container mx-auto px-4 py-12 md:py-16">
  <article class="max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-8"><%= t('legal:privacy.title', 'Politique de Confidentialité') %></h1>
    <p class="text-muted-foreground mb-8"><%= t('legal:privacy.intro', '') %></p>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s1Title', '') %></h2>
      <div class="bg-card rounded-lg p-6 border border-border">
        <ul class="list-none space-y-2 text-foreground">
          <li><strong><%= t('legal:privacy.s1Name', '') %></strong> <%= t('legal:privacy.s1NameValue', '') %></li>
          <li><strong><%= t('legal:privacy.s1Email', '') %></strong> <a href="mailto:contact@neksin.com" class="text-primary hover:underline">contact@neksin.com</a></li>
          <li><strong><%= t('legal:privacy.s1Website', '') %></strong> quiz-couple.com</li>
        </ul>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s2Title', '') %></h2>
      <h3 class="text-xl font-medium text-foreground mb-3"><%= t('legal:privacy.s2_1Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_1Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><%= t('legal:privacy.s2_1Item1', '') %></li>
        <li><%= t('legal:privacy.s2_1Item2', '') %></li>
        <li><%= t('legal:privacy.s2_1Item3', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_1Important', '') %></strong> <%= t('legal:privacy.s2_1ImportantText', '') %></p>
      </div>

      <h3 class="text-xl font-medium text-foreground mb-3 mt-6"><%= t('legal:privacy.s2_2Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_2Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s2_2Item1Label', '') %></strong> <%= t('legal:privacy.s2_2Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_2Item2Label', '') %></strong> <%= t('legal:privacy.s2_2Item2Text', '') %></li>
