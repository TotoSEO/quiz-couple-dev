<section class="container mx-auto px-4 py-12 md:py-16">
  <article class="max-w-3xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-8"><%= t('legal:privacy.title', 'Politique de Confidentialité') %></h1>
    <p class="text-muted-foreground mb-8"><%= t('legal:privacy.intro', '') %></p>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s1Title', '') %></h2>
      <div class="bg-card rounded-lg p-6 border border-border">
        <ul class="list-none space-y-2 text-foreground">
          <li><strong><%= t('legal:privacy.s1Name', '') %></strong> <%= t('legal:privacy.s1NameValue', '') %></li>
          <li><strong><%= t('legal:privacy.s1Email', '') %></strong> <a href="mailto:service@quiz-couple.com" class="text-primary hover:underline">service@quiz-couple.com</a></li>
          <li><strong><%= t('legal:privacy.s1Website', '') %></strong> quiz-couple.com</li>
        </ul>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s2Title', '') %></h2>
      <h3 class="text-xl font-medium text-foreground mb-3"><%= t('legal:privacy.s2_1Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_1Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><%= t('legal:privacy.s2_1Item1', '') %></li>
        <li><%= t('legal:privacy.s2_1Item2', '') %></li>
        <li><%= t('legal:privacy.s2_1Item3', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_1Important', '') %></strong> <%= t('legal:privacy.s2_1ImportantText', '') %></p>
      </div>

      <h3 class="text-xl font-medium text-foreground mb-3 mt-6"><%= t('legal:privacy.s2_2Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_2Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s2_2Item1Label', '') %></strong> <%= t('legal:privacy.s2_2Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_2Item2Label', '') %></strong> <%= t('legal:privacy.s2_2Item2Text', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_2Important', '') %></strong> <%- t('legal:privacy.s2_2ImportantText', '') %></p>
      </div>

      <h3 class="text-xl font-medium text-foreground mb-3 mt-6"><%= t('legal:privacy.s2_3Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_3Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s2_3Item1Label', '') %></strong> <%= t('legal:privacy.s2_3Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_3Item2Label', '') %></strong> <%= t('legal:privacy.s2_3Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_3Item3Label', '') %></strong> <%= t('legal:privacy.s2_3Item3Text', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_3Important', '') %></strong> <%= t('legal:privacy.s2_3ImportantText', '') %></p>
      </div>

      <%# Mesure d'audience premiere partie. Elle se passe de consentement au
          titre de l'exemption prevue pour la mesure d'audience, ce qui suppose
          d'en informer les visiteurs : c'est l'objet de cette sous-section. %>
      <h3 class="text-xl font-medium text-foreground mb-3 mt-6"><%= t('legal:privacy.s2_4Title', '') %></h3>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s2_4Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s2_4Item1Label', '') %></strong> <%= t('legal:privacy.s2_4Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_4Item2Label', '') %></strong> <%= t('legal:privacy.s2_4Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s2_4Item3Label', '') %></strong> <%= t('legal:privacy.s2_4Item3Text', '') %></li>
      </ul>
      <div class="bg-accent/30 rounded-lg p-4 border border-border">
        <p class="text-foreground text-sm"><strong><%= t('legal:privacy.s2_4Important', '') %></strong> <%= t('legal:privacy.s2_4ImportantText', '') %></p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s3Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s3Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground">
        <li><strong><%= t('legal:privacy.s3Item1', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s3Item2', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s3Item3', '') %></strong></li>
        <li><strong><%= t('legal:privacy.s3Item4', '') %></strong></li>
      </ul>
      <p class="text-foreground mt-4"><%- t('legal:privacy.s3Outro', '') %></p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s4Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s4Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground">
        <li><strong><%= t('legal:privacy.s4Item1Label', '') %></strong> <%= t('legal:privacy.s4Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s4Item2Label', '') %></strong> <%= t('legal:privacy.s4Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s4Item3Label', '') %></strong> <%= t('legal:privacy.s4Item3Text', '') %></li>
        <li><strong><%= t('legal:privacy.s4Item4Label', '') %></strong> <%= t('legal:privacy.s4Item4Text', '') %></li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s5Title', '') %></h2>
      <p class="text-foreground mb-4"><%= t('legal:privacy.s5Intro', '') %></p>
      <ul class="list-disc pl-6 space-y-2 text-foreground mb-4">
        <li><strong><%= t('legal:privacy.s5Item1Label', '') %></strong> <%= t('legal:privacy.s5Item1Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item2Label', '') %></strong> <%= t('legal:privacy.s5Item2Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item3Label', '') %></strong> <%= t('legal:privacy.s5Item3Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item4Label', '') %></strong> <%= t('legal:privacy.s5Item4Text', '') %></li>
        <li><strong><%= t('legal:privacy.s5Item5Label', '') %></strong> <%= t('legal:privacy.s5Item5Text', '') %></li>
      </ul>
      <p class="text-foreground"><%= t('legal:privacy.s5Outro', '') %></p>
    </section>

    <% for (let i = 6; i <= 9; i++) { %>
    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-foreground mb-4"><%= t('legal:privacy.s' + i + 'Title', '') %></h2>
      <p class="text-foreground"><%= t('legal:privacy.s' + i + 'Text', '') %><% if (i === 9) { %><a href="<%= getLocalizedUrl('contact', lang) %>" class="text-primary hover:underline"><%= t('legal:privacy.s9Lien', 'contact') %></a><%= t('legal:privacy.s9Fin', '.') %><% } %></p>
    </section>
    <% } %>

    <p class="text-sm text-muted-foreground mt-12 pt-6 border-t border-border"><%= t('legal:privacy.lastUpdated', '') %></p>
  </article>
</section>
