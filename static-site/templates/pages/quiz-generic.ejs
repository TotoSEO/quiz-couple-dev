<%
  /**
   * Generic quiz page template.
   * Set these variables before including:
   * - quizType: 'toxic', 'distance', 'sain', etc.
   * - ns: translation namespace like 'quiz-toxic'
   * - totalQ: total number of questions
   * - sectionCount: how many content sections exist
   *
   * Supports multiple JSON key patterns:
   * A) sectionN.title / sectionN.p1 (quiz-toxic, quiz-distance, quiz-marrant)
   * B) seo.sectionN.title / seo.sectionN.p1 (quiz-coquin)
   * C) seo.sN.title / seo.sN.p1 (quiz-divorce, nested objects)
   * D) seo.sNTitle / seo.sNp1 (quiz-couple-sain, quiz-ado, flat keys)
   */
  if (typeof quizType === 'undefined') var quizType = 'generic';
  if (typeof ns === 'undefined') var ns = 'quiz-' + quizType;
  if (typeof totalQ === 'undefined') var totalQ = 20;
  if (typeof sectionCount === 'undefined') var sectionCount = 7;

  const quizTitle = t('quizzes:' + routeKey + '.title', 'Quiz Couple');
  const quizDesc = t('quizzes:' + routeKey + '.metaDescription', '');

  // ── Multi-pattern helpers ──────────────────────────────────────
  // Try multiple key paths, return first non-empty result
  function tryKeys() {
    for (var i = 0; i < arguments.length; i++) {
      var key = arguments[i];
      var val = t(ns + ':' + key, '');
      if (val) return val;
    }
    return '';
  }

  function getSectionTitle(s) {
    return tryKeys(
      'section' + s + '.title',
      'seo.section' + s + '.title',
      'seo.s' + s + '.title',
      'seo.s' + s + 'Title'
    );
  }

  function getSectionIntro(s) {
    return tryKeys(
      'section' + s + '.intro',
      'seo.section' + s + '.intro',
      'seo.s' + s + '.intro',
      'seo.s' + s + 'Intro'
    );
  }

  function getSectionP(s, p) {
    return tryKeys(
      'section' + s + '.p' + p,
      'seo.section' + s + '.p' + p,
      'seo.s' + s + '.p' + p,
      'seo.s' + s + 'p' + p
    );
  }

  function getSubTitle(s, sub) {
    return tryKeys(
      'section' + s + '.sub' + sub + 'Title',
      'seo.section' + s + '.h3_' + sub,
      'seo.s' + s + '.h3_' + sub,
      'seo.s' + s + 'h3_' + sub + 'Title'
    );
  }

  function getSubText(s, sub, p) {
    // Try paragraph-numbered patterns first
    var result = tryKeys(
      'section' + s + '.sub' + sub + 'P' + p,
      'seo.section' + s + '.h3_' + sub + '_p' + p,
      'seo.s' + s + '.h3_' + sub + '_p' + p,
      'seo.s' + s + '.p' + ((sub - 1) * 2 + p)
    );
    if (result) return result;
    // Single-text patterns (no paragraph number), only return for p=1
    if (p === 1) {
      return tryKeys(
        'section' + s + '.sub' + sub + 'Text',
        'seo.s' + s + 'h3_' + sub + 'Text'
      );
    }
    return '';
  }

  function getPillarTitle(s, c) {
    return tryKeys(
      'section' + s + '.pillar' + c + 'Title',
      'seo.section' + s + '.pillar' + c + 'Title',
      'seo.s' + s + '.pillar' + c + 'Title',
      'seo.s' + s + 'r' + c + 'Title'
    );
  }

  function getPillarText(s, c) {
    return tryKeys(
      'section' + s + '.pillar' + c + 'Text',
      'seo.section' + s + '.pillar' + c + 'Text',
      'seo.s' + s + '.pillar' + c + 'Text',
      'seo.s' + s + 'r' + c + 'Text'
    );
  }

  function getQuote(s) {
    return tryKeys(
      'section' + s + '.quote',
      'seo.section' + s + '.quote',
      'seo.s' + s + '.quote',
      'seo.s' + s + 'Quote'
    );
  }

  function getTip(s) {
    return tryKeys(
      'section' + s + '.tip',
      'seo.section' + s + '.tip',
      'seo.s' + s + '.tip',
      'seo.s' + s + 'Tip'
    );
  }

  // Table helpers
  function getTableHeader(s, col) {
    return tryKeys(
      'section' + s + '.header' + col,
      'seo.section' + s + '.header' + col,
      'seo.s' + s + '.header' + col
    );
  }

  function getTableCell(s, r, col) {
    return tryKeys(
      'section' + s + '.row' + r + col,
      'seo.section' + s + '.row' + r + col,
      'seo.s' + s + '.row' + r + col
    );
  }

  // ── FAQ entries ────────────────────────────────────────────────
  var faqEntries = [];

  // Pattern 1: Array-based FAQ: seo.faq = [{q, a}] or faq.items = [{q, a}]
  var faqArray = t(ns + ':seo.faq', '');
  if (!Array.isArray(faqArray)) faqArray = t(ns + ':faq.items', '');
  if (Array.isArray(faqArray) && faqArray.length > 0) {
    faqEntries = faqArray;
  }

  // Pattern 2: Flat numbered keys: seo.faq1Q/faq1A, jsonLd.faq1Q/faq1A
  if (faqEntries.length === 0) {
    for (let i = 1; i <= 6; i++) {
      var q = tryKeys('jsonLd.faq' + i + 'Q', 'seo.faq' + i + 'Q', 'seo.faqQ' + i);
      var a = tryKeys('jsonLd.faq' + i + 'A', 'seo.faq' + i + 'A', 'seo.faqA' + i);
      if (q) faqEntries.push({ q, a });
    }
  }

  // Pattern 3: Named FAQ keys: faq.q1/faq.a1 or seo.faq.q1.question/answer
  if (faqEntries.length === 0) {
    for (let i = 1; i <= 6; i++) {
      var q = tryKeys('faq.q' + i, 'seo.faq.q' + i + '.question');
      var a = tryKeys('faq.a' + i, 'seo.faq.q' + i + '.answer');
      if (q) faqEntries.push({ q, a });
    }
  }

  // ── JSON-LD ────────────────────────────────────────────────────
  // Map quizType to gd.json prefix for structured data questions
  const gdPrefixMap = {
    'toxic': 'divorce', 'divorce': 'divorce', 'mariage': 'marriage',
    'tester-couple': 'couple', 'common-points': 'commonPoints',
    'sain': 'healthy', 'distance': 'distance', 'coquin': 'coquin',
    'knowledge': 'knowledge', 'amoureux': 'amoureux',
    'marrant': 'marrant', 'most': 'most', 'ado': 'ado',
    'parentalite': 'parentalite', 'emmenager': 'emmenager'
  };
  const gdPrefix = gdPrefixMap[quizType] || quizType;

  // Build hasPart with actual quiz questions from gd.json using tgd() for proper translations
  const hasPart = [];
  const optionLetters = ['a', 'b', 'c', 'd', 'e'];
  for (let qi = 1; qi <= (totalQ + 20); qi++) {
    const qText = tgd(gdPrefix + '.q' + qi, '');
    if (!qText || qText === gdPrefix + '.q' + qi) break;
    const questionObj = { "@type": "Question", "position": hasPart.length + 1, "name": qText };
    const answers = [];
    for (let oi = 0; oi < optionLetters.length; oi++) {
      const optText = tgd.local(gdPrefix + '.q' + qi + optionLetters[oi], '');
      if (!optText || optText === gdPrefix + '.q' + qi + optionLetters[oi]) break;
      answers.push({ "@type": "Answer", "position": oi + 1, "text": optText });
    }
    if (answers.length > 0) questionObj.suggestedAnswer = answers;
    hasPart.push(questionObj);
  }

  const quizJsonLd = {
    "@context": "https://schema.org", "@type": "Quiz",
    "name": quizTitle, "description": quizDesc, "inLanguage": lang,
    "url": canonical,
    "isAccessibleForFree": true, "datePublished": "2026-03-01",
    "learningResourceType": "Quiz", "interactivityType": "active",
    "image": (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : baseUrl + '/og-image.webp',
    "author": { "@type": "Organization", "name": "Quiz Couple", "url": baseUrl },
    "publisher": { "@type": "Organization", "name": "Quiz Couple", "url": baseUrl, "logo": { "@type": "ImageObject", "url": baseUrl + "/apple-touch-icon.png" } },
    "about": { "@type": "Thing", "name": "couple" },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "totalQuestions", "value": totalQ },
      { "@type": "PropertyValue", "name": "audience", "value": "couples" }
    ]
  };
  if (hasPart.length > 0) quizJsonLd.hasPart = hasPart;

  const jsonLd = [quizJsonLd];
  if (faqEntries.length > 0) {
    jsonLd.push({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqEntries.map(function(f) {
        return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
      })
    });
  }

  // Check for hero intro paragraphs (quiz-couple-sain style)
  const heroIntro1 = tryKeys('hero.intro1', 'hero.intro');
  const heroIntro2 = tryKeys('hero.intro2');

  // Check for array-based table (quiz-couple-sain style: seo.tableHeaders + seo.tableRows)
  const arrayTableHeaders = t(ns + ':seo.tableHeaders', '');
  const arrayTableRows = t(ns + ':seo.tableRows', '');

  // Check for signal lists (quiz-couple-sain style: seo.s4Signals)
  function getSignals(s) {
    return tryKeys('seo.s' + s + 'Signals', 'seo.s' + s + '.signals', 'section' + s + '.signals');
  }
  function getOutro(s) {
    return tryKeys('seo.s' + s + 'Outro', 'seo.s' + s + '.outro', 'section' + s + '.outro');
  }
%>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>

<!-- Hero -->
<section class="quiz-page-hero relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse at 30% 30%, hsl(var(--primary) / 0.1) 0%, transparent 50%), radial-gradient(ellipse at 70% 70%, hsl(var(--secondary) / 0.06) 0%, transparent 50%);"></div>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb mb-6" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= quizTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-5">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', quizTitle);
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-5 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground leading-tight">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else if (heroHighlight) { %>
          <%= heroTitle %> <span class="text-gradient"><%= heroHighlight %></span>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl leading-relaxed max-w-2xl mx-auto"><%- t(ns + ':hero.description', '') %></p>
      <% const heroSub = t(ns + ':hero.subtitle', ''); if (heroSub && heroSub !== ns + ':hero.subtitle') { %>
      <p class="text-sm text-muted-foreground mt-4 max-w-xl mx-auto"><%= heroSub %></p>
      <% } %>
    </div>
    <% if (heroIntro1) { %>
    <div class="mx-auto max-w-3xl mt-8 space-y-4 text-muted-foreground leading-relaxed text-center">
      <p><%- heroIntro1 %></p>
      <% if (heroIntro2) { %><p><%- heroIntro2 %></p><% } %>
    </div>
    <% } %>
  </div>
</section>

<!-- Quiz Engine -->
<section class="quiz-engine-section">
  <div class="container mx-auto px-4">
    <div id="quiz-engine" data-quiz="<%= quizType %>" data-lang="<%= lang %>"><%- include('../partials/quiz-loading', { lang, routeKey }) %></div>

    <%/* « Comment jouer ? » repliable. Ne s'affiche que si la page fournit ses
         étapes : les règles n'ont pas à encombrer l'écran de celui qui a déjà
         compris, mais elles doivent rester à portée de clic. */%>
    <% const jouerTitre = t(ns + ':howTo.title', ''); if (jouerTitre) { %>
    <details class="quiz-howto">
      <summary class="quiz-howto-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 015.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
        <span><%= jouerTitre %></span>
      </summary>
      <div class="quiz-howto-corps">
        <ol>
          <% for (let hi = 1; hi <= 4; hi++) {
            const etape = t(ns + ':howTo.step' + hi, '');
            if (!etape) continue; %>
          <li><%- etape %></li>
          <% } %>
        </ol>
        <% const jouerFin = t(ns + ':howTo.outro', ''); if (jouerFin) { %>
        <p class="quiz-howto-fin"><%- jouerFin %></p>
        <% } %>
      </div>
    </details>
    <% } %>

    <%/* Renvoi vers un jeu au format voisin, pour qui n'accroche pas avec
         celui-ci. Ne s'affiche que si la page nomme sa destination. */%>
    <% const croiseRoute = typeof crossRoute !== 'undefined' ? crossRoute : null;
       const croiseTitre = croiseRoute ? t(ns + ':crossLink.title', '') : ''; if (croiseTitre) { %>
    <div class="quiz-croise">
      <p class="quiz-croise-titre"><%= croiseTitre %></p>
      <p class="quiz-croise-texte"><%= t(ns + ':crossLink.text', '') %></p>
      <a class="btn btn-outline quiz-croise-btn" href="<%= getLocalizedUrl(croiseRoute, lang) %>">
        <span aria-hidden="true">🎲</span><%= t(ns + ':crossLink.button', '') %>
      </a>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- SEO Article -->
<article class="py-16 md:py-24 seo-content">
  <div class="container mx-auto px-4 max-w-3xl">
    <% let _figShown = false; const _hasRich = !!tryKeys('seo.richContent'); %>
    <% for (let s = 1; s <= sectionCount; s++) {
      const sTitle = getSectionTitle(s);
      if (!sTitle) continue;
    %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= sTitle %></h2>

      <%/* Intro paragraph */%>
      <% const sIntro = getSectionIntro(s); if (sIntro) { %>
      <p class="text-muted-foreground leading-relaxed mb-8"><%- sIntro %></p>
      <% } %>

      <%/* Standard paragraphs */%>
      <% const paragraphs = [];
        for (let p = 1; p <= 5; p++) { const pText = getSectionP(s, p); if (pText) paragraphs.push(pText); }
        if (paragraphs.length > 0) { %>
      <div class="space-y-4 text-muted-foreground leading-relaxed">
        <% for (const pText of paragraphs) { %>
        <p><%- pText %></p>
        <% } %>
      </div>
      <% } %>

      <%/* Subsections (h3) */%>
      <% for (let sub = 1; sub <= 8; sub++) {
        const subTitle = getSubTitle(s, sub);
        if (!subTitle) continue; %>
      <div class="mt-6">
        <h3 class="text-xl font-semibold mb-3"><%= subTitle %></h3>
        <% for (let sp = 1; sp <= 3; sp++) {
          const spText = getSubText(s, sub, sp);
          if (spText) { %>
        <p class="text-muted-foreground leading-relaxed mb-3"><%- spText %></p>
        <% } } %>
      </div>
      <% } %>

      <%/* Pillar/card items with icon pictograms */%>
      <% const firstPillar = getPillarTitle(s, 1);
        if (firstPillar) {
          const pillarIcons = [
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 00-8 8c0 3.36 2.07 6.24 5 7.42V19a1 1 0 001 1h4a1 1 0 001-1v-1.58c2.93-1.18 5-4.06 5-7.42a8 8 0 00-8-8zM10 22h4"/></svg>',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>'
          ];
          const pillarColors = ['hsl(340, 65%, 65%)', 'hsl(270, 40%, 50%)', 'hsl(200, 60%, 50%)', 'hsl(150, 50%, 45%)', 'hsl(30, 80%, 55%)', 'hsl(0, 60%, 55%)', 'hsl(180, 50%, 45%)', 'hsl(260, 50%, 55%)'];
        %>
      <div class="icon-cards-grid mt-6">
        <% for (let c = 1; c <= 8; c++) {
          const cTitle = getPillarTitle(s, c);
          if (!cTitle) continue; %>
        <div class="card-with-icon">
          <div class="icon-circle" style="background: <%= pillarColors[(c-1) % pillarColors.length] %>20; color: <%= pillarColors[(c-1) % pillarColors.length] %>">
            <%- pillarIcons[(c-1) % pillarIcons.length] %>
          </div>
          <h3 class="text-lg font-semibold mb-2"><%= cTitle %></h3>
          <p class="text-muted-foreground text-sm"><%- getPillarText(s, c) %></p>
        </div>
        <% } %>
      </div>
      <% } %>

      <%/* Signal list (quiz-couple-sain style) */%>
      <% const signals = getSignals(s);
        if (signals && Array.isArray(signals)) { %>
      <ul class="space-y-3 mt-6 ml-4">
        <% for (const sig of signals) { %>
        <li class="flex items-start gap-2"><span class="text-destructive font-bold mt-1">&bull;</span><span class="text-muted-foreground"><%- sig %></span></li>
        <% } %>
      </ul>
      <% const outro = getOutro(s); if (outro) { %>
      <p class="text-muted-foreground leading-relaxed mt-6"><%- outro %></p>
      <% } } %>

      <%/* Table: row-based pattern (sectionN.headerScore/row1Score) */%>
      <% const hasRowTable = getTableHeader(s, 'Score');
        if (hasRowTable) { %>
      <div class="overflow-x-auto mt-6">
        <table class="quiz-table">
          <thead><tr>
            <th><%= getTableHeader(s, 'Score') %></th>
            <th><%= getTableHeader(s, 'Level') %></th>
            <th><%= getTableHeader(s, 'Analysis') %></th>
          </tr></thead>
          <tbody>
            <% for (let r = 1; r <= 6; r++) {
              const rScore = getTableCell(s, r, 'Score');
              if (!rScore) continue; %>
            <tr>
              <td class="font-medium"><%= rScore %></td>
              <td><%= getTableCell(s, r, 'Level') %></td>
              <td class="text-sm text-muted-foreground"><%= getTableCell(s, r, 'Analysis') %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>

      <%/* Table: array-based pattern (seo.tableHeaders + seo.tableRows) */%>
      <% if (Array.isArray(arrayTableHeaders) && Array.isArray(arrayTableRows) && s === (function() {
          // Render this table in the section whose title matches the table context
          for (var ts = 1; ts <= sectionCount; ts++) {
            var tt = getSectionTitle(ts);
            if (tt && (tt.toLowerCase().includes('tableau') || tt.toLowerCase().includes('repère') || tt.toLowerCase().includes('vs') || tt.toLowerCase().includes('comparaison'))) return ts;
          }
          return 3; // default to section 3
        })()) { %>
      <div class="overflow-x-auto mt-6">
        <table class="quiz-table">
          <thead><tr>
            <% for (const h of arrayTableHeaders) { %><th><%= h %></th><% } %>
          </tr></thead>
          <tbody>
            <% for (const row of arrayTableRows) { %>
            <tr>
              <% for (let ci = 0; ci < row.length; ci++) { %>
              <td class="<%= ci === 0 ? 'font-medium' : 'text-sm text-muted-foreground' %>"><%- row[ci] %></td>
              <% } %>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>

      <%/* Tip box */%>
      <% const tip = getTip(s); if (tip) { %>
      <div class="mt-6 p-4 bg-primary/5 border border-primary/20 rounded-lg">
        <p class="text-sm text-muted-foreground"><%- tip %></p>
      </div>
      <% } %>

      <%/* Blockquote */%>
      <% const quote = getQuote(s); if (quote) { %>
      <blockquote class="border-l-4 border-primary pl-6 py-2 bg-muted/30 rounded-r-lg my-6">
        <p class="text-lg italic"><%- quote %></p>
      </blockquote>
      <% } %>
    </section>
    <% if (!_figShown && !_hasRich) { _figShown = true; %><%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: quizTitle }) %><% } %>
    <% } %>

    <%/* Card-based content with icon pictograms */%>
    <% const whyTitle = tryKeys('seo.whyTitle');
      if (whyTitle) {
        const cardIcons = [
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>',
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>',
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>',
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>'
        ];
        const cardColors = ['hsl(340, 65%, 65%)', 'hsl(270, 40%, 50%)', 'hsl(200, 60%, 50%)', 'hsl(150, 50%, 45%)', 'hsl(30, 80%, 55%)', 'hsl(0, 60%, 55%)'];
      %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-4"><%= whyTitle %></h2>
      <% const whySub = tryKeys('seo.whySubtitle'); if (whySub) { %>
      <p class="text-muted-foreground leading-relaxed mb-6"><%- whySub %></p>
      <% } %>
      <div class="icon-cards-grid">
        <% for (let c = 1; c <= 6; c++) {
          const cTitle = tryKeys('seo.card' + c + 'Title');
          if (!cTitle) continue; %>
        <div class="card-with-icon">
          <div class="icon-circle" style="background: <%= cardColors[(c-1) % cardColors.length] %>20; color: <%= cardColors[(c-1) % cardColors.length] %>">
            <%- cardIcons[(c-1) % cardIcons.length] %>
          </div>
          <h3 class="text-lg font-semibold mb-2"><%= cTitle %></h3>
          <p class="text-muted-foreground text-sm"><%- tryKeys('seo.card' + c + 'Text') %></p>
        </div>
        <% } %>
      </div>
    </section>
    <% if (!_figShown && !_hasRich) { _figShown = true; %><%- include('../partials/seo-figure', { contentImage: typeof contentImage !== 'undefined' ? contentImage : null, contentImageAlt: quizTitle }) %><% } %>
    <% } %>

    <%/* Step-based "how it works" (quiz-tester-couple style) */%>
    <% const howTitle = tryKeys('seo.howTitle');
      if (howTitle) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= howTitle %></h2>
      <div class="space-y-4">
        <% const stepColors = ['hsl(340, 65%, 65%)', 'hsl(270, 40%, 50%)', 'hsl(200, 60%, 50%)', 'hsl(150, 50%, 45%)'];
        for (let s = 1; s <= 4; s++) {
          const sTitle = tryKeys('seo.step' + s + 'Title');
          if (!sTitle) continue; %>
        <div class="card-with-icon" style="flex-direction: row; align-items: center; gap: 1rem;">
          <div class="icon-circle" style="background: <%= stepColors[(s-1) % stepColors.length] %>20; color: <%= stepColors[(s-1) % stepColors.length] %>; flex-shrink: 0; margin-bottom: 0;">
            <span style="font-weight: 700; font-size: 0.875rem;"><%= s %></span>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-1"><%= sTitle %></h3>
            <p class="text-muted-foreground text-sm"><%- tryKeys('seo.step' + s + 'Text') %></p>
          </div>
        </div>
        <% } %>
      </div>
    </section>
    <% } %>

    <%/* Rich HTML content (quiz-mariage style: seo.richContent) */%>
    <% const richContent = tryKeys('seo.richContent');
      if (richContent) { %>
    <section class="mb-16 seo-rich-content">
      <%- richContent %>
    </section>
    <% } %>

    <%/* FAQ section */%>
    <% if (faqEntries.length > 0) { %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= tryKeys('seo.faqTitle', 'faqTitle', 'faq.title', 'seo.faq.title') || 'FAQ' %></h2>
      <div class="space-y-4">
        <% for (const faq of faqEntries) { %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= faq.q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- faq.a %></div>
        </details>
        <% } %>
      </div>
    </section>
    <% } %>

  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<div id="route-slugs-data" data-route-slugs="<%- escapeHtml(JSON.stringify(routeSlugs)) %>" hidden></div>
<script src="/js/quiz-engine-core.js" defer></script>
<script src="/js/quiz-loader.js" defer></script>
