<%
  // Différence d'âge en couple (6 novembre 2026) : deux dates de naissance,
  // l'écart exact, qui a de plus que l'autre, la règle de la moitié plus
  // sept, le moment de l'année où l'écart affiché change, et les âges
  // additionnés. Outil autonome, hors quiz-loader, sur le gabarit des outils
  // par date (classes astro-* et dn-*) ; le calcul est dans js/difference-age.js.
  const ns = 'difference-age';
  const pageTitle = t('quizzes:differenceAge.title', "Différence d'âge en couple");

  // Tout ce que le script doit pouvoir afficher, dans la langue de la page.
  const daI18n = {
    form: {
      jour: t(ns + ':form.jour', 'Jour'),
      moisLabel: t(ns + ':form.moisLabel', 'Mois'),
      annee: t(ns + ':form.annee', 'Année'),
      mois: t(ns + ':form.mois', []),
      moisDate: t(ns + ':form.moisDate', []),
      joursSemaine: t(ns + ':form.joursSemaine', []),
      dateAffichee: t(ns + ':form.dateAffichee', '{{j}} {{mois}} {{a}}'),
      dateAvecJour: t(ns + ':form.dateAvecJour', '{{js}} {{date}}'),
      jourMois: t(ns + ':form.jourMois', '{{j}} {{mois}}'),
      premier: t(ns + ':form.premier', '1'),
      erreur: t(ns + ':form.erreur', ''),
      erreurVide: t(ns + ':form.erreurVide', ''),
      erreurFutur: t(ns + ':form.erreurFutur', ''),
    },
    unites: t(ns + ':unites', {}),
    et: t(ns + ':et', ' et '),
    virgule: t(ns + ':virgule', ', '),
    quand: t(ns + ':quand', {}),
    resultat: t(ns + ':resultat', {}),
  };

  const faqEntrees = [];
  for (let i = 1; i <= 6; i++) {
    const q = t(ns + ':faq.q' + i, '');
    const a = t(ns + ':faq.a' + i, '');
    if (q && a) faqEntrees.push({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } });
  }

  const baseUrl = 'https://quiz-couple.com';
  const imageDA = (typeof featuredImage !== 'undefined' && featuredImage) ? baseUrl + featuredImage : baseUrl + '/og-image.webp';
  const appDA = {
    '@context': 'https://schema.org', '@type': 'WebApplication',
    name: t(ns + ':jsonLd.name', pageTitle),
    description: t('quizzes:differenceAge.metaDescription', t('quizzes:differenceAge.description', '')),
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    inLanguage: lang,
    url: canonical,
    image: imageDA,
    isAccessibleForFree: true,
    about: { '@type': 'Thing', name: t(ns + ':jsonLd.about', '') },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    author: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl },
    publisher: { '@type': 'Organization', name: 'Quiz Couple', url: baseUrl, logo: { '@type': 'ImageObject', url: baseUrl + '/apple-touch-icon.png' } }
  };
  const personnes = [
    { n: '1', titre: t(ns + ':form.moi', ''), ex: t(ns + ':form.prenom1Ex', '') },
    { n: '2', titre: t(ns + ':form.autre', ''), ex: t(ns + ':form.prenom2Ex', '') },
  ];
%>
<script type="application/ld+json"><%- JSON.stringify(appDA) %></script>
<% if (faqEntrees.length) { %>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntrees }) %></script>
<% } %>

<!-- Hero -->
<section class="quiz-page-hero relative overflow-hidden hero-gradient">
  <div class="container mx-auto px-4 relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= t('quizzes:differenceAge.shortTitle', pageTitle) %></li>
        </ol>
      </nav>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="8" cy="12" r="5"/><circle cx="17" cy="12" r="4"/><path d="M8 9.5V12l1.5 1M17 10v2l1 .8"/></svg>
        <%= t(ns + ':hero.badge', '') %>
      </span>
      <%
        const heroTitle = t(ns + ':hero.title', pageTitle);
        const heroHighlight = t(ns + ':hero.highlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- escapeHtml(heroTitle).replace(escapeHtml(heroHighlight), '<span class="text-gradient">' + escapeHtml(heroHighlight) + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground md:text-xl"><%- t(ns + ':hero.description', '') %></p>
      <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':hero.subtitle', '') %></p>
    </div>
  </div>
  <%# L'image de tête vient en dernier dans le code, comme sur les autres pages de test. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '', featuredImageSrcset: typeof featuredImageSrcset !== 'undefined' ? featuredImageSrcset : null }) %>
</section>

<!-- L'outil -->
<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-2xl">
      <div id="da-outil" class="astro-form-card rounded-2xl p-6 md:p-10" data-lang="<%= lang %>">

        <div id="da-formulaire">
          <h2 class="text-xl md:text-2xl font-bold text-center mb-6"><%= t(ns + ':form.titre', '') %></h2>
          <% personnes.forEach(function (p) { %>
          <div class="dn-personne">
            <p class="dn-personne-titre"><span class="dn-personne-num dn-personne-num-<%= p.n %>"><%= p.n %></span><%= p.titre %></p>
            <div class="dn-champs">
              <div class="astro-field">
                <label class="astro-field-label" for="da-jour-<%= p.n %>"><%= t(ns + ':form.jour', 'Jour') %></label>
                <div class="astro-select-wrap"><select id="da-jour-<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="da-mois-<%= p.n %>"><%= t(ns + ':form.moisLabel', 'Mois') %></label>
                <div class="astro-select-wrap"><select id="da-mois-<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
              <div class="astro-field">
                <label class="astro-field-label" for="da-annee-<%= p.n %>"><%= t(ns + ':form.annee', 'Année') %></label>
                <div class="astro-select-wrap"><select id="da-annee-<%= p.n %>" class="astro-input astro-select"></select></div>
              </div>
            </div>
            <div class="astro-field mt-3">
              <label class="astro-field-label" for="da-nom-<%= p.n %>"><%= t(ns + ':form.prenom', '') %></label>
              <input id="da-nom-<%= p.n %>" type="text" class="astro-input" maxlength="30" autocomplete="off" placeholder="<%= p.ex %>">
            </div>
          </div>
          <% }) %>

          <p id="da-erreur" class="dn-erreur hidden" role="alert"></p>

          <div class="mt-6 text-center">
            <button id="da-lancer" type="button" class="btn btn-cta btn-gradient astro-submit-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <%= t(ns + ':form.lancer', '') %>
            </button>
            <p class="text-sm text-muted-foreground mt-4"><%= t(ns + ':form.aide', '') %></p>
          </div>
        </div>

        <div id="da-resultat" class="hidden"></div>

        <div id="da-suite" class="hidden">
          <div class="cc-actions">
            <button id="da-copier" type="button" class="btn btn-outline px-6 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              <%= t(ns + ':resultat.lienBouton', '') %>
            </button>
            <button id="da-refaire" type="button" class="btn btn-outline px-6 py-3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              <%= t(ns + ':resultat.modifier', '') %>
            </button>
          </div>
          <p id="da-copie" class="cc-copie hidden" role="status"></p>

          <div class="dn-suite-carte">
            <h3 class="dn-suite-titre"><%= t(ns + ':suite.titre', '') %></h3>
            <p class="dn-suite-texte"><%= t(ns + ':suite.texte', '') %></p>
            <a class="btn btn-cta btn-gradient" href="<%= getLocalizedUrl('testCompatibilite', lang) %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
              <%= t(ns + ':suite.bouton', '') %>
            </a>
          </div>
          <div class="text-center mt-6">
            <a href="#pq-reviews" class="btn btn-outline px-6 py-2.5 text-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <%= t(ns + ':resultat.avis', '') %>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# Sous l'outil, jamais au-dessus. %>
<% if (typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 31 }) %><% } %>

<%- include('../partials/wave-divider', { variant: 'muted', direction: 'down' }) %>

<!-- Contenu -->
<article class="py-16 md:py-24 seo-content">
  <div class="avec-colonne">
    <div class="avec-colonne__contenu container mx-auto px-4 max-w-3xl">

    <% for (let s = 1; s <= 4; s++) {
         const cle = ns + ':section' + s;
         const titre = t(cle + '.title', '');
         if (!titre) continue;
         const avant = ['p1', 'p2', 'p3'].map(function (k) { return t(cle + '.' + k, ''); }).filter(Boolean);
         const points = t(cle + '.points', []);
         const apres = t(cle + '.apres', '');
    %>
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= titre %></h2>
      <div class="space-y-4 text-muted-foreground leading-relaxed<%= (points.length || apres) ? ' mb-6' : '' %>">
        <% avant.forEach(function (p) { %><p><%- p %></p><% }) %>
      </div>
      <% if (points.length) { %>
      <ul class="space-y-3 text-muted-foreground leading-relaxed list-disc pl-6<%= apres ? ' mb-6' : '' %>">
        <% points.forEach(function (pt) { %><li><%- pt %></li><% }) %>
      </ul>
      <% } %>
      <% if (apres) { %><div class="space-y-4 text-muted-foreground leading-relaxed"><p><%- apres %></p></div><% } %>
    </section>
    <% if (s === 1 && typeof pagePublicitaire !== 'undefined' && pagePublicitaire) { %><%- include('../partials/pub', { format: 2 }) %><% } %>
    <% } %>

    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold mb-6"><%= t(ns + ':faq.title', 'FAQ') %></h2>
      <div class="space-y-3">
        <% for (let i = 1; i <= 6; i++) { const q = t(ns + ':faq.q' + i, ''); if (!q) continue; %>
        <details class="border border-border rounded-lg">
          <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= q %></summary>
          <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%- t(ns + ':faq.a' + i) %></div>
        </details>
        <% } %>
      </div>
    </section>

    </div>
  </div>
</article>

<%- include('../partials/related-tests', { routeKey, lang, t, getLocalizedUrl }) %>

<script>window.DA_I18N = <%- JSON.stringify(daI18n).replace(/</g, '\\u003c') %>;</script>
<script src="/js/difference-age.js" defer></script>
