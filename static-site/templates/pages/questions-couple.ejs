<%
  const ns = 'quiz-questions-couple';
  const faqRaw = t(ns + ':seo.faq', null);
  const faqItems = Array.isArray(faqRaw) ? faqRaw : [];
  const jsonLd = faqItems.length > 0 ? {
    "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqItems.map(function(item) {
      return { "@type": "Question", "name": item.q, "acceptedAnswer": { "@type": "Answer", "text": item.a } };
    })
  } : null;

  // Le curseur des listes : les articles de questions publiés dans la langue
  // (ARTICLES_QUESTIONS de config.js, cartes faites par carteArticle).
  const _cartes = typeof articlesQuestions !== 'undefined' && Array.isArray(articlesQuestions) ? articlesQuestions : [];
  const _listes = t(ns + ':listes', {}) || {};
  const _tags = _listes.tags || {};
  const _locale = { fr: 'fr-FR', en: 'en-GB', es: 'es-ES', de: 'de-DE', it: 'it-IT', nl: 'nl-NL' }[lang] || 'fr-FR';
  const _nombre = function (n) { try { return Number(n).toLocaleString(_locale); } catch (e) { return String(n); } };
  const _seuilLu = typeof seuilLectures === 'number' ? seuilLectures : 10;
  // Largeur affichée des images des cartes (.quiz-slide, max-w-4xl), relevée dans Chromium
  const _taillesCarte = '(min-width: 900px) 270px, (min-width: 640px) calc(46vw - 15px), min(340px, calc(82vw - 27px))';

  // En français, « ? ! : ; » et les guillemets restent collés à leur mot : sinon,
  // sur téléphone, le point d'interrogation d'une question passe seul à la ligne.
  const _insec = function (x) {
    if (lang !== 'fr' || x == null) return x;
    return String(x).replace(/ ([?!:;»])/g, '\u00a0$1').replace(/« /g, '«\u00a0');
  };

  const _situations = t(ns + ':situations', null);
  const _jeux = t(ns + ':jeux', null);
  const _conseils = t(ns + ':conseils', null);
%>
<% if (jsonLd) { %>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<% } %>

<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= rawTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <div><span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <%= heroBadge %>
      </span></div>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', '120 questions pour couple');
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto"><%= _insec(t(ns + ':hero.description', '')) %></p>
    </div>
  </div>
  <%# L'image de tete vient en dernier dans le code : sur mobile, elle s'affiche sous le texte (order: 99) et sur grand ecran elle est posee en absolu. Placee en tete, elle etait peinte seule pendant que le reste de la section arrivait encore, puis sautait de 300 px quand le texte se mettait en place. %>
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
</section>

<section class="container mx-auto px-4 py-8 md:py-12">
  <div class="mx-auto max-w-4xl space-y-10">

    <!-- Tirage au sort, alimente par la liste ci-dessous -->
    <div id="questions-container"></div>

    <% if (_cartes.length) { %>
    <section class="qc-listes" aria-labelledby="qc-listes-titre">
      <div class="bloc-entete">
        <span class="bloc-pastille"><%= _listes.pastille %></span>
        <h2 class="bloc-titre" id="qc-listes-titre"><%= _listes.titre %></h2>
        <span class="bloc-trait" aria-hidden="true"></span>
        <p class="bloc-sous-titre"><%= _insec(_listes.sousTitre) %></p>
      </div>
      <div class="quiz-slider" data-slider>
        <button type="button" class="quiz-slider__nav quiz-slider__nav--prev" data-slider-prev aria-label="<%= t('common:buttons.previous', 'Précédent') %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="quiz-slider__track" data-slider-track>
          <% for (const art of _cartes) { %>
          <a href="<%= art.url %>" class="quiz-slide lire-carte qc-liste-carte">
            <span class="lire-media">
              <% if (art.image) { %>
              <img src="<%= art.image %>"<% if (art.imageSrcset) { %> srcset="<%= art.imageSrcset %>" sizes="<%= _taillesCarte %>"<% } %> alt="" loading="lazy" decoding="async" width="1200" height="675">
              <% } %>
            </span>
            <span class="lire-corps">
              <% if (_tags[art.cle]) { %><span class="qc-liste-tag"><%= _tags[art.cle] %></span><% } %>
              <h3 class="lire-titre"><%= art.title %></h3>
              <span class="lire-meta">
                <% if (art.minutes) { %>
                <span class="lire-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><%= String(_listes.minutes || '{n} min').replace('{n}', art.minutes) %></span>
                <% } %>
                <% if (art.lectures !== null && art.lectures !== undefined && art.lectures >= _seuilLu) { %>
                <span class="lire-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><%= String(_listes.lu || '{n}').replace('{n}', _nombre(art.lectures)) %></span>
                <% } %>
              </span>
              <span class="lire-bouton"><%= _listes.bouton %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
            </span>
          </a>
          <% } %>
        </div>
        <button type="button" class="quiz-slider__nav quiz-slider__nav--next" data-slider-next aria-label="<%= t('common:buttons.next', 'Suivant') %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="quiz-slider__pied" aria-hidden="true">
          <div class="quiz-slider__barre"><span class="quiz-slider__avance"></span></div>
          <span class="quiz-slider__compteur" data-slider-compteur></span>
        </div>
      </div>
    </section>
    <% } %>

    <%
      // Les 120 questions sont ecrites dans le HTML, pas chargees en
      // JavaScript apres coup : c'est la liste elle-meme que les moteurs de
      // recherche doivent pouvoir lire, et c'est ce que font les pages qui se
      // positionnent sur cette requete.
      const liste = t(ns + ':liste', {});
      const themes = Object.keys(liste || {});
    %>
    <% if (themes.length) { %>
    <section class="qc-liste" id="liste-questions">
      <h2 class="qc-liste-titre"><%= t(ns + ':liste_titre', '') %></h2>
      <p class="qc-liste-intro"><%= t(ns + ':liste_intro', '') %></p>

      <nav class="qc-sommaire" aria-label="<%= t(ns + ':liste_titre', '') %>">
        <% themes.forEach(function (cle) { %>
        <a href="#theme-<%= cle %>" class="qc-sommaire-lien"><%= liste[cle].titre %></a>
        <% }); %>
      </nav>

      <% let numero = 0; %>
      <% themes.forEach(function (cle) { %>
      <div class="qc-theme" id="theme-<%= cle %>" data-theme="<%= cle %>" data-court="<%= liste[cle].court || liste[cle].titre %>">
        <h3 class="qc-theme-titre"><%= liste[cle].titre %></h3>
        <p class="qc-theme-intro"><%- _insec(liste[cle].intro) %></p>
        <ol class="qc-questions">
          <% liste[cle].questions.forEach(function (q) { numero++; %>
          <li class="qc-question"><span class="qc-numero"><%= numero %>.</span><span><%= _insec(q) %></span></li>
          <% }); %>
        </ol>
      </div>
      <% }); %>
    </section>
    <% } %>

    <article class="space-y-12 pt-10 border-t border-border seo-content">

      <% if (_situations && Array.isArray(_situations.items)) { %>
      <section>
        <h2 class="text-2xl font-bold mb-4"><%= _insec(_situations.titre) %></h2>
        <p class="text-muted-foreground mb-8 leading-relaxed"><%= _insec(_situations.intro) %></p>
        <div class="qc-situations">
          <% for (const sit of _situations.items) { %>
          <div class="qc-situation">
            <h3 class="qc-situation-titre"><%= _insec(sit.titre) %></h3>
            <p class="qc-situation-texte"><%- _insec(sit.texte) %></p>
            <ul class="qc-exemples">
              <% for (const ex of (sit.exemples || [])) { %>
              <li><%= _insec(ex) %></li>
              <% } %>
            </ul>
          </div>
          <% } %>
        </div>
      </section>
      <% } %>

      <% if (_jeux && Array.isArray(_jeux.items)) { %>
      <section>
        <h2 class="text-2xl font-bold mb-4"><%= _jeux.titre %></h2>
        <p class="text-muted-foreground mb-6 leading-relaxed"><%= _insec(_jeux.intro) %></p>
        <div class="qc-jeux">
          <% for (const jeu of _jeux.items) {
               const _url = getLocalizedUrl(jeu.route, lang);
               if (!_url) continue; %>
          <a href="<%= _url %>" class="qc-jeu">
            <span class="qc-jeu-nom"><%= t('common:nav.' + jeu.route, jeu.route) %></span>
            <span class="qc-jeu-texte"><%= _insec(jeu.texte) %></span>
            <span class="qc-jeu-cta"><%= _jeux.bouton %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
          </a>
          <% } %>
        </div>
      </section>
      <% } %>

      <%# L'évaluation de couple, avant les conseils (partials/bilan-banniere.ejs,
          seulement quand elle est ouverte). %>
      <%- include('../partials/bilan-banniere') %>

      <% if (_conseils && Array.isArray(_conseils.items)) { %>
      <section>
        <h2 class="text-2xl font-bold mb-4"><%= _conseils.titre %></h2>
        <p class="text-muted-foreground mb-4 leading-relaxed"><%= _insec(_conseils.intro) %></p>
        <ul class="qc-conseils">
          <% for (const c of _conseils.items) { %>
          <li><strong><%= _insec(c.titre) %></strong> <%= _insec(c.texte) %></li>
          <% } %>
        </ul>
      </section>
      <% } %>

      <% if (faqItems.length > 0) { %>
      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.faqTitle', 'FAQ') %></h2>
        <div class="space-y-4">
          <% for (const item of faqItems) { %>
          <details class="border border-border rounded-lg">
            <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= _insec(item.q) %></summary>
            <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= _insec(item.a) %></div>
          </details>
          <% } %>
        </div>
      </section>
      <% } %>

    </article>

  </div>
</section>

<script src="/js/questions-couple.js" defer></script>
<script src="/js/quiz-slider.js" defer></script>
