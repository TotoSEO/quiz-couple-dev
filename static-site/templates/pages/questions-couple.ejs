<%
  const ns = 'quiz-questions-couple';
  // FAQ items for JSON-LD
  const faqRaw = t(ns + ':seo.faq', null);
  const faqItems = Array.isArray(faqRaw) ? faqRaw : [];
  const jsonLd = faqItems.length > 0 ? {
    "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqItems.map(function(item) {
      return { "@type": "Question", "name": item.q, "acceptedAnswer": { "@type": "Answer", "text": item.a } };
    })
  } : null;

  // Table data
  const tableHeaders = t(ns + ':seo.s2.tableHeaders', { category: 'Catégorie', goal: 'Objectif', example: 'Exemple', count: 'Nombre' });
  const tableRowsRaw = t(ns + ':seo.s2.rows', null);
  const tableRows = Array.isArray(tableRowsRaw) ? tableRowsRaw : [];
  const whenItemsRaw = t(ns + ':seo.s3.items', null);
  const whenItems = Array.isArray(whenItemsRaw) ? whenItemsRaw : [];
  const tipsRaw = t(ns + ':seo.s4.tips', null);
  const tipsList = Array.isArray(tipsRaw) ? tipsRaw : [];
  const audiencesRaw = t(ns + ':seo.s5.audiences', null);
  const audiences = Array.isArray(audiencesRaw) ? audiencesRaw : [];
%>
<% if (jsonLd) { %>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<% } %>

<section class="relative overflow-hidden hero-gradient py-16 md:py-24">
  <%- include('../partials/quiz-featured', { featuredImage: typeof featuredImage !== 'undefined' ? featuredImage : null, featuredImageAlt: typeof featuredImageAlt !== 'undefined' ? featuredImageAlt : '' }) %>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="<%= lang === 'fr' ? '/' : '/' + lang + '/' %>">Quiz Couple</a></li>
          <li class="breadcrumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></li>
          <li class="breadcrumb-current" aria-current="page"><%= rawTitle %></li>
        </ol>
      </nav>
      <% const heroBadge = t(ns + ':hero.badge', ''); if (heroBadge) { %>
      <span class="hero-badge mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <%= heroBadge %>
      </span>
      <% } %>
      <%
        const heroTitle = t(ns + ':hero.title', '120 questions pour couple');
        const heroHighlight = t(ns + ':hero.titleHighlight', '');
      %>
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-foreground">
        <% if (heroHighlight && heroTitle.includes(heroHighlight)) { %>
          <%- heroTitle.replace(heroHighlight, '<span class="text-gradient">' + heroHighlight + '</span>') %>
        <% } else { %>
          <%= heroTitle %>
        <% } %>
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto"><%= t(ns + ':hero.description', '') %></p>
    </div>
  </div>
</section>

<section class="container mx-auto px-4 py-8 md:py-12">
  <div class="mx-auto max-w-4xl space-y-10">

    <!-- Tirage au sort, alimente par la liste ci-dessous -->
    <div id="questions-container"></div>

    <%
      // Les 120 questions sont ecrites dans le HTML, pas chargees en
      // JavaScript apres coup : c'est la liste elle-meme que les moteurs de
      // recherche doivent pouvoir lire, et c'est ce que font les pages qui se
      // positionnent sur cette requete.
      const liste = t(ns + ':liste', {});
      const themes = Object.keys(liste || {});
    %>
    <% if (themes.length) { %>
    <section class="qc-liste" id="liste-questions">
      <h2 class="qc-liste-titre"><%= t(ns + ':liste_titre', '') %></h2>
      <p class="qc-liste-intro"><%= t(ns + ':liste_intro', '') %></p>

      <nav class="qc-sommaire" aria-label="<%= t(ns + ':liste_titre', '') %>">
        <% themes.forEach(function (cle) { %>
        <a href="#theme-<%= cle %>" class="qc-sommaire-lien"><%= liste[cle].titre %></a>
        <% }); %>
      </nav>

      <% let numero = 0; %>
      <% themes.forEach(function (cle) { %>
      <div class="qc-theme" id="theme-<%= cle %>">
        <h3 class="qc-theme-titre"><%= liste[cle].titre %></h3>
        <p class="qc-theme-intro"><%- liste[cle].intro %></p>
        <ol class="qc-questions">
          <% liste[cle].questions.forEach(function (q) { numero++; %>
          <li class="qc-question"><span class="qc-numero"><%= numero %>.</span><span><%= q %></span></li>
          <% }); %>
        </ol>
      </div>
      <% }); %>
    </section>
    <% } %>

    <!-- SEO Article -->
    <article class="space-y-10 pt-10 border-t border-border seo-content">

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s1.title', '') %></h2>
        <div class="space-y-4 text-muted-foreground leading-relaxed">
          <p><%= t(ns + ':seo.s1.p1', '') %></p>
          <p><%= t(ns + ':seo.s1.p2', '') %></p>
          <p><%- t(ns + ':seo.s1.p3', '') %></p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s2.title', '') %></h2>
        <p class="text-muted-foreground mb-6 leading-relaxed"><%= t(ns + ':seo.s2.intro', '') %></p>
        <% if (tableRows.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="quiz-table">
            <thead><tr>
              <th><%= typeof tableHeaders === 'object' ? tableHeaders.category || 'Catégorie' : 'Catégorie' %></th>
              <th><%= typeof tableHeaders === 'object' ? tableHeaders.goal || 'Objectif' : 'Objectif' %></th>
              <th><%= typeof tableHeaders === 'object' ? tableHeaders.example || 'Exemple' : 'Exemple' %></th>
              <th><%= typeof tableHeaders === 'object' ? tableHeaders.count || 'Nombre' : 'Nombre' %></th>
            </tr></thead>
            <tbody>
              <% for (const row of tableRows) { %>
              <tr>
                <td class="font-medium"><%= row.cat %></td>
                <td class="text-muted-foreground"><%= row.goal %></td>
                <td class="text-muted-foreground italic">&laquo; <%= row.example %> &raquo;</td>
                <td class="text-center font-medium"><%= row.count %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
        <p class="text-muted-foreground mt-4 leading-relaxed"><%= t(ns + ':seo.s2.outro', '') %></p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s3.title', '') %></h2>
        <p class="text-muted-foreground mb-4 leading-relaxed"><%- t(ns + ':seo.s3.intro', '') %></p>
        <ul class="qc-points">
          <% for (const item of whenItems) { %>
          <li>
            <h3 class="qc-point-titre"><%= item.title %></h3>
            <p class="qc-point-texte"><%- item.desc %></p>
          </li>
          <% } %>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s4.title', '') %></h2>
        <p class="text-muted-foreground mb-4 leading-relaxed"><%= t(ns + ':seo.s4.intro', '') %></p>
        <ul class="qc-points">
          <% for (const tip of tipsList) { %>
          <li>
            <h3 class="qc-point-titre"><%= tip.title %></h3>
            <p class="qc-point-texte"><%- tip.desc %></p>
          </li>
          <% } %>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s5.title', '') %></h2>
        <p class="text-muted-foreground mb-4 leading-relaxed"><%- t(ns + ':seo.s5.p1', '') %></p>
        <ul class="qc-points">
          <% for (const aud of audiences) { %>
          <li>
            <h3 class="qc-point-titre"><%= aud.title %></h3>
            <p class="qc-point-texte"><%- aud.desc %></p>
          </li>
          <% } %>
        </ul>
        <p class="text-muted-foreground mt-4 leading-relaxed"><%- t(ns + ':seo.s5.outro', '') %></p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.s6.title', '') %></h2>
        <div class="space-y-4 text-muted-foreground leading-relaxed">
          <p><%- t(ns + ':seo.s6.p1', '') %></p>
          <p><%= t(ns + ':seo.s6.p2', '') %></p>
          <p><%= t(ns + ':seo.s6.p3', '') %></p>
        </div>
      </section>

      <% if (faqItems.length > 0) { %>
      <section>
        <h2 class="text-2xl font-bold mb-4"><%= t(ns + ':seo.faqTitle', 'FAQ') %></h2>
        <div class="space-y-4">
          <% for (const item of faqItems) { %>
          <details class="border border-border rounded-lg">
            <summary class="p-4 font-medium cursor-pointer hover:bg-muted transition-colors"><%= item.q %></summary>
            <div class="px-4 pb-4 text-muted-foreground leading-relaxed"><%= item.a %></div>
          </details>
          <% } %>
        </div>
      </section>
      <% } %>

    
      <% if (t(ns + ':conclusion', '')) { %>
      <section class="qc-conclusion">
        <p><%- t(ns + ':conclusion', '') %></p>
      </section>
      <% } %>

    </article>

  </div>
</section>

<script src="/js/questions-couple.js" defer></script>
